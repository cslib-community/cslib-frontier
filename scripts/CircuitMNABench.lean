set_option profiler true in
theorem stage_wf : sk4.check = true := by decide +kernel
set_option profiler true in
theorem stage_dec : sk4Dec.check sk4.size sk4.eRows sk4.fRows = true := by decide +kernel
set_option profiler true in
theorem stage_eq : isEquilibriumRows sk4.size sk4.fRows sk4.bList sk4Eq = true := by
  decide +kernel
set_option profiler true in
theorem stage_lyap_dense : sk4Lyap.check sk4Dec.k sk4Dec.A sk4P = true := by decide +kernel
set_option profiler true in
theorem stage_lyap_sparse :
    sk4SpLyap.check sk4Dec.k (sk4Dec.A.map (toSparseFrom 0)) sk4Psp = true := by
  decide +kernel
/-- The reduced matrix of the filter is exponentially stable, by the dense checker. -/
theorem stable_A_dense :
    (toEuclideanCLM (𝕜 := ℝ) (realOfRows sk4Dec.k sk4Dec.k sk4Dec.A)).IsExponentiallyStable :=
  LyapunovCert.isExponentiallyStable_of_check stage_lyap_dense

/-- The same, by the sparse checker. -/
theorem stable_A_sparse :
    (toEuclideanCLM (𝕜 := ℝ) (realOfRows sk4Dec.k sk4Dec.k sk4Dec.A)).IsExponentiallyStable := by
  simpa only [ofSparse_toSparse] using
    SparseLyapunovCert.isExponentiallyStable_of_check stage_lyap_sparse

/-- Every trajectory of the filter with zero input converges exponentially to its operating
point. -/
theorem stable_dense : ∃ M α : ℝ, 0 < α ∧ ∀ φ i, sk4.IsTrajectoryOn 0 φ i (Set.Ici 0) →
    ∀ t ≥ 0, ‖WithLp.toLp 2 (Fin.append (φ t) (i t) - realOfList sk4.size sk4Eq)‖ ≤
      M * Real.exp (-(α * t)) *
        ‖WithLp.toLp 2 (Fin.append (φ 0) (i 0) - realOfList sk4.size sk4Eq)‖ :=
  (sk4.isExponentiallyStable_of_check stage_wf stage_dec stage_eq stable_A_dense).2.2

/-- The same conclusion through the sparse checker. -/
theorem stable_sparse : ∃ M α : ℝ, 0 < α ∧ ∀ φ i, sk4.IsTrajectoryOn 0 φ i (Set.Ici 0) →
    ∀ t ≥ 0, ‖WithLp.toLp 2 (Fin.append (φ t) (i t) - realOfList sk4.size sk4Eq)‖ ≤
      M * Real.exp (-(α * t)) *
        ‖WithLp.toLp 2 (Fin.append (φ 0) (i 0) - realOfList sk4.size sk4Eq)‖ :=
  (sk4.isExponentiallyStable_of_check stage_wf stage_dec stage_eq stable_A_sparse).2.2

#print axioms stable_dense
#print axioms stable_sparse

