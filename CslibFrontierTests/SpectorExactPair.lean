import CslibFrontier.Foundations.Computability.SpectorExactPair

/-! Checked clients for Spector's exact pair theorem on degrees of sets:
1. Instantiating `Nat.RecursiveIn.exists_exactPair_seq` on `strictAscSeq` yields an exact pair with
   no greatest lower bound among degrees of sets or degrees of total functions.
2. The principal ideal `{d | IsSetDegree d ∧ d ≤ setDegree ∅}` (consisting solely of the bottom
   degree `setDegree ∅`) satisfies `IsSetDegreeIdeal`, is countable, and admits an exact pair via
   `TuringDegree.spector_exact_pair_setDegrees`.
3. The ideal generated by `strictAscSeq` satisfies `IsSetDegreeIdeal`, is countable, has no
   greatest element, and its exact pair has no greatest lower bound among degrees of sets. -/

namespace CslibFrontierTests.SpectorExactPair

open Nat.RecursiveIn TuringDegree
open scoped Computability

/-! ### Client 1: Exact pair for `strictAscSeq` has no meet -/

/-- Instantiating `exists_exactPair_seq` on `strictAscSeq` produces two sets `A` and `B` whose
degrees have no greatest lower bound among degrees of sets. -/
theorem exactPair_strictAscSeq_no_inf :
    ∃ A B : Set ℕ,
      (∀ n, setDegree (strictAscSeq n) ≤ setDegree A ∧
        setDegree (strictAscSeq n) ≤ setDegree B) ∧
      ∀ m, IsSetDegree m → m ≤ setDegree A → m ≤ setDegree B →
        ∃ d, IsSetDegree d ∧ d ≤ setDegree A ∧ d ≤ setDegree B ∧ ¬d ≤ m := by
  obtain ⟨A, B, hupper, hlower⟩ := exists_exactPair_seq strictAscSeq
  refine ⟨A, B, fun n => ?_, fun m hm hma hmb => ?_⟩
  · have hle : setDegree (strictAscSeq n) ≤ setDegree (prefixJoin strictAscSeq n) :=
      turingReducible_prefixJoin strictAscSeq le_rfl
    exact ⟨hle.trans (hupper n).1, hle.trans (hupper n).2⟩
  · obtain ⟨D, rfl⟩ := hm
    obtain ⟨n, hn⟩ := hlower (D.indicator 1) hma hmb
    have hpref : setDegree (prefixJoin strictAscSeq n) ≤ setDegree (strictAscSeq n) :=
      prefixJoin_turingReducible strictAscSeq n fun k hk =>
        strictMono_setDegree_strictAscSeq.monotone hk
    have hlt : setDegree D < setDegree (strictAscSeq (n + 1)) :=
      lt_of_le_of_lt (le_trans hn hpref) (strictMono_setDegree_strictAscSeq (Nat.lt_succ_self n))
    have hnext : setDegree (strictAscSeq (n + 1)) ≤ setDegree (prefixJoin strictAscSeq (n + 1)) :=
      turingReducible_prefixJoin strictAscSeq le_rfl
    exact ⟨setDegree (strictAscSeq (n + 1)), ⟨strictAscSeq (n + 1), rfl⟩,
      hnext.trans (hupper (n + 1)).1, hnext.trans (hupper (n + 1)).2, not_le_of_gt hlt⟩

/-! ### Client 2: Principal ideal below `setDegree ∅` -/

/-- The principal ideal of degrees of sets below `setDegree ∅`. -/
def emptyPrincipalIdeal : Set TuringDegree :=
  {d | IsSetDegree d ∧ d ≤ setDegree ∅}

theorem setDegree_empty_le (d : TuringDegree) : setDegree ∅ ≤ d := by
  induction d using Antisymmetrization.ind with
  | _ g =>
    have hzero : ((∅ : Set ℕ).indicator 1 : ℕ → ℕ) = fun _ => 0 := by
      funext n
      simp [Set.indicator]
    change (((∅ : Set ℕ).indicator 1 : ℕ → ℕ) : ℕ →. ℕ) ≤ᵀ g
    rw [hzero]
    exact Partrec.turingReducible (Computable.partrec (Computable.const 0))

theorem emptyPrincipalIdeal_eq_singleton : emptyPrincipalIdeal = {setDegree ∅} := by
  ext d
  constructor
  · rintro ⟨_, hle⟩
    exact le_antisymm hle (setDegree_empty_le d)
  · rintro rfl
    exact ⟨⟨∅, rfl⟩, le_rfl⟩

theorem isSetDegreeIdeal_emptyPrincipalIdeal : IsSetDegreeIdeal emptyPrincipalIdeal where
  nonempty := ⟨setDegree ∅, ⟨∅, rfl⟩, le_rfl⟩
  subset_setDegrees _ hd := hd.1
  lower _ _ hd₁ hd₂ hle := ⟨hd₂, hle.trans hd₁.2⟩
  sup_mem _ _ hd₁ hd₂ := ⟨hd₁.1.sup hd₂.1, sup_le hd₁.2 hd₂.2⟩

theorem countable_emptyPrincipalIdeal : emptyPrincipalIdeal.Countable :=
  (setDegree ∅).countable_Iic.mono fun _ hd => hd.2

/-- `spector_exact_pair_setDegrees` yields an exact pair for `emptyPrincipalIdeal`, i.e., a
minimal pair of degrees of sets whose only common lower bound among set degrees is `setDegree ∅`. -/
theorem exists_exactPair_emptyPrincipalIdeal :
    ∃ a b : TuringDegree,
      IsExactPairForSetDegrees emptyPrincipalIdeal a b ∧
      ∀ d, IsSetDegree d → d ≤ a → d ≤ b → d = setDegree ∅ := by
  obtain ⟨a, b, hab⟩ :=
    spector_exact_pair_setDegrees isSetDegreeIdeal_emptyPrincipalIdeal countable_emptyPrincipalIdeal
  refine ⟨a, b, hab, fun d hd hda hdb => ?_⟩
  have hmem : d ∈ emptyPrincipalIdeal := (hab.mem_iff d hd).2 ⟨hda, hdb⟩
  rw [emptyPrincipalIdeal_eq_singleton] at hmem
  exact hmem

/-! ### Client 3: Ideal generated by `strictAscSeq` -/

/-- The ideal of degrees of sets generated by `strictAscSeq`. -/
def strictAscIdeal : Set TuringDegree :=
  {d | IsSetDegree d ∧ ∃ n, d ≤ setDegree (strictAscSeq n)}

theorem isSetDegreeIdeal_strictAscIdeal : IsSetDegreeIdeal strictAscIdeal where
  nonempty := ⟨setDegree (strictAscSeq 0), ⟨strictAscSeq 0, rfl⟩, 0, le_rfl⟩
  subset_setDegrees _ hd := hd.1
  lower _ _ hd₁ hd₂ hle :=
    let ⟨n, hn⟩ := hd₁.2
    ⟨hd₂, n, hle.trans hn⟩
  sup_mem _ _ hd₁ hd₂ := by
    obtain ⟨n₁, hn₁⟩ := hd₁.2
    obtain ⟨n₂, hn₂⟩ := hd₂.2
    refine ⟨hd₁.1.sup hd₂.1, max n₁ n₂, sup_le ?_ ?_⟩
    · exact hn₁.trans (strictMono_setDegree_strictAscSeq.monotone (le_max_left n₁ n₂))
    · exact hn₂.trans (strictMono_setDegree_strictAscSeq.monotone (le_max_right n₁ n₂))

theorem countable_strictAscIdeal : strictAscIdeal.Countable := by
  refine (Set.countable_iUnion fun n => (setDegree (strictAscSeq n)).countable_Iic).mono ?_
  rintro d ⟨_, n, hn⟩
  exact Set.mem_iUnion.2 ⟨n, hn⟩

theorem strictAscIdeal_no_top :
    ∀ d ∈ strictAscIdeal, ∃ d' ∈ strictAscIdeal, d < d' := by
  rintro d ⟨_, n, hn⟩
  refine ⟨setDegree (strictAscSeq (n + 1)),
    ⟨⟨strictAscSeq (n + 1), rfl⟩, n + 1, le_rfl⟩,
    lt_of_le_of_lt hn (strictMono_setDegree_strictAscSeq (Nat.lt_succ_self n))⟩

/-- The exact pair for `strictAscIdeal` produced by `spector_exact_pair_setDegrees` has no greatest
lower bound among degrees of sets. -/
theorem exactPair_strictAscIdeal_no_inf :
    ∃ a b : TuringDegree,
      IsExactPairForSetDegrees strictAscIdeal a b ∧
      ∀ m, IsSetDegree m → m ≤ a → m ≤ b →
        ∃ d, IsSetDegree d ∧ d ≤ a ∧ d ≤ b ∧ m < d := by
  obtain ⟨a, b, hab⟩ :=
    spector_exact_pair_setDegrees isSetDegreeIdeal_strictAscIdeal countable_strictAscIdeal
  exact ⟨a, b, hab, hab.no_inf_of_no_top isSetDegreeIdeal_strictAscIdeal strictAscIdeal_no_top⟩

/-! ### Concrete set-join, prefix-join, and diagonalization checks -/

/-- Even positions of `setJoin A B` reflect membership in `A`, and odd positions reflect `B`. -/
example : 2 * 3 ∈ setJoin ({3} : Set ℕ) ({5} : Set ℕ) ∧
    2 * 5 + 1 ∈ setJoin ({3} : Set ℕ) ({5} : Set ℕ) ∧
    2 * 4 ∉ setJoin ({3} : Set ℕ) ({5} : Set ℕ) := by
  simp [setJoin]

/-- `prefixJoin` records columns `≤ n` and rejects columns `> n`. -/
example :
    Nat.pair 1 7 ∈ prefixJoin (fun k => {k + 6}) 1 ∧
    Nat.pair 2 8 ∉ prefixJoin (fun k => {k + 6}) 1 := by
  simp [prefixJoin]

/-- The constant-zero code outputs `0 ≠ 1` on its own Gödel number, so it belongs to `diagSet ∅`;
the code `comp succ zero` outputs `1` on every input, so it lies outside `diagSet ∅`. -/
example :
    Encodable.encode Nat.RecursiveIn.Code.zero ∈ diagSet ∅ ∧
    Encodable.encode (Nat.RecursiveIn.Code.comp .succ .zero) ∉ diagSet ∅ := by
  constructor
  · intro h
    simp only [Nat.RecursiveIn.Code.eval, Denumerable.ofNat_encode, pure, PFun.pure,
      Part.mem_some_iff] at h
    omega
  · intro h
    apply h
    simp only [Denumerable.ofNat_encode, Nat.RecursiveIn.Code.eval, pure, PFun.pure]
    change 1 ∈ (Part.some 0).bind fun x => Part.some (Nat.succ x)
    simp

/-- Neither the degrees of total functions nor the degrees of sets have meets for all pairs. -/
theorem not_exists_glb_setDegrees :
    ∃ a b : TuringDegree, IsSetDegree a ∧ IsSetDegree b ∧
      ¬∃ m, IsTotalDegree m ∧ m ≤ a ∧ m ≤ b ∧
        ∀ d, IsSetDegree d → d ≤ a → d ≤ b → d ≤ m := by
  obtain ⟨a, b, ha, hb, hno⟩ := exists_totalDegree_no_inf
  refine ⟨a, b, ha, hb, fun ⟨m, hm, hma, hmb, hglb⟩ => ?_⟩
  obtain ⟨d, hd, hda, hdb, hlt⟩ := hno m hm hma hmb
  exact not_le_of_gt hlt (hglb d hd hda hdb)

end CslibFrontierTests.SpectorExactPair
