/-!
# RAT steps in the LRAT checkers

The four clauses over `a = 0` and `b = 1` (DIMACS `1` and `2`) are refuted through a fresh variable
`x = 2` (DIMACS `3`). Clause `5`, `x`, is a RAT clause with no hints: no clause contains `¬x`.
Clause `6`, `¬x ∨ a`, is a RAT clause on the pivot `¬x`: its only candidate is clause `5`, and the
resolvent `¬x ∨ a` is refuted from `x, ¬a` by the hints `1, 2`. Then `a` is a RUP clause through
clauses `6` and `5`, and the empty clause follows. `checkLRATRat`, the kernel checker
`checkLRATKernel` and the array checker `checkLRATFast` accept it, and the RUP checker `checkLRAT`
rejects it. A wrong RAT chain, a missing RAT hint and a RAT step adding `¬a` to the
satisfiable formula `a` are rejected; a candidate with a tautological resolvent needs no hint.

A certificate from an independent solver: CaDiCaL 3.0.1 with `--factor` (bounded variable
addition) refutes PHP(7, 6) with 33 RAT steps among 976. Its definition clauses on the fresh
variables have no hints, and the other RAT steps have a RAT hint with an empty chain for each
candidate, whose resolvent is a tautology. The kernel checker and the array checker accept it,
and reject it once a literal is dropped from one RAT clause, which makes the resolvent with a
candidate neither a tautology nor refuted by its (empty) chain.
-/

set_option linter.privateModule false
set_option linter.hashCommand false
set_option linter.style.longFile 0

namespace CslibFrontierTests.Logics.Propositional.CNF.LRATRat

open Cslib.Logic.PL Std.Tactic.BVDecide

/-- Every clause over two variables. -/
private abbrev φ : CNF ℕ :=
  [[(0, true), (1, true)], [(0, true), (1, false)], [(0, false), (1, true)],
    [(0, false), (1, false)]]

/-- The refutation through the fresh variable `x`. -/
private abbrev cert : Array LRAT.IntAction :=
  #[.addRat 5 #[3] (3, true) #[] #[], .addRat 6 #[-3, 1] (3, false) #[] #[(5, #[1, 2])],
    .addRup 7 #[1] #[6, 5], .addEmpty 8 #[7, 3, 4]]

example : φ.checkLRATRat cert = true := by decide

example : ¬ φ.Satisfiable := CNF.not_satisfiable_of_checkLRATRat (cert := cert) (by decide)

example : φ.checkLRATKernel cert = true := by decide +kernel

#guard φ.checkLRATFast cert

-- The RUP checker rejects RAT steps.
example : φ.checkLRAT cert = false := by decide

-- Lean core's checker accepts the same certificate.
/-- info: true -/
#guard_msgs in
#eval LRAT.check cert φ.toStdSat

-- A RAT chain that does not refute the resolvent is rejected.
example : φ.checkLRATRat
    #[.addRat 5 #[3] (3, true) #[] #[], .addRat 6 #[-3, 1] (3, false) #[] #[(5, #[1])],
      .addRup 7 #[1] #[6, 5], .addEmpty 8 #[7, 3, 4]] = false := by decide

-- A candidate without a RAT hint is rejected when its resolvent is not a tautology.
example : φ.checkLRATRat
    #[.addRat 5 #[3] (3, true) #[] #[], .addRat 6 #[-3, 1] (3, false) #[] #[],
      .addRup 7 #[1] #[6, 5], .addEmpty 8 #[7, 3, 4]] = false := by decide

-- A candidate whose resolvent is a tautology needs no hint: `x ∨ ¬a` and `¬x ∨ a` resolve on `x`
-- to `a ∨ ¬a`.
example : φ.checkLRATRat
    #[.addRat 5 #[3, -1] (3, true) #[] #[], .addRat 6 #[-3, 1] (3, false) #[] #[],
      .addRup 7 #[1] #[1, 2], .addEmpty 8 #[7, 3, 4]] = true := by decide

-- `¬a` is not a RAT clause for the formula `a`, which it would make unsatisfiable.
example : CNF.checkLRATRat [[(0, true)]]
    #[.addRat 2 #[-1] (1, false) #[] #[], .addEmpty 3 #[2, 1]] = false := by decide

#guard !CNF.checkLRATFast [[(0, true)]]
  #[.addRat 2 #[-1] (1, false) #[] #[], .addEmpty 3 #[2, 1]]

/-- PHP(7, 6): pigeon `i` in hole `j` is the variable `6 * i + j`, the clauses in the order of
the DIMACS file the certificate refers to: each pigeon in some hole, then for each hole `j` and
pigeons `i < k`, not both in `j`. -/
private abbrev php : CNF ℕ :=
  (List.range 7).map (fun i => (List.range 6).map fun j => (6 * i + j, true)) ++
    (List.range 6).flatMap fun j => (List.range 7).flatMap fun i =>
      ((List.range 7).filter (i < ·)).map fun k => [(6 * i + j, false), (6 * k + j, false)]

