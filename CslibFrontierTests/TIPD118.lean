/-- The netlist read from a text, if it is accepted (kernel-decidable, unlike equality in
`Except`). -/
def okOf : Except String ParsedNetlist → Option ParsedNetlist
  | .ok P => some P
  | .error _ => none

/-- A text whose reading `okOf` accepts parses to that netlist. -/
theorem eq_ok_of_okOf {e : Except String ParsedNetlist} {P : ParsedNetlist}
    (h : okOf e = some P) : e = .ok P := by
  cases e <;> simp_all [okOf]

/-! ### The OPA1611 macromodel, open loop -/

/-- The OPA1611 macromodel in open loop: the input port `V1` drives the non-inverting
input (the inverting input is grounded) and the input port `I1` injects a test current into
the output. -/
