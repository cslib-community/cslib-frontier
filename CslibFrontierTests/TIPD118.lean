/-- **The certificate is accepted against the macromodel text.** -/
theorem opaText_check : checkText opaText opaCert = true := by decide +kernel

/-- The computed output rows of the realization of `opaText`: `C = [1, RL1]`,
`D = [0, RO1 + RL1]`. -/
theorem opa_rows :
    eqSparse (SparseRealizationCert.outputRows opaCert.dec
        (opaParsed.netlist.probeSparse opaParsed.probes)) [[(0, 1), (1, 294/5)]] = true ∧
      eqSparse (opaCert.real.feedthroughRows opaCert.dec
        (opaParsed.netlist.probeSparse opaParsed.probes)) [[(1, 29761/500)]] = true := by
  decide +kernel

/-- **The checked realization of the macromodel**: the state is the voltage on `CP1` and the
current of `LO1`, `A = diag (-ωp, -RL1/LO1)` with `ωp = 1/(RP1 CP1)`, `B = diag (gm/CP1, -RL1/LO1)`,
`C = [1, RL1]` and `D = [0, RO1 + RL1]`. -/
theorem opa_realization :
    opaParsed.netlist.sparseRealization opaCert.dec opaCert.real opaParsed.probes =
      ⟨!![-500000000000/6291352081, 0; 0, -58800000000/893],
        !![1000000000000/3979, 0; 0, -58800000000/893], !![1, 294/5], !![0, 29761/500]⟩ := by
  simp only [Netlist.sparseRealization, realOfSparse_eq_of_eqSparse opa_rows.1,
    realOfSparse_eq_of_eqSparse opa_rows.2]
  congr 1 <;> ext i j <;> fin_cases i <;> fin_cases j <;>
    simp [realOfRows, ofLists_apply, ofList_apply, ofSparse_apply, sparseGet_cons, opaCert]

/-- **The open-loop transfer function of the macromodel**, from the differential input and from
a test current into the output to the output voltage:
`H s = [A0 ωp / (s + ωp), RO1 + RL1 LO1 s / (LO1 s + RL1)]` with `A0 = 3162278`,
`ωp = 1/(RP1 CP1) = 500000000000/6291352081 rad/s`, `RO1 = 361/500`, `RL1 = 294/5` and
`LO1 = 893/1000000000`, for every `s` off the two poles. -/
theorem opa_transferFunction {s : ℂ} (h₁ : s + 500000000000 / 6291352081 ≠ 0)
    (h₂ : 893 / 1000000000 * s + 294 / 5 ≠ 0) :
    (opaParsed.netlist.sparseRealization opaCert.dec opaCert.real
        opaParsed.probes).transferFunction s =
      !![3162278 * (500000000000 / 6291352081) / (s + 500000000000 / 6291352081),
        361 / 500 + 294 / 5 * (893 / 1000000000 * s) / (893 / 1000000000 * s + 294 / 5)] := by
  have h₃ : s + 58800000000 / 893 ≠ 0 := fun h => h₂ (by linear_combination 893 / 1000000000 * h)
  rw [opa_realization]
  change LTISystem.transferFunction (n := Fin 2) (m := Fin 2) (p := Fin 1) _ s = _
  have hd : s • (1 : Matrix (Fin 2) (Fin 2) ℂ) -
      (!![-500000000000 / 6291352081, 0; 0, -58800000000 / 893] : Matrix (Fin 2) (Fin 2) ℝ).map
        (algebraMap ℝ ℂ) = diagonal ![s + 500000000000 / 6291352081, s + 58800000000 / 893] := by
    ext i j; fin_cases i <;> fin_cases j <;> simp [sub_eq_add_neg, neg_div]
  have hi : (diagonal ![s + 500000000000 / 6291352081, s + 58800000000 / 893])⁻¹ =
      diagonal ![(s + 500000000000 / 6291352081)⁻¹, (s + 58800000000 / 893)⁻¹] := by
    refine inv_eq_left_inv ?_
    rw [diagonal_mul_diagonal, ← diagonal_one]
    congr 1; ext i; fin_cases i <;> simp [h₁, h₃]
  have h₄ : 58800000000 + s * 893 ≠ 0 := fun h => h₃ (by linear_combination h / 893)
  have h₅ : 294000000000 + s * 4465 ≠ 0 := fun h => h₃ (by linear_combination h / 4465)
  simp only [LTISystem.transferFunction, hd, hi]
  ext i j; fin_cases i; fin_cases j
  · simp [Matrix.mul_apply, Fin.sum_univ_two]; field_simp; ring
  · simp [Matrix.mul_apply, Fin.sum_univ_two]; field_simp
    linear_combination (-147000 + 656355000 * s * (294000000000 + s * 4465)⁻¹) *
      inv_mul_cancel₀ h₄ + (-131271000 * s * (58800000000 + s * 893)⁻¹) * inv_mul_cancel₀ h₅

