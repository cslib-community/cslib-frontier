/-- The checked realization of `tipdText` as a sparse rational model. -/
def tipdLTI : SparseRatLTI 6 1 1 :=
  ⟨sparseOfRows tipdCert.dec.A, tipdAt, tipdCert.real.B, tipdBt, tipdC, tipdCt⟩

/-- The computed output rows of the realization of `tipdText`: `C = tipdC`, `D = 0`. -/
theorem tipd_rows :
    eqSparse (SparseRealizationCert.outputRows tipdCert.dec
        (tipdParsed.netlist.probeSparse tipdParsed.probes)) tipdC = true ∧
      eqSparse (tipdCert.real.feedthroughRows tipdCert.dec
        (tipdParsed.netlist.probeSparse tipdParsed.probes)) [] = true := by
  decide +kernel

/-- The checked realization of `tipdText` is the system of `tipdLTI`. -/
theorem tipd_realization :
    tipdParsed.netlist.sparseRealization tipdCert.dec tipdCert.real tipdParsed.probes =
      tipdLTI.toSystem := by
  simp only [Netlist.sparseRealization, SparseRatLTI.toSystem,
    realOfSparse_eq_of_eqSparse tipd_rows.1, realOfSparse_eq_of_eqSparse tipd_rows.2]
  congr 1
  · simp only [tipdLTI, ofSparse_sparseOfRows]
    rfl
  · ext i j
    simp [ofSparse_apply]

/-- **The decay certificate is accepted** for the realization of `tipdText`. -/
theorem tipdDecay_check : tipdDecay.check tipdLTI = true := by decide +kernel

/-- **Certified decay rate of TIPD118.** Every solution of the state equation `x' = A x` of the
checked realization of `tipdText` satisfies `‖x t‖₂² ≤ (hi / lo) exp (-18 t) ‖x 0‖₂²`: the state
decays at the rate `α = 9 s⁻¹`. -/
theorem tipd_decay {x : ℝ → Fin 6 → ℝ}
    (hx : ∀ t ∈ Ici (0 : ℝ), HasDerivWithinAt x (tipdLTI.toSystem.A *ᵥ x t) (Ici 0) t) {t : ℝ}
    (ht : 0 ≤ t) :
    x t ⬝ᵥ x t ≤ tipdDecay.hi / tipdDecay.lo * Real.exp (-(2 * tipdDecay.α) * t) * (x 0 ⬝ᵥ x 0) :=
  (SparseDecayCert.decayInequalities tipdDecay_check).dotProduct_self_le hx ht

/-- **Certified impulse-response envelope of TIPD118.** The impulse response `h` from `VIN` to
`VOUT` of the circuit described by `tipdText` (the response kernel of its checked realization,
`tipd_realization`, which `tipd_guarantee` identifies with the zero-state response) satisfies
`h t ² ≤ γ β exp (-2 α t)` for `t ≥ 0`, with `α = 9 s⁻¹` and `γ β = 2555904 · 242`. -/
theorem tipd_impulse_le {t : ℝ} (ht : 0 ≤ t) :
    tipdLTI.toSystem.responseKernel t 0 0 ^ 2 ≤
      tipdDecay.γ * tipdDecay.β * Real.exp (-(2 * tipdDecay.α) * t) := by
  have h := (SparseDecayCert.decayInequalities tipdDecay_check).responseKernel_mulVec_sq_le
    (fun _ => 1) ht
  simp only [dotProduct, mulVec, Finset.univ_unique, Fin.default_eq_zero, Finset.sum_singleton,
    mul_one] at h
  simpa only [sq] using h

