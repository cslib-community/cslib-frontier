module

import CslibFrontier.Crypto.Computational.DiscreteLog.SchnorrGroup.Decodable
import CslibFrontier.Crypto.Computational.ElGamal.Homomorphism
import CslibFrontierTests.Crypto.PrimeOrderGroupFixture
import Mathlib.Tactic.NormNum.Prime

/-!
# Tests for Multiplicative ElGamal Homomorphism and DDH Equivalence

Exercises `CslibFrontier/Crypto/Computational/ElGamal/Homomorphism.lean` ([BonehShoup2023],
Exercise 11.5(b) and (c), p. 459) under module encapsulation:

1. **Exercise 11.5(c) on `schnorrDecodableGroups` (`d23`, subgroup of order `11` modulo `23`
   generated by `2`):** concrete word-level homomorphic ciphertext combination
   (`elGamalAddCiphertext`) multiplying plaintexts `2` and `8` into `16 ≡ 2 * 8 (mod 23)`,
   polynomial-time computability (`computableInPolyTime_elGamalAddCiphertext`), support closure on
   `elGamalEncryptProb` (`elGamalAddCiphertext_mem_support_elGamalEncryptProb`), and decryption
   completeness (`elGamalDecryptDet_elGamalAddCiphertext`).
2. **Exercise 11.5(b) failure instance:** for any `DecodablePrimeOrderGroupFamily` and fixed group
   description `d₀`, DDH fails on `fun _ => PMF.pure d₀` (`PrimeOrderGroupFixture.not_ddh_const`),
   so native group-element multiplicative ElGamal fails `INDCPAOn` by
   `mt (F.indcpaOn_elGamalGroupEncryptProb_iff_ddh (.const d₀)).mp` (instantiated concretely on
   `schnorrDecodableGroups` at `d23`).
-/

-- This regression module checks ordinary imports and exports no test fixtures.
set_option linter.privateModule false

namespace CslibFrontierTests.Crypto.ElGamalHomomorphism

open Cslib Cslib.Probability Cslib.Crypto Cslib.Crypto.Encryption
  Cslib.Crypto.PrimeOrderGroupFamily CslibFrontierTests.Crypto.PrimeOrderGroupFixture
  Turing.MultiTapeTM

/-- The Schnorr group of order `11` in `(ZMod 23)ˣ`, generated by `2`. -/
def d23 : schnorrDecodableGroups.Desc :=
  ⟨(23, 11, 2), ⟨by norm_num, by norm_num, by norm_num, by norm_num, by norm_num⟩⟩

/-! ### Exercise 11.5(c): Concrete and support-level homomorphism on `d23` -/

-- Under secret key `a = 3` (public key `2^3 = 8 mod 23`), combining an encryption of `2` (coin `5`)
-- with an encryption of `8` (coin `7`) produces the encryption of `2 * 8 = 16` with coin `5 + 7 =
-- 12` (and with reduced coin `12 % 11 = 1`), which decrypts to `16`.
example :
    let pk := schnorrDecodableGroups.encodeElGamalPublicKey (d23, 3)
    let ct₁ := encPair encBits encBits
      (schnorrDecodableGroups.encodeElGamalEncrypt (d23, pk, (2 : ℕ).bits, 5))
    let ct₂ := encPair encBits encBits
      (schnorrDecodableGroups.encodeElGamalEncrypt (d23, pk, (8 : ℕ).bits, 7))
    let ct := schnorrDecodableGroups.elGamalAddCiphertext d23 ct₁ ct₂
    ct = encPair encBits encBits
        (schnorrDecodableGroups.encodeElGamalEncrypt (d23, pk, (16 : ℕ).bits, 12)) ∧
      ct = encPair encBits encBits
        (schnorrDecodableGroups.encodeElGamalEncrypt (d23, pk, (16 : ℕ).bits, 1)) ∧
      schnorrDecodableGroups.elGamalDecryptDet (fun _ => d23) 0 (encNat 3) ct = (16 : ℕ).bits := by
  decide

example :
    ComputableInPolyTime
      (fun p : schnorrDecodableGroups.Desc × List Bool × List Bool =>
        schnorrDecodableGroups.elGamalAddCiphertext p.1 p.2.1 p.2.2)
      (encPair schnorrDecodableGroups.encDesc (encPair encBits encBits)) encBits :=
  schnorrDecodableGroups.computableInPolyTime_elGamalAddCiphertext

-- Support closure and decryption completeness on `elGamalEncryptProb` outputs at `d23`.
example (n : ℕ) {keys : List Bool × List Bool}
    (hkeys : keys ∈ (ProbComp.eval
      (schnorrDecodableGroups.elGamalKeyGenProb (fun _ => d23) n)).support)
    (m₁ m₂ : schnorrDecodableGroups.Carrier d23) {ct₁ ct₂ : List Bool}
    (hct₁ : ct₁ ∈ (ProbComp.eval
      (schnorrDecodableGroups.elGamalEncryptProb (fun _ x => x) (fun _ => d23) n keys.1
        (schnorrDecodableGroups.encode d23 m₁))).support)
    (hct₂ : ct₂ ∈ (ProbComp.eval
      (schnorrDecodableGroups.elGamalEncryptProb (fun _ x => x) (fun _ => d23) n keys.1
        (schnorrDecodableGroups.encode d23 m₂))).support) :
    schnorrDecodableGroups.elGamalAddCiphertext d23 ct₁ ct₂ ∈ (ProbComp.eval
      (schnorrDecodableGroups.elGamalEncryptProb (fun _ x => x) (fun _ => d23) n keys.1
        (schnorrDecodableGroups.encode d23 (m₁ + m₂)))).support ∧
    schnorrDecodableGroups.elGamalDecryptDet (fun _ => d23) n keys.2
        (schnorrDecodableGroups.elGamalAddCiphertext d23 ct₁ ct₂) =
      schnorrDecodableGroups.encode d23 (m₁ + m₂) :=
  ⟨schnorrDecodableGroups.elGamalAddCiphertext_mem_support_elGamalEncryptProb
      (fun _ => d23) n hkeys hct₁ hct₂,
   schnorrDecodableGroups.elGamalDecryptDet_elGamalAddCiphertext
      (fun _ => d23) n hkeys hct₁ hct₂⟩

/-! ### Exercise 11.5(b): Failure of semantic security when DDH fails -/

/-- For every `DecodablePrimeOrderGroupFamily` and fixed group `d₀`, group-element multiplicative
ElGamal is not semantically secure (`¬ INDCPAOn`), deduced directly from
`indcpaOn_elGamalGroupEncryptProb_iff_ddh` and `PrimeOrderGroupFixture.not_ddh_const`
([BonehShoup2023], Exercise 11.5(b), p. 459). -/
theorem not_indcpaOn_elGamalGroupEncryptProb_const (F : DecodablePrimeOrderGroupFamily)
    (d₀ : F.Desc) :
    ¬ INDCPAOn (F.elGamalGroupValid (fun _ => d₀)) encBits
      (F.elGamalKeyGenProb (fun _ => d₀))
      (F.elGamalEncryptProb (fun _ m => m) (fun _ => d₀)) :=
  mt (F.indcpaOn_elGamalGroupEncryptProb_iff_ddh (.const d₀)).mp
    (not_ddh_const F.toPrimeOrderGroupFamily d₀)

-- Concrete Exercise 11.5(b) failure instance on `schnorrDecodableGroups` at `d23`.
example :
    ¬ schnorrDecodableGroups.toPrimeOrderGroupFamily.DDH (fun _ => PMF.pure d23) ∧
      ¬ INDCPAOn (schnorrDecodableGroups.elGamalGroupValid (fun _ => d23)) encBits
        (schnorrDecodableGroups.elGamalKeyGenProb (fun _ => d23))
        (schnorrDecodableGroups.elGamalEncryptProb (fun _ m => m) (fun _ => d23)) :=
  ⟨not_ddh_const schnorrDecodableGroups.toPrimeOrderGroupFamily d23,
   not_indcpaOn_elGamalGroupEncryptProb_const schnorrDecodableGroups d23⟩

end CslibFrontierTests.Crypto.ElGamalHomomorphism
