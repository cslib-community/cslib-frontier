module

import CslibFrontier.Crypto.Computational.DiffieHellman.GapCDH.Decodable
import CslibFrontier.Crypto.Computational.DiscreteLog.SchnorrGroup.Decodable
import CslibFrontier.Computability.Probabilistic.Oracle.Composition
import CslibFrontier.Computability.Machines.Turing.MultiTape.Complexity.PolyTime.Basic
import CslibFrontier.Computability.Machines.Turing.MultiTape.Complexity.PolyTime.List
import CslibFrontier.Computability.Machines.Turing.MultiTape.Complexity.PolyTime.Nat
import CslibFrontier.Tactic.PolyTime
import Mathlib.Tactic.NormNum.Prime

/-!
# Client tests for Gap-CDH, word-level DH-KEM, and Theorem 12.22

Exercises `CslibFrontier.Crypto.Computational.DiffieHellman.GapCDH.Decodable` (and its transitive
exports from `GapCDH.Assumption` and `GapCDH.WordKEM`) through ordinary `import` in a downstream
`module` file:

* Fixed-base DDH word oracle `ddhWordOracle` on `schnorrDecodableGroups` (`d23`, order `11` modulo
  `23` generated by `2`) for matching triples, non-matching triples, out-of-subgroup words, and
  ill-framed wire words.
* Word-level DH-KEM encapsulation/decapsulation round-trip (`dhKEMDecapsWord_encapsWord`) and
  canonical subgroup validation (`dhKEMDecapsWord_of_not_isElem`).
* Certified uniform strict oracle-PPT KEM CCA distinguisher instantiation with
  `isOraclePPTOn_dhKEMToGapCDHWord`, `advantage_dhKEMCCAWordGame_le`, and `GapCDH.dhKEMROMINDCCA`.
-/

-- Regression client module exercising ordinary imports; exports no test fixtures.
set_option linter.privateModule false

namespace CslibFrontierTests.Crypto.GapCDHDecodable

open Cslib Cslib.Probability Cslib.Crypto Turing.MultiTapeTM
open scoped NNReal

/-- The Schnorr subgroup of order `11` in `(ZMod 23)ˣ`, generated by `2`. -/
def d23 : schnorrDecodableGroups.Desc :=
  ⟨(23, 11, 2), ⟨by norm_num, by norm_num, by norm_num, by norm_num, by norm_num⟩⟩

/-! ### Fixed-base DDH word oracle on `schnorrDecodableGroups` -/

-- Valid matching query `(u = g, v = 3 • g)` at secret `b = 3` returns `[true]`;
-- valid non-matching query `(u = g, v = g)` at `b = 3` returns `[false]`;
-- out-of-subgroup residue `5` returns `[false]`; ill-framed `[]` returns `[false]`.
example :
    schnorrDecodableGroups.ddhWordOracle d23 3
      (encDDHOracleQuery ⟨schnorrDecodableGroups.encode d23 (schnorrDecodableGroups.generator d23),
        schnorrDecodableGroups.encode d23
          ((3 : ZMod (schnorrDecodableGroups.order d23)) •
            schnorrDecodableGroups.generator d23)⟩) = [true] ∧
    schnorrDecodableGroups.ddhWordOracle d23 3
      (encDDHOracleQuery ⟨schnorrDecodableGroups.encode d23 (schnorrDecodableGroups.generator d23),
        schnorrDecodableGroups.encode d23 (schnorrDecodableGroups.generator d23)⟩) = [false] ∧
    schnorrDecodableGroups.ddhWordOracle d23 3
      (encDDHOracleQuery ⟨(5 : ℕ).bits, (5 : ℕ).bits⟩) = [false] ∧
    schnorrDecodableGroups.ddhWordOracle d23 3 [] = [false] := by
  refine ⟨?_, ?_, ?_, rfl⟩
  · rw [schnorrDecodableGroups.ddhWordOracle_encDDHOracleQuery,
      schnorrDecodableGroups.ddhOraclePred_encode]
    simp
  · rw [schnorrDecodableGroups.ddhWordOracle_encDDHOracleQuery,
      schnorrDecodableGroups.ddhOraclePred_encode]
    have hne : schnorrDecodableGroups.generator d23 ≠
        (3 : ZMod (schnorrDecodableGroups.order d23)) • schnorrDecodableGroups.generator d23 := by
      intro h
      have h1 : (1 : ZMod (schnorrDecodableGroups.order d23)) = 3 :=
        schnorrDecodableGroups.smul_generator_injective d23 (by simpa using h)
      have hval : ZMod.val (1 : ZMod 11) = ZMod.val (3 : ZMod 11) := congrArg ZMod.val h1
      revert hval
      decide
    simp [hne]
  · rw [schnorrDecodableGroups.ddhWordOracle_encDDHOracleQuery]
    have his : schnorrDecodableGroups.isElem (d23, (5 : ℕ).bits) = false :=
      (schnorrDecodableGroups_isElem _).trans (by decide)
    simp [DecodablePrimeOrderGroupFamily.ddhOraclePred, his]

/-! ### Word-level DH-KEM encapsulation and malformed-ciphertext rejection -/

example (H : schnorrDecodableGroups.Carrier d23 → BitString 16)
    (x y : ZMod (schnorrDecodableGroups.order d23)) :
    let out := schnorrDecodableGroups.dhKEMEncapsWord d23 H
      (x • schnorrDecodableGroups.generator d23) y
    schnorrDecodableGroups.dhKEMDecapsWord d23 H x out.ciphertext = some out.key ∧
    schnorrDecodableGroups.dhKEMDecapsWord d23 H x (5 : ℕ).bits = none ∧
    schnorrDecodableGroups.dhKEMDecapsWord d23 H x (24 : ℕ).bits = none := by
  refine ⟨schnorrDecodableGroups.dhKEMDecapsWord_encapsWord d23 H x y, ?_, ?_⟩
  · exact schnorrDecodableGroups.dhKEMDecapsWord_of_not_isElem d23 H x
      ((schnorrDecodableGroups_isElem _).trans (by decide))
  · exact schnorrDecodableGroups.dhKEMDecapsWord_of_not_isElem d23 H x
      ((schnorrDecodableGroups_isElem _).trans (by decide))

/-! ### Certified KEM CCA adversary and end-to-end Theorem 12.22 instantiation -/

/-- A toy word-level KEM CCA adversary that queries bounded prefixes of both the random oracle and
the decapsulation oracle on `challenge` and tests whether the two replies coincide. -/
def toyKEMAdversary (n : ℕ) (challenge : List Bool) : WordOracleComp DHKEMOp Bool := do
  let h ← List.take n <$> ProbOracleComp.query (.hash, challenge)
  let dec ← List.take (2 * n + 4) <$> ProbOracleComp.query (.decaps, challenge)
  return h == dec

theorem isOraclePPT_toyKEMAdversary : IsOraclePPT encBool toyKEMAdversary := by
  have hhash : IsOraclePPTOn (encPair encUnary encBits) encBits
      (fun x : ℕ × List Bool => List.take x.1 <$> ProbOracleComp.query (DHKEMOp.hash, x.2)) :=
    IsOraclePPTOn.query_take DHKEMOp.hash (by polytime) (by polytime)
  have hdec : IsOraclePPTOn (encPair (encPair encUnary encBits) encBits) encBool
      (fun p : (ℕ × List Bool) × List Bool =>
        (p.2 == ·) <$>
          (List.take (2 * p.1.1 + 4) <$> ProbOracleComp.query (DHKEMOp.decaps, p.1.2))) :=
    (IsOraclePPTOn.query_take DHKEMOp.decaps (by polytime) (by polytime)).map_with (by polytime)
  exact (hhash.bind_with
    (second := fun x h =>
      (h == ·) <$>
        (List.take (2 * x.1 + 4) <$> ProbOracleComp.query (DHKEMOp.decaps, x.2)))
    hdec).congr fun ⟨_, _⟩ _ _ _ => by simp [toyKEMAdversary]

example {F : DecodablePrimeOrderGroupFamily} {setup : ℕ → PMF F.Desc}
    (hGap : F.GapCDH setup) :
    F.DHKEMROMINDCCA setup id :=
  hGap.dhKEMROMINDCCA ComputableInPolyTime.id'

example {F : DecodablePrimeOrderGroupFamily} {setup : ℕ → PMF F.Desc}
    (hGap : F.GapCDH setup) :
    IsOraclePPTOn (encGapCDHInput F.toPrimeOrderGroupFamily) encBits
      (F.dhKEMToGapCDHWord id toyKEMAdversary) ∧
    (∀ n, Game.advantage (F.dhKEMCCAWordGame setup id toyKEMAdversary true n)
        (F.dhKEMCCAWordGame setup id toyKEMAdversary false n) ≤
      Game.succProbability
        (F.gapCDHWordGame setup (F.dhKEMToGapCDHWord id toyKEMAdversary) n)) ∧
    F.DHKEMROMINDCCA setup id ∧
    Negligible (fun n => Game.advantage
      (F.dhKEMCCAWordGame setup id toyKEMAdversary true n)
      (F.dhKEMCCAWordGame setup id toyKEMAdversary false n)) := by
  have hcca : F.DHKEMROMINDCCA setup id := hGap.dhKEMROMINDCCA ComputableInPolyTime.id'
  exact ⟨F.isOraclePPTOn_dhKEMToGapCDHWord_id isOraclePPT_toyKEMAdversary,
    F.advantage_dhKEMCCAWordGame_le setup id isOraclePPT_toyKEMAdversary,
    hcca,
    hcca toyKEMAdversary isOraclePPT_toyKEMAdversary⟩

end CslibFrontierTests.Crypto.GapCDHDecodable
