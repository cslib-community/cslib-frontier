import CslibFrontier.Crypto.Primitives.HQC.ReedSolomon

/-!
# Tests: the shortened Reed–Solomon layer used by HQC

The source locator contains exactly `t1 + 1` coefficients.  In particular, the Chien root test
for the concrete Berlekamp result is evaluation of that bounded polynomial; no coefficient above
`t1` can affect it while remaining invisible to `Z` or the odd-locator denominator.

The three known-answer clients below transcribe sample 1 of the official
`exactly_t1_errors_any_position` scenario for HQC-1, HQC-3, and HQC-5.  They come from the
`kats/rs/<parameter-set>/rs.tv` files in implementation tag `v5.1.0`, commit
`06567ccbad10580d78dd7863b15d23f41076d57f`.  The pinned files have SHA-256 hashes
`745b727bbbd679649346d41e799bd8d07afd9fab1e955c5a4c8371786b41c2a3`,
`57b316d844a53d47dcdc9ee6e120cbe30d815bec4ac0aa753d8c10d0dcc81f76`, and
`c84b656037b87e1d880ddbee6297a06bb23ebcf4a715da738835947c0be07785`, respectively.

`HQCOfficialExactRadiusKATsHold` is deliberately a proposition rather than a proved result in this
source-only tranche.  It records the complete encoder/intermediate/decoder comparison that must be
discharged once the artifact lane is available.  Clean, message-only, parity-only, smaller mixed,
beyond-radius, full-corruption, and zero-denominator-guard clients also remain to be added.
-/

namespace CslibFrontierTests.Crypto.HQCReedSolomon

open Polynomial Cslib.Crypto.HQC

example :
    let p := hqcReedSolomonParameters .hqc1
    (p.length, p.messageLength, p.capacity) = (46, 16, 15) := by
  decide

example :
    let p := hqcReedSolomonParameters .hqc3
    (p.length, p.messageLength, p.capacity) = (56, 24, 16) := by
  decide

example :
    let p := hqcReedSolomonParameters .hqc5
    (p.length, p.messageLength, p.capacity) = (90, 32, 29) := by
  decide

/-- Regression for the capped-locator boundary: even the first coefficient beyond the source
array is identically zero. -/
example {F : Type*} [Semiring F] (p : HQCReedSolomonParameters)
    (locator : HQCRSErrorLocator p F) :
    (hqcRSLocatorPolynomial p locator).coeff (p.capacity + 1) = 0 :=
  hqcRSLocatorPolynomial_coeff_eq_zero p locator (by omega)

/-- The concrete Berlekamp stage feeds Chien evaluation only through the source's `t1 + 1`
coefficients. -/
example {F : Type*} [Field F] [CharP F 2] [DecidableEq F]
    (p : HQCReedSolomonParameters) (syndromes : Fin (2 * p.capacity) → F) (beta : F) :
    (hqcRSLocatorPolynomial p (hqcRSBerlekampLocator p syndromes)).eval beta =
      ∑ i, hqcRSBerlekampLocator p syndromes i * beta ^ (i : ℕ) :=
  hqcRSLocatorPolynomial_eval p (hqcRSBerlekampLocator p syndromes) beta

/-- One official source known-answer record, with bytes stored in codeword order. -/
structure HQCRSKnownAnswer where
  parameterSet : HQCReedSolomonInstance
  message : List ℕ
  codeword : List ℕ
  corrupted : List ℕ
  syndromes : List ℕ
  locator : List ℕ
  errorPositions : List ℕ
  decoded : List ℕ

/-- Interpret a byte list as a fixed-length HQC byte word.  A malformed short fixture is padded
with zero; `HQCRSKnownAnswer.WellFormed` rules this out for the clients below. -/
noncomputable def hqcRSBytes (n : ℕ) (bytes : List ℕ) : Fin n → HQCByte :=
  fun i => hqcByteOfNat (bytes.getD i 0)

/-- Interpret the source's byte-valued message-position flags as Booleans. -/
def hqcRSFlags (n : ℕ) (flags : List ℕ) : Fin n → Bool :=
  fun i => flags.getD i 0 != 0

/-- The record has exactly the dimensions of its selected parameter set. -/
def HQCRSKnownAnswer.WellFormed (kat : HQCRSKnownAnswer) : Prop :=
  let p := hqcReedSolomonParameters kat.parameterSet
  kat.message.length = p.messageLength ∧
    kat.codeword.length = p.length ∧
    kat.corrupted.length = p.length ∧
    kat.syndromes.length = 2 * p.capacity ∧
    kat.locator.length = p.capacity + 1 ∧
    kat.errorPositions.length = p.messageLength ∧
    kat.decoded.length = p.messageLength

/-- The exact source comparison exercised by an official record: encoding, the number of changed
symbols, syndromes, the capped locator, message-position Chien flags, and decoded message. -/
noncomputable def HQCRSKnownAnswer.Holds (kat : HQCRSKnownAnswer) : Prop :=
  let p := hqcReedSolomonParameters kat.parameterSet
  let message := hqcRSBytes p.messageLength kat.message
  let codeword := hqcRSBytes p.length kat.codeword
  let corrupted := hqcRSBytes p.length kat.corrupted
  let syndromes := hqcRSBytes (2 * p.capacity) kat.syndromes
  let locator := hqcRSBytes (p.capacity + 1) kat.locator
  kat.WellFormed ∧
    hqcRSLFSREncode p message = codeword ∧
    hammingNorm (corrupted - codeword) = p.capacity ∧
    hqcRSSyndromes p hqcAlpha corrupted = syndromes ∧
    hqcRSBerlekampLocator p syndromes = locator ∧
    hqcRSErrorPositions p hqcAlpha locator = hqcRSFlags p.messageLength kat.errorPositions ∧
    hqcRSDecode p hqcAlpha corrupted = hqcRSBytes p.messageLength kat.decoded ∧
    hqcRSBytes p.messageLength kat.decoded = message

