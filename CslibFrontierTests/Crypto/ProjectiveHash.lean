/-- Probe 7 (`universal2Wins` winning condition): dropping `ρHat ≠ ρ` lets an admissible `Q = 1`
adversary win with probability `1 > 1 / 11` by repeating `(z, v, w, ρ)`. -/
example :
    let g := schnorrGroups.generator d23
    let winsNoRhoNe : ZMod (schnorrGroups.order d23) → ZMod (schnorrGroups.order d23) →
        ZMod (schnorrGroups.order d23) → ZMod (schnorrGroups.order d23) →
        schnorrGroups.Carrier d23 →
        List (schnorrGroups.Carrier d23 × schnorrGroups.Carrier d23 ×
          schnorrGroups.Carrier d23 × ZMod (schnorrGroups.order d23)) → Bool :=
      fun σ₁ τ₁ σ₂ τ₂ u guesses => by
        classical
        exact guesses.any fun (zHat, vHat, wHat, ρHat) =>
          decide (¬ IsDHTriple schnorrGroups d23 u vHat wHat ∧
            zHat = projHash2 schnorrGroups d23 σ₁ τ₁ σ₂ τ₂ ρHat vHat wHat)
    let gameNoRhoNe : Game := do
      let σ₁ ← PMF.uniformOfFintype (ZMod (schnorrGroups.order d23))
      let τ₁ ← PMF.uniformOfFintype (ZMod (schnorrGroups.order d23))
      let σ₂ ← PMF.uniformOfFintype (ZMod (schnorrGroups.order d23))
      let τ₂ ← PMF.uniformOfFintype (ZMod (schnorrGroups.order d23))
      let z := projHash2 schnorrGroups d23 σ₁ τ₁ σ₂ τ₂ 1 0 g
      return winsNoRhoNe σ₁ τ₁ σ₂ τ₂ g [(z, 0, g, 1)]
    (1 : ℝ≥0) / 11 < Game.succProbability gameNoRhoNe := by
  intro g winsNoRhoNe gameNoRhoNe
  have hgame : gameNoRhoNe = PMF.pure true := by
    simp [gameNoRhoNe, winsNoRhoNe, g, d23_zero_gen_nonDHTriple]
  rw [hgame]
  norm_num [Game.succProbability]

/-- Probe 8 (`universal2Wins` winning condition): dropping `¬ IsDHTriple F d u vHat wHat` lets an
admissible `Q = 1` adversary win with probability `1 > 1 / 11` by outputting
`(h₁ + h₂, g, u, 1)`. -/
example :
    let g := schnorrGroups.generator d23
    let winsNoNonDH : ZMod (schnorrGroups.order d23) → ZMod (schnorrGroups.order d23) →
        ZMod (schnorrGroups.order d23) → ZMod (schnorrGroups.order d23) →
        ZMod (schnorrGroups.order d23) →
        List (schnorrGroups.Carrier d23 × schnorrGroups.Carrier d23 ×
          schnorrGroups.Carrier d23 × ZMod (schnorrGroups.order d23)) → Bool :=
      fun σ₁ τ₁ σ₂ τ₂ ρ guesses => by
        classical
        exact guesses.any fun (zHat, vHat, wHat, ρHat) =>
          decide (ρHat ≠ ρ ∧
            zHat = projHash2 schnorrGroups d23 σ₁ τ₁ σ₂ τ₂ ρHat vHat wHat)
    let gameNoNonDH : Game := do
      let σ₁ ← PMF.uniformOfFintype (ZMod (schnorrGroups.order d23))
      let τ₁ ← PMF.uniformOfFintype (ZMod (schnorrGroups.order d23))
      let σ₂ ← PMF.uniformOfFintype (ZMod (schnorrGroups.order d23))
      let τ₂ ← PMF.uniformOfFintype (ZMod (schnorrGroups.order d23))
      let hh := projHash2Aux schnorrGroups d23 σ₁ τ₁ σ₂ τ₂ g
      return winsNoNonDH σ₁ τ₁ σ₂ τ₂ 0 [(hh.1 + hh.2, g, g, 1)]
    (1 : ℝ≥0) / 11 < Game.succProbability gameNoNonDH := by
  intro g winsNoNonDH gameNoNonDH
  have hmatch : ∀ σ₁ τ₁ σ₂ τ₂ : ZMod (schnorrGroups.order d23),
      (projHash2Aux schnorrGroups d23 σ₁ τ₁ σ₂ τ₂ g).1 +
        (projHash2Aux schnorrGroups d23 σ₁ τ₁ σ₂ τ₂ g).2 =
      projHash2 schnorrGroups d23 σ₁ τ₁ σ₂ τ₂ 1 g g := by
    intro σ₁ τ₁ σ₂ τ₂
    simp only [projHash2Aux, projHashAux, projHash, projHash2, one_mul, add_smul]
    abel
  have hgame : gameNoNonDH = PMF.pure true := by
    simp [gameNoNonDH, winsNoNonDH, hmatch, show (1 : ZMod (schnorrGroups.order d23)) ≠ 0 by decide]
  rw [hgame]
  norm_num [Game.succProbability]

