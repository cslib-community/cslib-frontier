/-!
# Tests for universal and $\text{universal}_2$ projective hash functions

Concrete checks on the Schnorr group of order `11` in `(ZMod 23)ˣ` generated by `2` for universal
and $\text{universal}_2$ projective hash bijections (`projHashEquiv`, `projHashFiberChangeEquiv`,
`projHash2Equiv`, `projHash2FiberChangeEquiv`), concrete projective evaluation and fiber invariance
on Diffie–Hellman triples (`IsDHTriple`, `projHash_fiber_eq_of_isDHTriple`,
`projHash2_fiber_eq_of_isDHTriple`), Lemma 12.5 (`1 / q ^ 2`) and Lemma 12.7 (`1 / q ^ 4`)
point-mass formulas, the single-tuple (`1 / q`) and finite-list (`Q / q`) union-bound ingredients
of Lemma 12.8, positive adaptive and printed Attack Game 12.4–12.5 / Exercise 12.26(a)–(b) tests
(`universalDistExperiment_false_eq_true`, `succProbability_universal2GuessGame_le`), and necessity
probes for each hypothesis.
-/

public section

namespace CslibFrontierTests.Crypto.ProjectiveHash

open Cslib Cslib.Probability Cslib.Crypto Cslib.Crypto.ProjectiveHash
open scoped ENNReal NNReal

/-- The Schnorr group of order `11` in `(ZMod 23)ˣ`, generated by `2`. -/
def d23 : schnorrGroups.Desc :=
  ⟨(23, 11, 2), ⟨by norm_num, by norm_num, by norm_num, by norm_num, by norm_num⟩⟩

/-- Concrete `decide` check for `projHashEquiv` and `projHashFiberChangeEquiv` on
`ZMod 11 × ZMod 11` with `α = 2, β = 3, γ = 7` (`7 ≠ 2 * 3 = 6`):
`(4 + 2 * 5, 3 * 4 + 7 * 5) = (14, 47) = (3, 3)` mod `11`. -/
example :
    let hγ : (7 : ZMod (schnorrGroups.order d23)) ≠ 2 * 3 := by decide
    (projHashEquiv schnorrGroups d23 hγ) (4, 5) = (3, 3) ∧
      (projHashEquiv schnorrGroups d23 hγ).symm (3, 3) = (4, 5) ∧
      (projHashFiberChangeEquiv schnorrGroups d23 2) (3, 5) = (4, 5) ∧
      (projHashFiberChangeEquiv schnorrGroups d23 2).symm (4, 5) = (3, 5) := by
  let hγ : (7 : ZMod (schnorrGroups.order d23)) ≠ 2 * 3 := by decide
  have hf : (projHashEquiv schnorrGroups d23 hγ) (4, 5) = (3, 3) := by decide
  have hfc : (projHashFiberChangeEquiv schnorrGroups d23 2) (3, 5) = (4, 5) := by decide
  exact ⟨hf, by rw [← hf, Equiv.symm_apply_apply], hfc, by rw [← hfc, Equiv.symm_apply_apply]⟩

/-- Concrete `decide` check for `projHash2Equiv` and `projHash2FiberChangeEquiv` on `ZMod 11`
4-tuples with `α = 2, β = 3, γ = 7, β' = 4, γ' = 9, ρ = 1, ρ' = 5`. -/
example :
    let hγ : (7 : ZMod (schnorrGroups.order d23)) ≠ 2 * 3 := by decide
    let hγ' : (9 : ZMod (schnorrGroups.order d23)) ≠ 2 * 4 := by decide
    let hρ : (5 : ZMod (schnorrGroups.order d23)) ≠ 1 := by decide
    let e := projHash2Equiv schnorrGroups d23 hγ hγ' hρ
    let ec := projHash2FiberChangeEquiv schnorrGroups d23 2 1
    e ((1, 2), (3, 4)) = ((5, 0), (10, 9)) ∧
      e.symm ((5, 0), (10, 9)) = ((1, 2), (3, 4)) ∧
      ec ((5, 0), (6, 4)) = ((1, 2), (3, 4)) ∧
      ec.symm ((1, 2), (3, 4)) = ((5, 0), (6, 4)) := by
  let hγ : (7 : ZMod (schnorrGroups.order d23)) ≠ 2 * 3 := by decide
  let hγ' : (9 : ZMod (schnorrGroups.order d23)) ≠ 2 * 4 := by decide
  let hρ : (5 : ZMod (schnorrGroups.order d23)) ≠ 1 := by decide
  let e := projHash2Equiv schnorrGroups d23 hγ hγ' hρ
  let ec := projHash2FiberChangeEquiv schnorrGroups d23 2 1
  have hf : e ((1, 2), (3, 4)) = ((5, 0), (10, 9)) := by decide
  have hfc : ec ((5, 0), (6, 4)) = ((1, 2), (3, 4)) := by decide
  exact ⟨hf, by rw [← hf, Equiv.symm_apply_apply], hfc, by rw [← hfc, Equiv.symm_apply_apply]⟩

/-- Concrete check of projective evaluation of `projHash` and `projHash2` on the
Diffie–Hellman pair `(5 • g, 5 • (2 • g))` in `d23` at `σ₁ = 1, τ₁ = 2, σ₂ = 3, τ₂ = 4, ρ = 6`. -/
example :
    let g := schnorrGroups.generator d23
    let u := (2 : ZMod (schnorrGroups.order d23)) • g
    let β : ZMod (schnorrGroups.order d23) := 5
    projHash schnorrGroups d23 1 2 (β • g) (β • u) =
      (3 : ZMod (schnorrGroups.order d23)) • g ∧
    β • projHashAux schnorrGroups d23 1 2 u =
      (3 : ZMod (schnorrGroups.order d23)) • g ∧
    projHash2 schnorrGroups d23 1 2 3 4 6 (β • g) (β • u) =
      (3 : ZMod (schnorrGroups.order d23)) • g ∧
    β • ((projHash2Aux schnorrGroups d23 1 2 3 4 u).1 +
      (6 : ZMod (schnorrGroups.order d23)) • (projHash2Aux schnorrGroups d23 1 2 3 4 u).2) =
      (3 : ZMod (schnorrGroups.order d23)) • g := by
  simp only [projHash_generator_smul, projHashAux_generator_smul, projHash2_generator_smul,
    projHash2Aux, smul_smul, ← add_smul]
  refine ⟨?_, ?_, ?_, ?_⟩ <;> congr 1

/-- Lemma 12.5 on `d23`: for the non-DH triple `(2 • g, 3 • g, 7 • g)` (`7 ≠ 2 * 3`), every joint
pair `(h, z)` has probability `((11 : ℝ≥0∞) ^ 2)⁻¹`. -/
example (h z : schnorrGroups.Carrier d23) :
    ((PMF.uniformOfFintype
      (ZMod (schnorrGroups.order d23) × ZMod (schnorrGroups.order d23))).map (fun p =>
      (projHashAux schnorrGroups d23 p.1 p.2 ((2 : ZMod (schnorrGroups.order d23)) •
        schnorrGroups.generator d23),
        projHash schnorrGroups d23 p.1 p.2 ((3 : ZMod (schnorrGroups.order d23)) •
          schnorrGroups.generator d23)
          ((7 : ZMod (schnorrGroups.order d23)) • schnorrGroups.generator d23)))) (h, z) =
      ((schnorrGroups.order d23 : ℝ≥0∞) ^ 2)⁻¹ := by
  have hγ : (7 : ZMod (schnorrGroups.order d23)) ≠ 2 * 3 := by decide
  exact uniform_projHash_apply_of_ne schnorrGroups d23 hγ h z

/-- Single-tuple ingredient of Lemma 12.8 (via Lemma 12.7) on `d23`: on the `τ₂`-fiber for fixed
`(δ₁, δ₂, ξ)`, the query value `projHash2` on a non-DH triple with tag `ρ' = 5 ≠ 1 = ρ` hits any
target `z'` with probability `(11 : ℝ≥0∞)⁻¹`. -/
example (δ₁ δ₂ ξ : ZMod (schnorrGroups.order d23)) (z' : schnorrGroups.Carrier d23) :
    let α : ZMod (schnorrGroups.order d23) := 2
    let β' : ZMod (schnorrGroups.order d23) := 4
    let γ' : ZMod (schnorrGroups.order d23) := 9
    let ρ : ZMod (schnorrGroups.order d23) := 1
    let ρ' : ZMod (schnorrGroups.order d23) := 5
    ((PMF.uniformOfFintype (ZMod (schnorrGroups.order d23))).map (fun τ₂ =>
      projHash2 schnorrGroups d23 (δ₁ - α * (ξ - ρ * τ₂)) (ξ - ρ * τ₂) (δ₂ - α * τ₂) τ₂ ρ'
        (β' • schnorrGroups.generator d23) (γ' • schnorrGroups.generator d23))) z' =
      (schnorrGroups.order d23 : ℝ≥0∞)⁻¹ := by
  have hγ' : (9 : ZMod (schnorrGroups.order d23)) ≠ 2 * 4 := by decide
  have hρ : (5 : ZMod (schnorrGroups.order d23)) ≠ 1 := by decide
  exact uniform_projHash2_fiber_apply schnorrGroups d23 hγ' hρ δ₁ δ₂ ξ z'

/-- Finite-list union-bound ingredient of Lemma 12.8 on `d23`: for a list of two non-DH queries
`(β' = 4, γ' = 9, ρ' = 5, z₁)` and `(β' = 3, γ' = 7, ρ' = 6, z₂)` against `α = 2, ρ = 1`, the
probability over uniform `τ₂` that either query hits its target is at most `2 / 11`. -/
example [DecidableEq (schnorrGroups.Carrier d23)] (δ₁ δ₂ ξ : ZMod (schnorrGroups.order d23))
    (z₁ z₂ : schnorrGroups.Carrier d23) :
    let α : ZMod (schnorrGroups.order d23) := 2
    let ρ : ZMod (schnorrGroups.order d23) := 1
    let queries :
        List (ZMod (schnorrGroups.order d23) × ZMod (schnorrGroups.order d23) ×
          ZMod (schnorrGroups.order d23) × schnorrGroups.Carrier d23) :=
      [(4, 9, 5, z₁), (3, 7, 6, z₂)]
    ((PMF.uniformOfFintype (ZMod (schnorrGroups.order d23))).map (fun τ₂ =>
      queries.any (fun q =>
        decide (projHash2 schnorrGroups d23 (δ₁ - α * (ξ - ρ * τ₂)) (ξ - ρ * τ₂) (δ₂ - α * τ₂)
          τ₂ q.2.2.1 (q.1 • schnorrGroups.generator d23)
          (q.2.1 • schnorrGroups.generator d23) = q.2.2.2)))) true ≤
      2 / (schnorrGroups.order d23 : ℝ≥0∞) := by
  simpa using uniform_projHash2_fiber_any_le schnorrGroups d23 2 1 δ₁ δ₂ ξ
    [(4, 9, 5, z₁), (3, 7, 6, z₂)] (by
      intro q hq
      rcases List.mem_cons.mp hq with rfl | hq
      · dsimp only; decide
      · rcases List.mem_singleton.mp hq with rfl
        dsimp only; decide)

/-! ### Standalone security games and necessity probes -/

private theorem d23_bind3_uniform_decide_smul_eq_inv11
    (c : ZMod (schnorrGroups.order d23) → ZMod (schnorrGroups.order d23) →
      schnorrGroups.Carrier d23) :
    ((PMF.uniformOfFintype (ZMod (schnorrGroups.order d23))).bind fun σ =>
      (PMF.uniformOfFintype (ZMod (schnorrGroups.order d23))).bind fun τ =>
        (PMF.uniformOfFintype (ZMod (schnorrGroups.order d23))).bind fun ζ =>
          PMF.pure (decide (ζ • schnorrGroups.generator d23 = c σ τ))) true =
      ((11 : ℝ≥0∞)⁻¹) := by
  refine PMF.bind_apply_of_forall _ fun σ => PMF.bind_apply_of_forall _ fun τ => ?_
  classical
  obtain ⟨γ, hγ⟩ := schnorrGroups.smul_generator_surjective d23 (c σ τ)
  rw [← hγ]
  have hinj : ∀ ζ : ZMod (schnorrGroups.order d23),
      (ζ • schnorrGroups.generator d23 = γ • schnorrGroups.generator d23) ↔ ζ = γ :=
    fun ζ => ⟨fun h => schnorrGroups.smul_generator_injective d23 h, fun h => by subst h; rfl⟩
  simp only [PMF.bind_apply, PMF.pure_apply, hinj]
  rw [tsum_eq_single γ (fun x hx => by simp [hx])]
  simp only [decide_true, ↓reduceIte, PMF.uniformOfFintype_apply]
  have hord : schnorrGroups.order d23 = 11 := rfl
  simp [hord]

private theorem d23_zero_gen_nonDHTriple :
    ¬ IsDHTriple schnorrGroups d23
      (schnorrGroups.generator d23) 0 (schnorrGroups.generator d23) := by
  rintro ⟨β, h0, hg⟩
  have hβ : (0 : ZMod (schnorrGroups.order d23)) = β :=
    schnorrGroups.smul_generator_injective d23 (by simpa using h0)
  subst hβ
  have h01 : (0 : ZMod (schnorrGroups.order d23)) = 1 :=
    schnorrGroups.smul_generator_injective d23 (by simpa using hg.symm)
  exact absurd h01 (by decide)

private theorem advantage_pos_of_eq_pure_true_eq_inv11 (g₀ g₁ : Game)
    (h₀ : g₀ = PMF.pure true) (h₁ : g₁ true = (11 : ℝ≥0∞)⁻¹) :
    0 < Game.advantage g₀ g₁ := by
  have hs0 : Game.succProbability g₀ = 1 := by
    simp [Game.succProbability, h₀]
  have hs1 : Game.succProbability g₁ = (11 : ℝ≥0)⁻¹ := by
    rw [Game.succProbability, h₁, ENNReal.toNNReal_inv, ENNReal.toNNReal_ofNat]
  rw [Game.advantage, hs0, hs1]
  by_contra h
  have h0 : nndist (1 : ℝ≥0) (11 : ℝ≥0)⁻¹ = 0 := le_antisymm (not_lt.mp h) zero_le
  exact absurd (nndist_eq_zero.mp h0) (by norm_num)

/-- Concrete `IsDHTriple` and fiber-invariance checks on `d23` for `projHash` and `projHash2`. -/
example (δ δ₁ δ₂ τ τ₁ τ₂ ρ : ZMod (schnorrGroups.order d23)) :
    let g := schnorrGroups.generator d23
    let u := (2 : ZMod (schnorrGroups.order d23)) • g
    IsDHTriple schnorrGroups d23 u ((3 : ZMod (schnorrGroups.order d23)) • g)
      ((6 : ZMod (schnorrGroups.order d23)) • g) ∧
    projHash schnorrGroups d23 (δ - 2 * τ) τ ((3 : ZMod (schnorrGroups.order d23)) • g)
      ((6 : ZMod (schnorrGroups.order d23)) • g) =
      projHash schnorrGroups d23 δ 0 ((3 : ZMod (schnorrGroups.order d23)) • g)
        ((6 : ZMod (schnorrGroups.order d23)) • g) ∧
    projHash2 schnorrGroups d23 (δ₁ - 2 * τ₁) τ₁ (δ₂ - 2 * τ₂) τ₂ ρ
      ((3 : ZMod (schnorrGroups.order d23)) • g) ((6 : ZMod (schnorrGroups.order d23)) • g) =
      projHash2 schnorrGroups d23 δ₁ 0 δ₂ 0 ρ
        ((3 : ZMod (schnorrGroups.order d23)) • g) ((6 : ZMod (schnorrGroups.order d23)) • g) := by
  intro g u
  have hdh : IsDHTriple schnorrGroups d23 u ((3 : ZMod (schnorrGroups.order d23)) • g)
      ((6 : ZMod (schnorrGroups.order d23)) • g) :=
    (isDHTriple_generator_smul_iff schnorrGroups d23 2 3 6).mpr (by decide)
  exact ⟨hdh,
    projHash_fiber_eq_of_isDHTriple schnorrGroups d23 hdh,
    projHash2_fiber_eq_of_isDHTriple schnorrGroups d23 hdh⟩

/-- Concrete non-adaptive Attack Game 12.4 / Lemma 12.6 instance (pure `chooseChallenge`
returning `(0, g)` independently of `h`): an admissible adversary with an evaluation query in
`L_u` (`(g, g)`) and non-DH `(v, w) = (0, g)` has advantage `0`. -/
example :
    let g := schnorrGroups.generator d23
    let A : UniversalDistAdversary schnorrGroups d23 Unit Unit :=
      { chooseU := pure (g, ())
        chooseChallenge := fun _ _ => pure (0, g, ())
        guess := fun _ z => do
          let r ← ProbOracleComp.query (g, g)
          return decide (r = z) }
    Game.advantage (universalDistExperiment schnorrGroups d23 A false)
      (universalDistExperiment schnorrGroups d23 A true) = 0 := by
  intro g A
  suffices hA : A.Admissible by
    rw [universalDistExperiment_false_eq_true schnorrGroups d23 A hA, Game.advantage_self]
  intro u st₀ hsupp
  simp only [A, ProbComp.eval_pure, PMF.support_pure, Set.mem_singleton_iff, Prod.mk.injEq] at hsupp
  rcases hsupp with ⟨rfl, _⟩
  refine ⟨fun _ => .pure _, fun σ τ v w st₁ hchal => ?_⟩
  simp only [A, ProbOracleComp.run_pure, ProbComp.eval_pure, PMF.support_pure,
    Set.mem_singleton_iff, Prod.mk.injEq] at hchal
  rcases hchal with ⟨rfl, rfl, _⟩
  exact ⟨d23_zero_gen_nonDHTriple, fun _ =>
    .bind (.query ⟨1, (one_smul _ g).symm, (one_smul _ g).symm⟩) fun _ => .pure _⟩

/-- Concrete Exercise 12.26(a) test: an admissible adaptive adversary making `L_u` queries in both
`chooseChallenge` and `guess` has advantage `0`. -/
example :
    let g := schnorrGroups.generator d23
    let A : UniversalDistAdversary schnorrGroups d23 Unit (schnorrGroups.Carrier d23) :=
      { chooseU := pure (g, ())
        chooseChallenge := fun _ _ => do
          let r₁ ← ProbOracleComp.query ((2 : ZMod (schnorrGroups.order d23)) • g,
            (2 : ZMod (schnorrGroups.order d23)) • g)
          return (0, g, r₁)
        guess := fun r₁ z => do
          let r₂ ← ProbOracleComp.query ((3 : ZMod (schnorrGroups.order d23)) • g,
            (3 : ZMod (schnorrGroups.order d23)) • g)
          return decide (r₁ = r₂ ∧ z = g) }
    Game.advantage (universalDistExperiment schnorrGroups d23 A false)
      (universalDistExperiment schnorrGroups d23 A true) = 0 := by
  intro g A
  suffices hA : A.Admissible by
    rw [universalDistExperiment_false_eq_true schnorrGroups d23 A hA, Game.advantage_self]
  intro u st₀ hsupp
  simp only [A, ProbComp.eval_pure, PMF.support_pure, Set.mem_singleton_iff, Prod.mk.injEq] at hsupp
  rcases hsupp with ⟨rfl, _⟩
  refine ⟨fun _ => .bind (.query ⟨2, rfl, rfl⟩) fun _ => .pure _, ?_⟩
  intro σ τ v w st₁ hchal
  simp only [A, ProbOracleComp.run_bind, ProbOracleComp.run_query, ProbOracleComp.run_pure,
    ProbComp.eval_bind, ProbComp.eval_pure, PMF.pure_bind, PMF.support_pure,
    Set.mem_singleton_iff, Prod.mk.injEq] at hchal
  rcases hchal with ⟨rfl, rfl, rfl⟩
  exact ⟨d23_zero_gen_nonDHTriple, fun _ => .bind (.query ⟨3, rfl, rfl⟩) fun _ => .pure _⟩

/-- Concrete non-adaptive Attack Game 12.5 / Lemma 12.8 instance (pure `chooseChallenge`
returning `(v, w, 0)` independently of `(h₁, h₂)`) for both non-DH `(v, w) = (0, g)` and DH
`(v, w) = (g, g)`: both satisfy `succProbability ≤ 2 / 11`. -/
example :
    let g := schnorrGroups.generator d23
    let mkAdv (v w : schnorrGroups.Carrier d23) :
        Universal2GuessAdversary schnorrGroups d23 Unit Unit :=
      { chooseU := pure (g, ())
        chooseChallenge := fun _ _ => pure (v, w, 0, ())
        guess := fun _ z => do
          let r ← ProbOracleComp.query ((g, g), 1)
          return [(z, 0, g, 1), (r, 0, g, 2)] }
    Game.succProbability (universal2GuessGame schnorrGroups d23 (mkAdv 0 g)) ≤ (2 : ℝ≥0) / 11 ∧
    Game.succProbability (universal2GuessGame schnorrGroups d23 (mkAdv g g)) ≤ (2 : ℝ≥0) / 11 := by
  intro g mkAdv
  have hadm (v w : schnorrGroups.Carrier d23) : (mkAdv v w).Admissible 2 := by
    intro u st₀ hsupp
    simp only [mkAdv, ProbComp.eval_pure, PMF.support_pure, Set.mem_singleton_iff,
      Prod.mk.injEq] at hsupp
    rcases hsupp with ⟨rfl, _⟩
    refine ⟨fun _ => .pure _, fun σ₁ τ₁ σ₂ τ₂ v' w' ρ st₁ hchal z => ?_⟩
    simp only [mkAdv, ProbOracleComp.run_pure, ProbComp.eval_pure, PMF.support_pure,
      Set.mem_singleton_iff, Prod.mk.injEq] at hchal
    rcases hchal with ⟨rfl, rfl, rfl, _⟩
    refine ⟨.bind (.query ⟨1, (one_smul _ g).symm, (one_smul _ g).symm⟩) fun _ => .pure _,
      fun _ _ _ _ guesses hg => ?_⟩
    simp only [mkAdv, ProbOracleComp.run_bind, ProbOracleComp.run_query, ProbOracleComp.run_pure,
      ProbComp.eval_bind, ProbComp.eval_pure, PMF.pure_bind, PMF.support_pure,
      Set.mem_singleton_iff] at hg
    subst hg
    simp
  exact ⟨by simpa [d23, schnorrGroups] using
      succProbability_universal2GuessGame_le schnorrGroups d23 (mkAdv 0 g) (hadm 0 g),
    by simpa [d23, schnorrGroups] using
      succProbability_universal2GuessGame_le schnorrGroups d23 (mkAdv g g) (hadm g g)⟩

/-- Concrete Exercise 12.26(b) test: an admissible three-stage adversary with `L_u` queries in
`chooseChallenge` and `guess` and output length `≤ 1` wins with probability `≤ 1 / 11`. -/
example :
    let g := schnorrGroups.generator d23
    let A : Universal2GuessAdversary schnorrGroups d23 Unit (schnorrGroups.Carrier d23) :=
      { chooseU := pure (g, ())
        chooseChallenge := fun _ _ => do
          let r ← ProbOracleComp.query ((g, g), 1)
          return (0, g, 0, r)
        guess := fun r z => do
          let _ ← ProbOracleComp.query ((2 • g, 2 • g), 2)
          return [(r + z, 0, g, 1)] }
    Game.succProbability (universal2GuessGame schnorrGroups d23 A) ≤ (1 : ℝ≥0) / 11 := by
  intro g A
  have hadm : A.Admissible 1 := by
    intro u st₀ hsupp
    simp only [A, ProbComp.eval_pure, PMF.support_pure, Set.mem_singleton_iff,
      Prod.mk.injEq] at hsupp
    rcases hsupp with ⟨rfl, _⟩
    refine ⟨fun _ => .bind (.query ⟨1, (one_smul _ g).symm, (one_smul _ g).symm⟩) fun _ => .pure _,
      ?_⟩
    intro σ₁ τ₁ σ₂ τ₂ v w ρ st₁ hchal z
    simp only [A, ProbOracleComp.run_bind, ProbOracleComp.run_query, ProbOracleComp.run_pure,
      ProbComp.eval_bind, ProbComp.eval_pure, PMF.pure_bind, PMF.support_pure,
      Set.mem_singleton_iff, Prod.mk.injEq] at hchal
    rcases hchal with ⟨rfl, rfl, rfl, rfl⟩
    refine ⟨.bind (.query ⟨2, rfl, rfl⟩) fun _ => .pure _, fun _ _ _ _ guesses hg => ?_⟩
    simp only [A, ProbOracleComp.run_bind, ProbOracleComp.run_query, ProbOracleComp.run_pure,
      ProbComp.eval_bind, ProbComp.eval_pure, PMF.pure_bind, PMF.support_pure,
      Set.mem_singleton_iff] at hg
    subst hg
    simp
  simpa [d23, schnorrGroups] using
    succProbability_universal2GuessGame_le schnorrGroups d23 A hadm

/-- Probe 1 (Lemma 12.6 / Exercise 12.26(a)): dropping `¬ IsDHTriple F d u v w` allows advantage
`10 / 11 > 0`. -/
example :
    let g := schnorrGroups.generator d23
    let A : UniversalDistAdversary schnorrGroups d23 Unit (schnorrGroups.Carrier d23) :=
      { chooseU := pure (g, ())
        chooseChallenge := fun _ h => pure (g, g, h)
        guess := fun h z => pure (decide (z = h)) }
    0 < Game.advantage (universalDistExperiment schnorrGroups d23 A false)
      (universalDistExperiment schnorrGroups d23 A true) := by
  intro g A
  have hfalse : universalDistExperiment schnorrGroups d23 A false = PMF.pure true := by
    simp [universalDistExperiment, A, g, projHashAux, projHash]
  have htrue : (universalDistExperiment schnorrGroups d23 A true) true = (11 : ℝ≥0∞)⁻¹ := by
    simp only [universalDistExperiment, A, g, ProbComp.eval_pure, ProbOracleComp.run_pure,
      PMF.pure_bind, ↓reduceIte, PMF.monad_bind_eq_bind]
