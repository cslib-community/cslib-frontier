/-- Probe 4 (Lemma 12.8 / Exercise 12.26(b)): dropping the output-length bound `guesses.length ≤ Q`
(`Q = 1`) allows winning with probability `1 > 1 / 11`. -/
example :
    let g := schnorrGroups.generator d23
    let guesses : List (schnorrGroups.Carrier d23 × schnorrGroups.Carrier d23 ×
        schnorrGroups.Carrier d23 × ZMod (schnorrGroups.order d23)) :=
      List.ofFn fun i : Fin 11 => ((i.val : ZMod (schnorrGroups.order d23)) • g, 0, g, 1)
    let A : Universal2GuessAdversary schnorrGroups d23 Unit Unit :=
      { chooseU := pure (g, ())
        chooseChallenge := fun _ _ => pure (0, g, 0, ())
        guess := fun _ _ => pure guesses }
    (1 : ℝ≥0) / 11 < Game.succProbability (universal2GuessGame schnorrGroups d23 A) := by
  intro g guesses A
  have hwin : ∀ σ₁ τ₁ σ₂ τ₂ : ZMod (schnorrGroups.order d23),
      universal2Wins schnorrGroups d23 σ₁ τ₁ σ₂ τ₂ 0 g guesses = true := by
    intro σ₁ τ₁ σ₂ τ₂
    classical
    simp only [universal2Wins, List.any_eq_true, decide_eq_true_eq]
    let k : ZMod (schnorrGroups.order d23) := τ₁ + τ₂
    have hk : k.val < 11 := k.val_lt
    refine ⟨(k • g, 0, g, 1), List.mem_ofFn.mpr ⟨⟨k.val, hk⟩, ?_⟩,
      d23_zero_gen_nonDHTriple, show (1 : ZMod (schnorrGroups.order d23)) ≠ 0 by decide, ?_⟩
    · simp [k]
    · simp [projHash2, k, add_smul]
  have hgame : universal2GuessGame schnorrGroups d23 A = PMF.pure true := by
    simp [universal2GuessGame, A, hwin]
  rw [hgame]
  norm_num [Game.succProbability]

