module

public import CslibFrontier.Crypto.Protocols.SecretSharing.AccessStructure.Linear
public import CslibFrontier.Crypto.Protocols.SecretSharing.AccessStructure.Privacy
public import Mathlib.Algebra.Field.ZMod
import Mathlib.Data.Fin.VecNotation

/-!
# Monotone Span Programs and Linear Secret Sharing: Checked Instances

An ordinary `module` client of `CslibFrontier.Computability.Circuit.SpanProgram.Basic` and
`CslibFrontier.Crypto.Protocols.SecretSharing.AccessStructure.Linear` ([BonehShoup2023], Section
22.5.2, pp. 978–982), checking:

* Example 22.3 on `Fin 4` over `ZMod 5` recognizing `AccessStructure.ofSets {{0, 1, 2}, {0, 2, 3}}`,
  its explicit row-weight witness (`sum_dotProduct_linearShare_eq_secret`), `PerfectlyCorrect`,
  `ViewIndist`, and additive/scalar linearity.
* Necessity and boundary probes for every added or weakened hypothesis: `P.Accepts s` for
  reconstruction and additive reconstruction, `¬ P.Accepts s` and
  `Q ∈ SourceClass.translationInvariant (LinearKey P)` for privacy, non-uniformity of
  unauthorized views when `P.matrix` has duplicate rows, `tailDim = 0`,
  `Party = Fin 0`, and a `ZMod 4` counterexample showing `[Field F]` cannot be relaxed to
  `[CommRing F]`.
-/

public section

namespace CslibFrontierTests.LinearSecretSharing

open Cslib.Circuits Cslib.Crypto.Protocols.SecretSharing
open Cslib.Probability Cslib.Probability.PMF

local instance : Fact (Nat.Prime 5) := ⟨by decide⟩

/-- Example 22.3 ([BonehShoup2023], p. 979) on `Fin 4` over `ZMod 5`. -/
def example22_3 : MonotoneSpanProgram (ZMod 5) (Fin 4) where
  tailDim := 4
  rowDim := ![2, 1, 2, 1]
  matrix
    | 0 => !![1, 1, 0, 0, 0; 1, 0, 0, 1, 0]
    | 1 => !![0, 0, 1, 0, 0]
    | 2 => !![0, -1, -1, 0, 0; 0, 0, 0, 0, 1]
    | 3 => !![0, 0, 0, -1, -1]

theorem example22_3_accepts_012 : example22_3.Accepts {0, 1, 2} := by
  rw [MonotoneSpanProgram.accepts_iff_exists_vecMul]
  let w : (i : ({0, 1, 2} : Finset (Fin 4))) → Fin (example22_3.rowDim i.1) → ZMod 5 :=
    fun i => match i with
      | ⟨0, _⟩ => ![1, 0]
      | ⟨1, _⟩ => ![1]
      | ⟨2, _⟩ => ![1, 0]
  refine ⟨w, ?_⟩
  ext j
  fin_cases j <;> decide

theorem example22_3_accepts_023 : example22_3.Accepts {0, 2, 3} := by
  rw [MonotoneSpanProgram.accepts_iff_exists_vecMul]
  let w : (i : ({0, 2, 3} : Finset (Fin 4))) → Fin (example22_3.rowDim i.1) → ZMod 5 :=
    fun i => match i with
      | ⟨0, _⟩ => ![0, 1]
      | ⟨2, _⟩ => ![0, 1]
      | ⟨3, _⟩ => ![1]
  refine ⟨w, ?_⟩
  ext j
  fin_cases j <;> decide

theorem example22_3_not_accepts_02 : ¬ example22_3.Accepts {0, 2} := by
  refine MonotoneSpanProgram.not_accepts_of_exists_nullVector example22_3 ![1, -1, 1, -1, 0] rfl ?_
  intro i hi
  fin_cases i <;> first | exact absurd hi (by decide) | decide

theorem example22_3_not_accepts_123 : ¬ example22_3.Accepts {1, 2, 3} := by
  refine MonotoneSpanProgram.not_accepts_of_exists_nullVector example22_3 ![1, 0, 0, 0, 0] rfl ?_
  intro i hi
  fin_cases i <;> first | exact absurd hi (by decide) | decide

/-- Example 22.3 recognizes the access structure generated by `{{0, 1, 2}, {0, 2, 3}}`. -/
theorem example22_3_accessStructure_eq :
    example22_3.accessStructure = AccessStructure.ofSets {{0, 1, 2}, {0, 2, 3}} := by
  ext s
  constructor
  · intro hs
    by_contra hnot
    have hnot' : ¬ (s = {0, 1, 2} ∨ s = {0, 2, 3} ∨ s = Finset.univ) := by
      intro hor
      apply hnot
      simp only [AccessStructure.ofSets_authorized_iff]
      rcases hor with rfl | rfl | rfl
      · exact ⟨{0, 1, 2}, by simp, Finset.Subset.rfl⟩
      · exact ⟨{0, 2, 3}, by simp, Finset.Subset.rfl⟩
      · exact ⟨{0, 1, 2}, by simp, Finset.subset_univ _⟩
    have hsubAll :
        ∀ t : Finset (Fin 4),
          ¬ (t = {0, 1, 2} ∨ t = {0, 2, 3} ∨ t = Finset.univ) →
            t ⊆ {0, 1, 3} ∨ t ⊆ {0, 2} ∨ t ⊆ {1, 2, 3} := by
      decide
    rcases hsubAll s hnot' with h | h | h
    · have h' : example22_3.Accepts {0, 1, 3} := example22_3.accepts_mono h hs
      refine MonotoneSpanProgram.not_accepts_of_exists_nullVector
        example22_3 ![1, -1, 0, -1, 1] rfl ?_ h'
      intro i hi
      fin_cases i <;> first | exact absurd hi (by decide) | decide
    · exact example22_3_not_accepts_02 (example22_3.accepts_mono h hs)
    · exact example22_3_not_accepts_123 (example22_3.accepts_mono h hs)
  · intro hs
    simp only [AccessStructure.ofSets_authorized_iff] at hs
    rcases hs with ⟨b, hb, hsub⟩
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hb
    rcases hb with rfl | rfl
    · exact example22_3.accepts_mono hsub example22_3_accepts_012
    · exact example22_3.accepts_mono hsub example22_3_accepts_023

/-- Concrete `AccessScheme` derived from Example 22.3 over `ZMod 5`. -/
noncomputable def example22_3Scheme :
    AccessScheme (ZMod 5) (LinearKey example22_3) (Fin 4) (LinearShare example22_3) :=
  linearUniformAccessScheme example22_3

example :
    PerfectlyCorrect example22_3Scheme.access example22_3Scheme.share
      example22_3Scheme.reconstruct :=
  example22_3Scheme.perfectlyCorrect

example :
    ViewIndist example22_3Scheme.access example22_3Scheme.sources example22_3Scheme.share :=
  example22_3Scheme.viewIndist

/-- Explicit row-weight recombination (`sum_dotProduct_linearShare_eq_secret`) on `{0, 1, 2}`. -/
example (k : LinearKey example22_3) (secret : ZMod 5) :
    let w : (i : ({0, 1, 2} : Finset (Fin 4))) → Fin (example22_3.rowDim i.1) → ZMod 5 :=
      fun i => match i with
        | ⟨0, _⟩ => ![1, 0]
        | ⟨1, _⟩ => ![1]
        | ⟨2, _⟩ => ![1, 0]
    ∑ i : ({0, 1, 2} : Finset (Fin 4)), dotProduct (w i) (linearShare example22_3 k secret i.1) =
      secret := by
  refine sum_dotProduct_linearShare_eq_secret example22_3 k secret _ ?_
  ext j
  fin_cases j <;> decide

/-- End-to-end sharing/reconstruction, Remark 22.15 additive homomorphism, and scalar
multiplication checks on `example22_3` (`linearShare_smul` is not in the book). -/
example (k₁ k₂ : LinearKey example22_3) (secret₁ secret₂ c : ZMod 5) :
    example22_3Scheme.reconstruct {0, 1, 2}
        (example22_3Scheme.view {0, 1, 2} k₁ secret₁) = secret₁ ∧
      linearReconstruct example22_3 {0, 2, 3}
        (fun i => linearShare example22_3 k₁ secret₁ i.1 + linearShare example22_3 k₂ secret₂ i.1) =
        secret₁ + secret₂ ∧
      linearShare example22_3 (c • k₁) (c * secret₁) 0 =
        c • linearShare example22_3 k₁ secret₁ 0 :=
  ⟨example22_3Scheme.reconstruct_view_eq_secret k₁ secret₁ example22_3_accepts_012,
   linearReconstruct_linearShare_add example22_3 k₁ k₂ secret₁ secret₂ example22_3_accepts_023,
   linearShare_smul example22_3 c k₁ secret₁ 0⟩

/-- Probe 1 (`hs : P.Accepts s` in `linearReconstruct_linearShare`): on unauthorized `{0, 2}`,
`linearReconstruct` outputs `0 ≠ 1`. -/
example (k : LinearKey example22_3) :
    linearReconstruct example22_3 {0, 2} (fun i => linearShare example22_3 k 1 i.1) ≠ 1 := by
  classical
  simp [linearReconstruct, example22_3_not_accepts_02]

/-- Probe 2 (`hs : P.Accepts s` in `linearReconstruct_linearShare_add`): on `{0, 2}`,
reconstructing the sum of sharings of `1` and `2` outputs `0 ≠ 3`. -/
example (k₁ k₂ : LinearKey example22_3) :
    linearReconstruct example22_3 {0, 2}
      (fun i => linearShare example22_3 k₁ 1 i.1 + linearShare example22_3 k₂ 2 i.1) ≠ 3 := by
  classical
  simp only [linearReconstruct, example22_3_not_accepts_02, ↓reduceDIte, ne_eq]
  decide

/-- Probe 3 (`hs : ¬ P.Accepts s` in `linearView_eq_of_not_accepts`): on authorized `{0, 1, 2}`,
views for secrets `0` and `1` have different distributions because `reconstruct` maps them to `0`
and `1`. -/
example :
    example22_3Scheme.viewDist (uniformOfFintype (LinearKey example22_3)) {0, 1, 2} 0 ≠
      example22_3Scheme.viewDist (uniformOfFintype (LinearKey example22_3)) {0, 1, 2} 1 := by
  intro h
  have hmap := congrArg (PMF.map (example22_3Scheme.reconstruct {0, 1, 2})) h
  have heval (m : ZMod 5) :
      (example22_3Scheme.viewDist (uniformOfFintype (LinearKey example22_3)) {0, 1, 2} m).map
          (example22_3Scheme.reconstruct {0, 1, 2}) =
        PMF.pure m := by
    rw [AccessScheme.viewDist, AccessStructure.viewDistOf, PMF.map_comp]
    have hconst :
        (example22_3Scheme.reconstruct {0, 1, 2} ∘ fun k (i : ({0, 1, 2} : Finset (Fin 4))) =>
            example22_3Scheme.share k m i.1) =
          Function.const (LinearKey example22_3) m := by
      funext k
      exact example22_3Scheme.correct k m {0, 1, 2} example22_3_accepts_012
    rw [hconst, PMF.map_const]
  rw [heval 0, heval 1] at hmap
  have h01 := congrArg (fun p : PMF (ZMod 5) => p 0) hmap
  simp [PMF.pure_apply] at h01

/-- Probe 4 (`hQ : Q ∈ SourceClass.translationInvariant (LinearKey P)` in
`linearView_eq_of_not_accepts`): for `P` with `M₀ = !![1, 1]` (`tailDim = 1`), `{0}` is
unauthorized, yet under
`Q = PMF.pure 0 ∉ SourceClass.translationInvariant (LinearKey probe4Program)`,
the views of `0` and `1` differ. -/
def probe4Program : MonotoneSpanProgram (ZMod 5) (Fin 1) where
  tailDim := 1
  rowDim := ![1]
  matrix | 0 => !![1, 1]

theorem probe4Program_not_accepts_0 : ¬ probe4Program.Accepts {0} := by
  refine MonotoneSpanProgram.not_accepts_of_exists_nullVector probe4Program ![1, -1] rfl ?_
  intro i hi
  fin_cases i
  decide

example :
    AccessStructure.viewDistOf (PMF.pure (0 : LinearKey probe4Program))
        (linearShare probe4Program) {0} 0 ≠
      AccessStructure.viewDistOf (PMF.pure (0 : LinearKey probe4Program))
        (linearShare probe4Program) {0} 1 := by
  intro h
  have hne :
      (fun i : ({0} : Finset (Fin 1)) => linearShare probe4Program 0 0 i.1) ≠
        fun i : ({0} : Finset (Fin 1)) => linearShare probe4Program 0 1 i.1 := by
    intro heq
    have hval := congrFun (congrFun heq ⟨0, by simp⟩) ⟨0, by simp [probe4Program]⟩
    dsimp only [linearShare, probe4Program] at hval
    revert hval
    decide
  have h0 := congrArg
    (fun p : PMF ((i : ({0} : Finset (Fin 1))) → LinearShare probe4Program i.1) =>
      p (fun i : ({0} : Finset (Fin 1)) => linearShare probe4Program 0 0 i.1)) h
  simp only [AccessStructure.viewDistOf, PMF.pure_map, PMF.pure_apply, hne] at h0
  norm_num at h0

/-- Probe 5 (why `ViewIndist` does not claim `viewDist = uniformOfFintype`): if `M₀` has duplicate
rows `!![0, 1; 0, 1]`, the uniform-key view on `{0}` assigns probability `0` to `![0, 1]`, whereas
`uniformOfFintype` assigns positive probability. -/
def probe5DupProgram : MonotoneSpanProgram (ZMod 5) (Fin 1) where
  tailDim := 1
  rowDim := ![2]
  matrix | 0 => !![0, 1; 0, 1]

example :
    (linearUniformAccessScheme probe5DupProgram).viewDist
        (uniformOfFintype (LinearKey probe5DupProgram)) {0} 0 ≠
      uniformOfFintype ((i : ({0} : Finset (Fin 1))) → LinearShare probe5DupProgram i.1) := by
  intro h
  let bad : (i : ({0} : Finset (Fin 1))) → LinearShare probe5DupProgram i.1 :=
    fun _ r => (r.1 : ZMod 5)
  have h0 := congrArg (fun p : PMF _ => p bad) h
  have hLHS :
      (linearUniformAccessScheme probe5DupProgram).viewDist
          (uniformOfFintype (LinearKey probe5DupProgram)) {0} 0 bad = 0 := by
    simp only [AccessScheme.viewDist, AccessStructure.viewDistOf, linearUniformAccessScheme,
      AccessScheme.monoSources, linearAccessScheme, PMF.map_apply, tsum_eq_zero_iff]
    intro r
    by_cases hbad : (fun i : ({0} : Finset (Fin 1)) => linearShare probe5DupProgram r 0 i.1) = bad
    · have h0' := congrFun (congrFun hbad ⟨0, by simp⟩) ⟨0, by simp [probe5DupProgram]⟩
      have h1' := congrFun (congrFun hbad ⟨0, by simp⟩) ⟨1, by simp [probe5DupProgram]⟩
      simp only [linearShare, probe5DupProgram, bad, Matrix.cons_val_zero] at h0' h1'
      have h01 : (0 : ZMod 5) = 1 := by
        calc
          (0 : ZMod 5) = (Matrix.mulVec !![0, 1; 0, 1] (Fin.cons 0 r)) ⟨0, by decide⟩ := h0'.symm
          _ = r ⟨0, by simp [probe5DupProgram]⟩ := by
                simp [Matrix.mulVec, dotProduct]
                rfl
          _ = (Matrix.mulVec !![0, 1; 0, 1] (Fin.cons 0 r)) ⟨1, by decide⟩ := by
                simp [Matrix.mulVec, dotProduct]
                rfl
          _ = 1 := h1'
      exact absurd h01 (by decide)
    · simp [Ne.symm hbad]
  have hRHS :
      (uniformOfFintype ((i : ({0} : Finset (Fin 1))) → LinearShare probe5DupProgram i.1))
        bad ≠ 0 := by
    simp [uniformOfFintype_apply]
  exact hRHS (h0.symm.trans hLHS)

/-- Probe 6 (`tailDim = 0`, i.e., `d = 1`): trivial 1-column monotone span program `M₀ = !![1]`
works without vacuity. -/
def probe6OneColProgram : MonotoneSpanProgram (ZMod 5) (Fin 1) where
  tailDim := 0
  rowDim := ![1]
  matrix | 0 => !![1]

example : probe6OneColProgram.Accepts {0} ∧ ¬ probe6OneColProgram.Accepts ∅ := by
  constructor
  · rw [MonotoneSpanProgram.accepts_iff_exists_vecMul]
    refine ⟨fun _ _ => 1, ?_⟩
    decide
  · exact probe6OneColProgram.not_accepts_empty

/-- Probe 7 (`Party = Fin 0`): empty party set requires no `Nonempty Party`. -/
def probe7EmptyParty : MonotoneSpanProgram (ZMod 5) (Fin 0) where
  tailDim := 0
  rowDim := fun _ => 0
  matrix := fun _ => 0

example : ¬ probe7EmptyParty.Accepts ∅ :=
  probe7EmptyParty.not_accepts_empty

/-- Probe 8 (`[Field F]` cannot be relaxed to `[CommRing F]`): over `ZMod 4`, with `d = 1` and
`M₀ = !![2]`, the target `![1]` is outside the `ZMod 4`-span of `![2]`, yet no `v` with `v 0 = 1`
satisfies `M₀ *ᵥ v = 0`, and the share `![2 * secret]` leaks `secret` (`0` vs `1`). -/
example :
    (![1] : Fin 1 → ZMod 4) ∉ Submodule.span (ZMod 4) ({![2]} : Set (Fin 1 → ZMod 4)) ∧
      ¬ (∃ v : Fin 1 → ZMod 4, v 0 = 1 ∧ Matrix.mulVec !![(2 : ZMod 4)] v = 0) ∧
      Matrix.mulVec !![(2 : ZMod 4)] ![0] ≠ Matrix.mulVec !![(2 : ZMod 4)] ![1] := by
  refine ⟨?_, ?_, by decide⟩
  · intro hmem
    rw [Submodule.mem_span_singleton] at hmem
    obtain ⟨c, hc⟩ := hmem
    have h0 := congrFun hc 0
    revert c h0
    decide
  · rintro ⟨v, hv0, hmul⟩
    have h0 := congrFun hmul 0
    simp only [Matrix.mulVec, dotProduct, Fin.sum_univ_one, Matrix.of_apply, Matrix.cons_val',
      Matrix.cons_val_zero, hv0, mul_one] at h0
    revert h0
    decide

end CslibFrontierTests.LinearSecretSharing
