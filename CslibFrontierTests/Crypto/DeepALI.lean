/-!
# Concrete Finite-Field Witnesses for Coset Folding, DEEP Quotienting, and DEEP-ALI

Exercises every layer of `CslibFrontier.Crypto.Protocols.FRI.DeepALI` from an ordinary `module`
client (no `import all`, zero `sorry`, zero custom axioms):

1. **Odd-arity (`a = 3`) 3-to-1 coset folding over `ZMod 19`**: verifies
   `toOuterMeasure_foldWord_reedSolomon_close_le_unique` (`≤ 12 / 19 < 1`) at non-power-of-two
   folding arity `3` on the `18`-element multiplicative subgroup generated by `2 : ZMod 19`.
2. **List-decoding pretender disambiguation & DEEP quotienting over `ZMod 17`**: constructs a word
   `splitWord8` on `8` points agreeing on `4` coordinates each with two distinct linear polynomials
   `0` and `X` (strictly beyond unique decoding `8 + 2 > 2 * 4`, inside the integer Johnson bound
   `8 * 1 < 4 ^ 2`), checks membership of both pretenders in `agreePolyList`, bounds the list size
   by `3` via `card_agreePolyList_le_of_johnson`, and verifies Reed–Solomon membership of honest
   `deepQuotientWord` vs. non-membership under a false out-of-domain claim.
3. **Satisfiable and unsatisfiable masked AIR systems in `DeepALISystem` over `ZMod 257`**:
   constructs two-shift (`X` and `16 * X`) polynomial constraint systems on subgroup `L₀ = ⟨4⟩`
   (`|L₀| = 8`) and trace subgroup `H = ⟨16⟩` (`|H| = 4`), proving perfect completeness
   (`= PMF.pure true`) for `P_0(X) = X` and unconditional unique-decoding soundness (`< 1`) against
   all adaptive cheating provers on an unsatisfiable transition/boundary system.
4. **Beyond-unique-decoding Johnson-regime DEEP-ALI soundness over Goldilocks (`ZMod goldilocksP`,
   `p = 2 ^ 64 - 2 ^ 32 + 1`, `d = 6, k = 4, α = 5 / 16, η = 1 / 16`)**: constructs an
   unsatisfiable two-shift AIR system at rate `ρ = 1 / 16` (`√ρ = 1 / 4`), strictly beyond unique
   decoding (`2 * 44 + 5 = 93 > 64`), with Johnson list bound `L = 7` and symbolic polynomial-root
   out-of-domain set of size `≥ 1000`, proving `deepALIGame airUnsatGoldilocks adv true < 3 / 5`
   against every adaptive prover via `deepALIGame_ofBinary_le_of_johnson_eta`.
-/

set_option linter.privateModule false

namespace CslibFrontierTests.Crypto.DeepALI

open Cslib.Code Cslib.Crypto.Protocols.FRI Cslib.Probability Finset Polynomial
open CslibFrontierTests.Crypto.FRI CslibFrontierTests.Crypto.FRIJohnson
open scoped BigOperators NNReal ENNReal

/-! ### 1. Odd-arity (`a = 3`) 3-to-1 coset folding over `ZMod 19` -/

instance : Fact (Nat.Prime 19) := ⟨by decide⟩

private lemma isPrimitiveRoot_two_zmod19 : IsPrimitiveRoot (2 : ZMod 19) 18 := by
  rw [IsPrimitiveRoot.iff_def]
  refine ⟨by decide, fun l hl => ?_⟩
  by_contra hndvd
  have hrem : l % 18 ≠ 0 := fun h0 => hndvd (Nat.dvd_of_mod_eq_zero h0)
  have hpow : (2 : ZMod 19) ^ (l % 18) = 1 := by
    have hdiv := Nat.div_add_mod l 18
    have h18 : (2 : ZMod 19) ^ 18 = 1 := by decide
    have h1 : (2 : ZMod 19) ^ (18 * (l / 18) + l % 18) = 1 := hdiv.symm ▸ hl
    rwa [pow_add, pow_mul, h18, one_pow, one_mul] at h1
  have hlt : l % 18 < 18 := Nat.mod_lt l (by omega)
  revert hrem hpow
  generalize l % 18 = r at hlt
  interval_cases r <;> decide

/-- Word on `Fin 18` equal to `1` on `{0, 1, 2, 3}` and `0` on `{4, …, 17}`: distance `4 > 3` from
`0` and at least `14 - 2 = 12 > 3` from every nonzero polynomial of degree `< 3`. -/
private def farWord18 (i : Fin 18) : ZMod 19 :=
  if i.val < 4 then 1 else 0

private lemma farWord18_far :
    ∀ c ∈ reedSolomon (cosetPoint (1 : ZMod 19) 2 18) 3, 3 < hammingDist farWord18 c := by
  intro c hc
  by_contra hle
  have hdist : hammingDist farWord18 c ≤ 3 := Nat.le_of_not_lt hle
  obtain ⟨p, hp_deg, rfl⟩ := mem_reedSolomon.mp hc
  by_cases hp0 : p = 0
  · subst hp0
    simp only [eval_zero] at hdist
    have hd4 : hammingDist farWord18 (fun _ => (0 : ZMod 19)) = 4 := by decide
    omega
  · let tailSet : Finset (Fin 18) := Finset.univ.filter fun i : Fin 18 => 4 ≤ i.val
    have htail_card : tailSet.card = 14 := by decide
    let zeroOnTail : Finset (Fin 18) := tailSet.filter fun i => p.eval (cosetPoint 1 2 18 i) = 0
    have hbad_sub : tailSet \ zeroOnTail ⊆
        Finset.univ.filter fun i : Fin 18 => farWord18 i ≠ p.eval (cosetPoint 1 2 18 i) := by
      intro i hi
      obtain ⟨hi_tail, hi_nz⟩ := Finset.mem_sdiff.mp hi
      have hge4 : 4 ≤ i.val := (Finset.mem_filter.mp hi_tail).2
      have hfw : farWord18 i = 0 := by
        simp only [farWord18]
        exact ite_eq_right (by omega)
      rw [Finset.mem_filter]
      refine ⟨Finset.mem_univ i, ?_⟩
      rw [hfw]
      exact fun hEq => hi_nz (Finset.mem_filter.mpr ⟨hi_tail, hEq.symm⟩)
    have hsdiff_le : (tailSet \ zeroOnTail).card ≤ 3 :=
      (Finset.card_le_card hbad_sub).trans hdist
    have hsub_le : zeroOnTail ⊆ tailSet := Finset.filter_subset _ _
    have hcard_add := Finset.card_sdiff_add_card_eq_card hsub_le
    have hzero_ge : 3 ≤ zeroOnTail.card := by omega
    have hp_eq0 : p = 0 := eq_of_degree_lt_of_eval_eq_on
      (cosetPoint_injective one_ne_zero isPrimitiveRoot_two_zmod19)
      hzero_ge hp_deg (WithBot.bot_lt_coe 3)
      fun i hi => by simpa only [eval_zero] using (Finset.mem_filter.mp hi).2
    exact hp0 hp_eq0

/-- **Checked ternary (`3`-to-`1`) coset-folding soundness witness over `ZMod 19`**. -/
example :
    (PMF.uniformOfFintype (ZMod 19)).toOuterMeasure
        {z : ZMod 19 |
          ∃ c' ∈ reedSolomon (cosetPoint ((1 : ZMod 19) ^ 3) ((2 : ZMod 19) ^ 3) 6) 1,
            hammingDist (foldWord (a := 3) (N := 6) 1 2 farWord18 z) c' ≤ 1} < 1 := by
  have hbound := toOuterMeasure_foldWord_reedSolomon_close_le_unique
    (F := ZMod 19) (g := 1) (ω := 2) (a := 3) (N := 6) (k := 1) (e := 3)
    one_ne_zero (by decide) (by omega) isPrimitiveRoot_two_zmod19 (by omega) farWord18_far
  refine lt_of_le_of_lt hbound ?_
  rw [ZMod.card 19]
  have hnn : (12 : ℝ≥0) / 19 < 1 := by norm_num
  simpa only [ENNReal.coe_div (by norm_num : (19 : ℝ≥0) ≠ 0), ENNReal.coe_ofNat, ENNReal.coe_one,
    (by norm_num : ((3 - 1) * 6 : ℕ) = 12), Nat.cast_ofNat] using ENNReal.coe_lt_coe.mpr hnn

/-! ### 2. List-decoding pretenders & out-of-domain DEEP quotienting over `ZMod 17` -/

instance : Fact (Nat.Prime 17) := ⟨by decide⟩

private def dom8 (s : Fin 8) : ZMod 17 := (s.val : ZMod 17)

private lemma dom8_injective : Function.Injective dom8 := by
  intro i j h
  revert i j h
  decide

private def splitWord8 (s : Fin 8) : ZMod 17 :=
  if s.val < 4 then 0 else (s.val : ZMod 17)

/-- Both `0` and `X` belong to `agreePolyList dom8 2 splitWord8 4`, while the integer Johnson bound
caps the list size at `3`, and honest vs. false OOD claims separate membership in `reedSolomon`. -/
example :
    (0 : (ZMod 17)[X]) ∈ agreePolyList dom8 2 splitWord8 4 ∧
    (Polynomial.X : (ZMod 17)[X]) ∈ agreePolyList dom8 2 splitWord8 4 ∧
    (agreePolyList dom8 2 splitWord8 4).card ≤ 3 ∧
    deepQuotientWord dom8 (fun s => (Polynomial.X : (ZMod 17)[X]).eval (dom8 s)) 10 10 ∈
      reedSolomon dom8 1 ∧
    deepQuotientWord dom8 (fun s => (Polynomial.X : (ZMod 17)[X]).eval (dom8 s)) 10 0 ∉
      reedSolomon dom8 1 := by
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · rw [mem_agreePolyList]
    refine ⟨WithBot.bot_lt_coe 2, ?_⟩
    simp only [eval_zero]
    decide
  · rw [mem_agreePolyList]
    refine ⟨by simpa only [degree_X] using (by norm_num : (1 : WithBot ℕ) < (2 : ℕ)), ?_⟩
    simp only [eval_X]
    decide
  · have hj := card_agreePolyList_le_of_johnson dom8_injective (k := 2) (a := 4)
      (by omega) (by rw [Fintype.card_fin]; omega) splitWord8
    rw [Fintype.card_fin] at hj
    exact hj.trans (by decide)
  · have hdeg : (Polynomial.X : (ZMod 17)[X]).degree < ((1 + 1 : ℕ) : WithBot ℕ) := by
      simpa only [degree_X] using (by norm_num : (1 : WithBot ℕ) < ((2 : ℕ) : WithBot ℕ))
    simpa only [eval_X] using
      deepQuotientWord_mem_reedSolomon (α := dom8) (p := Polynomial.X) (k := 1) (z := 10) hdeg
        (by decide)
  · intro hmem
    obtain ⟨q, hq_deg, hq_ev⟩ := mem_reedSolomon.mp hmem
    have hq_const : ∃ c : ZMod 17, q = Polynomial.C c := by
      rcases eq_or_ne q 0 with rfl | hq0
      · exact ⟨0, by simp only [map_zero]⟩
      · have h0 : q.natDegree = 0 := by
          have hlt := (natDegree_lt_iff_degree_lt hq0).mpr hq_deg
          omega
        exact ⟨q.coeff 0, eq_C_of_natDegree_eq_zero h0⟩
    obtain ⟨c, rfl⟩ := hq_const
    have h0 := congrFun hq_ev 0
    have h1 := congrFun hq_ev 1
    simp only [eval_C, eval_X, deepQuotientWord, dom8, Fin.val_zero, Fin.val_one, Nat.cast_zero,
      Nat.cast_one, sub_zero, zero_div] at h0 h1
    have h1_ne : (1 : ZMod 17) / (1 - 10) ≠ 0 := div_ne_zero one_ne_zero (by decide)
    exact h1_ne (h1.symm.trans h0)

/-! ### 3. Satisfiable and unsatisfiable masked AIR systems in `DeepALISystem` over `ZMod 257` -/

private lemma four_pow_8_zmod257 : (4 : ZMod 257) ^ 8 = 1 := by decide

private def smoothParams257 : FRISmoothParams (ZMod 257) where
  d := 3
  m := 1
  stepLog := fun _ => 1
  kFinal := 1
  q := 4
  g := 1
  ω := 4
  hstepPos := fun _ => le_rfl
  htotal := by decide
  hkPos := le_rfl
  hkLe := by decide
  hg := one_ne_zero
  h2 := by decide
  hω := isPrimitiveRoot_four_eight

private lemma cosetEval_257_pow_8 (s : Fin (2 ^ smoothParams257.d)) :
    (cosetEval smoothParams257.g smoothParams257.ω smoothParams257.d 0 s) ^ 8 = 1 := by
  change ((1 : ZMod 257) * 4 ^ s.val) ^ 8 = 1
  rw [one_mul, ← pow_mul, mul_comm, pow_mul, four_pow_8_zmod257, one_pow]

private def cand257 : Finset (ZMod 257) :=
  (Finset.range 208).image fun t : ℕ => (t : ZMod 257)

private lemma card_cand257 : cand257.card = 208 := by
  rw [cand257, Finset.card_image_of_injOn, Finset.card_range]
  intro a ha b hb hab
  have ha_lt : a < 257 := (Finset.mem_range.mp ha).trans (by omega)
  have hb_lt : b < 257 := (Finset.mem_range.mp hb).trans (by omega)
  have hv := congrArg ZMod.val hab
  rwa [ZMod.val_natCast_of_lt ha_lt, ZMod.val_natCast_of_lt hb_lt] at hv

private noncomputable def oodDom257 : Finset (ZMod 257) :=
  cand257.filter fun z => z ^ 8 - 1 ≠ 0

private lemma card_oodDom257_ge : 200 ≤ oodDom257.card := by
  have hpart : (cand257 \ oodDom257).card + oodDom257.card = cand257.card :=
    Finset.card_sdiff_add_card_eq_card (Finset.filter_subset _ _)
  rw [card_cand257] at hpart
  let q : (ZMod 257)[X] := Polynomial.X ^ 8 - Polynomial.C 1
  have hq_monic : q.Monic := monic_X_pow_sub_C 1 (by omega)
  have hq_deg : q.natDegree = 8 := natDegree_X_pow_sub_C (n := 8) (a := (1 : ZMod 257))
  have hbad_sub : cand257 \ oodDom257 ⊆ q.roots.toFinset := by
    intro z hz
    obtain ⟨hz_cand, hz_not⟩ := Finset.mem_sdiff.mp hz
    have hz0 : z ^ 8 - 1 = 0 :=
      not_not.mp fun hne => hz_not (Finset.mem_filter.mpr ⟨hz_cand, hne⟩)
    rw [Multiset.mem_toFinset, mem_roots hq_monic.ne_zero, IsRoot.def]
    simpa only [q, eval_sub, eval_pow, eval_X, eval_C] using hz0
  have hbad_le : (cand257 \ oodDom257).card ≤ 8 := by
    calc _ ≤ q.roots.toFinset.card := Finset.card_le_card hbad_sub
      _ ≤ q.roots.card := Multiset.toFinset_card_le _
      _ ≤ q.natDegree := card_roots' q
      _ = 8 := hq_deg
  omega

/-- Satisfiable geometric-step AIR (`P_0(16 X) - 16 P_0(X)` on `X ^ 4 - 1` and `P_0(X) - 1` on
`X - 1`, witnessed by `P_0(X) = X`). -/
private noncomputable def airSat257 : DeepALISystem (ZMod 257) 1 2 2 0 where
  params := smoothParams257
  maskCol := fun _ => 0
  maskShift := fun u => if u.val = 0 then 1 else 16
  constraintPoly := fun m =>
    if m.val = 0 then
      MvPolynomial.X (some 1) - MvPolynomial.C 16 * MvPolynomial.X (some 0)
    else
      MvPolynomial.X (some 0) - MvPolynomial.C 1
  zerofier := fun m =>
    if m.val = 0 then Polynomial.X ^ 4 - Polynomial.C 1 else Polynomial.X - Polynomial.C 1
  hzerofier_monic := fun m => by
    fin_cases m
    · exact monic_X_pow_sub_C 1 (by omega)
    · exact monic_X_sub_C 1
  hquot_deg := fun m => by
    have hdim : smoothParams257.dim 0 = 2 := by decide
    rw [hdim]
    fin_cases m
    · simp only [↓reduceIte, natDegree_X_pow_sub_C]
      have hdeg : constraintDegBound
          (MvPolynomial.X (some 1) - MvPolynomial.C (16 : ZMod 257) * MvPolynomial.X (some 0) :
            MvPolynomial (Option (Fin 2)) (ZMod 257)) 2 ≤ 2 := by
        refine (constraintDegBound_sub_le _ _ 2).trans (max_le ?_ ?_)
        · simp only [constraintDegBound_X_some, le_rfl]
        · refine (constraintDegBound_mul_le _ _ 2).trans ?_
          simp only [constraintDegBound_C, constraintDegBound_X_some, zero_add, le_rfl]
      omega
    · simp only [show (1 : ℕ) ≠ 0 by omega, ↓reduceIte, natDegree_X_sub_C]
      have hdeg : constraintDegBound
          (MvPolynomial.X (some 0) - MvPolynomial.C (1 : ZMod 257) :
            MvPolynomial (Option (Fin 2)) (ZMod 257)) 2 ≤ 2 := by
        refine (constraintDegBound_sub_le _ _ 2).trans (max_le ?_ ?_)
        · simp only [constraintDegBound_X_some, le_rfl]
        · simp only [constraintDegBound_C, Nat.zero_le]
      omega
  oodDom := oodDom257
  hood_nonempty := Finset.card_pos.mp (lt_of_lt_of_le (by omega : 0 < 200) card_oodDom257_ge)
  hood_coset := fun z hz s heq => by
    have hz8 : z ^ 8 - 1 ≠ 0 := (Finset.mem_filter.mp hz).2
    exact hz8 (by rw [← heq, cosetEval_257_pow_8 s, sub_self])
  hood_mask := fun z hz u s heq => by
    have hz8 : z ^ 8 - 1 ≠ 0 := (Finset.mem_filter.mp hz).2
    fin_cases u
    · change cosetEval smoothParams257.g smoothParams257.ω smoothParams257.d 0 s = 1 * z at heq
      rw [one_mul] at heq
      exact hz8 (by rw [← heq, cosetEval_257_pow_8 s, sub_self])
    · change cosetEval smoothParams257.g smoothParams257.ω smoothParams257.d 0 s = 16 * z at heq
      have h16 : ((16 : ZMod 257) * z) ^ 8 = z ^ 8 := by
        rw [mul_pow, show (16 : ZMod 257) ^ 8 = 1 by decide, one_mul]
      exact hz8 (by rw [← h16, ← heq, cosetEval_257_pow_8 s, sub_self])
  hood_zerofier := fun z hz m => by
    have hz8 : z ^ 8 - 1 ≠ 0 := (Finset.mem_filter.mp hz).2
    have hz4 : z ^ 4 - 1 ≠ 0 := fun h4 => by
      have hz4_eq : z ^ 4 = 1 := sub_eq_zero.mp h4
      have h8 : z ^ 8 = (z ^ 4) ^ 2 := by ring
      exact hz8 (by rw [h8, hz4_eq, one_pow, sub_self])
    fin_cases m
    · change (Polynomial.X ^ 4 - Polynomial.C (1 : ZMod 257)).eval z ≠ 0
      simpa only [eval_sub, eval_pow, eval_X, eval_C] using hz4
    · change (Polynomial.X - Polynomial.C (1 : ZMod 257)).eval z ≠ 0
      simp only [eval_sub, eval_X, eval_C]
      intro h1
      exact hz4 (by rw [sub_eq_zero.mp h1, one_pow, sub_self])

private lemma isValidWitness_X_airSat257 :
    airSat257.IsValidWitness (fun _ => Polynomial.X) := by
  have hdim : smoothParams257.dim 0 = 2 := by decide
  refine ⟨fun _ => ?_, fun m => ?_⟩
  · change (Polynomial.X : (ZMod 257)[X]).degree < (smoothParams257.dim 0 + 1 : ℕ)
    rw [hdim, degree_X]
    norm_num
  · fin_cases m
    · change airSat257.zerofier 0 ∣ airSat257.evalMaskPoly 0 (fun _ => Polynomial.X)
      have h0 : airSat257.evalMaskPoly 0 (fun _ => Polynomial.X) = 0 := by
        rw [DeepALISystem.evalMaskPoly, ← MvPolynomial.coe_eval₂Hom]
        change (MvPolynomial.eval₂Hom Polynomial.C _
          (MvPolynomial.X (some 1) - MvPolynomial.C 16 * MvPolynomial.X (some 0))) = 0
        simp only [map_sub, map_mul, MvPolynomial.eval₂Hom_X', MvPolynomial.eval₂Hom_C,
          Option.elim'_some, X_comp, airSat257, Fin.val_one, Fin.val_zero,
          show (1 : ℕ) ≠ 0 by omega, ↓reduceIte, C_1, one_mul, sub_self]
      rw [h0]
      exact dvd_zero _
    · change airSat257.zerofier 1 ∣ airSat257.evalMaskPoly 1 (fun _ => Polynomial.X)
      rw [airSat257.prod_X_sub_C_dvd_evalMaskPoly_iff 1 ({1} : Finset (ZMod 257))
        (by simp only [Finset.prod_singleton]; rfl)]
      intro x hx
      rw [Finset.mem_singleton.mp hx]
      change MvPolynomial.eval _ (MvPolynomial.X (some 0) - MvPolynomial.C (1 : ZMod 257)) = 0
      simp only [map_sub, MvPolynomial.eval_X, MvPolynomial.eval_C, Option.elim'_some, eval_X,
        airSat257, Fin.val_zero, ↓reduceIte, one_mul, sub_self]

/-- **Checked perfect completeness of `deepALIGame` on `airSat257`**. -/
example :
    deepALIGame airSat257 (honestDeepALIProver airSat257 (fun _ => Polynomial.X)) =
      PMF.pure true :=
  deepALIGame_honest_eq_pure_true airSat257 isValidWitness_X_airSat257

/-- Unsatisfiable AIR over `ZMod 257`: enforces `P_0(16 X) - P_0(X) = 0` on `X ^ 4 - 1`,
`P_0(1) = 1` on `X - 1`, and `P_0(16) = 2` on `X - 16`. -/
private noncomputable def airUnsat257 : DeepALISystem (ZMod 257) 1 2 3 0 where
  params := smoothParams257
  maskCol := fun _ => 0
  maskShift := fun u => if u.val = 0 then 1 else 16
  constraintPoly := fun m =>
    match m.val with
    | 0 => MvPolynomial.X (some 1) - MvPolynomial.X (some 0)
    | 1 => MvPolynomial.X (some 0) - MvPolynomial.C 1
    | _ => MvPolynomial.X (some 0) - MvPolynomial.C 2
  zerofier := fun m =>
    match m.val with
    | 0 => Polynomial.X ^ 4 - Polynomial.C 1
    | 1 => Polynomial.X - Polynomial.C 1
    | _ => Polynomial.X - Polynomial.C 16
  hzerofier_monic := fun m => by
    fin_cases m
    · exact monic_X_pow_sub_C 1 (by omega)
    · exact monic_X_sub_C 1
    · exact monic_X_sub_C 16
  hquot_deg := fun m => by
    have hdim : smoothParams257.dim 0 = 2 := by decide
    rw [hdim]
    fin_cases m
    · change constraintDegBound
          (MvPolynomial.X (some 1) - MvPolynomial.X (some 0) :
            MvPolynomial (Option (Fin 2)) (ZMod 257)) 2 <
        (Polynomial.X ^ 4 - Polynomial.C (1 : ZMod 257)).natDegree + 1 * (2 + 1)
      rw [natDegree_X_pow_sub_C]
      have hdeg : constraintDegBound
          (MvPolynomial.X (some 1) - MvPolynomial.X (some 0) :
            MvPolynomial (Option (Fin 2)) (ZMod 257)) 2 ≤ 2 := by
        refine (constraintDegBound_sub_le _ _ 2).trans (max_le ?_ ?_) <;>
          simp only [constraintDegBound_X_some, le_rfl]
      omega
    · change constraintDegBound
          (MvPolynomial.X (some 0) - MvPolynomial.C (1 : ZMod 257) :
            MvPolynomial (Option (Fin 2)) (ZMod 257)) 2 <
        (Polynomial.X - Polynomial.C (1 : ZMod 257)).natDegree + 1 * (2 + 1)
      rw [natDegree_X_sub_C]
      have hdeg : constraintDegBound
          (MvPolynomial.X (some 0) - MvPolynomial.C (1 : ZMod 257) :
            MvPolynomial (Option (Fin 2)) (ZMod 257)) 2 ≤ 2 := by
        refine (constraintDegBound_sub_le _ _ 2).trans (max_le ?_ ?_)
        · simp only [constraintDegBound_X_some, le_rfl]
        · simp only [constraintDegBound_C, Nat.zero_le]
      omega
    · change constraintDegBound
          (MvPolynomial.X (some 0) - MvPolynomial.C (2 : ZMod 257) :
            MvPolynomial (Option (Fin 2)) (ZMod 257)) 2 <
        (Polynomial.X - Polynomial.C (16 : ZMod 257)).natDegree + 1 * (2 + 1)
      rw [natDegree_X_sub_C]
      have hdeg : constraintDegBound
          (MvPolynomial.X (some 0) - MvPolynomial.C (2 : ZMod 257) :
            MvPolynomial (Option (Fin 2)) (ZMod 257)) 2 ≤ 2 := by
        refine (constraintDegBound_sub_le _ _ 2).trans (max_le ?_ ?_)
        · simp only [constraintDegBound_X_some, le_rfl]
        · simp only [constraintDegBound_C, Nat.zero_le]
      omega
  oodDom := oodDom257
  hood_nonempty := Finset.card_pos.mp (lt_of_lt_of_le (by omega : 0 < 200) card_oodDom257_ge)
  hood_coset := fun z hz s heq => by
    have hz8 : z ^ 8 - 1 ≠ 0 := (Finset.mem_filter.mp hz).2
    exact hz8 (by rw [← heq, cosetEval_257_pow_8 s, sub_self])
  hood_mask := fun z hz u s heq => by
    have hz8 : z ^ 8 - 1 ≠ 0 := (Finset.mem_filter.mp hz).2
    fin_cases u
    · change cosetEval smoothParams257.g smoothParams257.ω smoothParams257.d 0 s = 1 * z at heq
      rw [one_mul] at heq
      exact hz8 (by rw [← heq, cosetEval_257_pow_8 s, sub_self])
    · change cosetEval smoothParams257.g smoothParams257.ω smoothParams257.d 0 s = 16 * z at heq
      have h16 : ((16 : ZMod 257) * z) ^ 8 = z ^ 8 := by
        rw [mul_pow, show (16 : ZMod 257) ^ 8 = 1 by decide, one_mul]
      exact hz8 (by rw [← h16, ← heq, cosetEval_257_pow_8 s, sub_self])
  hood_zerofier := fun z hz m => by
    have hz8 : z ^ 8 - 1 ≠ 0 := (Finset.mem_filter.mp hz).2
    have hz4 : z ^ 4 - 1 ≠ 0 := fun h4 => by
      have hz4_eq : z ^ 4 = 1 := sub_eq_zero.mp h4
      have h8 : z ^ 8 = (z ^ 4) ^ 2 := by ring
      exact hz8 (by rw [h8, hz4_eq, one_pow, sub_self])
    fin_cases m
    · change (Polynomial.X ^ 4 - Polynomial.C (1 : ZMod 257)).eval z ≠ 0
      simpa only [eval_sub, eval_pow, eval_X, eval_C] using hz4
    · change (Polynomial.X - Polynomial.C (1 : ZMod 257)).eval z ≠ 0
      simp only [eval_sub, eval_X, eval_C]
      intro h1
      exact hz4 (by rw [sub_eq_zero.mp h1, one_pow, sub_self])
    · change (Polynomial.X - Polynomial.C (16 : ZMod 257)).eval z ≠ 0
      simp only [eval_sub, eval_X, eval_C]
      intro h16
      exact hz4 (by rw [sub_eq_zero.mp h16]; decide)

private lemma not_satisfiable_airUnsat257 : ¬ airUnsat257.Satisfiable := by
  rintro ⟨P, _, hdvd⟩
  have h0 : (airUnsat257.evalMaskPoly 0 P).eval 1 = 0 := by
    obtain ⟨q, hq⟩ := hdvd 0
    have hz0 : (airUnsat257.zerofier 0).eval 1 = 0 := by
      change (Polynomial.X ^ 4 - Polynomial.C (1 : ZMod 257)).eval 1 = 0
      simp only [eval_sub, eval_pow, eval_X, eval_C, one_pow, sub_self]
    rw [hq, eval_mul, hz0, zero_mul]
  have h1 : (airUnsat257.evalMaskPoly 1 P).eval 1 = 0 :=
    dvd_iff_isRoot.mp (hdvd 1)
  have h2 : (airUnsat257.evalMaskPoly 2 P).eval 16 = 0 :=
    dvd_iff_isRoot.mp (hdvd 2)
  rw [airUnsat257.eval_evalMaskPoly] at h0 h1 h2
  simp only [DeepALISystem.evalConstraintPoint, airUnsat257, Fin.val_zero, Fin.val_one,
    Fin.val_two, map_sub, MvPolynomial.eval_X, MvPolynomial.eval_C, Option.elim'_some,
    show (1 : ℕ) ≠ 0 by omega, ↓reduceIte, one_mul, mul_one] at h0 h1 h2
  rw [sub_eq_zero.mp h1, sub_eq_zero.mp h2] at h0
  exact absurd h0 (by decide)

/-- **Checked unconditional unique-decoding soundness (`< 1`) on `airUnsat257`**. -/
example (adv : DeepALIProver airUnsat257) :
    deepALIGame airUnsat257 adv true < 1 := by
  have hdim : airUnsat257.params.dim 0 = 2 := by decide
  have htot : airUnsat257.params.totalLog = 1 := by decide
  have hlink_deg : airUnsat257.linkDegBound = 8 := by
    simp only [DeepALISystem.linkDegBound, hdim, Fin.sum_univ_three]
    change 1 * 3 - 1 +
      ((Polynomial.X ^ 4 - Polynomial.C (1 : ZMod 257)).natDegree +
        (Polynomial.X - Polynomial.C (1 : ZMod 257)).natDegree +
        (Polynomial.X - Polynomial.C (16 : ZMod 257)).natDegree) = 8
    rw [natDegree_X_pow_sub_C, natDegree_X_sub_C, natDegree_X_sub_C]
  have hbound := deepALIGame_le_of_unique (e := 2) airUnsat257 not_satisfiable_airUnsat257
    (by rw [hdim]; decide) adv
  rw [ZMod.card 257, hlink_deg, htot, show airUnsat257.params.d = 3 from rfl,
    show airUnsat257.params.q = 4 from rfl] at hbound
  have hood_le : (8 : ℝ≥0∞) / (airUnsat257.oodDom.card : ℝ≥0∞) ≤ (8 : ℝ≥0∞) / 200 :=
    ENNReal.div_le_div_left (by exact_mod_cast card_oodDom257_ge) _
  refine lt_of_le_of_lt hbound ?_
  refine lt_of_le_of_lt (add_le_add (add_le_add le_rfl hood_le) le_rfl) ?_
  have hnn : (1 : ℝ≥0) / 257 + 8 / 200 + (12 / 257 + (5 / 8) ^ 4) < 1 := by norm_num
  simpa only [ENNReal.coe_add, ENNReal.coe_pow,
    ENNReal.coe_div (by norm_num : (257 : ℝ≥0) ≠ 0),
    ENNReal.coe_div (by norm_num : (200 : ℝ≥0) ≠ 0),
    ENNReal.coe_div (by norm_num : (8 : ℝ≥0) ≠ 0),
    ENNReal.coe_ofNat, ENNReal.coe_one,
    (by norm_num : (2 * 2 ^ 3 - 2 ^ (3 - 1) : ℕ) = 12),
    (by norm_num : (2 ^ 3 - 2 - 1 : ℕ) = 5),
    (by norm_num : (2 : ℝ≥0∞) ^ 3 = 8),
    Nat.cast_ofNat] using ENNReal.coe_lt_coe.mpr hnn

/-! ### 4. Beyond-unique-decoding Johnson-regime DEEP-ALI soundness over Goldilocks -/

private theorem eight_pow_32_goldilocks : (8 : ZMod goldilocksP) ^ 32 = -1 := by
  have hdvd : goldilocksP ∣ 8 ^ 32 + 1 := ⟨2 ^ 32 + 1, by norm_num [goldilocksP]⟩
  have hcast : ((8 ^ 32 + 1 : ℕ) : ZMod goldilocksP) = 0 :=
    (ZMod.natCast_eq_zero_iff (8 ^ 32 + 1) goldilocksP).mpr hdvd
  rw [Nat.cast_add, Nat.cast_pow, Nat.cast_ofNat, Nat.cast_one] at hcast
  exact eq_neg_of_add_eq_zero_left hcast

private theorem eight_pow_64_goldilocks : (8 : ZMod goldilocksP) ^ 64 = 1 := by
  have h64 : (8 : ZMod goldilocksP) ^ 64 = ((8 : ZMod goldilocksP) ^ 32) ^ 2 := by ring
  rw [h64, eight_pow_32_goldilocks, neg_one_sq]

private def binParamsGoldilocks : FRIParams (ZMod goldilocksP) where
  d := 6
  m := 2
  kFinal := 1
  q := 6
  g := 1
  ω := 8
  hm := by omega
  hkPos := by omega
  hkLe := by omega
  hg := one_ne_zero
  h2 := by decide
  hω := isPrimitiveRoot_two_pow_of_neg_one (by omega) (by decide) eight_pow_32_goldilocks

private lemma cosetEval_goldilocks_pow_64 (s : Fin (2 ^ binParamsGoldilocks.toSmooth.d)) :
    (cosetEval binParamsGoldilocks.toSmooth.g binParamsGoldilocks.toSmooth.ω
      binParamsGoldilocks.toSmooth.d 0 s) ^ 64 = 1 := by
  change ((1 : ZMod goldilocksP) * 8 ^ s.val) ^ 64 = 1
  rw [one_mul, ← pow_mul, mul_comm, pow_mul, eight_pow_64_goldilocks, one_pow]

private def candGoldilocks : Finset (ZMod goldilocksP) :=
  (Finset.range 1064).image fun t : ℕ => (t : ZMod goldilocksP)

private lemma card_candGoldilocks : candGoldilocks.card = 1064 := by
  rw [candGoldilocks, Finset.card_image_of_injOn, Finset.card_range]
  intro a ha b hb hab
  have ha_lt : a < goldilocksP := (Finset.mem_range.mp ha).trans (by norm_num [goldilocksP])
  have hb_lt : b < goldilocksP := (Finset.mem_range.mp hb).trans (by norm_num [goldilocksP])
  have hv := congrArg ZMod.val hab
  rwa [ZMod.val_natCast_of_lt ha_lt, ZMod.val_natCast_of_lt hb_lt] at hv

private noncomputable def oodDomGoldilocks : Finset (ZMod goldilocksP) :=
  candGoldilocks.filter fun z => z ^ 64 - 1 ≠ 0

private lemma card_oodDomGoldilocks_ge : 1000 ≤ oodDomGoldilocks.card := by
  have hpart : (candGoldilocks \ oodDomGoldilocks).card + oodDomGoldilocks.card =
      candGoldilocks.card :=
    Finset.card_sdiff_add_card_eq_card (Finset.filter_subset _ _)
  rw [card_candGoldilocks] at hpart
  let q : (ZMod goldilocksP)[X] := Polynomial.X ^ 64 - Polynomial.C 1
  have hq_monic : q.Monic := monic_X_pow_sub_C 1 (by omega)
  have hq_deg : q.natDegree = 64 := natDegree_X_pow_sub_C (n := 64) (a := (1 : ZMod goldilocksP))
  have hbad_sub : candGoldilocks \ oodDomGoldilocks ⊆ q.roots.toFinset := by
    intro z hz
    obtain ⟨hz_cand, hz_not⟩ := Finset.mem_sdiff.mp hz
    have hz0 : z ^ 64 - 1 = 0 :=
      not_not.mp fun hne => hz_not (Finset.mem_filter.mpr ⟨hz_cand, hne⟩)
    rw [Multiset.mem_toFinset, mem_roots hq_monic.ne_zero, IsRoot.def]
    simpa only [q, eval_sub, eval_pow, eval_X, eval_C] using hz0
  have hbad_le : (candGoldilocks \ oodDomGoldilocks).card ≤ 64 := by
    calc _ ≤ q.roots.toFinset.card := Finset.card_le_card hbad_sub
      _ ≤ q.roots.card := Multiset.toFinset_card_le _
      _ ≤ q.natDegree := card_roots' q
      _ = 64 := hq_deg
  omega

/-- Unsatisfiable two-shift AIR over `ZMod goldilocksP` (`P_0(8^16 X) - P_0(X) = 0` on `X^4 - 1`,
`P_0(1) = 1`, `P_0(8^16) = 2`), parameterized by `binParamsGoldilocks.toSmooth`. -/
private noncomputable def airUnsatGoldilocks :
    DeepALISystem (ZMod goldilocksP) 1 2 3 0 where
  params := binParamsGoldilocks.toSmooth
  maskCol := fun _ => 0
  maskShift := fun u => if u.val = 0 then 1 else (8 : ZMod goldilocksP) ^ 16
  constraintPoly := fun m =>
    match m.val with
    | 0 => MvPolynomial.X (some 1) - MvPolynomial.X (some 0)
    | 1 => MvPolynomial.X (some 0) - MvPolynomial.C 1
    | _ => MvPolynomial.X (some 0) - MvPolynomial.C 2
  zerofier := fun m =>
    match m.val with
    | 0 => Polynomial.X ^ 4 - Polynomial.C 1
    | 1 => Polynomial.X - Polynomial.C 1
    | _ => Polynomial.X - Polynomial.C ((8 : ZMod goldilocksP) ^ 16)
  hzerofier_monic := fun m => by
    fin_cases m
    · exact monic_X_pow_sub_C 1 (by omega)
    · exact monic_X_sub_C 1
    · exact monic_X_sub_C _
  hquot_deg := fun m => by
    have hdim : binParamsGoldilocks.toSmooth.dim 0 = 4 := by
      rw [binParamsGoldilocks.toSmooth_dim (Nat.zero_le _)]
      decide
    rw [hdim]
    fin_cases m
    · change constraintDegBound
          (MvPolynomial.X (some 1) - MvPolynomial.X (some 0) :
            MvPolynomial (Option (Fin 2)) (ZMod goldilocksP)) 4 <
        (Polynomial.X ^ 4 - Polynomial.C (1 : ZMod goldilocksP)).natDegree + 1 * (4 + 1)
      rw [natDegree_X_pow_sub_C]
      have hdeg : constraintDegBound
          (MvPolynomial.X (some 1) - MvPolynomial.X (some 0) :
            MvPolynomial (Option (Fin 2)) (ZMod goldilocksP)) 4 ≤ 4 := by
        refine (constraintDegBound_sub_le _ _ 4).trans (max_le ?_ ?_) <;>
          simp only [constraintDegBound_X_some, le_rfl]
      omega
    · change constraintDegBound
          (MvPolynomial.X (some 0) - MvPolynomial.C (1 : ZMod goldilocksP) :
            MvPolynomial (Option (Fin 2)) (ZMod goldilocksP)) 4 <
        (Polynomial.X - Polynomial.C (1 : ZMod goldilocksP)).natDegree + 1 * (4 + 1)
      rw [natDegree_X_sub_C]
      have hdeg : constraintDegBound
          (MvPolynomial.X (some 0) - MvPolynomial.C (1 : ZMod goldilocksP) :
            MvPolynomial (Option (Fin 2)) (ZMod goldilocksP)) 4 ≤ 4 := by
        refine (constraintDegBound_sub_le _ _ 4).trans (max_le ?_ ?_)
        · simp only [constraintDegBound_X_some, le_rfl]
        · simp only [constraintDegBound_C, Nat.zero_le]
      omega
    · change constraintDegBound
          (MvPolynomial.X (some 0) - MvPolynomial.C (2 : ZMod goldilocksP) :
            MvPolynomial (Option (Fin 2)) (ZMod goldilocksP)) 4 <
        (Polynomial.X - Polynomial.C ((8 : ZMod goldilocksP) ^ 16)).natDegree + 1 * (4 + 1)
      rw [natDegree_X_sub_C]
      have hdeg : constraintDegBound
          (MvPolynomial.X (some 0) - MvPolynomial.C (2 : ZMod goldilocksP) :
            MvPolynomial (Option (Fin 2)) (ZMod goldilocksP)) 4 ≤ 4 := by
        refine (constraintDegBound_sub_le _ _ 4).trans (max_le ?_ ?_)
        · simp only [constraintDegBound_X_some, le_rfl]
        · simp only [constraintDegBound_C, Nat.zero_le]
      omega
  oodDom := oodDomGoldilocks
  hood_nonempty :=
    Finset.card_pos.mp (lt_of_lt_of_le (by omega : 0 < 1000) card_oodDomGoldilocks_ge)
  hood_coset := fun z hz s heq => by
    have hz64 : z ^ 64 - 1 ≠ 0 := (Finset.mem_filter.mp hz).2
    exact hz64 (by rw [← heq, cosetEval_goldilocks_pow_64 s, sub_self])
  hood_mask := fun z hz u s heq => by
    have hz64 : z ^ 64 - 1 ≠ 0 := (Finset.mem_filter.mp hz).2
    fin_cases u
    · change cosetEval binParamsGoldilocks.toSmooth.g binParamsGoldilocks.toSmooth.ω
          binParamsGoldilocks.toSmooth.d 0 s = 1 * z at heq
      rw [one_mul] at heq
      exact hz64 (by rw [← heq, cosetEval_goldilocks_pow_64 s, sub_self])
    · change cosetEval binParamsGoldilocks.toSmooth.g binParamsGoldilocks.toSmooth.ω
          binParamsGoldilocks.toSmooth.d 0 s = (8 : ZMod goldilocksP) ^ 16 * z at heq
      have hmul64 : (((8 : ZMod goldilocksP) ^ 16 * z) ^ 64) = z ^ 64 := by
        rw [mul_pow, ← pow_mul, show 16 * 64 = 64 * 16 by omega, pow_mul,
          eight_pow_64_goldilocks, one_pow, one_mul]
      exact hz64 (by rw [← hmul64, ← heq, cosetEval_goldilocks_pow_64 s, sub_self])
  hood_zerofier := fun z hz m => by
    have hz64 : z ^ 64 - 1 ≠ 0 := (Finset.mem_filter.mp hz).2
    have hz4 : z ^ 4 - 1 ≠ 0 := fun h4 => by
      have hz4_eq : z ^ 4 = 1 := sub_eq_zero.mp h4
      have h64 : z ^ 64 = (z ^ 4) ^ 16 := by ring
      exact hz64 (by rw [h64, hz4_eq, one_pow, sub_self])
    fin_cases m
    · change (Polynomial.X ^ 4 - Polynomial.C (1 : ZMod goldilocksP)).eval z ≠ 0
      simpa only [eval_sub, eval_pow, eval_X, eval_C] using hz4
    · change (Polynomial.X - Polynomial.C (1 : ZMod goldilocksP)).eval z ≠ 0
      simp only [eval_sub, eval_X, eval_C]
      intro h1
      exact hz4 (by rw [sub_eq_zero.mp h1, one_pow, sub_self])
    · change (Polynomial.X - Polynomial.C ((8 : ZMod goldilocksP) ^ 16)).eval z ≠ 0
      simp only [eval_sub, eval_X, eval_C]
      intro hw
      have hw4 : ((8 : ZMod goldilocksP) ^ 16) ^ 4 = 1 := by
        rw [← pow_mul, show 16 * 4 = 64 by omega, eight_pow_64_goldilocks]
      exact hz4 (by rw [sub_eq_zero.mp hw, hw4, sub_self])

private lemma not_satisfiable_airUnsatGoldilocks : ¬ airUnsatGoldilocks.Satisfiable := by
  rintro ⟨P, _, hdvd⟩
  have h0 : (airUnsatGoldilocks.evalMaskPoly 0 P).eval 1 = 0 := by
    obtain ⟨q, hq⟩ := hdvd 0
    have hz0 : (airUnsatGoldilocks.zerofier 0).eval 1 = 0 := by
      change (Polynomial.X ^ 4 - Polynomial.C (1 : ZMod goldilocksP)).eval 1 = 0
      simp only [eval_sub, eval_pow, eval_X, eval_C, one_pow, sub_self]
    rw [hq, eval_mul, hz0, zero_mul]
  have h1 : (airUnsatGoldilocks.evalMaskPoly 1 P).eval 1 = 0 :=
    dvd_iff_isRoot.mp (hdvd 1)
  have h2 : (airUnsatGoldilocks.evalMaskPoly 2 P).eval ((8 : ZMod goldilocksP) ^ 16) = 0 :=
    dvd_iff_isRoot.mp (hdvd 2)
  rw [airUnsatGoldilocks.eval_evalMaskPoly] at h0 h1 h2
  simp only [DeepALISystem.evalConstraintPoint, airUnsatGoldilocks, Fin.val_zero, Fin.val_one,
    Fin.val_two, map_sub, MvPolynomial.eval_X, MvPolynomial.eval_C, Option.elim'_some,
    show (1 : ℕ) ≠ 0 by omega, ↓reduceIte, one_mul, mul_one] at h0 h1 h2
  rw [sub_eq_zero.mp h1, sub_eq_zero.mp h2] at h0
  exact absurd h0 (by decide)

/-- **Checked beyond-unique-decoding Johnson-regime soundness (`< 3 / 5 < 1`) on
`airUnsatGoldilocks`** (`α = 5 / 16`, `e = 44`, `2 * 44 + 5 = 93 > 64`, `L = 7`). -/
example (adv : DeepALIProver airUnsatGoldilocks) :
    deepALIGame airUnsatGoldilocks adv true < 3 / 5 := by
  have hdim_bin : binParamsGoldilocks.dim 0 = 4 := by decide
  have hdim : airUnsatGoldilocks.params.dim 0 = 4 := by
    change binParamsGoldilocks.toSmooth.dim 0 = 4
    rw [binParamsGoldilocks.toSmooth_dim (Nat.zero_le _), hdim_bin]
  have hsqrt :
      Real.sqrt ((binParamsGoldilocks.dim 0 : ℝ) / (2 ^ binParamsGoldilocks.d : ℝ)) = 1 / 4 := by
    have hrat :
        ((binParamsGoldilocks.dim 0 : ℝ) / (2 ^ binParamsGoldilocks.d : ℝ)) = (1 / 4 : ℝ) ^ 2 := by
      norm_num [binParamsGoldilocks, FRIParams.dim]
    rw [hrat, Real.sqrt_sq (by norm_num)]
  have hceil : ⌈(5 / 16 : ℝ) * (2 ^ binParamsGoldilocks.d : ℝ)⌉₊ = 20 := by
    norm_num [binParamsGoldilocks]
  have hL : airUnsatGoldilocks.johnsonListBound (5 / 16) = 7 := by
    simp only [DeepALISystem.johnsonListBound, hdim]
    change max 1 ((64 * (⌈(5 / 16 : ℝ) * (64 : ℝ)⌉₊ - 4)) /
      (⌈(5 / 16 : ℝ) * (64 : ℝ)⌉₊ ^ 2 - 64 * 4)) = 7
    norm_num
  have hlink_deg : airUnsatGoldilocks.linkDegBound = 10 := by
    simp only [DeepALISystem.linkDegBound, hdim, Fin.sum_univ_three]
    change 1 * 5 - 1 +
      ((Polynomial.X ^ 4 - Polynomial.C (1 : ZMod goldilocksP)).natDegree +
        (Polynomial.X - Polynomial.C (1 : ZMod goldilocksP)).natDegree +
        (Polynomial.X - Polynomial.C ((8 : ZMod goldilocksP) ^ 16)).natDegree) = 10
    rw [natDegree_X_pow_sub_C, natDegree_X_sub_C, natDegree_X_sub_C]
  have hbound := deepALIGame_ofBinary_le_of_johnson_eta binParamsGoldilocks airUnsatGoldilocks rfl
    not_satisfiable_airUnsatGoldilocks (η := 1 / 16) (α := 5 / 16) (by norm_num)
    (by rw [hsqrt]; norm_num) (by norm_num)
    (by rw [hdim_bin, hceil]; omega)
    (by rw [hdim_bin, hceil]; norm_num [binParamsGoldilocks])
    adv
  dsimp only at hbound
  rw [hL, hlink_deg, ZMod.card goldilocksP] at hbound
  have hood_le : ((490 : ℕ) : ℝ≥0∞) / (airUnsatGoldilocks.oodDom.card : ℝ≥0∞) ≤
      (490 : ℝ≥0∞) / 1000 :=
    ENNReal.div_le_div_left (by exact_mod_cast card_oodDomGoldilocks_ge) _
  have herr_lt :
      friBatchJohnsonEtaCommitError binParamsGoldilocks (1 / 16) +
        (5 / 16 : ℝ) ^ binParamsGoldilocks.q < (1 : ℝ) / 50 := by
    simp only [friBatchJohnsonEtaCommitError, ZMod.card, binParamsGoldilocks, FRIParams.dim,
      goldilocksP]
    norm_num
  have hof_le :
      ENNReal.ofReal (friBatchJohnsonEtaCommitError binParamsGoldilocks (1 / 16) +
        (5 / 16 : ℝ) ^ binParamsGoldilocks.q) ≤ (1 : ℝ≥0∞) / 50 := by
    have hle := ENNReal.ofReal_le_ofReal herr_lt.le
    have hrhs : ENNReal.ofReal ((1 : ℝ) / 50) = (1 : ℝ≥0∞) / 50 := by
      rw [ENNReal.ofReal_div_of_pos (by norm_num), ENNReal.ofReal_one]
      norm_num
    rwa [hrhs] at hle
  refine lt_of_le_of_lt hbound ?_
  refine lt_of_le_of_lt (add_le_add (add_le_add le_rfl hood_le) hof_le) ?_
  have hnn : (7 : ℝ≥0) / 18446744069414584321 + 490 / 1000 + 1 / 50 < 3 / 5 := by norm_num
  simpa only [ENNReal.coe_add,
    ENNReal.coe_div (by norm_num : (18446744069414584321 : ℝ≥0) ≠ 0),
    ENNReal.coe_div (by norm_num : (1000 : ℝ≥0) ≠ 0),
    ENNReal.coe_div (by norm_num : (50 : ℝ≥0) ≠ 0),
    ENNReal.coe_div (by norm_num : (5 : ℝ≥0) ≠ 0),
    ENNReal.coe_ofNat, ENNReal.coe_one, goldilocksP,
    (by decide : 7 ^ 1 = 7), Nat.cast_ofNat] using ENNReal.coe_lt_coe.mpr hnn

