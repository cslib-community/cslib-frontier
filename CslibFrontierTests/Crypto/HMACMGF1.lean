module
-- upstream: local-only (test)

public import CslibFrontier.Crypto.Primitives.Hash.HMAC
public import CslibFrontier.Crypto.Primitives.Hash.MGF1
public meta import CslibFrontier.Crypto.Primitives.Hash.HMAC
public meta import CslibFrontier.Crypto.Primitives.Hash.MGF1

/-!
# HMAC and MGF1 boundary clients

HMAC test cases 1 and 6 are copied from RFC 4231, Sections 4.2 and 4.7. They exercise the
short-key padding and long-key hashing branches for both SHA-256 and SHA-512. The exact-block-key
fixtures independently cover the remaining preprocessing branch. [RFC4231]

The MGF1 fixtures were independently computed from RFC 8017, Appendix B.2.1. They cover empty
output, both sides of each digest boundary, the inclusive output-length bound, and the final
four-byte counter `0xffffffff`.
-/

-- This module checks the exported HMAC and MGF1 APIs and exports no test fixtures.
set_option linter.privateModule false

public section

namespace HMACMGF1Tests

open Cslib.Crypto Cslib.Crypto.HMAC Cslib.Crypto.MGF1

set_option linter.hashCommand false

private def case1Key : List Byte := List.replicate 20 0x0b

private def case1Text : List Byte :=
  [0x48, 0x69, 0x20, 0x54, 0x68, 0x65, 0x72, 0x65]

private def case1SHA256 : List Byte :=
  [0xb0, 0x34, 0x4c, 0x61, 0xd8, 0xdb, 0x38, 0x53,
    0x5c, 0xa8, 0xaf, 0xce, 0xaf, 0x0b, 0xf1, 0x2b,
    0x88, 0x1d, 0xc2, 0x00, 0xc9, 0x83, 0x3d, 0xa7,
    0x26, 0xe9, 0x37, 0x6c, 0x2e, 0x32, 0xcf, 0xf7]

private def case1SHA512 : List Byte :=
  [0x87, 0xaa, 0x7c, 0xde, 0xa5, 0xef, 0x61, 0x9d,
    0x4f, 0xf0, 0xb4, 0x24, 0x1a, 0x1d, 0x6c, 0xb0,
    0x23, 0x79, 0xf4, 0xe2, 0xce, 0x4e, 0xc2, 0x78,
    0x7a, 0xd0, 0xb3, 0x05, 0x45, 0xe1, 0x7c, 0xde,
    0xda, 0xa8, 0x33, 0xb7, 0xd6, 0xb8, 0xa7, 0x02,
    0x03, 0x8b, 0x27, 0x4e, 0xae, 0xa3, 0xf4, 0xe4,
    0xbe, 0x9d, 0x91, 0x4e, 0xeb, 0x61, 0xf1, 0x70,
    0x2e, 0x69, 0x6c, 0x20, 0x3a, 0x12, 0x68, 0x54]

private def sampleInnerDigest : FixedBytes 32 := fun i =>
  ⟨i.val % 256, Nat.mod_lt _ (by decide)⟩

-- The padded key block precedes the payload on both HMAC passes, with the selected pad XORed
-- bytewise before concatenation. For case 1, `0x0b xor 0x36 = 0x3d` and
-- `0x0b xor 0x5c = 0x57`; the zero-padded tail therefore remains the pad byte itself.
#guard input (sha256KeyBlock case1Key case1Text (by decide)) 0x36 case1Text ==
  List.replicate 20 0x3d ++ List.replicate 44 0x36 ++ case1Text
#guard input (sha256KeyBlock case1Key case1Text (by decide)) 0x5c sampleInnerDigest.toList ==
  List.replicate 20 0x57 ++ List.replicate 44 0x5c ++ sampleInnerDigest.toList

#guard (hmacSHA256 case1Key case1Text (by decide)).toList == case1SHA256
#guard (hmacSHA512 case1Key case1Text (by decide)).toList == case1SHA512

