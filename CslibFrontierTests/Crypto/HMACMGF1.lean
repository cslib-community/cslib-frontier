#guard (mgf1SHA512 mgfSeed 63 (by decide)).toList == mgfSHA512Length65.take 63
#guard (mgf1SHA512 mgfSeed 64 (by decide)).toList == mgfSHA512Length65.take 64
#guard (mgf1SHA512 mgfSeed 65 (by decide)).toList == mgfSHA512Length65

private def finalCounter : Fin (2 ^ 32) :=
  ⟨2 ^ 32 - 1, Nat.sub_lt (Nat.two_pow_pos 32) Nat.one_pos⟩

private def finalCounterSHA256 : List Byte :=
  [0xc2, 0x6c, 0x93, 0xe0, 0x68, 0xad, 0xb7, 0xef,
    0xff, 0x80, 0xf0, 0x51, 0x79, 0xc6, 0xae, 0x31,
    0x11, 0xd9, 0xa4, 0x4b, 0xf5, 0x17, 0xea, 0x3b,
    0xf0, 0x63, 0xcf, 0xc7, 0x80, 0x8d, 0x45, 0x53]

private def finalCounterSHA512 : List Byte :=
  [0x71, 0xa7, 0xb4, 0x93, 0x86, 0x40, 0x5e, 0x1f,
    0x4c, 0x36, 0xfe, 0x9a, 0xc1, 0xe6, 0xaa, 0x0e,
    0x65, 0x18, 0x5b, 0x57, 0x5c, 0x51, 0xae, 0xc1,
