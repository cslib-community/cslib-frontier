    0x48, 0x53, 0xf8, 0x86, 0x8c, 0xc0, 0x59, 0xd8,
    0x88]

private def mgfSHA512Length65 : List Byte :=
  [0xa8, 0x5b, 0xab, 0x9a, 0x26, 0x62, 0x03, 0x0c,
    0xd5, 0x3f, 0x2f, 0x98, 0xd6, 0x17, 0xc3, 0xaf,
