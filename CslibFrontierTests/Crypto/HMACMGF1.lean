#guard (hmacSHA512 case6Key case6Text (by decide)).toList == case6SHA512

private def byteSequence (length : ℕ) : List Byte :=
  (List.range length).map fun value => ⟨value % 256, Nat.mod_lt _ (by decide)⟩

private def exactKeyText : List Byte := [0x00, 0xff, 0x10, 0x20, 0x30, 0x40, 0x50]

private def exact64SHA256 : List Byte :=
  [0x3d, 0x82, 0xf5, 0x87, 0xe5, 0x5d, 0x21, 0x23,
    0xc8, 0xe2, 0x4d, 0x8a, 0x92, 0x7f, 0x3f, 0x4d,
    0x71, 0x1c, 0x40, 0xe7, 0x50, 0x30, 0x77, 0x20,
    0xfb, 0x3b, 0x9b, 0x7a, 0x95, 0xad, 0x48, 0x42]

private def exact128SHA512 : List Byte :=
  [0xb4, 0xcc, 0x99, 0x76, 0xf2, 0xa8, 0xa0, 0x50,
    0x63, 0xf3, 0x91, 0x6e, 0x2e, 0x86, 0xb2, 0x3c,
    0x5c, 0x71, 0xf6, 0xd8, 0x6f, 0x81, 0xb4, 0x82,
    0x67, 0x6a, 0x82, 0x55, 0x7e, 0xd6, 0x0a, 0x79,
