/-!
# Regular and context-free languages are not identifiable from text

Gold's theorem [Gold1967] applied to Mathlib's classes of formal languages: over a countable
nonempty alphabet, neither the regular languages (`Language.IsRegular`) nor the context-free
languages (`Language.IsContextFree`) are identifiable in the limit from text, since each class
contains every finite language and an infinite one. By contrast the class of finite languages is
identifiable (`Cslib.MachineLearning.InductiveInference.identifiable_setOf_finite`), so the
obstruction is the infinite language together with its finite subsets.

## Main results

* `Cslib.MachineLearning.InductiveInference.not_identifiable_isRegular`: the regular languages
  are not identifiable from text.
* `Cslib.MachineLearning.InductiveInference.not_identifiable_isContextFree`: the context-free
  languages are not identifiable from text.

## Implementation notes

Languages over `T` are taken as sets of words `Set (List T)`, the type of the general theory;
Mathlib's `Language T` is a definition over the same type, and the classes are written with a
type ascription to it. The alphabet is any countable nonempty type, which includes Gold's finite
alphabets; countability is what makes every language have a text.

## References

* [Gold1967]
-/

public section

namespace Cslib.MachineLearning.InductiveInference

variable {T : Type*} [Countable T] [Nonempty T]

/-- The regular languages over a countable nonempty alphabet are not identifiable in the limit from
text [Gold1967] (locator not verified): they contain every finite language and the infinite
language of all words. -/
theorem not_identifiable_isRegular :
    ¬Identifiable {L : Set (List T) | Language.IsRegular (L : Language T)} :=
  not_identifiable_of_finite_subsets (L := Set.univ) Cslib.Language.IsRegular.top
    Set.infinite_univ fun _ _ hS => Cslib.Language.IsRegular.of_finite hS

/-- The context-free languages over a countable nonempty alphabet are not identifiable in the limit
from text [Gold1967] (locator not verified): they contain every finite language and an infinite
one, generated by the rules `S → ε` and `S → a S` for a letter `a`. -/
theorem not_identifiable_isContextFree :
    ¬Identifiable {L : Set (List T) | Language.IsContextFree (L : Language T)} := by
  classical
  obtain ⟨a⟩ := ‹Nonempty T›
  let g : ContextFreeGrammar T :=
    ⟨Unit, (), {⟨(), []⟩, ⟨(), [.terminal a, .nonterminal ()]⟩}⟩
  have hmem : ∀ n, List.replicate n a ∈ g.language := fun n => by
    rw [ContextFreeGrammar.mem_language_iff]
    induction n with
    | zero =>
      exact ContextFreeGrammar.Produces.single
        (ContextFreeGrammar.produces_nonterminal_iff.mpr ⟨⟨(), []⟩, by simp [g], rfl, rfl⟩)
    | succ n ih =>
      have hstep : g.Derives [.nonterminal ()] ([.terminal a] ++ [.nonterminal ()]) :=
        ContextFreeGrammar.Produces.single
          (ContextFreeGrammar.produces_nonterminal_iff.mpr
            ⟨⟨(), [.terminal a, .nonterminal ()]⟩, by simp [g], rfl, rfl⟩)
      simpa [List.replicate_succ] using hstep.trans (ih.append_left [.terminal a])
  exact not_identifiable_of_finite_subsets (L := (g.language : Set (List T))) ⟨g, rfl⟩
    (Set.infinite_of_injective_forall_mem (List.replicate_left_injective a) hmem)
    fun _ _ hS => Language.IsContextFree.of_finite hS

end Cslib.MachineLearning.InductiveInference
