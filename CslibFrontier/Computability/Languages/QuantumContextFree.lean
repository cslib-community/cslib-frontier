/-!
# Quantum context-free languages

A Moore–Crutchfield grammar assigns a complex weight to each production in each of
finitely many channels. The contribution of a derivation in a channel is the product
of its production weights. Those contributions add coherently within a channel. The
score of a word is the sum of squared norms over all channels.

Leftmost derivations count each derivation tree once, as in the correspondence between
Greibach-normal-form derivations and pushdown paths in [MooreCrutchfield2000, §3.2,
arXiv:quant-ph/9707031v1]. Cyclic grammars may have infinitely many derivations of
a fixed word. We require summability of the contributions for each word and channel
so that their sum is independent of enumeration. For an ordinary language the
grammar must generate its characteristic function, following the convention of
[MooreCrutchfield2000, §§2 and 3.6].

## Main definitions

* `ContextFreeRule.rewriteLeftmost`: apply a rule only at the first nonterminal.
* `Cslib.Language.QuantumContextFreeGrammar`: an ordinary grammar with complex weights.
* `Cslib.Language.QuantumContextFreeGrammar.score`: the sum of squared channel amplitudes.
* `Cslib.Language.IsQuantumContextFree`: the exact Boolean language class QCFL.
-/

public section

namespace ContextFreeRule

variable {T N : Type*} [DecidableEq N]

/-- Apply a production to the first nonterminal, if it matches the rule's input. -/
@[expose] def rewriteLeftmost (r : ContextFreeRule T N) :
    List (Symbol T N) → Option (List (Symbol T N))
  | [] => none
  | .terminal a :: rest => (r.rewriteLeftmost rest).map (.terminal a :: ·)
  | .nonterminal n :: rest => if n = r.input then some (r.output ++ rest) else none

/-- Leftmost rewriting is a valid application in the ordinary context-free grammar. -/
theorem rewrites_of_rewriteLeftmost_eq_some {r : ContextFreeRule T N}
    {u v : List (Symbol T N)} (h : r.rewriteLeftmost u = some v) : r.Rewrites u v := by
  induction u generalizing v with
  | nil => simp [rewriteLeftmost] at h
  | cons head tail ih =>
    cases head with
    | terminal a =>
      simp only [rewriteLeftmost, Option.map_eq_some_iff] at h
      obtain ⟨next, hn, rfl⟩ := h
      exact .cons (.terminal a) (ih hn)
    | nonterminal n =>
      simp only [rewriteLeftmost] at h
      split at h
      · next hn =>
        subst n
        exact Option.some.inj h ▸ .head tail
      · contradiction

end ContextFreeRule

namespace Cslib.Language

/-- A context-free grammar with a finite vector of amplitudes per rule. -/
structure QuantumContextFreeGrammar (T : Type*) where
  /-- The underlying finite rule set and initial nonterminal. -/
  grammar : ContextFreeGrammar T
  finiteNonterminals : Finite grammar.NT
  /-- The number of channels, whose final squared norms are added. -/
  channels : ℕ
  channels_pos : 0 < channels
  /-- A complex weight for each channel and production. -/
  weight : Fin channels → grammar.rules → ℂ

namespace QuantumContextFreeGrammar

variable {T : Type*} (G : QuantumContextFreeGrammar T)

/-- Replay a list of rules from the initial nonterminal, always rewriting leftmost. -/
@[expose] noncomputable def replay (steps : List G.grammar.rules) :
    Option (List (Symbol T G.grammar.NT)) :=
  letI := Classical.decEq G.grammar.NT
  steps.foldl (fun current r => current.bind r.val.rewriteLeftmost)
    (some [.nonterminal G.grammar.initial])

/-- The amplitude contributed by this sequence to the specified terminal word. -/
@[expose] noncomputable def contribution (i : Fin G.channels) (w : List T)
    (steps : List G.grammar.rules) : ℂ := by
  classical
  exact if G.replay steps = some (w.map Symbol.terminal) then (steps.map (G.weight i)).prod else 0

/-- The channel amplitude is the sum of all leftmost derivation contributions. -/
@[expose] noncomputable def amplitude (i : Fin G.channels) (w : List T) : ℂ :=
  ∑' steps, G.contribution i w steps

/-- The generated score sums the squared channel amplitudes without mixing the channels. -/
@[expose] noncomputable def score (w : List T) : ℝ :=
  ∑ i, ‖G.amplitude i w‖ ^ 2

end QuantumContextFreeGrammar

/-- An ordinary language is QCFL when its characteristic function is generated by a quantum
context-free grammar whose derivation contributions are summable. -/
@[expose] def IsQuantumContextFree {T : Type*} (L : Language T) : Prop :=
  Finite T ∧ ∃ G : QuantumContextFreeGrammar T,
    (∀ i w, Summable (G.contribution i w)) ∧
    (∀ w ∈ L, G.score w = 1) ∧
    (∀ w ∉ L, G.score w = 0)

end Cslib.Language
