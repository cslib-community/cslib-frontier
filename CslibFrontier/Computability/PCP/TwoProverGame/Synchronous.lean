namespace Cslib.PCP.CommutingStrategy

variable {X A 𝒜 : Type*} [Fintype A]

section Ring

variable [Ring 𝒜] [PartialOrder 𝒜] [Algebra ℂ 𝒜]

/-- Identical questions in a synchronous strategy have zero off-diagonal probabilities. -/
@[expose] def IsSynchronous (S : CommutingStrategy X X A A 𝒜) : Prop :=
  ∀ x a b, a ≠ b → S.prob x x a b = 0

/-- Physically swapping the players preserves synchrony. -/
@[simp] theorem isSynchronous_swap_iff (S : CommutingStrategy X X A A 𝒜) :
    S.swap.IsSynchronous ↔ S.IsSynchronous := by
  simp only [IsSynchronous, prob_swap]
  exact ⟨fun h x a b hab => h x b a hab.symm, fun h x a b hab => h x b a hab.symm⟩

/-- In a synchronous strategy, Alice's marginal on a repeated question is its diagonal entry. -/
theorem IsSynchronous.sum_prob_eq_diag {S : CommutingStrategy X X A A 𝒜}
    (h : S.IsSynchronous) (x : X) (a : A) :
    ∑ b, S.prob x x a b = S.prob x x a a := by
  classical
  exact sum_eq_single a (fun b _ hb => h x a b (Ne.symm hb)) fun ha => (ha (mem_univ _)).elim

end Ring

section Agreement

variable [Ring 𝒜] [StarRing 𝒜] [PartialOrder 𝒜] [StarOrderedRing 𝒜] [Algebra ℂ 𝒜]
  [TopologicalSpace 𝒜] [ContinuousFunctionalCalculus ℝ 𝒜 IsSelfAdjoint]
  [NonnegSpectrumClass ℝ 𝒜] [StarModule ℂ 𝒜] [SelfAdjointDecompose 𝒜]
  {S : CommutingStrategy X X A A 𝒜}

/-- The matching effects of a synchronous strategy agree in the shared state. -/
theorem IsSynchronous.norm_effect_sub_eq_zero (h : S.IsSynchronous) (x : X) (a : A) :
    S.state.norm ((S.alice x).effect a - (S.bob x).effect a) = 0 := by
  have hsum : Measurement.agreement S.state (S.alice x) (S.bob x) = 1 := by
    change ∑ b, S.prob x x b b = 1
    exact (sum_congr rfl fun b _ => (h.sum_prob_eq_diag x b).symm).trans (S.sum_prob x x)
  have hle := Measurement.sum_norm_sub_sq_le S.state (S.alice x) (S.bob x)
    (fun b => S.commute x x b b)
  rw [hsum] at hle
  have ha := (single_le_sum (fun b _ => sq_nonneg
    (S.state.norm ((S.alice x).effect b - (S.bob x).effect b))) (mem_univ a)).trans hle
  have hn := S.state.norm_nonneg ((S.alice x).effect a - (S.bob x).effect a)
  exact le_antisymm ((sq_le_sq₀ hn le_rfl).mp (by linarith only [ha])) hn

/-- A synchronous correlation is exactly the state of the product of Alice's two
effects, as a complex number. -/
theorem IsSynchronous.ofReal_prob_eq_state_alice (h : S.IsSynchronous) (x y : X) (a b : A) :
    (S.prob x y a b : ℂ) = S.state ((S.alice x).effect a * (S.alice y).effect b) := by
  have he : (S.alice y).effect b ≈[S.state; 0] (S.bob y).effect b :=
    (h.norm_effect_sub_eq_zero y b).le
  rw [S.state.apply_mul_eq_of_approx_zero he ((S.alice x).effect a)]
  exact S.state.ofReal_re_apply (S.effect_mul_effect_nonneg x y a b)

/-- Bob's product gives the same correlation with the factors in reverse order. -/
theorem IsSynchronous.ofReal_prob_eq_state_bob (h : S.IsSynchronous) (x y : X) (a b : A) :
    (S.prob x y a b : ℂ) = S.state ((S.bob y).effect b * (S.bob x).effect a) := by
  have he := ((isSynchronous_swap_iff S).mpr h).ofReal_prob_eq_state_alice y x b a
  rwa [prob_swap] at he

end Agreement

section Trace

variable [CStarAlgebra 𝒜] [PartialOrder 𝒜]
  (S : CommutingStrategy X X A A 𝒜)

/-- The norm-closed unital star subalgebra generated by Alice's effects.
For Bob's algebra, exchange the two players. -/
def aliceAlgebra : StarSubalgebra ℂ 𝒜 :=
  (StarAlgebra.adjoin ℂ (Set.range fun p : X × A => (S.alice p.1).effect p.2)).topologicalClosure

/-- Alice's generated algebra is closed in the operator norm. -/
theorem isClosed_aliceAlgebra : IsClosed (S.aliceAlgebra : Set 𝒜) :=
  StarSubalgebra.isClosed_topologicalClosure _

noncomputable instance : CStarAlgebra S.aliceAlgebra :=
  StarSubalgebra.cstarAlgebra _ (h_closed := S.isClosed_aliceAlgebra)

instance [StarOrderedRing 𝒜] : StarOrderedRing S.aliceAlgebra :=
  let _ := S.isClosed_aliceAlgebra
  Subtype.starOrderedRing (𝕜 := ℂ) S.aliceAlgebra

/-- Every closed star subalgebra containing Alice's effects contains her generated algebra. -/
theorem aliceAlgebra_le {D : StarSubalgebra ℂ 𝒜} (hD : IsClosed (D : Set 𝒜))
    (he : ∀ x a, (S.alice x).effect a ∈ D) : S.aliceAlgebra ≤ D := by
  apply StarSubalgebra.topologicalClosure_minimal _ hD
  exact StarAlgebra.adjoin_le (by rintro _ ⟨⟨x, a⟩, rfl⟩; exact he x a)

/-- Alice's effects belong to the generated algebra. -/
theorem alice_effect_mem_aliceAlgebra (x : X) (a : A) :
    (S.alice x).effect a ∈ S.aliceAlgebra :=
  StarSubalgebra.le_topologicalClosure _ (StarAlgebra.subset_adjoin ℂ _ ⟨(x, a), rfl⟩)

/-- The shared state restricted to Alice's generated algebra. -/
def aliceState : AlgState S.aliceAlgebra where
  toFun x := S.state x.val
  map_add' _ _ := S.state.map_add' _ _
  map_smul' _ _ := S.state.map_smul' _ _
  monotone' _ _ h := S.state.apply_mono h
  map_one' := S.state.map_one

/-- The restricted state evaluates an element by applying the original state. -/
@[simp] theorem aliceState_apply (x : S.aliceAlgebra) : S.aliceState x = S.state x.val := by
  rfl

/-- Alice's measurements viewed in the algebra they generate. -/
def aliceMeasurements (x : X) : Measurement A S.aliceAlgebra where
  effect a := ⟨(S.alice x).effect a, S.alice_effect_mem_aliceAlgebra x a⟩
  nonneg a := (S.alice x).nonneg a
  sum_effect := by
    apply Subtype.ext
    change S.aliceAlgebra.subtype (∑ a, _) = S.aliceAlgebra.subtype 1
    rw [map_sum, map_one]
    exact (S.alice x).sum_effect

@[simp] theorem aliceMeasurements_effect (x : X) (a : A) :
    ((S.aliceMeasurements x).effect a : 𝒜) = (S.alice x).effect a := by
  rfl

variable [StarOrderedRing 𝒜]

/-- The state is tracial on the norm-closed algebra generated by the effects of a player
in a synchronous commuting strategy. -/
private theorem IsSynchronous.tracial_on_aliceAlgebra {S : CommutingStrategy X X A A 𝒜}
    (h : S.IsSynchronous) {u v : 𝒜} (hu : u ∈ S.aliceAlgebra) (hv : v ∈ S.aliceAlgebra) :
    S.state (u * v) = S.state (v * u) := by
  let L (p : X × A) := (S.alice p.1).effect p.2
  let R (p : X × A) := (S.bob p.1).effect p.2
  let G := S.aliceAlgebra
  have hL (p : X × A) : IsSelfAdjoint (L p) := ((S.alice p.1).nonneg p.2).isSelfAdjoint
  have hR (p : X × A) : IsSelfAdjoint (R p) := ((S.bob p.1).nonneg p.2).isSelfAdjoint
  have hcomm : G ≤ StarSubalgebra.centralizer ℂ (Set.range R) := by
    apply StarSubalgebra.topologicalClosure_minimal
    · apply StarAlgebra.adjoin_le
      rintro _ ⟨p, rfl⟩
      change L p ∈ StarSubalgebra.centralizer ℂ (Set.range R)
      rw [StarSubalgebra.mem_centralizer_iff]
      rintro _ ⟨q, rfl⟩
      rw [(hR q).star_eq]
      exact ⟨(S.commute p.1 q.1 p.2 q.2).symm.eq, (S.commute p.1 q.1 p.2 q.2).symm.eq⟩
    · rw [StarSubalgebra.coe_centralizer]
      exact Set.isClosed_centralizer _
  have hgen (p : X × A) (z : 𝒜) (hz : z ∈ G) :
      S.state (L p * z) = S.state (z * L p) := by
    have hm : S.state.norm (L p - R p) = 0 := h.norm_effect_sub_eq_zero p.1 p.2
    have hleft := S.state.norm_apply_star_mul_le (L p - R p) z
    rw [star_sub, (hL p).star_eq, (hR p).star_eq, hm, zero_mul, norm_le_zero_iff,
      sub_mul, map_sub, sub_eq_zero] at hleft
    have hz' : z ∈ StarSubalgebra.centralizer ℂ (Set.range R) := hcomm hz
    have hc := ((StarSubalgebra.mem_centralizer_iff ℂ).mp hz' (R p) ⟨p, rfl⟩).1
    exact hleft.trans ((congrArg S.state hc).trans
      (S.state.apply_mul_eq_of_approx_zero hm.le z).symm)
  have hadjoin (w : 𝒜) (hw : w ∈ StarAlgebra.adjoin ℂ (Set.range L)) :
      ∀ z ∈ G, S.state (w * z) = S.state (z * w) := by
    change w ∈ Algebra.adjoin ℂ (Set.range L ∪ star (Set.range L)) at hw
    induction hw using Algebra.adjoin_induction with
    | mem t ht =>
      rcases ht with ⟨p, rfl⟩ | ⟨p, hp⟩
      · exact hgen p
      · rw [← star_star t, ← hp, (hL p).star_eq]
        exact hgen p
    | algebraMap r => intro z _; rw [Algebra.commutes]
    | add x y _ _ hx hy =>
      intro z hz
      rw [add_mul, mul_add, map_add, map_add, hx z hz, hy z hz]
    | mul x y hx hy hx' hy' =>
      intro z hz
      have hxy : x ∈ G := StarSubalgebra.le_topologicalClosure _ hx
      have hyz : y ∈ G := StarSubalgebra.le_topologicalClosure _ hy
      rw [mul_assoc, hx' (y * z) (mul_mem hyz hz), mul_assoc y z x,
        hy' (z * x) (mul_mem hz hxy), ← mul_assoc z x y]
  have hcont : Continuous S.state := map_continuous S.state
  have hclosed : IsClosed {w : 𝒜 | S.state (w * v) = S.state (v * w)} :=
    isClosed_eq (hcont.comp (continuous_id.mul continuous_const))
      (hcont.comp (continuous_const.mul continuous_id))
  exact closure_minimal (fun w hw => hadjoin w hw v hv) hclosed hu

/-- The shared state restricts to a tracial state on Alice's generated algebra. -/
theorem IsSynchronous.aliceState_isTracial {S : CommutingStrategy X X A A 𝒜}
    (h : S.IsSynchronous) : S.aliceState.IsTracial :=
  fun x y => h.tracial_on_aliceAlgebra x.property y.property

/-- A synchronous correlation is invariant under exchanging the questions and answers. -/
theorem IsSynchronous.prob_comm {S : CommutingStrategy X X A A 𝒜}
    (h : S.IsSynchronous) (x y : X) (a b : A) :
    S.prob x y a b = S.prob y x b a := by
  apply Complex.ofReal_injective
  rw [h.ofReal_prob_eq_state_alice, h.ofReal_prob_eq_state_alice]
  exact h.tracial_on_aliceAlgebra (S.alice_effect_mem_aliceAlgebra x a)
    (S.alice_effect_mem_aliceAlgebra y b)

/-- The restricted trace evaluates the products of Alice's measurements to the correlations. -/
theorem IsSynchronous.ofReal_prob_eq_aliceState {S : CommutingStrategy X X A A 𝒜}
    (h : S.IsSynchronous) (x y : X) (a b : A) :
    (S.prob x y a b : ℂ) = S.aliceState
      ((S.aliceMeasurements x).effect a * (S.aliceMeasurements y).effect b) := by
  rw [S.aliceState_apply]
  change (S.prob x y a b : ℂ) = S.state (S.aliceAlgebra.subtype (_ * _))
  rw [map_mul]
  simpa only [StarSubalgebra.subtype_apply, aliceMeasurements_effect] using
    h.ofReal_prob_eq_state_alice x y a b

/-- A projective synchronous strategy has a tracial representation by projective
measurements in Alice's generated algebra. -/
theorem IsSynchronous.exists_aliceState_projective {S : CommutingStrategy X X A A 𝒜}
    (h : S.IsSynchronous) (hP : ∀ x, (S.alice x).IsProjective) :
    ∃ P : X → Measurement A S.aliceAlgebra,
      (∀ x, (P x).IsProjective) ∧
      ∀ x y a b, (S.prob x y a b : ℂ) = S.aliceState ((P x).effect a * (P y).effect b) := by
  refine ⟨S.aliceMeasurements, fun x a => ?_, h.ofReal_prob_eq_aliceState⟩
  apply Subtype.ext
  change S.aliceAlgebra.subtype (_ * _) = _
  rw [map_mul]
  simpa only [StarSubalgebra.subtype_apply, aliceMeasurements_effect] using hP x a

end Trace

section Converse

open MulOpposite

private noncomputable def unitVectorState
    {H : Type*} [NormedAddCommGroup H] [InnerProductSpace ℂ H]
    (ξ : H) (hξ : ‖ξ‖ = 1) : AlgState (H →L[ℂ] H) where
  toFun T := inner ℂ ξ (T ξ)
  map_add' T R := by simp [inner_add_right]
  map_smul' c T := by simp [inner_smul_right]
  monotone' T R h := by
    exact sub_nonneg.mp (by
      simpa only [sub_apply, inner_sub_right] using
        (ContinuousLinearMap.nonneg_iff_isPositive.mp (sub_nonneg.mpr h)).inner_nonneg_right ξ)
  map_one' := by simp [inner_self_eq_norm_sq_to_K, hξ]

variable [CStarAlgebra 𝒜] [PartialOrder 𝒜] [StarOrderedRing 𝒜]
  (τ : AlgState 𝒜) (hτ : τ.IsTracial) (P : X → Measurement A 𝒜)

/-- A measurement family in a tracial C*-algebra gives a commuting strategy on the
GNS space. Alice uses left multiplication and Bob uses right multiplication by
the same effects. -/
noncomputable def ofTracial :
    CommutingStrategy X X A A (τ.toPositiveLinearMap.GNS →L[ℂ] τ.toPositiveLinearMap.GNS) where
  state := unitVectorState (τ.toPreGNS 1) (by
    rw [UniformSpace.Completion.norm_coe]
    change τ.norm 1 = 1
    simp [AlgState.norm_eq_sqrt])
  alice x :=
    { effect := fun a => τ.toPositiveLinearMap.gnsStarAlgHom ((P x).effect a)
      nonneg a := map_nonneg (τ.toPositiveLinearMap.gnsStarAlgHom) ((P x).nonneg a)
      sum_effect := by rw [← map_sum, (P x).sum_effect, map_one] }
  bob x :=
    { effect := fun a => τ.gnsRight hτ (op ((P x).effect a))
      nonneg a := map_nonneg (τ.gnsRight hτ)
        (show 0 ≤ op ((P x).effect a) from (P x).nonneg a)
      sum_effect := by
        rw [← map_sum, ← op_sum, (P x).sum_effect, op_one, map_one] }
  commute x y a b := τ.commute_gnsLeft_gnsRight hτ ((P x).effect a) ((P y).effect b)

/-- Alice's effect in the tracial realization acts by left multiplication. -/
theorem ofTracial_alice_effect (x : X) (a : A) :
    ((ofTracial τ hτ P).alice x).effect a =
      τ.toPositiveLinearMap.gnsStarAlgHom ((P x).effect a) := by
  rfl

/-- The state in the tracial realization is the vector state of the unit element. -/
theorem ofTracial_state_apply (T : τ.toPositiveLinearMap.GNS →L[ℂ] τ.toPositiveLinearMap.GNS) :
    (ofTracial τ hτ P).state T =
      inner ℂ (τ.toPreGNS 1 : τ.toPositiveLinearMap.GNS) (T (τ.toPreGNS 1)) := by
  rfl

/-- The GNS strategy realizes the full complex trace of the product of the effects. -/
theorem ofTracial_prob (x y : X) (a b : A) :
    ((ofTracial τ hτ P).prob x y a b : ℂ) = τ ((P x).effect a * (P y).effect b) := by
  refine ((ofTracial τ hτ P).state.ofReal_re_apply
    ((ofTracial τ hτ P).effect_mul_effect_nonneg x y a b)).trans ?_
  rw [ofTracial_state_apply]
  change
    inner ℂ (τ.toPreGNS 1 : τ.toPositiveLinearMap.GNS)
      (τ.toPositiveLinearMap.gnsStarAlgHom ((P x).effect a)
        (τ.gnsRight hτ (op ((P y).effect b)) (τ.toPreGNS 1))) = _
  rw [τ.gnsRight_toPreGNS, τ.gnsStarAlgHom_toPreGNS, one_mul,
    UniformSpace.Completion.inner_coe, τ.inner_toPreGNS, star_one, one_mul]

/-- Left and right multiplication preserve projective measurements. -/
theorem ofTracial_isProjective (hP : ∀ x, (P x).IsProjective) (x : X) :
    ((ofTracial τ hτ P).alice x).IsProjective ∧ ((ofTracial τ hτ P).bob x).IsProjective := by
  refine ⟨fun a => ?_, fun a => ?_⟩
  · simpa only [ofTracial, ← map_mul] using congrArg τ.toPositiveLinearMap.gnsStarAlgHom (hP x a)
  · simpa only [ofTracial, Function.comp_apply, ← map_mul, ← op_mul] using
      congrArg (τ.gnsRight hτ ∘ op) (hP x a)

/-- The GNS strategy answers synchronously because distinct effects of each
projective measurement are orthogonal. -/
theorem ofTracial_isSynchronous (hP : ∀ x, (P x).IsProjective) :
    (ofTracial τ hτ P).IsSynchronous := by
  intro x a b hab
  apply Complex.ofReal_injective
  rw [ofTracial_prob, (hP x).mul_eq_zero hab, map_zero, Complex.ofReal_zero]

end Converse

end Cslib.PCP.CommutingStrategy
