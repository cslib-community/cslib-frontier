/-!
# Decoding arbitrary axis answers

Use the selected coordinate itself as the line parameter, with the other
coordinates fixed. This makes the decoded line measurement invariant under
resampling the selected coordinate. Its value at the original point agrees
with any accepted point answer.

## Main results

* `Cslib.PCP.LowIndividualDegree.axisPointDisagreement_le`: average loss of
  the decoded point and line answers in the point-first role assignment.
-/

public section

namespace Cslib.PCP.LowIndividualDegree

open Cslib.Quantum Finset Function MvPolynomial
open scoped BigOperators

variable {F A : Type*} {n : ℕ} [Field F] [Fintype F] [DecidableEq F]

/-- The point on the chosen axis whose selected coordinate is zero. -/
def axisOrigin (u : Point F (n + 1)) (i : Fin (n + 1)) : Point F (n + 1) :=
  update u i 0

omit [Fintype F] [DecidableEq F] in
theorem update_eq_axisAffine (u : Point F (n + 1)) (i : Fin (n + 1)) (t : F) :
    update u i t = axisOrigin u i + t • Pi.single i (1 : F) := by
  ext j
  by_cases h : j = i
  · subst j
    simp [axisOrigin]
  · simp [axisOrigin, update_of_ne h, Pi.single_eq_of_ne h]

/-- The line generated by the selected coordinate through the given point. -/
def coordinateLine (u : Point F (n + 1)) (i : Fin (n + 1)) : Finset (Point F (n + 1)) :=
  linePoints (axisOrigin u i) (Pi.single i 1)

theorem coordinateLine_eq (u : Point F (n + 1)) (i : Fin (n + 1)) :
    coordinateLine u i = linePoints u (Pi.single i 1) := by
  have he : u = axisOrigin u i + u i • Pi.single i (1 : F) :=
    (update_eq_self i u).symm.trans (update_eq_axisAffine u i (u i))
  conv_rhs => rw [he]
  exact (linePoints_translate_direction _ _ _).symm

/-- Decode the axis answer as a polynomial function of the selected coordinate. -/
noncomputable def decodeCoordinate (d : ℕ) (u : Point F (n + 1)) (i : Fin (n + 1))
    (a : Answer F (n + 1)) : PolynomialFunction F d :=
  decodeAffinePolynomial d (axisOrigin u i) (Pi.single i 1) a

/-- Acceptance of an axis and point answer forces agreement at the point's coordinate. -/
theorem decodeCoordinate_agrees {d : ℕ} (u : Point F (n + 1)) (i : Fin (n + 1))
    {a b : Answer F (n + 1)}
    (h : accepts d (.axis (coordinateLine u i)) (.point u) a b) :
    (decodeCoordinate d u i a).value (u i) = decodePoint b := by
  rw [decodeCoordinate, PolynomialFunction.value_eq_eval]
  have he : axisOrigin u i + u i • Pi.single i (1 : F) = u :=
    (update_eq_axisAffine u i (u i)).symm.trans (update_eq_self i u)
  exact decodeAffinePolynomial_agrees _ _ (u i) (fun _ => u i)
    (by simpa only [he, coordinateLine] using h) rfl

/-- The decoder uses the same line parametrization at every point on the coordinate line. -/
theorem decodeCoordinate_update (d : ℕ) (u : Point F (n + 1)) (i : Fin (n + 1)) (t : F) :
    decodeCoordinate d (update u i t) i = decodeCoordinate d u i := by
  funext a
  unfold decodeCoordinate axisOrigin
  rw [update_idem]

/-- The restriction of a bounded polynomial to the line in the selected coordinate. -/
noncomputable def axisRestriction {d : ℕ} (u : Point F (n + 1)) (i : Fin (n + 1))
    (g : BoundedPolynomial F (n + 1) d) : PolynomialFunction F d :=
  .ofPolynomial (evalCoordinate u i g.val)
    ((natDegree_evalCoordinate_le u i g.val).trans (g.prop i))

/-- The line parameter is the updated coordinate of the ambient point. -/
theorem value_axisRestriction {d : ℕ} (u : Point F (n + 1)) (i : Fin (n + 1))
    (g : BoundedPolynomial F (n + 1) d) (a : F) :
    (axisRestriction u i g).value a = eval (update u i a) g.val := by
  rw [axisRestriction, PolynomialFunction.value_eq_eval, PolynomialFunction.eval_ofPolynomial,
    eval_evalCoordinate]

/-- The restriction depends on the line and is unchanged by selecting another point on it. -/
theorem axisRestriction_update {d : ℕ} (u : Point F (n + 1)) (i : Fin (n + 1))
    (g : BoundedPolynomial F (n + 1) d) (t : F) :
    axisRestriction (update u i t) i g = axisRestriction u i g := by
  apply PolynomialFunction.value_injective
  funext a
  simp only [value_axisRestriction, update_idem]

/-- A different legal line answer can agree with the restriction at at most a
degree-over-field-size fraction of positions on the line. -/
theorem expect_axisRestriction_collision_le {d : ℕ} (u : Point F (n + 1)) (i : Fin (n + 1))
    (g : BoundedPolynomial F (n + 1) d) (f : PolynomialFunction F d)
    (hne : f ≠ axisRestriction u i g) :
    (𝔼 a : F, if f.value a = (axisRestriction u i g).value a then (1 : ℝ) else 0) ≤
      (d : ℝ) / Fintype.card F := by
  obtain ⟨p, hp, hval⟩ := f.exists_polynomial_value
  let q := evalCoordinate u i g.val
  have hq : q.natDegree ≤ d := (natDegree_evalCoordinate_le u i g.val).trans (g.prop i)
  have he (a : F) : (axisRestriction u i g).value a = q.eval a := by
    rw [value_axisRestriction, eval_evalCoordinate]
  have hpq : p ≠ q := by
    intro h
    apply hne
    apply PolynomialFunction.value_injective
    funext a
    exact (hval a).symm.trans ((congrArg (fun r : Polynomial F => r.eval a) h).trans (he a).symm)
  have hcard := Cslib.Code.card_filter_eval_eq_eval_le
    (α := id) (ι := F) Function.injective_id hp hq hpq
  simp_rw [← hval, he]
  rw [Fintype.expect_eq_sum_div_card, sum_boole]
  exact div_le_div_of_nonneg_right (by exact_mod_cast hcard) (by positivity)

section Measurement

variable [Ring A] [PartialOrder A] [IsOrderedAddMonoid A]

/-- Decode the selected axis line into polynomial functions. -/
@[expose] noncomputable def decodedCoordinate
    (M : Question F (n + 1) → Measurement (Answer F (n + 1)) A)
    (d : ℕ) (u : Point F (n + 1)) (i : Fin (n + 1)) : Measurement (PolynomialFunction F d) A :=
  (M (.axis (coordinateLine u i))).map (decodeCoordinate d u i)

/-- Resampling a coordinate leaves its decoded line measurement unchanged. -/
theorem decodedCoordinate_update
    (M : Question F (n + 1) → Measurement (Answer F (n + 1)) A)
    (d : ℕ) (u : Point F (n + 1)) (i : Fin (n + 1)) (t : F) :
    decodedCoordinate M d (update u i t) i = decodedCoordinate M d u i := by
  simp only [decodedCoordinate, coordinateLine, axisOrigin, update_idem, decodeCoordinate_update]

end Measurement

variable [CStarAlgebra A] [PartialOrder A] [StarOrderedRing A]

local notation "Q" => Question F (n + 1)
local notation "Ans" => Answer F (n + 1)

/-- Averaging over the verifier's coordinate choice, the decoded disagreement
costs at most twice the axis-branch loss for fixing the point-first role. -/
theorem axisPointDisagreement_le (S : CommutingStrategy Q Q Ans Ans A) (d : ℕ) :
    (𝔼 u : Point F (n + 1), 𝔼 i : Fin (n + 1),
      (1 - Measurement.agreement S.state (decodedPoint S.alice u)
        ((decodedCoordinate S.bob d u i).map (fun f => f.value (u i))))) ≤
      2 * (1 - (branchGame (F := F) n d .axis).commutingWinProb S) := by
  have he (u : Point F (n + 1)) (i : Fin (n + 1)) :
      acceptScore S d (.point u) (.axis (coordinateLine u i)) ≤
        Measurement.agreement S.state (decodedPoint S.alice u)
          ((decodedCoordinate S.bob d u i).map (fun f => f.value (u i))) := by
    rw [decodedPoint, decodedCoordinate, Measurement.map_map]
    exact acceptScore_le_decodedAgreement S d _ _ _ _ fun _ _ h =>
      (decodeCoordinate_agrees u i ((accepts_point_axis_iff d _ _ _ _).mp h)).symm
  rw [axisScore_eq_expect]
  calc
    _ ≤ 𝔼 u : Point F (n + 1), 𝔼 i : Fin (n + 1), (2 * (1 - axisScoreAt S d u i)) := by
      refine expect_le_expect fun u _ => expect_le_expect fun i _ => ?_
      have hb := acceptScore_le_one S d (.axis (coordinateLine u i)) (.point u)
      unfold axisScoreAt
      rw [← coordinateLine_eq]
      linarith only [he u i, hb]
    _ = _ := by simp only [← mul_expect, expect_sub_distrib, Fintype.expect_const]

/-- The average squared state distance between the point and the evaluated axis answer. -/
theorem axisPointStateDist_le (S : CommutingStrategy Q Q Ans Ans A) (d : ℕ) :
    (𝔼 u : Point F (n + 1), 𝔼 i : Fin (n + 1), ∑ a,
      S.state.norm ((decodedPoint S.alice u).effect a -
        ((decodedCoordinate S.bob d u i).map (fun f => f.value (u i))).effect a) ^ 2) ≤
      4 * (1 - (branchGame (F := F) n d .axis).commutingWinProb S) := by
  classical
  calc
    _ ≤ 𝔼 u : Point F (n + 1), 𝔼 i : Fin (n + 1),
        (2 * (1 - Measurement.agreement S.state (decodedPoint S.alice u)
          ((decodedCoordinate S.bob d u i).map (fun f => f.value (u i))))) := by
      refine expect_le_expect fun u _ => expect_le_expect fun i _ => ?_
      refine Measurement.sum_norm_sub_sq_le_of_agreement _ _ _ ?_ (by
        simp only [sub_sub_cancel, le_refl])
      intro a
      rw [decodedPoint, decodedCoordinate, Measurement.map_map]
      exact Measurement.commute_map_map _ _ (S.commute (.point u) (.axis (coordinateLine u i)))
        _ _ a a
    _ ≤ _ := by
      simp only [← mul_expect]
      linarith only [axisPointDisagreement_le S d]

end Cslib.PCP.LowIndividualDegree
