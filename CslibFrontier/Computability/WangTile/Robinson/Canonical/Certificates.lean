/-!
# Closed decorated Robinson expansions

These certificates describe 312 selected context-tagged decorations. Each node has
sixteen children, interpreted as two substitutions of its Robinson parent and a compatible
four-by-four array of shade blocks. Semantic seam codes are checked once against the actual
nodes, then reused to certify both internal and boundary matching.

## Main definitions

* `Canonical.Node`, `Canonical.Node.child`, `Canonical.seedNode`: the closed decorated system.

## Main results

* `Canonical.children_hCompatible_within` and the boundary counterparts certify refinement.
* `Canonical.Node.block_allowed` verifies the local shade rule.
* `Canonical.Node.child_parent` identifies the prescribed two-step substitution.

These certificates are consumed by canonical finite patches and their plane-tiling theorem;
they do not assert forcing or seed removal for arbitrary tilings.

## References

The node data retain `ShadedSubstitutionStateWitnesses.stateRows`, `childRows` and
`reachableNodes` from [lean-wang](https://github.com/edemaine/lean-wang/tree/64268a3),
revision `64268a3`, with reachable IDs reindexed by their source-list positions.
The mathematical background is the corrected Robinson construction in [JeandelVanier2020].
The seam factorization compresses these finite certificates without changing their semantic
obligations.
-/

public section

-- These finite certificates normalize the same tables. Serial elaboration avoids retaining
-- several large normalization tasks at once. Six-node batches keep peak memory moderate
-- while staying below the default proof limits.
set_option Elab.async false

namespace Cslib.WangTile.Robinson.Canonical

open scoped Cslib.WangTile.Robinson

/-- The four quarter shade states of one decorated Robinson tile. -/
structure ShadeBlock where
  /-- Southwest quarter. -/
  southwest : ShadeState
  /-- Southeast quarter. -/
  southeast : ShadeState
  /-- Northwest quarter. -/
  northwest : ShadeState
  /-- Northeast quarter. -/
  northeast : ShadeState
  deriving DecidableEq

/-- Read a quarter; zero selects west/south and a nonzero offset east/north. -/
@[expose] def ShadeBlock.at (block : ShadeBlock) (x y : ℕ) : ShadeState :=
  if x = 0 then if y = 0 then block.southwest else block.northwest
  else if y = 0 then block.southeast else block.northeast

/-- Matching shade edges along the two horizontal block seams. -/
@[expose] def ShadeBlock.hMatches (left right : ShadeBlock) : Bool :=
  decide ((left.at 1 0).east = (right.at 0 0).west) &&
    decide ((left.at 1 1).east = (right.at 0 1).west)

/-- Matching shade edges along the two vertical block seams. -/
@[expose] def ShadeBlock.vMatches (lower upper : ShadeBlock) : Bool :=
  decide ((lower.at 0 1).north = (upper.at 0 0).south) &&
    decide ((lower.at 1 1).north = (upper.at 1 0).south)

@[expose] public section
/-- A selected decoration, indexed by the source reachable-node enumeration. -/
structure Node where
  /-- Position in the closed source enumeration, rather than its external numeric node ID. -/
  code : Fin 312
  deriving DecidableEq
end

/-- Decide universal node predicates through the finite node enumeration. -/
instance (predicate : Node → Prop) [DecidablePred predicate] :
    Decidable (∀ node : Node, predicate node) :=
  match (inferInstance : Decidable (∀ code : Fin 312, predicate ⟨code⟩)) with
  | .isTrue valid => .isTrue (fun node => valid node.code)
  | .isFalse invalid => .isFalse (fun valid => invalid (fun code => valid ⟨code⟩))

