/-- The row and column observations on a three-by-three quarter halo. The axis-relative
orientation is `false` toward decreasing coordinates and `true` toward increasing coordinates;
`none` means no selected border. Sharing this convention lets both axes use one refinement rule. -/
structure BorderHalo where
  /-- Selected vertical boundaries: `false` faces west, `true` east, and `none` is absent. -/
  row : Fin 3 → Fin 3 → Option Bool
  /-- Selected horizontal boundaries: `false` faces south, `true` north, and `none` is absent. -/
  column : Fin 3 → Fin 3 → Option Bool

/-- Decide extensional halo equality by its finite pointwise characterization. -/
instance : DecidableEq BorderHalo := fun first second =>
  decidable_of_iff
    (∀ x y : Fin 3, first.row x y = second.row x y ∧ first.column x y = second.column x y)
    (by
      constructor
      · intro h
        have rows := funext fun x => funext fun y => (h x y).1
        have columns := funext fun x => funext fun y => (h x y).2
        cases first
        cases second
        simp only [BorderHalo.mk.injEq]
        exact ⟨rows, columns⟩
      · intro h
        cases h
        intro x y
        exact ⟨rfl, rfl⟩)

/-- A decorated node, its coordinate parities, and the surrounding selected-border halo. -/
structure BorderState where
  /-- The decorated Robinson node. -/
  node : Node
  /-- Parity of the node's horizontal block coordinate. -/
  xParity : Fin 2
  /-- Parity of the node's vertical block coordinate. -/
  yParity : Fin 2
  /-- The visible two-by-two patch together with its one-cell halo. -/
  halo : BorderHalo

/-- Decide equality of the node, parities, and finite halo observations. -/
instance : DecidableEq BorderState := fun first second =>
  decidable_of_iff
    (first.node = second.node ∧ first.xParity = second.xParity ∧
      first.yParity = second.yParity ∧ first.halo = second.halo)
    (by cases first; cases second; simp only [BorderState.mk.injEq])

/-- Round a coordinate up to the next multiple of four, then divide by four. -/
@[expose] def ceilDivFour (coordinate : ℕ) : ℕ := (coordinate + 3) / 4

/-- Lift a selected border through two substitutions. `false` faces decreasing coordinates
(west or south), `true` faces increasing coordinates (east or north), and `none` is absent. -/
@[expose] def liftBorder (coordinate : ℕ) : Option Bool → Option Bool
  | none => none
  | some true => if coordinate % 4 = 1 then some true else none
  | some false => if coordinate % 4 = 0 then some false else none

/-- The newly created depth-zero frame: residues two and three inside a period of four.
`true` faces increasing coordinates, `false` decreasing coordinates, and `none` is absent. -/
@[expose] def baseFrame (coordinate transverse : ℕ) : Option Bool :=
  if 2 ≤ transverse % 4 ∧ transverse % 4 ≤ 3 then
    if coordinate % 4 = 2 then some true
    else if coordinate % 4 = 3 then some false else none
  else none

/-- The persistent opening on the west or south edge of a seed supertile, facing increasing
coordinates (`some true`); all other positions have no selected border (`none`). -/
@[expose] def outerBorder (coordinate transverse : ℕ) : Option Bool :=
  if coordinate = 1 ∧ 1 ≤ transverse then some true else none

/-- The outer-border seed state, before any decorated expansion. -/
@[expose] def BorderState.seed : BorderState where
  node := seedNode
  xParity := 0
  yParity := 0
  halo.row x y := outerBorder x y
  halo.column x y := outerBorder y x

/-- Refine the node and its halo at one position of the selected four-by-four expansion. -/
@[expose] def BorderState.refine (state : BorderState) (childX childY : Fin 4) : BorderState where
  node := state.node.child (blockPosition childX childY)
  xParity := ⟨childX.val % 2, Nat.mod_lt _ (by decide)⟩
  yParity := ⟨childY.val % 2, Nat.mod_lt _ (by decide)⟩
  halo.row x y :=
    let coarseX : Fin 3 := ⟨ceilDivFour (2 * childX.val + x.val), by
      dsimp only [ceilDivFour]; omega⟩
    let coarseY : Fin 3 := ⟨ceilDivFour (2 * childY.val + y.val), by
      dsimp only [ceilDivFour]; omega⟩
    (liftBorder (2 * childX.val + x.val) (state.halo.row coarseX coarseY)).or
      (liftBorder (2 * childX.val + x.val)
        (baseFrame (2 * state.xParity.val + coarseX.val)
          (2 * state.yParity.val + coarseY.val)))
  halo.column x y :=
    let coarseX : Fin 3 := ⟨ceilDivFour (2 * childX.val + x.val), by
      dsimp only [ceilDivFour]; omega⟩
    let coarseY : Fin 3 := ⟨ceilDivFour (2 * childY.val + y.val), by
      dsimp only [ceilDivFour]; omega⟩
    (liftBorder (2 * childY.val + y.val) (state.halo.column coarseX coarseY)).or
      (liftBorder (2 * childY.val + y.val)
        (baseFrame (2 * state.yParity.val + coarseY.val)
          (2 * state.xParity.val + coarseX.val)))

private def decodeBorder : ℕ → Option Bool
  | 0 => none
  | 1 => some false
  | _ => some true

private def borderRow (raw : BorderRow) : BorderState where
  node := ⟨⟨raw.node % 312, Nat.mod_lt _ (by decide)⟩⟩
  xParity := ⟨raw.blockXParity % 2, Nat.mod_lt _ (by decide)⟩
  yParity := ⟨raw.blockYParity % 2, Nat.mod_lt _ (by decide)⟩
  halo.row x y := decodeBorder ((haloPatterns.getD raw.haloIndex #[]).getD (x.val + 3 * y.val) 0)
  halo.column x y :=
    decodeBorder ((haloPatterns.getD raw.haloIndex #[]).getD (9 + x.val + 3 * y.val) 0)

private theorem borderRaw_size : borderRaw.size = 376 := by decide +kernel

private def borderStateAt (index : Fin 376) : BorderState :=
  borderRow (borderRaw[index.val]'(by rw [borderRaw_size]; exact index.isLt))

private def borderTarget (index : Fin 376) (x y : Fin 4) : Fin 376 :=
  ⟨((borderTargetCodes.getD index.val 0) / 376 ^ (x.val + 4 * y.val)) % 376,
    Nat.mod_lt _ (by decide)⟩

private def borderCheck (index : Fin 376) : Bool :=
  let state := borderStateAt index
  decide (
    (∀ x y : Fin 2,
      state.halo.row x.castSucc y.castSucc = state.node.rowInterior x y ∧
      state.halo.column x.castSucc y.castSucc = state.node.columnInterior x y) ∧
    (∀ childX childY : Fin 4,
      state.refine childX childY = borderStateAt (borderTarget index childX childY)) ∧
    (∀ childX childY : Fin 4, (state.refine childX childY).node.parent = 0 →
      (childX = 0 ∧ childY = 0 ∧ state.node.parent = 0 ∧
        state.xParity = 0 ∧ state.yParity = 0) ∨
      (childX = 0 ∧ childY = 0 ∧ state.node.parent = 4 ∧
        state.xParity = 1 ∧ state.yParity = 1) ∨
      (childX = 2 ∧ childY = 2 ∧ state.xParity = 0 ∧ state.yParity = 0)))

private def borderChunk (chunk : ℕ) : Bool :=
  (List.range 8).all fun offset =>
    borderCheck ⟨(8 * chunk + offset) % 376, Nat.mod_lt _ (by decide)⟩

