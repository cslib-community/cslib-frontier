/-!
# Static bounds for named native oracle programs

The first-order description of a native oracle machine exhaustively stores one row for every
control, input symbol, work-head observation and answer-head observation. For a state type of
cardinality `s`, `k` work tapes and `r` oracle channels, the table therefore has exactly
`s * 3 * 3 ^ k * 3 ^ r` rows. This module bounds the complete encoded description by that row
count and the maximum encoded row length.

The family-level theorem deliberately assumes that the exhaustive-row schedule is polynomially
bounded. Polynomial state, tape and channel schedules do not imply this: the factor
`3 ^ (k + r)` can be exponential. The fixed-channel corollary derives the row premise from a
polynomial state-cardinality schedule. Growing-channel applications must instead supply an
appropriate representation or prove the exhaustive-row premise separately.

## Main definitions

* `Turing.MultiTapePTM.Internal.Description.observationRowCount`: exact exhaustive row count.
* `Turing.MultiTapePTM.Internal.Description.maxEncodedRowBits`: maximum encoded generated row.
* `Turing.MultiTapePTM.Internal.Description.structuralBitsBound`: arithmetic description bound.
* `Turing.MultiTapePTM.Internal.NativeOracleProgram.staticBitsBound`: the bound specialized to a
  retained witness.

## Main results

* `Turing.MultiTapePTM.Internal.Description.descLen_ofMachine_le`: the generated description fits
  the structural bound.
* `Turing.MultiTapePTM.Internal.Description.scheduledBitsBound_polynomiallyBounded`: polynomial
  components, exhaustive rows and maximum rows give a polynomial description schedule.
* `Turing.MultiTapePTM.Internal.Description.staticBits_polynomiallyBounded_of_le`: transfer that
  schedule bound to a concrete indexed artifact family.
* `Turing.MultiTapePTM.Internal.NativeOracleProgram.staticBits_le_staticBitsBound`: witness-level
  specialization.

## References

The structural accounting interface is original to this module.
-/

public section

namespace Turing.MultiTapePTM.Internal

open Cslib Turing.MultiTapeMachine Turing.MultiTapeTM

namespace Description

open Turing.MultiTapePTM.Universal

variable {k r : ℕ} {State : Type} [Fintype State]

/-- Exact number of observations exhaustively enumerated by `ofMachine`: one of three input-head
symbols, one of three symbols at each ordinary work head and one of three symbols at each oracle
answer head, for every native control. -/
@[expose] def observationRowCount (stateCard tapeCount operationCount : ℕ) : ℕ :=
  stateCard * 3 * 3 ^ tapeCount * 3 ^ operationCount

/-- The table generated by `ofMachine` has exactly the exhaustive observation-row count. -/
theorem table_length_ofMachine (stateEncoding : State ↪ ℕ)
    (machine : MultiTapePTM k Bool State (Fin r)) :
    (ofMachine stateEncoding machine).table.length =
      observationRowCount (Fintype.card State) k r := by
  simp [ofMachine, observationRowCount, Finset.length_toList, Finset.card_univ,
    Fintype.card_prod, Fintype.card_option, Fintype.card_bool, Fintype.card_fun,
    Fintype.card_fin, Nat.mul_assoc]

/-- Encoded length of the generated row at one native observation. -/
@[expose] def encodedRowBits (stateEncoding : State ↪ ℕ)
    (machine : MultiTapePTM k Bool State (Fin r))
    (entry : State × Option Bool × (Fin k → Option Bool) × (Fin r → Option Bool)) : ℕ :=
  (encPair Universal.eKey Universal.eBranches
    (Universal.key (stateEncoding entry.1)
      (entry.2.1.map Turing.MultiTapeTM.Universal.eBit)
      (Option.map Turing.MultiTapeTM.Universal.eBit ∘ entry.2.2.1)
      (Option.map Turing.MultiTapeTM.Universal.eBit ∘ entry.2.2.2),
    branches stateEncoding machine entry.1 entry.2.1 entry.2.2.1 entry.2.2.2)).length

/-- Maximum encoded key-and-branches row produced by the exhaustive construction. -/
@[expose] noncomputable def maxEncodedRowBits (stateEncoding : State ↪ ℕ)
    (machine : MultiTapePTM k Bool State (Fin r)) : ℕ :=
  Finset.univ.sup (encodedRowBits stateEncoding machine)

/-- Every generated table row is bounded by the construction's maximum encoded row length. -/
theorem encoded_row_le_maxEncodedRowBits (stateEncoding : State ↪ ℕ)
    (machine : MultiTapePTM k Bool State (Fin r))
    {row : Universal.Key × Universal.Branches}
    (hrow : row ∈ (ofMachine stateEncoding machine).table) :
    (encPair Universal.eKey Universal.eBranches row).length ≤
      maxEncodedRowBits stateEncoding machine := by
  obtain ⟨entry, -, rfl⟩ := List.mem_map.mp hrow
  exact Finset.le_sup (f := encodedRowBits stateEncoding machine) (Finset.mem_univ entry)

/-- Arithmetic upper bound for a right-associated description encoding with the given structural
coordinates. `rowCount` and `maxRowBits` are kept independent so asymptotic users must justify the
chosen table representation explicitly. -/
@[expose] def structuralBitsBound (tapeCount stateTagCount operationCount initialTag rowCount
    maxRowBits : ℕ) : ℕ :=
  2 * tapeCount + 1 + 2 * stateTagCount + 1 + 2 * operationCount + 1 +
    2 * initialTag + 1 + rowCount * (2 * maxRowBits + 1)

/-- Construction-derived upper bound for the complete encoded description of a native machine. -/
@[expose] noncomputable def descriptionBitsBound (stateEncoding : State ↪ ℕ)
    (machine : MultiTapePTM k Bool State (Fin r)) : ℕ :=
  structuralBitsBound k (stateCount stateEncoding) r (stateEncoding machine.initial)
    (observationRowCount (Fintype.card State) k r)
    (maxEncodedRowBits stateEncoding machine)

/-- The exact generated first-order description fits its construction-derived structural bound. -/
theorem descLen_ofMachine_le (stateEncoding : State ↪ ℕ)
    (machine : MultiTapePTM k Bool State (Fin r)) :
    Universal.descLen (ofMachine stateEncoding machine) ≤
      descriptionBitsBound stateEncoding machine := by
  have htable := Turing.MultiTapeTM.length_encList_le
    (encPair Universal.eKey Universal.eBranches) (ofMachine stateEncoding machine).table
    (encoded_row_le_maxEncodedRowBits stateEncoding machine)
  rw [table_length_ofMachine] at htable
  simp only [Universal.descLen, Universal.eDesc_apply, length_encPair, encUnary_apply,
    List.length_replicate] at htable ⊢
  unfold descriptionBitsBound structuralBitsBound
  omega

/-- Structural bound for a family of descriptions. The exact exhaustive row count is visible in
the formula rather than inferred from the component schedules. -/
@[expose] def scheduledBitsBound
    (stateCard tapeCount stateTagCount operationCount initialTag maxRowBits : ℕ → ℕ)
    (n : ℕ) : ℕ :=
  structuralBitsBound (tapeCount n) (stateTagCount n) (operationCount n) (initialTag n)
    (observationRowCount (stateCard n) (tapeCount n) (operationCount n)) (maxRowBits n)

/-- Polynomial structural coordinates, exhaustive row schedule and maximum encoded row schedule
give a polynomial description-size schedule. The row hypothesis is intentionally separate: it
cannot be inferred from polynomial `tapeCount` and `operationCount`. -/
theorem scheduledBitsBound_polynomiallyBounded
    {stateCard tapeCount stateTagCount operationCount initialTag maxRowBits : ℕ → ℕ}
    (htapes : Cslib.PolynomiallyBounded tapeCount)
    (hstates : Cslib.PolynomiallyBounded stateTagCount)
    (hoperations : Cslib.PolynomiallyBounded operationCount)
    (hinitial : Cslib.PolynomiallyBounded initialTag)
    (hrows : Cslib.PolynomiallyBounded (fun n =>
      observationRowCount (stateCard n) (tapeCount n) (operationCount n)))
    (hmaxRow : Cslib.PolynomiallyBounded maxRowBits) :
    Cslib.PolynomiallyBounded (scheduledBitsBound stateCard tapeCount stateTagCount operationCount
      initialTag maxRowBits) := by
  unfold scheduledBitsBound structuralBitsBound
  fun_prop

/-- Any concrete static-size schedule pointwise bounded by the structural schedule is polynomially
bounded under the same explicit component and exhaustive-row premises. This formulation applies
directly to indexed native witnesses without packaging their dependent state types. -/
theorem staticBits_polynomiallyBounded_of_le
    {staticBits stateCard tapeCount stateTagCount operationCount initialTag maxRowBits : ℕ → ℕ}
    (htapes : Cslib.PolynomiallyBounded tapeCount)
    (hstates : Cslib.PolynomiallyBounded stateTagCount)
    (hoperations : Cslib.PolynomiallyBounded operationCount)
    (hinitial : Cslib.PolynomiallyBounded initialTag)
    (hrows : Cslib.PolynomiallyBounded (fun n =>
      observationRowCount (stateCard n) (tapeCount n) (operationCount n)))
    (hmaxRow : Cslib.PolynomiallyBounded maxRowBits)
    (hle : ∀ n, staticBits n ≤
      scheduledBitsBound stateCard tapeCount stateTagCount operationCount initialTag maxRowBits n) :
    Cslib.PolynomiallyBounded staticBits :=
  (scheduledBitsBound_polynomiallyBounded htapes hstates hoperations hinitial hrows
    hmaxRow).mono_of_le hle

/-- With fixed tape and channel counts, a polynomial state-cardinality schedule gives a polynomial
exhaustive-row schedule. This does not extend to arbitrary growing polynomial channel counts. -/
theorem observationRowCount_polynomiallyBounded_fixed
    {stateCard : ℕ → ℕ} (hstates : Cslib.PolynomiallyBounded stateCard)
    (tapeCount operationCount : ℕ) :
    Cslib.PolynomiallyBounded (fun n =>
      observationRowCount (stateCard n) tapeCount operationCount) := by
  unfold observationRowCount
  fun_prop

/-- Fixed tape and channel counts discharge the exhaustive-row premise from a polynomial
state-cardinality schedule. -/
theorem scheduledBitsBound_polynomiallyBounded_fixed
    {stateCard stateTagCount initialTag maxRowBits : ℕ → ℕ}
    (tapeCount operationCount : ℕ)
    (hcard : Cslib.PolynomiallyBounded stateCard)
    (htags : Cslib.PolynomiallyBounded stateTagCount)
    (hinitial : Cslib.PolynomiallyBounded initialTag)
    (hmaxRow : Cslib.PolynomiallyBounded maxRowBits) :
    Cslib.PolynomiallyBounded (scheduledBitsBound stateCard (fun _ => tapeCount)
      stateTagCount (fun _ => operationCount) initialTag maxRowBits) :=
  scheduledBitsBound_polynomiallyBounded (Cslib.PolynomiallyBounded.const tapeCount) htags
    (Cslib.PolynomiallyBounded.const operationCount) hinitial
    (observationRowCount_polynomiallyBounded_fixed hcard tapeCount operationCount) hmaxRow

end Description

namespace NativeOracleProgram

open Cslib.Probability

variable {r : ℕ} {Alpha Beta : Type}
  {program : Alpha → ProbOracleComp (fun _ : Fin r × List Bool => List Bool) Beta}
  {encIn : Alpha ↪ List Bool} {encOut : Beta ↪ List Bool}

/-- Cardinality of the retained native control type. -/
@[expose] noncomputable def stateCard
    (witness : NativeOracleProgram r program encIn encOut) : ℕ := by
  letI := witness.stateFintype
  exact Fintype.card witness.State

/-- Declared natural-tag control count of the retained first-order description. -/
@[expose] noncomputable def stateTagCount
    (witness : NativeOracleProgram r program encIn encOut) : ℕ := by
  letI := witness.stateFintype
  exact Description.stateCount witness.stateEncoding

/-- Number of fixed oracle-operation channels of the retained witness. -/
@[expose] def operationCount
    (_witness : NativeOracleProgram r program encIn encOut) : ℕ :=
  r

/-- Natural tag of the retained machine's initial control. -/
@[expose] def initialStateTag
    (witness : NativeOracleProgram r program encIn encOut) : ℕ :=
  witness.stateEncoding witness.machine.initial

/-- Exact number of rows exhaustively stored by the retained witness description. -/
@[expose] noncomputable def observationRowCount
    (witness : NativeOracleProgram r program encIn encOut) : ℕ :=
  Description.observationRowCount witness.stateCard witness.tapeCount witness.operationCount

/-- Maximum encoded generated row of the retained witness description. -/
@[expose] noncomputable def maxEncodedRowBits
    (witness : NativeOracleProgram r program encIn encOut) : ℕ := by
  letI := witness.stateFintype
  exact Description.maxEncodedRowBits witness.stateEncoding witness.machine

/-- Construction-derived static upper bound exposing tapes, channels, finite-state coordinates,
the exhaustive row count and maximum encoded row length. -/
@[expose] noncomputable def staticBitsBound
    (witness : NativeOracleProgram r program encIn encOut) : ℕ :=
  Description.structuralBitsBound witness.tapeCount witness.stateTagCount witness.operationCount
    witness.initialStateTag witness.observationRowCount witness.maxEncodedRowBits

/-- The retained artifact's exact `descLen` static charge fits its structural upper bound. -/
theorem staticBits_le_staticBitsBound
    (witness : NativeOracleProgram r program encIn encOut) :
    witness.staticBits ≤ witness.staticBitsBound := by
  letI := witness.stateFintype
  exact Description.descLen_ofMachine_le witness.stateEncoding witness.machine

/-- The retained table has exactly the exposed exhaustive row count. -/
theorem description_table_length
    (witness : NativeOracleProgram r program encIn encOut) :
    witness.description.table.length = witness.observationRowCount := by
  letI := witness.stateFintype
  exact Description.table_length_ofMachine witness.stateEncoding witness.machine

end NativeOracleProgram

end Turing.MultiTapePTM.Internal
