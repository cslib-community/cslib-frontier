module
-- upstream: candidate

public import CslibFrontier.Computability.Machines.Turing.MultiTape.Alternating.CarryLookaheadCountingClockBound

/-!
# Counting with a separate charge for raw input and short arithmetic

A predicate may scan a long word on each root-to-leaf branch, then perform arithmetic on a
much shorter record. The counting machine preserves this distinction even for padded leaves.
-/

public section

namespace Turing.MultiTapeATM.CarryLookaheadCountingFromParametersCost

open MultiTapeTM Cslib Cslib.Circuits.Boolean.CarryLookahead.Query

/-- Collect the fixed number of raw scans outside the polynomial in the short fields. -/
private theorem clock_bound (A D d : ℕ) :
    ∃ C E, ∀ R S N W L B : ℕ, L ≤ 2 * R + 2 * S + 4 → B ≤ 2 * N + W →
      A * (L + (N + W + 1) ^ D + (2 * L + 1 + B + R + (S + B) ^ d)) ≤
        C * (R + (S + N + W + 1) ^ E + 1) := by
  let E := max D (max d 1)
  refine ⟨A * (20 + 2 ^ d), E, ?_⟩
  intro R S N W L B hL hB
  let z := S + N + W + 1
  have hz : 1 ≤ z := by dsimp [z]; omega
  have hE₁ : 1 ≤ E := (Nat.le_max_right d 1).trans (Nat.le_max_right D _)
  have hEd : d ≤ E := (Nat.le_max_left d 1).trans (Nat.le_max_right D _)
  have hp : (N + W + 1) ^ D ≤ z ^ E :=
    (Nat.pow_le_pow_left (by dsimp [z]; omega) D).trans
      (Nat.pow_le_pow_right hz (Nat.le_max_left D _))
  have hzE : z ≤ z ^ E := by simpa using Nat.pow_le_pow_right hz hE₁
  have hb : (S + B) ^ d ≤ 2 ^ d * z ^ E := by
    calc
      _ ≤ (2 * z) ^ d := Nat.pow_le_pow_left (by dsimp [z]; omega) _
      _ = _ := Nat.mul_pow ..
      _ ≤ _ := Nat.mul_le_mul_left _ (Nat.pow_le_pow_right hz hEd)
  rw [Nat.mul_assoc]
  apply Nat.mul_le_mul_left
  change _ ≤ (20 + 2 ^ d) * (R + z ^ E + 1)
  rw [Nat.add_mul]
  have hm := Nat.mul_le_mul_left (2 ^ d) (show z ^ E ≤ R + z ^ E + 1 by omega)
  dsimp [z] at hzE
  change S + N + W + 1 ≤ z ^ E at hzE
  omega

private theorem path_budget (n w : ℕ) :
    CarrySaveCountingRoot.sizeBudget n w ≤ 2 * n.size + w.size := by
  have hn : Nat.clog 2 n ≤ n.size := Nat.clog_le_of_le_pow (Nat.lt_size_self n).le
  have hh := Nat.size_le_self (Nat.clog 2 n)
  unfold CarrySaveCountingRoot.sizeBudget
  omega

/-- Charge a native primitive predicate on every candidate generated by the counting ATM.
A fixed context is shared along each path. The polynomial acts on the short parameters
and candidate index length, while the raw input contributes only linearly. -/
theorem exists_evaluator_on_context {α : Type*}
    (word : α → List Bool) (raw short : α → ℕ) (P : List Bool × ℕ → Bool)
    {T W : List Bool × ℕ → ℕ} (hp : ComputableInO P (encPair encBits encNat) encBool T W)
    (d : ℕ) (hL : ∀ a, (word a).length ≤ 2 * raw a + 2 * short a + 4)
    (hT : ∀ a j, T (word a, j) ≤ (encPair encBits encNat (word a, j)).length +
      raw a + (short a + j.size) ^ d) :
    ∃ (scratch u r q : ℕ) (S : Type) (_ : Finite S)
      (atm : MultiTapeATM (CarryLookaheadCountingPrepare.size scratch u r q) Bool S) (C E : ℕ),
      ∀ (input : List Bool) (a : α) (n w : ℕ) (bit : Fin w)
        (claim : Bool),
        let params : CountingInput.Input := ⟨n, ⟨w, bit.val, claim⟩⟩
        let start := (CarryLookaheadCountingPrepare.initial scratch u r q input
          (word a) params).withState (some atm.toPTM.initial)
        let time := C * (raw a +
          (short a + n.size + w.size + 1) ^ E + 1)
        atm.HaltsWithin time start ∧ (atm.AcceptsWithin time start ↔
          (∑ j ∈ Finset.range n, (P (word a, j)).toNat).testBit
            bit.val = claim) := by
  obtain ⟨s, u, r, q, State, hS, atm, A, D, h⟩ :=
    exists_evaluator_testBit P hp
  obtain ⟨C, E, hc⟩ := clock_bound A D d
  refine ⟨s, u, r, q, State, hS, atm, C, E, ?_⟩
  intro input a n w bit claim
  let B := CarrySaveCountingRoot.sizeBudget n w
  let R := raw a
  let S := short a
  let L := (word a).length
  let cost := 2 * L + 1 + B + R + (S + B) ^ d
  obtain ⟨hh, ha⟩ := h input (word a) n w bit claim cost (by
    intro path hpath
    let j := BitString.binaryValue path
    have hj : j.size ≤ B := (Nat.size_le.mpr (BitString.binaryValue_lt_two_pow path)).trans hpath
    refine (hT a j).trans ?_
    have hpow := Nat.pow_le_pow_left (Nat.add_le_add_left hj (short a)) d
    rw [length_encPair]
    simp only [encBits_apply, encNat_apply, Nat.size_eq_bits_len]
    dsimp only [cost, L, R, S]
    omega)
  have hbound := hc R S n.size w.size L B (hL a) (path_budget n w)
  refine ⟨hh.mono hbound, ?_⟩
  exact ⟨fun hacc => ha.mp (hacc.of_halted_stepCoins hh), fun hx => (ha.mpr hx).mono hbound⟩

end Turing.MultiTapeATM.CarryLookaheadCountingFromParametersCost
