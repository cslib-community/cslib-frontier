module
-- upstream: candidate

public import CslibFrontier.Computability.Machines.Turing.MultiTape.Alternating.CarryLookaheadCountingContext
public import CslibFrontier.Computability.Machines.Turing.MultiTape.BlockComputation.RootPredecessorContext
public import CslibFrontier.Computability.Machines.Turing.MultiTape.BlockComputation.RootPredecessorGraph

/-!
# An alternating bit evaluator for seeded ranks in the root network

The count-bit machine calls the native predecessor predicate on its fixed context and the
candidate index carried by its current path. This charges even padded leaf addresses. One
finite machine works for all schedules, source machines with the chosen tape count, packing
seeds and bit claims. Its clock is linear in the raw movement table plus a polynomial in
the binary index and seed sizes and the supplied unary label length.
-/

public section

namespace Turing.MultiTapeATM.RootPackingRank

open MultiTapeTM MultiTapePTM Cslib Cslib.Circuits.Boolean.CarryLookahead.Query
open RootPredecessorContext (word withCandidate)
open RootPredecessorGraph (graphInput edgeCount vertexCount)

/-- One machine counts native predecessor bits with a uniform branch clock. The input tape
and shared context are independent of the guessed candidate, which is generated by the ATM. -/
theorem exists_evaluator (k : ℕ) :
    ∃ (scratch u r q : ℕ) (S : Type) (_ : Finite S)
      (atm : MultiTapeATM (CarryLookaheadCountingPrepare.size scratch u r q) Bool S) (C E : ℕ),
      ∀ (input : List Bool) (a : RootPredecessorQuery.Input) (n w : ℕ) (bit : Fin w)
        (claim : Bool),
        let params : CountingInput.Input := ⟨n, ⟨w, bit.val, claim⟩⟩
        let start := (CarryLookaheadCountingPrepare.initial scratch u r q input
          (word a) params).withState (some atm.toPTM.initial)
        let time := C * (a.raw.length +
          (RootPredecessorQuery.shortSize a + n.size + w.size + 1) ^ E + 1)
        atm.HaltsWithin time start ∧ (atm.AcceptsWithin time start ↔
          (∑ j ∈ Finset.range n, (RootPredecessorQuery.query k (withCandidate a j)).toNat).testBit
            bit.val = claim) := by
  obtain ⟨d, hd⟩ := RootPredecessorContext.exists_computableInO k
  have h := CarryLookaheadCountingFromParametersCost.exists_evaluator_on_context
    word (fun a => a.raw.length) RootPredecessorQuery.shortSize _ hd d
    (fun a => by
      have hw := RootPredecessorContext.length_word_le a
      rw [RootPredecessorQuery.length_encInput] at hw
      unfold RootPredecessorQuery.shortSize
      omega)
    (fun a j => by
      rw [RootPredecessorContext.inputOf_word]
      exact Nat.add_le_add_left (Nat.pow_le_pow_left
        (RootPredecessorContext.shortSize_withCandidate_le a j) d) _)
  simpa only [RootPredecessorContext.predicate_word] using h

/-- For the actual represented copied and subdivided graph, the sum computed on the fixed
context is the packing's class rank. Both edge endpoints and all four hashes are native. -/
theorem sum_eq_rank {k q copies : ℕ} {State : Type} (machine : MultiTapePTM k Bool State)
    (input : List Bool) (b σ : ℕ) (code : BlockLetter k State b → Fin copies → Bool)
    (a : ℕ) (seed : BalancedSchedules.SeededLabels.Seed (vertexCount k q copies) (6 * a))
    (e : Fin (edgeCount k q copies)) :
    (∑ j ∈ Finset.range (edgeCount k q copies), (RootPredecessorQuery.query k
      (withCandidate (graphInput k q copies σ a seed e e) j)).toNat) =
      PacketPacking.Seeded.rank (vertexCount k q copies) a
        (explicitVertexEquiv k q copies).toEmbedding
        (RootPredecessorGraph.rowOf machine input b σ code)
        (RootPredecessorGraph.colOf k q copies) seed e := by
  rw [RootPredecessorGraph.rank_eq_sum_query machine input b σ code a seed e,
    ← Fin.sum_univ_eq_sum_range]
  rfl

/-- For each fixed tape count, one alternating machine checks bits of the actual
fixed-seed packing rank of every represented root graph. Choosing the precision and claim
changes only the stored input to the machine. -/
theorem exists_rank_evaluator (k : ℕ) :
    ∃ (scratch u r v : ℕ) (S : Type) (_ : Finite S)
      (atm : MultiTapeATM (CarryLookaheadCountingPrepare.size scratch u r v) Bool S) (C E : ℕ),
      ∀ {q copies : ℕ} {State : Type} (machine : MultiTapePTM k Bool State) (input : List Bool)
        (b σ : ℕ) (code : BlockLetter k State b → Fin copies → Bool) (a : ℕ)
        (seed : BalancedSchedules.SeededLabels.Seed (vertexCount k q copies) (6 * a))
        (e : Fin (edgeCount k q copies)) (w : ℕ) (bit : Fin w) (claim : Bool),
        let n := edgeCount k q copies
        let arg := graphInput k q copies σ a seed e e
        let params : CountingInput.Input := ⟨n, ⟨w, bit.val, claim⟩⟩
        let start := (CarryLookaheadCountingPrepare.initial scratch u r v input
          (word arg) params).withState (some atm.toPTM.initial)
        let time := C * (arg.raw.length +
          (RootPredecessorQuery.shortSize arg + n.size + w.size + 1) ^ E + 1)
        atm.HaltsWithin time start ∧ (atm.AcceptsWithin time start ↔
          (PacketPacking.Seeded.rank (vertexCount k q copies) a
            (explicitVertexEquiv k q copies).toEmbedding (RootPredecessorGraph.rowOf machine
              input b σ code) (RootPredecessorGraph.colOf k q copies) seed e).testBit bit.val =
              claim) := by
  obtain ⟨scratch, u, r, v, S, hS, atm, C, E, h⟩ := exists_evaluator k
  refine ⟨scratch, u, r, v, S, hS, atm, C, E, ?_⟩
  intro q copies State machine input b σ code a seed e w bit claim
  simpa only [sum_eq_rank machine input b σ code a seed e] using
    h input (graphInput k q copies σ a seed e e) (edgeCount k q copies) w bit claim

end Turing.MultiTapeATM.RootPackingRank
