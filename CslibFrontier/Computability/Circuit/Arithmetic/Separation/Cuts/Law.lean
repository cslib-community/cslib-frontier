/-!
# Laws: exchange identities between roles

A *law* (`Cut.Law`) is an identity that the moves of the cutting argument of [AnthropicVPVNP2026]
(Appendix H.2; module `Nc.G.Defs`) use to cut units. It has *roles*, *slots* and *channels*; a slot
and a channel each have two ends, at two different roles, exactly as the units of the play have two
holders (`Play.Holds`). Every slot carries one bit, of which the two roles at its ends each have a
copy. The identity says that the condition "the two copies of the bit of every slot agree" is a
sum, over an index and over a bit string on every channel, of a product of tables of the roles;
the table of a role reads the bits of its slots and the strings of its channels.

Taking the product of `B` copies of the identity gives the same identity for `B` bits on every
slot (`Cut.Law.pow`), which is how a move uses a law on whole units.

A law has finitely many entries, the values of its tables (`Cut.Law.entries`,
`Cut.Law.finite_entries`). In the proof of Theorem G.2 the ring `A` is generated by the entries
of finitely many laws over the field; a law whose tables lie in a subsemiring `A` is a law over
`A` (`Cut.Law.restrict`). A law over `A` is a law over every `A`-algebra, with the images of its
tables (`Cut.Law.map`).

## Main definitions

* `Cut.Law`: a law over a commutative semiring.
* `Cut.Law.SlotAt`, `Cut.Law.ChannelAt`: the slots and the channels of a role.
* `Cut.Law.LengthLE`: a bound for the lengths of the strings of a law.
* `Cut.Law.entries`: the values of the tables of a law.
* `Cut.Law.restrict`: a law with tables in a subsemiring, as a law over the subsemiring.
* `Cut.Law.map`: the image of a law under a ring homomorphism.

## Main results

* `Cut.Law.pow`: the identity of a law for `B` bits on every slot.
* `Cut.Law.connected_pow`: indices of `B` copies that agree along channels are equal.
* `Cut.Law.finite_entries`: a law has finitely many entries.

## References

* [Anthropic, *VP ≠ VNP over every field*, paper and Lean formalization][AnthropicVPVNP2026],
  Appendix H.2 and Theorem G.2 (p. 43); modules `Nc.G.Defs`, `Nc.G.Contract`,
  `Nc.Tow.FromPriceK` and `Paper.Laws`
-/

public section

namespace Cslib.Circuits.Arithmetic.Separation.Cut

open Finset

/-- A law: an identity that writes the agreement of the two copies of the bit of every slot as a
sum, over indices and over strings on the channels, of products of tables of the roles. -/
structure Law (F : Type*) [CommSemiring F] where
  /-- The roles. -/
  Role : Type
  /-- The slots: one bit each, seen by the two roles at its ends. -/
  Slot : Type
  /-- The channels: one bit string each, seen by the two roles at its ends. -/
  Channel : Type
  /-- The indices of the sum. -/
  Index : Type
  [fintypeRole : Fintype Role]
  [decEqRole : DecidableEq Role]
  [fintypeSlot : Fintype Slot]
  [decEqSlot : DecidableEq Slot]
  [fintypeChannel : Fintype Channel]
  [decEqChannel : DecidableEq Channel]
  [fintypeIndex : Fintype Index]
  [decEqIndex : DecidableEq Index]
  /-- The roles at the two ends of a slot. -/
  slotEnd : Slot → Bool → Role
  slotEnd_ne : ∀ e, slotEnd e false ≠ slotEnd e true
  /-- The roles at the two ends of a channel. -/
  channelEnd : Channel → Bool → Role
  channelEnd_ne : ∀ ν, channelEnd ν false ≠ channelEnd ν true
  /-- The length of the labels of the indices. -/
  labelLength : ℕ
  /-- The label of an index. -/
  label : Index → BitString labelLength
  label_injective : Function.Injective label
  /-- The length of the string on a channel, for an index. -/
  length : Index → Channel → ℕ
  /-- The tables: a role sees the bits of its slots and the strings of its channels. -/
  table : (p : Role) → (i : Index) → ({e // Play.Holds slotEnd p e} → Bool) →
    ((ν : {ν // Play.Holds channelEnd p ν}) → BitString (length i ν)) → F
  /-- The identity of the law. -/
  identity : ∀ X : Role → Slot → Bool,
    (if ∀ e, X (slotEnd e false) e = X (slotEnd e true) e then (1 : F) else 0) =
      ∑ i, ∑ g : ∀ ν, BitString (length i ν), ∏ p, table p i (fun e => X p e) (fun ν => g ν)
  /-- Indices of the roles that agree along all channels are equal. -/
  connected : ∀ ι : Role → Index,
    (∀ ν, ι (channelEnd ν false) = ι (channelEnd ν true)) → ∀ p q, ι p = ι q

attribute [instance] Law.fintypeRole Law.decEqRole Law.fintypeSlot Law.decEqSlot
  Law.fintypeChannel Law.decEqChannel Law.fintypeIndex Law.decEqIndex

namespace Law

variable {F : Type*} [CommSemiring F] (L : Law F)

/-- The slots of a role. -/
abbrev SlotAt (p : L.Role) : Type := {e : L.Slot // Play.Holds L.slotEnd p e}

/-- The channels of a role. -/
abbrev ChannelAt (p : L.Role) : Type := {ν : L.Channel // Play.Holds L.channelEnd p ν}

/-- The strings of the law have length at most `m`. -/
@[expose] def LengthLE (m : ℕ) : Prop := ∀ i ν, L.length i ν ≤ m

/-- **The power of a law**: the identity for `B` bits on every slot. The index and the strings on
the channels are chosen for every bit. -/
theorem pow (B : ℕ) (X : L.Role → Fin B → L.Slot → Bool) :
    (if ∀ e k, X (L.slotEnd e false) k e = X (L.slotEnd e true) k e then (1 : F) else 0) =
      ∑ i : Fin B → L.Index, ∑ g : (ν : L.Channel) → (k : Fin B) → BitString (L.length (i k) ν),
        ∏ p, ∏ k, L.table p (i k) (fun e => X p k e) fun ν => g ν k := by
  have h : (if ∀ e k, X (L.slotEnd e false) k e = X (L.slotEnd e true) k e then (1 : F) else 0) =
      ∏ k, if ∀ e, X (L.slotEnd e false) k e = X (L.slotEnd e true) k e then (1 : F) else 0 := by
    rw [prod_ite_zero]
    simp only [mem_univ, true_imp_iff, prod_const_one]
    exact if_congr forall_comm rfl rfl
  rw [h, prod_congr rfl fun k _ => L.identity fun p => X p k]
  simp only [prod_univ_sum, Fintype.piFinset_univ]
  refine sum_congr rfl fun i _ => ?_
  refine Fintype.sum_equiv
    (Equiv.piComm fun (k : Fin B) (ν : L.Channel) => BitString (L.length (i k) ν)) _ _ fun g => ?_
  rw [prod_comm]
  rfl

/-- Indices of `B` copies of a law that agree along all channels are equal. -/
theorem connected_pow {B : ℕ} (f : L.Role → Fin B → L.Index)
    (h : ∀ ν, f (L.channelEnd ν false) = f (L.channelEnd ν true)) (p q : L.Role) : f p = f q :=
  funext fun k => L.connected (fun p => f p k) (fun ν => congrFun (h ν) k) p q

/-- The values of the tables of a law. -/
@[expose] def entries : Set F := ⋃ p, ⋃ i, ⋃ X, Set.range (L.table p i X)

/-- A law has finitely many entries. -/
theorem finite_entries : L.entries.Finite :=
  Set.finite_iUnion fun _ => Set.finite_iUnion fun _ => Set.finite_iUnion fun _ =>
    Set.finite_range _

/-- A law whose tables take values in a subsemiring `A` of `F`, as a law over `A`. -/
@[expose] def restrict {S : Type*} [SetLike S F] [SubsemiringClass S F] (A : S)
    (hA : ∀ p i X g, L.table p i X g ∈ A) : Law A :=
  { L with
    table p i X g := ⟨L.table p i X g, hA p i X g⟩
    identity X := Subtype.ext <| by
      simpa only [apply_ite Subtype.val, OneMemClass.coe_one, ZeroMemClass.coe_zero,
        AddSubmonoidClass.coe_finsetSum, SubmonoidClass.coe_finsetProd] using L.identity X }

/-- **A law over every algebra** (Appendix G, p. 43, after Theorem G.2): the image of a law under
a ring homomorphism `f`, with the tables `f ∘ L.table`. -/
@[expose] def map {R : Type*} [CommSemiring R] (f : F →+* R) : Law R :=
  { L with
    table p i X g := f (L.table p i X g)
    identity X := by
      simpa only [apply_ite f, map_one, map_zero, map_sum, map_prod] using
        congrArg f (L.identity X) }

end Law

end Cslib.Circuits.Arithmetic.Separation.Cut
