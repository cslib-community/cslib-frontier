/-!
# The existence of laws

Theorem G.2 of [AnthropicVPVNP2026] (p. 43): in the contracting case there are finitely many laws
on `U_h` (Definition G.1, p. 42) over a finitely generated subring `A` of the field, such that
(a) every load `n` on pairs with `‖n‖ ≤ a₁ t` is at most `t` times the slots of one of them, and
(b) the label and the strings on the near pairs of every law are short. Laws on `U_h` are the laws
at the vertices of the tower `SLTower.tower h 0` (a `TowerPlan.VertexLaws`), and
`VertexLaws.transfer` moves them to the other towers `SLTower.tower h n`.

The proof is the paper's. Theorem F.6 (p. 40, `Poincare.exists_poincareBound`) compares the
prices of all pairs of elements of `U_h` with those of the near pairs (Appendix G.1, p. 42). By
the Cauchy–Schwarz inequality (`Prices.exists_load`), every price then makes the slots of a load
`σ` on pairs cost at most the channels of one of finitely many loads on near pairs. The duality
theorem (Theorem A.6, p. 20, `PartyTensor.exists_coveredBy_pow_of_forall_le`) turns this into a
cover of the wires `q σ` by at most `2 ^ q` products of wires on near pairs, which is a law
(`Prices.exists_wireId`). The ring `A` is generated by the entries of the tables of these laws
(`Cut.Law.restrict`). Where the paper takes `2 ^ (ε q)` terms for a small `ε`, here `ε = 1`: the
labels of `q` bits are absorbed by the choice of the large integer `a`.

## Main results

* `Laws.exists_vertexLaws`: Theorem G.2 for one `h` chosen as in (G.1).

## References

* [Anthropic, *VP ≠ VNP over every field*, paper and Lean formalization][AnthropicVPVNP2026],
  Appendix G: Definition G.1 (p. 42) and Theorem G.2 (p. 43); module `Paper.Laws`
-/

public section

namespace Cslib.Circuits.Arithmetic.Separation.Laws

open Finset Cslib.SLTower Cslib.PartyTensor Cslib.CoveringTower Prices TowerPlan Cut Poincare
  TwoCases

/-- A function on `U h` with the same value at the two ends of every near pair is constant: the
near pairs connect `U h` (Appendix G.2, p. 43). -/
private theorem apply_eq_of_near {h : ℕ} {β : Type*} {f : U h → β}
    (hf : ∀ ν : NN h, f ν.elt = f (x h ν.idx * ν.elt)) (p q : U h) : f p = f q := by
  refine apply_eq_of_x_mul (fun j u => ?_) p q
  have h1 := congrArg (Sym2.map f) (npair_sym j u)
  rw [Sym2.map_mk, Sym2.map_mk, ← hf] at h1
  have h2 : s(f u, f (x h j * u)).IsDiag := by rw [h1]; exact Sym2.mk_isDiag_iff.2 rfl
  exact (Sym2.mk_isDiag_iff.1 h2).symm

/-- `U h` has at least two elements for `h ≥ 2`. -/
private theorem two_le_card_U {h : ℕ} (h2 : 2 ≤ h) : 2 ≤ Fintype.card (U h) :=
  Fintype.one_lt_card_iff.2 ⟨x h ⟨0, by omega⟩, 1, x_ne_one _⟩

/-- Theorem F.6 over all pairs (Appendix G.1, p. 42): for an integer `C₀ ≥ 2C + 1`, the sum of
`|e|²` over the pairs `e` of different elements of `U (l u)` is at most `C₀ (b - 1)` times the sum
over the near pairs, where `b = |U (l u)|`. -/
private theorem sum_pairs_le_of_poincareBound {K : Type} [Field K] {u : ℕ} (hu : 1 ≤ u) {C : ℝ}
    (hP : PoincareBound K u C) {C₀ : ℕ} (hC₀ : 2 * C + 1 ≤ C₀) {l : ℕ} (hl : 2 ≤ l)
    {w : U (l * u) → U (l * u) → ℝ} (hw : IsPrice K w) :
    ∑ e : {q : Sym2 (U (l * u)) // ¬ q.IsDiag}, w e.val.out.fst e.val.out.snd ^ 2 ≤
      C₀ * (Fintype.card (U (l * u)) - 1) *
        ∑ ν : NN (l * u), w ν.elt (x (l * u) ν.idx * ν.elt) ^ 2 := by
  have hb : (2 : ℝ) ≤ Fintype.card (U (l * u)) := by
    exact_mod_cast two_le_card_U (le_mul_of_le_of_one_le hl hu)
  have h1 := hP l hl w hw
  rw [sum_comm, ← sum_div, sum_NN (fun j k => w k (x (l * u) j * k) ^ 2) fun j k => by
    rw [← mul_assoc, x_mul_self, one_mul, hw.symm], ← two_mul,
    div_le_iff₀ (by positivity)] at h1
  -- the sum over the ordered pairs is twice the sum over the pairs
  let f : Sym2 (U (l * u)) → ℝ := Sym2.lift ⟨(w · · ^ 2), fun p q => congrArg (· ^ 2) (hw.symm p q)⟩
  have h2 : ∑ k, ∑ g, w k (g * k) ^ 2 = 2 * ∑ e : {q : Sym2 (U (l * u)) // ¬ q.IsDiag}, f e.1 := by
    rw [Fintype.sum_subtype_not_isDiag, two_mul, ← two_nsmul,
      ← Fintype.sum_sum_ite_eq_two_nsmul_sum_sym2]
    refine sum_congr rfl fun k _ => (Fintype.sum_equiv (Equiv.mulRight k) _ (w k · ^ 2)
      fun _ => rfl).trans (sum_congr rfl fun q _ => ?_)
    split_ifs with hkq
    · rw [hkq, hw.self, zero_pow two_ne_zero]
    · rfl
  rw [h2] at h1
  set b : ℝ := (Fintype.card (U (l * u)) : ℝ)
  set S := ∑ ν : NN (l * u), w ν.elt (x (l * u) ν.idx * ν.elt) ^ 2
  have hS : 0 ≤ S := sum_nonneg fun _ _ => sq_nonneg _
  calc _ = ∑ e : {q : Sym2 (U (l * u)) // ¬ q.IsDiag}, f e.1 :=
        sum_congr rfl fun e _ => congrArg f (Sym2.mk_fst_out_snd_out e.1)
    _ ≤ C * b * S := by linarith [(by field_simp : C * (2 * S / b) * b ^ 2 = 2 * (C * b * S))]
    _ ≤ C₀ * (b - 1) * S := mul_le_mul_of_nonneg_right (by nlinarith) hS

/-- Theorem A.6 for products of wires, read as identities between functions of bits (proof of
Theorem G.2, p. 43): if every price makes the wires `σ` cost at most the wires of some `ℬ β`, then
for every large `q` the wires `q σ`, one bit each, are a sum over at most `2 ^ q` indices `i` of
networks whose channels carry the sums `∑ β, v i β * ℬ β` of `q` of the loads `ℬ β`. -/
private theorem exists_bitId {K : Type} [Field K] {V E N B : Type} [Fintype V] [Nonempty V]
    [Fintype E] [Fintype N] [DecidableEq N] [Fintype B] (a b : E → V) (c d : N → V) (σ : E → ℕ)
    (ℬ : B → N → ℕ)
    (h : ∀ w : V → V → ℝ, IsPrice K w →
      ∃ β, ∑ e, (σ e : ℝ) * w (a e) (b e) ≤ ∑ ν, (ℬ β ν : ℝ) * w (c ν) (d ν)) :
    ∃ q₀ : ℕ, ∀ q, q₀ ≤ q → ∃ (m : ℕ) (v : Fin m → B → ℕ), m ≤ 2 ^ q ∧ (∀ i, ∑ β, v i β = q) ∧
      ∃ tab, BitId K (fun s : Σ e, Fin (q * σ e) => a s.1) (fun s => b s.1) c d
        (fun i ν => ∑ β, v i β * ℬ β ν) tab := by
  classical
  have nz {E : Type} [Fintype E] [DecidableEq E] (a b : E → V) (n : E → ℕ) :
      ∃ x, (wires K a b fun e => 2 ^ n e).entry x ≠ 0 :=
    ⟨fun _ _ _ => ⟨0, Nat.two_pow_pos _⟩, prod_ne_zero_iff.2 fun e _ =>
      (unit_entry_of (K := K) (x := fun _ : Fin 2 => (⟨0, Nat.two_pow_pos (n e)⟩ : Fin _))
        fun _ _ => rfl).trans_ne one_ne_zero⟩
  obtain ⟨β₀, -⟩ := h _ isPrice_zero
  obtain ⟨q₀, hq⟩ := exists_coveredBy_pow_of_forall_le
    (A := fun β => wires K c d fun ν => 2 ^ ℬ β ν) (nz a b σ) ⟨β₀, nz c d (ℬ β₀)⟩
    (fun F => (h _ (isPrice_wireExponent F)).imp fun β hβ => by
      rw [apply_wires_two_pow, apply_wires_two_pow]
      exact Real.rpow_le_rpow_of_exponent_le one_le_two hβ) one_pos
  refine ⟨q₀, fun q hq' => ?_⟩
  obtain ⟨m, v, hm, hv, hs⟩ := hq q hq'
  obtain ⟨tab, htab⟩ := exists_wireId ((hs.of_le (antisymmRel_wires_pow a b σ q).2).mono
    fun i => (antisymmRel_prod_wires_pow c d ℬ (v i)).1)
  rw [one_mul, Real.rpow_natCast] at hm
  exact ⟨m, v, by exact_mod_cast hm, hv, _, htab.bitId⟩

/-- The proof of Theorem G.2 (p. 43) for one `h ≥ 2`, from the inequality of Appendix G.1 with
an integer `C₀ ≥ 1`: laws over `K` at the vertices of the tower `SLTower.tower h 0`, with the
contraction `4 C₀` and the length bound `8 C₀ a₁²`, where `a₁` is the scale. -/
private theorem exists_vertexLaws_of_sum_pairs_le {K : Type} [Field K] {h : ℕ} [NeZero h]
    (h2 : 2 ≤ h) {C₀ : ℕ} (hC₀ : 0 < C₀)
    (hP : ∀ w : U h → U h → ℝ, IsPrice K w →
      ∑ e : {q : Sym2 (U h) // ¬ q.IsDiag}, w e.val.out.fst e.val.out.snd ^ 2 ≤
        C₀ * (Fintype.card (U h) - 1) * ∑ ν : NN h, w ν.elt (x h ν.idx * ν.elt) ^ 2) :
    ∃ FL : VertexLaws K (tower h 0 h2),
      FL.contraction = 4 * C₀ ∧ FL.lengthBound = 8 * C₀ * FL.scale ^ 2 := by
  have hb2 : (2 : ℝ) ≤ Fintype.card (U h) := by exact_mod_cast two_le_card_U h2
  have hcard : (Fintype.card (U h) : ℝ) = ((2 ^ ee h : ℕ) : ℝ) := congrArg Nat.cast (card_U h)
  set b : ℝ := (Fintype.card (U h) : ℝ)
  -- the pairs of different elements, and the two norms of Appendix G.1
  let E := {q : Sym2 (U h) // ¬ q.IsDiag}
  let α : E → ℝ := fun _ => 2 / (b * (b - 1))
  let β : NN h → ℝ := fun _ => 2 * C₀ / b
  have hα : ∀ e, 0 < α e := fun _ => div_pos two_pos (by nlinarith)
  have hβ : ∀ ν, 0 < β ν := fun _ => by positivity
  -- for every price, Theorem F.6 compares the two norms
  have hquad (w : U h → U h → ℝ) (hw : IsPrice K w) :
      ∑ e, α e * w e.val.out.fst e.val.out.snd ^ 2 ≤
        ∑ ν, β ν * w ν.elt (x h ν.idx * ν.elt) ^ 2 := by
    simp only [α, β, ← mul_sum]
    rw [div_mul_eq_mul_div, div_le_iff₀ (by nlinarith)]
    exact (mul_le_mul_of_nonneg_left (hP w hw) two_pos.le).trans_eq (by field_simp)
  -- the loads on pairs, the kinds of laws, and the loads on near pairs
  set Z₁ := loadNorm α fun _ => 1
  set Z₂ := loadNorm β fun _ => 1
  have hZ₁ : 0 ≤ Z₁ := loadNorm_nonneg _ _
  have hZ₂ : 0 ≤ Z₂ := loadNorm_nonneg _ _
  obtain ⟨a, ha⟩ := exists_nat_ge (Z₁ + 2 * Z₂ + 1)
  have ha0 : (0 : ℝ) < a := by linarith
  set R := (a : ℝ) + Z₁
  have hR : 0 < R := by linarith
  let _ : Fintype (Loads α R) := @Fintype.ofFinite _ (finite_loads α hα R)
  let _ : Fintype (Loads β (R + Z₂)) := @Fintype.ofFinite _ (finite_loads β hβ _)
  let _ : DecidableEq (Loads α R) := Classical.decEq _
  let _ : DecidableEq (Loads β (R + Z₂)) := Classical.decEq _
  -- for every price, the slots of a load cost at most the channels of a load (Cauchy–Schwarz)
  have hmax (t : Loads α R) (w : U h → U h → ℝ) (hw : IsPrice K w) : ∃ y : Loads β (R + Z₂),
      ∑ e, (t.1 e : ℝ) * w e.val.out.fst e.val.out.snd ≤
        ∑ ν, (y.1 ν : ℝ) * w ν.elt (x h ν.idx * ν.elt) := by
    obtain ⟨y, hy, hle⟩ := exists_load α hα β hβ _ _ (fun ν => hw.nonneg _ _) (hquad w hw) t.1
      hR.le (div_nonneg hZ₂ hR.le) t.2 1 (by rw [Nat.cast_one, one_mul, div_mul_cancel₀ _ hR.ne'])
    exact ⟨⟨y, hy.trans_eq (by
      rw [Nat.cast_one, mul_one, add_mul, one_mul, div_mul_cancel₀ _ hR.ne', add_comm])⟩,
      by simpa using hle⟩
  -- Theorem A.6, with one `q` for all kinds
  choose q₀ hq₀ using fun t : Loads α R => exists_bitId (K := K) (fun e : E => e.val.out.fst)
    (fun e => e.val.out.snd) (fun ν : NN h => ν.elt) (fun ν => x h ν.idx * ν.elt) t.1
    (fun y : Loads β (R + Z₂) => y.1) (hmax t)
  set q := ∑ t, q₀ t + 1
  choose m v hm hv tab htab using fun t => hq₀ t q
    ((single_le_sum (fun _ _ => Nat.zero_le _) (mem_univ t)).trans (Nat.le_succ _))
  -- (a): every load on pairs of norm at most `a q t` is below `t` times the slots of a law
  have hcover (n : Sym2 (U h) → ℕ) (t : ℕ) (ht : √(b * (b - 1) / 2 *
      ∑ r, if r.IsDiag then 0 else (n r : ℝ) ^ 2) ≤ (a * q : ℕ) * t) :
      ∃ σ : Loads α R, ∀ r (hr : ¬ r.IsDiag), n r ≤ q * σ.1 ⟨r, hr⟩ * t := by
    rw [← Fintype.sum_subtype_not_isDiag, mul_sum, ← sum_congr rfl fun e _ =>
      (by simp only [α]; field_simp : (n e.1 : ℝ) ^ 2 / α e = b * (b - 1) / 2 * (n e.1 : ℝ) ^ 2)]
      at ht
    set c : ℝ := ((a * q : ℕ) : ℝ) * t
    have hx : loadNorm α (fun e => c⁻¹ * (n e.1 : ℝ)) ≤ 1 := by
      rw [loadNorm_smul α (by positivity)]
      exact inv_mul_le_one_of_le₀ ht (by positivity)
    let σ (e : E) : ℕ := ⌈(a : ℝ) * (c⁻¹ * n e.1)⌉₊
    have hσ : loadNorm α (fun e => (σ e : ℝ)) ≤ R := by
      refine (loadNorm_mono α hα (fun _ => Nat.cast_nonneg _) fun e =>
        (Nat.ceil_lt_add_one (by positivity)).le).trans ((loadNorm_add_le α hα _ _).trans ?_)
      rw [loadNorm_smul α (Nat.cast_nonneg a)]
      exact add_le_add (mul_le_of_le_one_right (Nat.cast_nonneg a) hx) le_rfl
    refine ⟨⟨σ, hσ⟩, fun r hr => ?_⟩
    rcases Nat.eq_zero_or_pos t with rfl | ht0
    · have h0 := (le_loadNorm α hα _ ⟨r, hr⟩).trans
        (mul_nonpos_of_nonpos_of_nonneg (ht.trans_eq (by simp [c])) (Real.sqrt_nonneg _))
      rw [mul_zero]
      exact_mod_cast h0
    · have hc : (q * a * t : ℝ) = c := by push_cast [c]; ring
      have : (n r : ℝ) ≤ q * σ ⟨r, hr⟩ * t := calc
        (n r : ℝ) = q * ((a : ℝ) * (c⁻¹ * n r)) * t := by
            rw [← hc]; field_simp [ha0.ne', (by positivity : (q : ℝ) ≠ 0)]
        _ ≤ q * σ ⟨r, hr⟩ * t := by gcongr; exact Nat.le_ceil _
      exact_mod_cast this
  -- the slots of a load `σ` on a pair `r` are `q σ r`
  have hcount (σ : E → ℕ) (r : Sym2 (U h)) (hr : ¬ r.IsDiag) :
      #{s : Σ e : E, Fin (q * σ e) | s(s.fst.val.out.fst, s.fst.val.out.snd) = r} =
        q * σ ⟨r, hr⟩ := by
    rw [card_filter, Fintype.sum_sigma]
    simp only [Sym2.mk_fst_out_snd_out]
    rw [Fintype.sum_eq_single ⟨r, hr⟩ fun e he =>
      sum_eq_zero fun _ _ => ite_eq_right (mt Subtype.ext he)]
    simp
  -- (b): the label and the strings on the near pairs are short
  have hshort (t : Loads α R) (i : Fin (m t)) : b * ∑ ν, ((q : ℝ) + ∑ y, (v t i y : ℝ) * y.1 ν) ^ 2
      ≤ 8 * C₀ * ((a : ℝ) * q) ^ 2 := by
    have h1 : loadNorm β (fun ν => ∑ y, (v t i y : ℝ) * y.1 ν) ≤ q * (R + Z₂) := by
      refine (loadNorm_sum_le univ β hβ _).trans ?_
      rw [← hv t i, Nat.cast_sum, sum_mul]
      exact sum_le_sum fun y _ => (loadNorm_smul β (Nat.cast_nonneg _) _).trans_le
        (mul_le_mul_of_nonneg_left y.2 (Nat.cast_nonneg _))
    have h2 : loadNorm β (fun _ => (q : ℝ)) = q * Z₂ := by
      simpa using loadNorm_smul β (Nat.cast_nonneg q) fun _ => (1 : ℝ)
    have h3 := (loadNorm_add_le β hβ _ _).trans (add_le_add h2.le h1)
    rw [loadNorm, Real.sqrt_le_left (by positivity)] at h3
    calc _ = 2 * C₀ * ∑ ν, ((q : ℝ) + ∑ y, (v t i y : ℝ) * y.1 ν) ^ 2 / β ν := by
          rw [mul_sum, mul_sum]; exact sum_congr rfl fun ν _ => by simp only [β]; field_simp
      _ ≤ 2 * C₀ * (q * Z₂ + q * (R + Z₂)) ^ 2 := by gcongr
      _ ≤ 2 * C₀ * (2 * (a * q)) ^ 2 := by gcongr; nlinarith
      _ = _ := by ring
  -- the laws
  let L (t : Loads α R) : Law K :=
    { Role := U h
      Slot := Σ e : E, Fin (q * t.1 e)
      Channel := NN h
      Index := Fin (m t)
      slotEnd s d := cond d s.fst.val.out.snd s.fst.val.out.fst
      slotEnd_ne s hs :=
        s.fst.property (Sym2.mk_fst_out_snd_out s.fst.val ▸ Sym2.mk_isDiag_iff.2 hs)
      channelEnd ν d := cond d (x h ν.idx * ν.elt) ν.elt
      channelEnd_ne := (tower h 0 h2).n_ne
      labelLength := q
      label i := (BitString.equivFin q).symm (Fin.castLE (hm t) i)
      label_injective := (BitString.equivFin q).symm.injective.comp (Fin.castLE_injective _)
      length i ν := ∑ y, v t i y * y.1 ν
      table p i X g := tab t p i (fun e => X ⟨e.1, e.2.elim (⟨false, ·⟩) (⟨true, ·⟩)⟩)
        fun ν => g ⟨ν.1, ν.2.elim (⟨false, ·⟩) (⟨true, ·⟩)⟩
      identity X := htab t X
      connected _ hι := apply_eq_of_near hι }
  refine ⟨{ Kind := Loads α R
            law := L
            place _ := Equiv.refl _
            nearPair _ := Equiv.refl _
            place_channelEnd _ _ := rfl
            labelLength_pos _ := Nat.le_add_left 1 _
            nonempty_index t := univ_nonempty_iff.1 (nonempty_of_sum_ne_zero (by
              rw [← htab t fun _ _ => false, ite_eq_left fun _ => rfl]; exact one_ne_zero))
            scale := a * q
            scale_pos := Nat.mul_pos (by exact_mod_cast ha0) (Nat.succ_pos _)
            contraction := 4 * C₀
            contraction_nonneg := by positivity
            lengthBound := 8 * C₀ * (a * q) ^ 2
            lengthBound_le := le_of_eq (by push_cast; ring)
            exists_le_card_slot n t ht := (hcover n t (by rwa [Tower.NN2_def, ← hcard] at ht)).imp
              fun σ hσ r hr => (hσ r hr).trans_eq (congrArg (· * t) (hcount σ.1 r hr).symm)
            sum_length_sq_le t i := by
              rw [one_mul]
              exact_mod_cast hcard ▸ hshort t i }, rfl, rfl⟩

/-- **Theorem G.2** (p. 43) for one `h` chosen as in (G.1) (p. 42). In the contracting case there
are `h ≥ 3`, a finitely generated subring `A` of `K` and finitely many laws over `A` at the
vertices of the tower `SLTower.tower h 0`, whose contraction `C₁` satisfies `1 + 8 C₁ ≤ h / 4` and
whose length bound is `2 C₁ a₁²` for their scale `a₁`. Clauses (a) and (b) of the theorem are the
fields `exists_le_card_slot` and `sum_length_sq_le` of `VertexLaws`. The proof, like the paper's,
works for every multiple `h ≥ 2u` of the `u` of Theorem F.6, with `C₁ = 4 C₀` for an integer
`C₀ ≥ 2C + 1`; the statement keeps one such `h`. `VertexLaws.transfer` moves the laws to the
towers `SLTower.tower h n`. -/
theorem exists_vertexLaws {K : Type} [Field K] (hK : ContractingCase K) :
    ∃ (h : ℕ) (_ : NeZero h) (h3 : 3 ≤ h) (A : Subring K), Algebra.FiniteType ℤ A ∧
      ∃ FL : VertexLaws A (tower h 0 (by omega)), 1 + 8 * FL.contraction ≤ (h : ℝ) / 4 ∧
        (FL.lengthBound : ℝ) = 2 * FL.contraction * FL.scale ^ 2 := by
  obtain ⟨u, hu, C, hC, hP⟩ := exists_poincareBound hK
  obtain ⟨C₀, hC₀⟩ := exists_nat_ge (2 * C + 1)
  have hC₀0 : 0 < C₀ := by exact_mod_cast (by linarith : (0 : ℝ) < C₀)
  set l := 64 * C₀ + 2 with hl
  have hlu : l * 2 ≤ l * u := Nat.mul_le_mul_left l hu
  have : NeZero (l * u) := ⟨by omega⟩
  obtain ⟨FL, hcon, hlen⟩ := exists_vertexLaws_of_sum_pairs_le (h := l * u) (by omega) hC₀0
    fun w hw => sum_pairs_le_of_poincareBound (by omega) hP hC₀ (by omega) hw
  -- the ring generated by the entries of the tables
  let S := ⋃ d, (FL.law d).entries
  have hA : Algebra.FiniteType ℤ (Algebra.adjoin ℤ S).toSubring := by
    convert Algebra.FiniteType.adjoin_of_finite
      (Set.finite_iUnion fun d => (FL.law d).finite_entries)
  have hmem d p i X g : (FL.law d).table p i X g ∈ (Algebra.adjoin ℤ S).toSubring :=
    Algebra.subset_adjoin (Set.mem_iUnion.2 ⟨d, by
      simp only [Law.entries, Set.mem_iUnion, Set.mem_range]; exact ⟨p, i, X, g, rfl⟩⟩)
  let FL' : VertexLaws (Algebra.adjoin ℤ S).toSubring (tower (l * u) 0 (by omega)) :=
    { FL with law d := (FL.law d).restrict _ (hmem d) }
  refine ⟨l * u, this, by omega, _, hA, FL', ?_, ?_⟩
  · change 1 + 8 * FL.contraction ≤ _
    rw [hcon, le_div_iff₀ four_pos]
    exact_mod_cast ((by omega : (1 + 8 * (4 * C₀)) * 4 = l * 2).trans_le hlu)
  · change (FL.lengthBound : ℝ) = 2 * FL.contraction * FL.scale ^ 2
    rw [hlen, hcon]
    push_cast
    ring

end Cslib.Circuits.Arithmetic.Separation.Laws
