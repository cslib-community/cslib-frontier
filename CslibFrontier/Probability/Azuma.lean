/-!
# Sequential `PMF` processes and the Azuma–Hoeffding inequality

`Cslib.Probability.PMF.seqProcess step n` runs `n` adaptive discrete transitions
`step t : (Fin t → α) → PMF α`, where each step distribution may depend on the full prefix of
previous outcomes. For any real-valued process `X k : (Fin k → α) → ℝ` along these prefixes whose
one-step conditional expectation on supported prefixes `h ∈ (seqProcess step k).support` does not
increase (`∑' x, (step k h x).toReal * X (k + 1) ... ≤ X k h`) and whose one-step values on
`(step k h).support` lie in a history-dependent interval `[a, b]` of width `b - a ≤ c k` bounded
by a deterministic step width `c k`, centering the next value by its conditional mean preserves
that width, `Cslib.Probability.PMF.tsum_mul_exp_sub_mean_le` ([Hoeffding1963, §4, eq. (4.16)])
gives the conditional `[G]` factor ([Azuma1967, §1, p. 357 and Remark 1, p. 358]) with parameter
`c k / 2`, and nonpositive supermartingale drift iterates to the exponential moment bound
`exp (s² (∑ k < n, c k ^ 2) / 8)` (`seqProcess_mul_exp_le`, adapting
[Azuma1967, §2, proof of Lemma 2, display (2.4), pp. 358–359]). Optimizing the Laplace parameter
derives the fixed-time upper, lower, and two-sided Azuma–Hoeffding tail corollaries
(`seqProcess_ge_le`, `seqProcess_le_le`, `seqProcess_abs_sub_ge_le`; cf.
[Hoeffding1963, Theorem 2 (eq. (2.6)) and martingale extension (eq. (2.18))]) on arbitrary outcome
types `α` without `[Fintype α]` or a caller-supplied `[MeasurableSpace α]`, for all `ε ≥ 0`
(including zero total squared width `∑ k < n, c k ^ 2 = 0`, where the bound evaluates to `1`).
Measure-theoretic filtrations and random step widths outside a deterministic envelope `c k` are
outside this finite-horizon `PMF` model.

## Main definitions

* `Cslib.Probability.PMF.seqProcess`: finite-horizon sequential `PMF` process generated by
  history-dependent transition kernels `step t : (Fin t → α) → PMF α`.

## Main results

* `Cslib.Probability.PMF.seqProcess_apply`: explicit trajectory mass as the product of conditional
  transition probabilities along prefixes.
* `Cslib.Probability.PMF.summable_toReal_mul_of_abs_le`,
  `Cslib.Probability.PMF.tsum_toReal_seqProcess_step`: summability of bounded observables and
  one-step conditional expectation decomposition along `seqProcess`.
* `Cslib.Probability.PMF.seqProcess_mul_exp_le`: supermartingale exponential moment bound along
  `seqProcess`.
* `Cslib.Probability.PMF.seqProcess_ge_le`, `Cslib.Probability.PMF.seqProcess_le_le`,
  `Cslib.Probability.PMF.seqProcess_abs_sub_ge_le`: upper, lower, and two-sided Azuma–Hoeffding
  tail bounds along `seqProcess`.

## References

* [W. Hoeffding, *Probability inequalities for sums of bounded random
  variables*][Hoeffding1963]
* [K. Azuma, *Weighted sums of certain dependent random variables*][Azuma1967]
-/

public section

namespace Cslib.Probability.PMF

open scoped BigOperators ENNReal

variable {α : Type*}

/-- Finite-horizon sequential `PMF` process generated by history-dependent transition distributions
`step t : (Fin t → α) → PMF α`. -/
@[expose]
noncomputable def seqProcess (step : ∀ t : ℕ, (Fin t → α) → PMF α) :
    (n : ℕ) → PMF (Fin n → α)
  | 0 => PMF.pure Fin.elim0
  | n + 1 => (seqProcess step n).bind fun h => (step n h).map fun a => Fin.snoc h a

private def snocEquiv (α : Type*) (n : ℕ) : (Fin n → α) × α ≃ (Fin (n + 1) → α) :=
  (Equiv.prodComm (Fin n → α) α).trans (Fin.snocEquiv fun _ => α)

private theorem seqProcess_snoc (step : ∀ t : ℕ, (Fin t → α) → PMF α)
    (n : ℕ) (h₀ : Fin n → α) (a : α) :
    seqProcess step (n + 1) (Fin.snoc (α := fun _ => α) h₀ a) =
      seqProcess step n h₀ * step n h₀ a := by
  rw [seqProcess, PMF.bind_apply, tsum_eq_single h₀ fun h hh => ?_, PMF.map_apply,
    tsum_eq_single a fun b hb => ?_]
  · simp
  · exact ite_eq_right fun heq => hb (Fin.snoc_right_injective (α := fun _ => α) h₀ heq).symm
  · rw [PMF.map_apply, tsum_eq_zero_iff.mpr fun b => ite_eq_right fun heq =>
      hh (Fin.snoc_injective2 (α := fun _ => α) heq).1.symm, mul_zero]

/-- The mass of a trajectory `h : Fin n → α` under `seqProcess step n` is the product of the
one-step transition probabilities along its prefixes. -/
theorem seqProcess_apply (step : ∀ t : ℕ, (Fin t → α) → PMF α) :
    ∀ (n : ℕ) (h : Fin n → α),
      seqProcess step n h =
        ∏ t : Fin n, step t.1 (fun j : Fin t.1 => h (Fin.castLT j (lt_trans j.isLt t.isLt))) (h t)
  | 0, h => by
    rw [seqProcess, Fin.prod_univ_zero, Subsingleton.elim h Fin.elim0, PMF.pure_apply_self]
  | n + 1, h => by
    conv_lhs => rw [← Fin.snoc_init_self h]
    rw [seqProcess_snoc, seqProcess_apply step n (Fin.init h), Fin.prod_univ_castSucc]
    congr 1

/-- Any real observable bounded on `p.support` is summable against `(p ·).toReal`. -/
theorem summable_toReal_mul_of_abs_le (p : PMF α) (f : α → ℝ)
    {C : ℝ} (hC : ∀ x ∈ p.support, |f x| ≤ C) :
    Summable fun x => (p x).toReal * f x := by
  obtain ⟨x₀, hx₀⟩ := p.support_nonempty
  have hC0 : 0 ≤ C := (abs_nonneg (f x₀)).trans (hC x₀ hx₀)
  refine Summable.of_norm_bounded ((summable_toReal p).mul_right C) fun x => ?_
  classical
  by_cases hx : x ∈ p.support
  · rw [Real.norm_eq_abs, abs_mul, abs_of_nonneg ENNReal.toReal_nonneg]
    exact mul_le_mul_of_nonneg_left (hC x hx) ENNReal.toReal_nonneg
  · rw [(p.apply_eq_zero_iff x).mpr hx, ENNReal.toReal_zero, zero_mul, zero_mul, norm_zero]

/-- One-step expectation decomposition along `seqProcess`: averaging a bounded observable
`g : (Fin (n + 1) → α) → ℝ` over `n + 1` steps averages over the first `n` steps and then over
`step n h`. -/
theorem tsum_toReal_seqProcess_step (step : ∀ t : ℕ, (Fin t → α) → PMF α)
    (n : ℕ) (g : (Fin (n + 1) → α) → ℝ) {C : ℝ} (hC : ∀ h, |g h| ≤ C) :
    ∑' h : Fin (n + 1) → α, ((seqProcess step (n + 1)) h).toReal * g h =
      ∑' h : Fin n → α, ((seqProcess step n) h).toReal *
        ∑' a : α, ((step n h) a).toReal * g (Fin.snoc h a) := by
  by_cases hα : Nonempty α
  · have hC0 : 0 ≤ C := (abs_nonneg (g fun _ => Classical.arbitrary α)).trans (hC _)
    let F : (Fin n → α) × α → ℝ := fun p =>
      ((seqProcess step n) p.1).toReal * (((step n p.1) p.2).toReal * g (Fin.snoc p.1 p.2))
    let G : (Fin n → α) × α → ℝ := fun p =>
      ((seqProcess step n) p.1).toReal * ((step n p.1) p.2).toReal * C
    have h2 (h₀ : Fin n → α) :
        HasSum (fun a : α => G (h₀, a)) (((seqProcess step n) h₀).toReal * C) := by
      simpa only [G, tsum_toReal, mul_assoc, one_mul] using
        (((summable_toReal (step n h₀)).hasSum.mul_left
          ((seqProcess step n) h₀).toReal).mul_right C)
    have hs_G : Summable G := (summable_prod_of_nonneg fun _ =>
        mul_nonneg (mul_nonneg ENNReal.toReal_nonneg ENNReal.toReal_nonneg) hC0).mpr
      ⟨fun h₀ => (h2 h₀).summable,
        ((summable_toReal (seqProcess step n)).mul_right C).congr fun h₀ => (h2 h₀).tsum_eq.symm⟩
    have hs_prod : Summable F := Summable.of_norm_bounded hs_G fun p => by
      simp only [F, G, Real.norm_eq_abs, abs_mul, abs_of_nonneg ENNReal.toReal_nonneg, mul_assoc]
      gcongr; exact hC _
    calc ∑' h : Fin (n + 1) → α, ((seqProcess step (n + 1)) h).toReal * g h
        = ∑' p : (Fin n → α) × α, F p := by
          rw [← Equiv.tsum_eq (snocEquiv α n)]
          refine tsum_congr fun p => ?_
          simp only [snocEquiv, Equiv.trans_apply, Equiv.prodComm_apply, Fin.snocEquiv_apply,
            Prod.fst_swap, Prod.snd_swap, F, seqProcess_snoc, ENNReal.toReal_mul, mul_assoc]
      _ = ∑' h : Fin n → α, ((seqProcess step n) h).toReal *
            ∑' a : α, ((step n h) a).toReal * g (Fin.snoc h a) := by
          simpa only [F, tsum_mul_left] using hs_prod.tsum_prod
  · rw [not_nonempty_iff] at hα
    have : IsEmpty (Fin (n + 1) → α) := ⟨fun h => hα.false (h (Fin.last n))⟩
    simp [tsum_empty]

/-- **Azuma–Hoeffding exponential moment bound** along `seqProcess`
[Azuma1967, §2, proof of Lemma 2, display (2.4), pp. 358–359; Hoeffding1963, §2 eq. (2.18) and
§4 eq. (4.16)]: if at each step `k < n` and supported prefix `h`, the conditional expectation of
`X (k + 1) (Fin.snoc h ·)` is at most `X k h` and its values on `(step k h).support` lie in a
history-dependent interval of width at most the deterministic step bound `c k`, then for every
`s ≥ 0` the exponential moment of `s * (X n - X 0)` is at most
`exp (s² * (∑ k ∈ range n, c k ^ 2) / 8)`. -/
theorem seqProcess_mul_exp_le (step : ∀ t : ℕ, (Fin t → α) → PMF α)
    (X : ∀ k : ℕ, (Fin k → α) → ℝ) (c : ℕ → ℝ) (n : ℕ)
    (hmean : ∀ k, k < n → ∀ h ∈ (seqProcess step k).support,
      ∑' x : α, ((step k h) x).toReal * X (k + 1) (Fin.snoc h x) ≤ X k h)
    (hrange : ∀ k, k < n → ∀ h ∈ (seqProcess step k).support,
      ∃ a b : ℝ, b - a ≤ c k ∧ ∀ x ∈ (step k h).support, X (k + 1) (Fin.snoc h x) ∈ Set.Icc a b)
    {s : ℝ} (hs : 0 ≤ s) :
    ∑' h : Fin n → α, seqProcess step n h *
        ENNReal.ofReal (Real.exp (s * (X n h - X 0 Fin.elim0))) ≤
      ENNReal.ofReal (Real.exp (s ^ 2 * (∑ k ∈ Finset.range n, c k ^ 2) / 8)) := by
  induction n with
  | zero =>
    rw [seqProcess, tsum_eq_single Fin.elim0 fun h hh =>
      absurd (Subsingleton.elim h Fin.elim0) hh]
    simp
  | succ n ih =>
    have ih' := ih (fun k hk => hmean k (Nat.lt_succ_of_lt hk))
      (fun k hk => hrange k (Nat.lt_succ_of_lt hk))
    rw [seqProcess, tsum_bind_mul]
    have hstep (h : Fin n → α) :
        seqProcess step n h *
          (∑' h' : Fin (n + 1) → α, ((step n h).map fun x => Fin.snoc h x) h' *
            ENNReal.ofReal (Real.exp (s * (X (n + 1) h' - X 0 Fin.elim0)))) ≤
        seqProcess step n h *
          (ENNReal.ofReal (Real.exp (s * (X n h - X 0 Fin.elim0))) *
            ENNReal.ofReal (Real.exp (s ^ 2 * c n ^ 2 / 8))) := by
      classical
      by_cases hh : h ∈ (seqProcess step n).support
      · rw [tsum_map_mul]
        refine mul_le_mul_right ?_ _
        obtain ⟨a, b, hab_c, hg⟩ := hrange n (Nat.lt_succ_self n) h hh
        obtain ⟨x₀, hx₀⟩ := (step n h).support_nonempty
        have hab0 : 0 ≤ b - a := sub_nonneg.mpr ((hg x₀ hx₀).1.trans (hg x₀ hx₀).2)
        have hsplit (x : α) :
            step n h x *
                ENNReal.ofReal (Real.exp (s * (X (n + 1) (Fin.snoc h x) - X 0 Fin.elim0))) =
              ENNReal.ofReal (Real.exp (s * (X n h - X 0 Fin.elim0))) *
                (step n h x *
                  ENNReal.ofReal (Real.exp (s * (X (n + 1) (Fin.snoc h x) - X n h)))) := by
          rw [show s * (X (n + 1) (Fin.snoc h x) - X 0 Fin.elim0) =
              s * (X n h - X 0 Fin.elim0) + s * (X (n + 1) (Fin.snoc h x) - X n h) by ring,
            Real.exp_add, ENNReal.ofReal_mul (Real.exp_pos _).le, mul_left_comm]
        simp_rw [hsplit]
        rw [ENNReal.tsum_mul_left]
        refine mul_le_mul_right ?_ _
        have hmu := hmean n (Nat.lt_succ_self n) h hh
        refine (tsum_le_tsum fun x => mul_le_mul_right (ENNReal.ofReal_le_ofReal
          (Real.exp_le_exp.mpr (mul_le_mul_of_nonneg_left (sub_le_sub_left hmu _) hs))) _).trans ?_
        refine (tsum_mul_exp_sub_mean_le (step n h) (fun x => X (k := n + 1) (Fin.snoc h x)) hg
          s).trans (ENNReal.ofReal_le_ofReal (Real.exp_le_exp.mpr ?_))
        have hsq : (b - a) ^ 2 ≤ c n ^ 2 := pow_le_pow_left₀ hab0 hab_c 2
        gcongr
      · rw [((seqProcess step n).apply_eq_zero_iff h).mpr hh, zero_mul, zero_mul]
    calc ∑' h : Fin n → α, seqProcess step n h *
            ∑' h' : Fin (n + 1) → α, ((step n h).map fun x => Fin.snoc h x) h' *
              ENNReal.ofReal (Real.exp (s * (X (n + 1) h' - X 0 Fin.elim0)))
        ≤ ∑' h : Fin n → α, seqProcess step n h *
            (ENNReal.ofReal (Real.exp (s * (X n h - X 0 Fin.elim0))) *
              ENNReal.ofReal (Real.exp (s ^ 2 * c n ^ 2 / 8))) := tsum_le_tsum hstep
      _ = (∑' h : Fin n → α, seqProcess step n h *
            ENNReal.ofReal (Real.exp (s * (X n h - X 0 Fin.elim0)))) *
            ENNReal.ofReal (Real.exp (s ^ 2 * c n ^ 2 / 8)) := by
          simp_rw [← mul_assoc, ENNReal.tsum_mul_right]
      _ ≤ ENNReal.ofReal (Real.exp (s ^ 2 * (∑ k ∈ Finset.range n, c k ^ 2) / 8)) *
            ENNReal.ofReal (Real.exp (s ^ 2 * c n ^ 2 / 8)) := mul_le_mul_left ih' _
      _ = ENNReal.ofReal (Real.exp (s ^ 2 * (∑ k ∈ Finset.range (n + 1), c k ^ 2) / 8)) := by
          rw [← ENNReal.ofReal_mul (Real.exp_pos _).le, ← Real.exp_add, Finset.sum_range_succ]
          exact congrArg (ENNReal.ofReal ∘ Real.exp) (by ring)

/-- **Azuma–Hoeffding inequality, upper tail**
[Azuma1967, §2, proof of Lemma 2, display (2.4), pp. 358–359; Hoeffding1963, Theorem 2 (eq. (2.6))
and eq. (2.18)]: if `X` is a discrete supermartingale along `seqProcess step` whose one-step
conditional support at each supported prefix lies in a history-dependent interval of width at most
the deterministic step bound `c k` (`k < n`), then `X n` exceeds `X 0 Fin.elim0 + ε` (`ε ≥ 0`) with
probability at most `exp (-2 ε² / ∑ k ∈ range n, c k ^ 2)` (`1` when
`∑ k ∈ range n, c k ^ 2 = 0`). -/
theorem seqProcess_ge_le (step : ∀ t : ℕ, (Fin t → α) → PMF α)
    (X : ∀ k : ℕ, (Fin k → α) → ℝ) (c : ℕ → ℝ) (n : ℕ)
    (hmean : ∀ k, k < n → ∀ h ∈ (seqProcess step k).support,
      ∑' x : α, ((step k h) x).toReal * X (k + 1) (Fin.snoc h x) ≤ X k h)
    (hrange : ∀ k, k < n → ∀ h ∈ (seqProcess step k).support,
      ∃ a b : ℝ, b - a ≤ c k ∧ ∀ x ∈ (step k h).support, X (k + 1) (Fin.snoc h x) ∈ Set.Icc a b)
    {ε : ℝ} (hε : 0 ≤ ε) :
    ((seqProcess step n).toOuterMeasure {h | X 0 Fin.elim0 + ε ≤ X n h}).toReal ≤
      Real.exp (-2 * ε ^ 2 / ∑ k ∈ Finset.range n, c k ^ 2) := by
  set V : ℝ := ∑ k ∈ Finset.range n, c k ^ 2
  have hV0 : 0 ≤ V := Finset.sum_nonneg fun k _ => sq_nonneg (c k)
  rcases eq_or_lt_of_le hV0 with hV_zero | hV_pos
  · rw [← hV_zero, div_zero, Real.exp_zero]
    exact toOuterMeasure_toReal_le_one _ _
  · set s : ℝ := 4 * ε / V
    have hs : 0 ≤ s := div_nonneg (by linarith) hV_pos.le
    set E : Set (Fin n → α) := {h | X 0 Fin.elim0 + ε ≤ X n h}
    have hmarkov : (seqProcess step n).toOuterMeasure E * ENNReal.ofReal (Real.exp (s * ε)) ≤
        ENNReal.ofReal (Real.exp (s ^ 2 * V / 8)) := by
      rw [toOuterMeasure_eq_tsum_mul_indicator, ← ENNReal.tsum_mul_right]
      refine (tsum_le_tsum fun h => ?_).trans
        (seqProcess_mul_exp_le step X c n hmean hrange hs)
      rw [mul_assoc]
      refine mul_le_mul_right ?_ _
      classical
      by_cases hh : h ∈ E
      · simp only [Set.indicator_of_mem hh, Pi.one_apply, one_mul]
        exact ENNReal.ofReal_le_ofReal (Real.exp_le_exp.mpr
          (mul_le_mul_of_nonneg_left (le_sub_iff_add_le'.mpr hh) hs))
      · simp only [Set.indicator_of_notMem hh, zero_mul, zero_le]
    have hdiv : ((seqProcess step n).toOuterMeasure E).toReal ≤
        Real.exp (s ^ 2 * V / 8 - s * ε) := by
      have hm := ENNReal.toReal_mono ENNReal.ofReal_ne_top hmarkov
      rw [ENNReal.toReal_mul, ENNReal.toReal_ofReal (Real.exp_pos _).le,
        ENNReal.toReal_ofReal (Real.exp_pos _).le] at hm
      rwa [Real.exp_sub, le_div_iff₀ (Real.exp_pos _)]
    refine hdiv.trans_eq (congrArg Real.exp ?_)
    dsimp only [s]
    field_simp [hV_pos.ne']
    ring

/-- **Azuma–Hoeffding inequality, lower tail**
[Azuma1967, §2, proof of Lemma 2, display (2.4), pp. 358–359; Hoeffding1963, Theorem 2 (eq. (2.6))
and eq. (2.18)]: if `X` is a discrete submartingale along `seqProcess step` whose one-step
conditional support at each supported prefix lies in a history-dependent interval of width at most
the deterministic step bound `c k` (`k < n`), then `X n` falls at or below `X 0 Fin.elim0 - ε`
(`ε ≥ 0`) with probability at most `exp (-2 ε² / ∑ k ∈ range n, c k ^ 2)`. -/
theorem seqProcess_le_le (step : ∀ t : ℕ, (Fin t → α) → PMF α)
    (X : ∀ k : ℕ, (Fin k → α) → ℝ) (c : ℕ → ℝ) (n : ℕ)
    (hmean : ∀ k, k < n → ∀ h ∈ (seqProcess step k).support,
      X k h ≤ ∑' x : α, ((step k h) x).toReal * X (k + 1) (Fin.snoc h x))
    (hrange : ∀ k, k < n → ∀ h ∈ (seqProcess step k).support,
      ∃ a b : ℝ, b - a ≤ c k ∧ ∀ x ∈ (step k h).support, X (k + 1) (Fin.snoc h x) ∈ Set.Icc a b)
    {ε : ℝ} (hε : 0 ≤ ε) :
    ((seqProcess step n).toOuterMeasure {h | X n h ≤ X 0 Fin.elim0 - ε}).toReal ≤
      Real.exp (-2 * ε ^ 2 / ∑ k ∈ Finset.range n, c k ^ 2) := by
  have heq : {h : Fin n → α | X n h ≤ X 0 Fin.elim0 - ε} =
      {h : Fin n → α | -X 0 Fin.elim0 + ε ≤ -X n h} := by
    ext h
    simp only [Set.mem_ofPred_eq]
    constructor <;> intro hh <;> linarith
  rw [heq]
  refine seqProcess_ge_le step (fun k h => -X k h) c n (fun k hk h hh => ?_)
    (fun k hk h hh => ?_) hε
  · simp_rw [mul_neg, tsum_neg]
    exact neg_le_neg (hmean k hk h hh)
  · obtain ⟨a, b, hab, hg⟩ := hrange k hk h hh
    refine ⟨-b, -a, by linarith, fun x hx => ?_⟩
    exact ⟨neg_le_neg (hg x hx).2, neg_le_neg (hg x hx).1⟩

/-- **Azuma–Hoeffding inequality, two-sided tail**
[Azuma1967, §2, proof of Lemma 2, display (2.4), pp. 358–359; Hoeffding1963, Theorem 2 (eq. (2.6))
and eq. (2.18)]: if `X` is a discrete martingale along `seqProcess step` whose one-step conditional
support at each supported prefix lies in a history-dependent interval of width at most the
deterministic step bound `c k` (`k < n`), then `|X n - X 0 Fin.elim0| ≥ ε` (`ε ≥ 0`) with
probability at most `2 * exp (-2 ε² / ∑ k ∈ range n, c k ^ 2)`. -/
theorem seqProcess_abs_sub_ge_le (step : ∀ t : ℕ, (Fin t → α) → PMF α)
    (X : ∀ k : ℕ, (Fin k → α) → ℝ) (c : ℕ → ℝ) (n : ℕ)
    (hmean : ∀ k, k < n → ∀ h ∈ (seqProcess step k).support,
      ∑' x : α, ((step k h) x).toReal * X (k + 1) (Fin.snoc h x) = X k h)
    (hrange : ∀ k, k < n → ∀ h ∈ (seqProcess step k).support,
      ∃ a b : ℝ, b - a ≤ c k ∧ ∀ x ∈ (step k h).support, X (k + 1) (Fin.snoc h x) ∈ Set.Icc a b)
    {ε : ℝ} (hε : 0 ≤ ε) :
    ((seqProcess step n).toOuterMeasure {h | ε ≤ |X n h - X 0 Fin.elim0|}).toReal ≤
      2 * Real.exp (-2 * ε ^ 2 / ∑ k ∈ Finset.range n, c k ^ 2) := by
  linarith [toOuterMeasure_abs_sub_ge_toReal_le (seqProcess step n) (X n) (X 0 Fin.elim0) ε,
    seqProcess_ge_le step X c n (fun k hk h hh => (hmean k hk h hh).le) hrange hε,
    seqProcess_le_le step X c n (fun k hk h hh => (hmean k hk h hh).ge) hrange hε]

end Cslib.Probability.PMF
