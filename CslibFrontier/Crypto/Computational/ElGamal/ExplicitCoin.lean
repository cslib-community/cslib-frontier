public import CslibFrontier.Crypto.Protocols.PKE.ExplicitCoin
public import Mathlib.Algebra.Module.ZMod

/-!
# Multiplicative ElGamal over a fixed group

Section 12.6.2 of Boneh and Shoup ([BonehShoup2023], printed pp. 499–500) defines multiplicative
ElGamal over a cyclic group `𝔾` of prime order `q` generated by `g`: `G_a()` draws `α ←R ℤ_q` and
outputs `(g^α, α)`, `E_a(u, x; β)` outputs `(g^β, u^β x)`, and `D_a(α, (v, y))` outputs
`y / v^α`.

`elGamalExplicitCoinPKEWith q g sample` is this scheme in additive notation over a
`ZMod q`-module `G`, parameterized by the exponent sampler `sample : ProbComp (ZMod q)`, and
`elGamalExplicitCoinPKE q g` specializes `sample` to the exact uniform distribution `$ᵗ ZMod q`
(for `q ≠ 0`). The definition and its correctness (`elGamalExplicitCoinPKEWith_correct`) need
neither `q ≠ 0`, that `q` is prime, nor that `g` generates `G`. The module imports no group
family: the fair-coin instantiation with `PrimeOrderGroupFamily.sampleExp` is in
`CslibFrontier/Crypto/Computational/ElGamal/ProbComp.lean`, and the reduction to CDH is in
`CslibFrontier/Crypto/Computational/ElGamal/OneWay.lean`.

## Main definitions

* `Cslib.Crypto.elGamalExplicitCoinPKEWith`: multiplicative ElGamal over a fixed group for a given
  exponent sampler.
* `Cslib.Crypto.elGamalExplicitCoinPKE`: multiplicative ElGamal with exact uniform exponents
  `$ᵗ ZMod q`.

## Main results

* `Cslib.Crypto.elGamalExplicitCoinPKEWith_correct`: correctness for any exponent sampler.

## References

* [D. Boneh, V. Shoup, *A Graduate Course in Applied Cryptography*, Version 0.6][BonehShoup2023],
  Section 12.6.2 (printed pp. 499–500).
-/

public section

namespace Cslib.Crypto

open Probability Protocols

variable {G : Type} [AddCommGroup G] (q : ℕ) [Module (ZMod q) G] (g : G)

/-- Multiplicative ElGamal ([BonehShoup2023], Section 12.6.2, pp. 499–500) in additive notation
over the group generated by `g`, drawing both the secret key `α` and the encryption coins `β` from
`sample : ProbComp (ZMod q)`: the public key is `α • g`, a message `x` is encrypted with coins `β`
as `(β • g, β • u + x)`, and a ciphertext `(v, y)` decrypts to `y - α • v`. -/
@[expose]
def elGamalExplicitCoinPKEWith (sample : ProbComp (ZMod q)) :
    ExplicitCoinPKE G (ZMod q) G (ZMod q) (G × G) where
  keyGen := do
    let α ← sample
    return (α • g, α)
  sampleCoins := sample
  encDet u x β := (β • g, β • u + x)
  dec α ct := some (ct.2 - α • ct.1)

/-- Multiplicative ElGamal ([BonehShoup2023], Section 12.6.2, pp. 499–500) in additive notation
over the group generated by `g`, with exact uniform exponents `$ᵗ ZMod q`. -/
noncomputable abbrev elGamalExplicitCoinPKE [NeZero q] :
    ExplicitCoinPKE G (ZMod q) G (ZMod q) (G × G) :=
  elGamalExplicitCoinPKEWith q g ($ᵗ ZMod q)

/-- Multiplicative ElGamal decrypts every honest encryption correctly, for any exponent sampler. -/
theorem elGamalExplicitCoinPKEWith_correct (sample : ProbComp (ZMod q)) :
    (elGamalExplicitCoinPKEWith q g sample).toPKE.Correct := by
  intro keys hkeys m ct hct
  simp only [ExplicitCoinPKE.toPKE, elGamalExplicitCoinPKEWith, ExplicitCoinPKE.encrypt,
    ProbComp.eval_bind, ProbComp.eval_pure, PMF.mem_support_bind_iff, PMF.support_pure,
    Set.mem_singleton_iff] at hkeys hct
  obtain ⟨α, _, rfl⟩ := hkeys
  obtain ⟨β, _, rfl⟩ := hct
  simp [ExplicitCoinPKE.toPKE, elGamalExplicitCoinPKEWith, smul_smul, mul_comm β α]

end Cslib.Crypto
