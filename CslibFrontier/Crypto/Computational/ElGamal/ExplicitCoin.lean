-- upstream: candidate

public import CslibFrontier.Crypto.Protocols.PKE.ExplicitCoin
public import Mathlib.Algebra.Module.ZMod

/-!
# Multiplicative ElGamal over a fixed group

Section 12.6.2 of Boneh and Shoup ([BonehShoup2023], printed pp. 499–500) defines multiplicative
ElGamal over a cyclic group `𝔾` of prime order `q` generated by `g`: `G_a()` draws `α ←R ℤ_q` and
outputs `(g^α, α)`, `E_a(u, x; β)` outputs `(g^β, u^β x)`, and `D_a(α, (v, y))` outputs
`y / v^α`.

`elGamalExplicitCoinPKE q g` is this scheme in additive notation over a `ZMod q`-module `G` with
`q ≠ 0`, as a public-key scheme whose encryption coins are the exponent `β`. The definition and
its correctness need neither that `q` is prime nor that `g` generates `G`. The module imports no
group family: the reduction to CDH is in
`CslibFrontier/Crypto/Computational/ElGamal/OneWay.lean`.

## Main definitions

* `Cslib.Crypto.elGamalExplicitCoinPKE`: multiplicative ElGamal over a fixed group.

## Main results

* `Cslib.Crypto.elGamalExplicitCoinPKE_correct`: correctness.

## References

* [D. Boneh, V. Shoup, *A Graduate Course in Applied Cryptography*, Version 0.6][BonehShoup2023],
  Section 12.6.2 (printed pp. 499–500).
-/

public section

namespace Cslib.Crypto

open Probability Protocols

variable {G : Type} [AddCommGroup G] (q : ℕ) [NeZero q] [Module (ZMod q) G] (g : G)

/-- Multiplicative ElGamal ([BonehShoup2023], Section 12.6.2, pp. 499–500) in additive notation
over the group generated by `g`: the secret key is `α`, the public key `α • g`; a message `x` is
encrypted with coins `β` as `(β • g, β • u + x)` and a ciphertext `(v, y)` decrypts to
`y - α • v`. -/
@[expose]
noncomputable def elGamalExplicitCoinPKE : ExplicitCoinPKE G (ZMod q) G (ZMod q) (G × G) where
  keyGen := do
    let α ← $ᵗ ZMod q
    return (α • g, α)
  sampleCoins := $ᵗ ZMod q
  encDet u x β := (β • g, β • u + x)
  dec α ct := some (ct.2 - α • ct.1)

/-- Multiplicative ElGamal decrypts every honest encryption correctly. -/
theorem elGamalExplicitCoinPKE_correct : (elGamalExplicitCoinPKE q g).toPKE.Correct := by
  intro keys hkeys m ct hct
  simp only [ExplicitCoinPKE.toPKE, elGamalExplicitCoinPKE, ExplicitCoinPKE.encrypt,
    ProbComp.eval_bind, ProbComp.eval_pure, PMF.mem_support_bind_iff, PMF.support_pure,
    Set.mem_singleton_iff] at hkeys hct
  obtain ⟨α, _, rfl⟩ := hkeys
  obtain ⟨β, _, rfl⟩ := hct
  simp [ExplicitCoinPKE.toPKE, elGamalExplicitCoinPKE, smul_smul, mul_comm β α]

end Cslib.Crypto
