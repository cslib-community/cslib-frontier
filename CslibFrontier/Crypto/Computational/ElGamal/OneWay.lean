/-!
# Multiplicative ElGamal is one-way under CDH

Section 12.6.2 of Boneh and Shoup ([BonehShoup2023], printed pp. 499–500) notes that
multiplicative ElGamal over a cyclic group `𝔾` of prime order `q` generated by `g` "is one-way
under the CDH assumption": an adversary `𝒜` against Attack Game 12.6 "is easily converted to an
adversary `ℬ` that breaks the CDH with same advantage". Given `(u, v)`, `ℬ` "sets `y ←R 𝔾`, and
gives `𝒜` the public key `u` and the ciphertext `(v, y)`; when `𝒜` outputs `x ∈ 𝔾`, adversary `ℬ`
outputs `w ← y/x`."

The scheme is `elGamalExplicitCoinPKE q g` of
`CslibFrontier/Crypto/Computational/ElGamal/ExplicitCoin.lean`, in additive notation over a
`ZMod q`-module `G`, and `elGamalOWToCDH sampleGroup A` is the adversary `ℬ`, with `y` drawn from
`sampleGroup`. When the message and `y` are both drawn as `γ • g` for uniform `γ`, the one-way
experiment and the CDH experiment of `ℬ` have the same law
(`eval_owExperiment_elGamalExplicitCoinPKE`), so the advantages are equal
(`owAdvantage_elGamalExplicitCoinPKE_eq_cdhAdvantage`). This needs neither finiteness of `G` nor
that `g` generates it. In the book `g` generates `𝔾`, so `γ • g` for uniform `γ` is the book's
uniform draw from `𝔾`.

For a prime-order group family, `elGamalOWGame` is Attack Game 12.6 on the scheme of each group,
with the message drawn as `γ • g`, which is uniform on the group because the family's generator
generates it (`smul_generator_bijective`). `elGamalOWToCDHAdversary` is `ℬ` with `y` drawn through
the family's polynomial-time exponent sampler `sampleExp`, and is efficient whenever `𝒜` is
(`isPPT_elGamalOWToCDHAdversary`). Because `sampleExp` is within `1 / 2 ^ n` of uniform, the two
games differ by at most `1 / 2 ^ n` (`advantage_elGamalOWGame_cdhGame_le`), not exactly, and
`CDH.elGamal_oneWay` concludes that every efficient typed adversary has negligible advantage under
CDH. Adversaries read and write group elements, as CDH adversaries of the family do; a word-level
one-wayness predicate would need a decoder for group elements, which the family does not provide.

## Main definitions

* `Cslib.Crypto.elGamalOWToCDH`: the book's adversary `ℬ`.
* `Cslib.Crypto.PrimeOrderGroupFamily.ElGamalOWAdversary`, `…ElGamalOWAdversary.IsPPT`: typed
  one-way adversaries against a family, and their efficiency.
* `Cslib.Crypto.PrimeOrderGroupFamily.elGamalOWToCDHAdversary`: the reduction for a family.
* `Cslib.Crypto.PrimeOrderGroupFamily.elGamalOWGame`: Attack Game 12.6 for a family.

## Main results

* `Cslib.Crypto.eval_owExperiment_elGamalExplicitCoinPKE`,
  `Cslib.Crypto.owAdvantage_elGamalExplicitCoinPKE_eq_cdhAdvantage`: equal advantage in a fixed
  group.
* `Cslib.Crypto.PrimeOrderGroupFamily.isPPT_elGamalOWToCDHAdversary`: the reduction is efficient.
* `Cslib.Crypto.PrimeOrderGroupFamily.advantage_elGamalOWGame_cdhGame_le`: the family games differ
  by at most `1 / 2 ^ n`.
* `Cslib.Crypto.PrimeOrderGroupFamily.CDH.elGamal_oneWay`: one-wayness under CDH.

## References

* [D. Boneh, V. Shoup, *A Graduate Course in Applied Cryptography*, Version 0.6][BonehShoup2023],
  Section 12.6.2 (printed pp. 499–500).
-/

public section

namespace Cslib.Crypto

open Probability Protocols Turing.MultiTapeTM
open scoped NNReal

section FixedGroup

variable {G : Type} [AddCommGroup G] (q : ℕ) [NeZero q] [Module (ZMod q) G] (g : G)

/-- The adversary `ℬ` of [BonehShoup2023], Section 12.6.2, p. 500, that turns a one-way adversary
`A` against multiplicative ElGamal into a CDH adversary: on `(u, v)` draw `y ← sampleGroup`, run
`A` on the public key `u` and the ciphertext `(v, y)`, and output `y - x` for its answer `x`. -/
@[expose]
def elGamalOWToCDH (sampleGroup : ProbComp G) (A : G → G × G → ProbComp G) :
    G → G → ProbComp G :=
  fun u v => do
    let y ← sampleGroup
    let x ← A u (v, y)
    return y - x

variable [DecidableEq G]

/-- **The one-way experiment of multiplicative ElGamal is the CDH experiment of `ℬ`**
([BonehShoup2023], Section 12.6.2, p. 500), when the message and `ℬ`'s `y` are both drawn as
`γ • g` for uniform `γ`. -/
theorem eval_owExperiment_elGamalExplicitCoinPKE (A : G → G × G → ProbComp G) :
    ProbComp.eval (PKE.owExperiment (elGamalExplicitCoinPKE q g).toPKE
        ((fun γ : ZMod q => γ • g) <$> ($ᵗ ZMod q)) A) =
      ProbComp.eval (cdhExperiment q g
        (elGamalOWToCDH ((fun γ : ZMod q => γ • g) <$> ($ᵗ ZMod q)) A)) := by
  simp only [PKE.owExperiment, ExplicitCoinPKE.toPKE, ExplicitCoinPKE.encrypt,
    elGamalExplicitCoinPKE, cdhExperiment, elGamalOWToCDH,
    ProbComp.eval_bind, ProbComp.eval_map, ProbComp.eval_uniform, ProbComp.eval_pure,
    PMF.bind_bind, PMF.pure_bind, PMF.bind_map, Function.comp_def]
  refine congrArg (PMF.bind _) (funext fun α => ?_)
  rw [PMF.bind_comm]
  refine congrArg (PMF.bind _) (funext fun β => ?_)
  rw [← PMF.uniformOfFintype_bind_equiv (Equiv.addLeft (α * β))
    (fun δ => (ProbComp.eval (A (α • g) (β • g, δ • g))).bind fun x' =>
      PMF.pure (decide (δ • g - x' = (α * β) • g)))]
  refine congrArg (PMF.bind _) (funext fun γ => ?_)
  have hsmul : β • (α • g) = (α * β) • g := by rw [smul_smul, mul_comm β α]
  simp only [Equiv.coe_addLeft, hsmul, add_smul]
  refine congrArg (PMF.bind _) (funext fun x' => ?_)
  have hsub : ((α * β) • g + γ • g - x' = (α * β) • g) ↔ (x' = γ • g) := by
    rw [sub_eq_iff_eq_add, eq_comm, add_left_cancel_iff, eq_comm]
  simp [hsub]

/-- **"Breaks the CDH with same advantage"** ([BonehShoup2023], Section 12.6.2, p. 500): in a fixed
group, the one-way advantage against multiplicative ElGamal equals the CDH advantage of `ℬ`. -/
theorem owAdvantage_elGamalExplicitCoinPKE_eq_cdhAdvantage (A : G → G × G → ProbComp G) :
    PKE.owAdvantage (elGamalExplicitCoinPKE q g).toPKE
        ((fun γ : ZMod q => γ • g) <$> ($ᵗ ZMod q)) A =
      cdhAdvantage q g (elGamalOWToCDH ((fun γ : ZMod q => γ • g) <$> ($ᵗ ZMod q)) A) := by
  unfold PKE.owAdvantage cdhAdvantage Experiment.succProbability
  rw [eval_owExperiment_elGamalExplicitCoinPKE]

end FixedGroup

namespace PrimeOrderGroupFamily

variable (F : PrimeOrderGroupFamily)

/-- A typed one-way adversary against multiplicative ElGamal over a prime-order group family: it
receives the security parameter, the group description, the public key and the ciphertext, and
outputs a group element. -/
abbrev ElGamalOWAdversary : Type :=
  ℕ → (d : F.Desc) → F.Carrier d → F.Carrier d × F.Carrier d → ProbComp (F.Carrier d)

/-- A typed one-way adversary is efficient when it is uniform strict PPT on the encoded input
`(1ⁿ, d, encode u, encode v, encode y)` with the encoded output. The input is a `DDHInput`, whose
fields carry the public key `u` (`leftPublic`) and the ciphertext `(v, y)` (`rightPublic`,
`candidateShared`). -/
@[expose]
def ElGamalOWAdversary.IsPPT {F : PrimeOrderGroupFamily} (A : F.ElGamalOWAdversary) : Prop :=
  IsPPTOn F.encDDHInput encBits fun x =>
    F.encode x.groupParameters <$>
      A x.secParam x.groupParameters x.leftPublic (x.rightPublic, x.candidateShared)

/-- The reduction `ℬ` for a prime-order group family ([BonehShoup2023], Section 12.6.2, p. 500):
`elGamalOWToCDH` in each group, with `y` drawn as `c • g` for `c ← sampleExp n d`. -/
noncomputable def elGamalOWToCDHAdversary (A : F.ElGamalOWAdversary) : F.CDHAdversary :=
  fun n d =>
    elGamalOWToCDH ((fun c => (c : ZMod (F.order d)) • F.generator d) <$> F.sampleExp n d) (A n d)

/-- `elGamalOWToCDHAdversary A` is an efficient CDH adversary whenever `A` is efficient. The
subtraction `y - x` is computed as an ElGamal decryption with secret key `1`. -/
theorem isPPT_elGamalOWToCDHAdversary {F : PrimeOrderGroupFamily} {A : F.ElGamalOWAdversary}
    (hA : A.IsPPT) : (F.elGamalOWToCDHAdversary A).IsPPT := by
  unfold CDHAdversary.IsPPT elGamalOWToCDHAdversary elGamalOWToCDH
  have hsample : IsPPTOn F.encCDHInput encNat
      (fun x : F.CDHInput => F.sampleExp x.secParam x.groupParameters) :=
    F.isPPTOn_sampleExp (by fun_prop) (by fun_prop)
  have hd : ComputableInPolyTime (fun p : F.CDHInput × ℕ => p.1.groupParameters)
      (encPair F.encCDHInput encNat) F.encDesc := by fun_prop
  have hy : ComputableInPolyTime
      (fun p : F.CDHInput × ℕ => F.encode p.1.groupParameters
        ((p.2 : ZMod (F.order p.1.groupParameters)) • F.generator p.1.groupParameters))
      (encPair F.encCDHInput encNat) encBits :=
    F.computableInPolyTime_encode_natCast_smul hd (ComputableInPolyTime.snd _ _)
      (F.computableInPolyTime_encode_generator hd)
  have hrunA : IsPPTOn (encPair F.encCDHInput encNat) encBits fun p : F.CDHInput × ℕ =>
      F.encode p.1.groupParameters <$> A p.1.secParam p.1.groupParameters p.1.leftPublic
        (p.1.rightPublic,
          (p.2 : ZMod (F.order p.1.groupParameters)) • F.generator p.1.groupParameters) :=
    hA.preprocess (F.encDDHInput_mk_polyTime (by fun_prop) hd (by fun_prop) (by fun_prop) hy)
  let fpost : (F.CDHInput × ℕ) → List Bool → List Bool := fun p w =>
    F.decodeElGamal (p.1.groupParameters, 1, w, F.encode p.1.groupParameters
      ((p.2 : ZMod (F.order p.1.groupParameters)) • F.generator p.1.groupParameters))
  have hpost : ComputableInPolyTime (fun q : (F.CDHInput × ℕ) × List Bool => fpost q.1 q.2)
      (encPair (encPair F.encCDHInput encNat) encBits) encBits :=
    F.computableInPolyTime_decodeElGamal.comp
      ((hd.comp (ComputableInPolyTime.fst _ _)).prod ((ComputableInPolyTime.const 1).prod
        ((ComputableInPolyTime.snd _ _).prod (hy.comp (ComputableInPolyTime.fst _ _)))))
  refine (IsPPTOn.bind_pair hsample (hrunA.map_with (f := fpost) hpost)).congr fun x => ?_
  simp only [fpost, ProbComp.eval_map, ProbComp.eval_bind, ProbComp.eval_pure,
    PMF.map, Function.comp_def, PMF.bind_bind, PMF.pure_bind, F.decodeElGamal_encode,
    elGamalDecrypt, Nat.cast_one, one_smul]

/-- **Attack Game 12.6 for multiplicative ElGamal over a group family** ([BonehShoup2023],
Section 12.6, p. 495, and Section 12.6.2): draw the group description from `setup n` and run
`PKE.owExperiment` on its scheme, with the message drawn as `γ • g` for uniform `γ`. That law is
uniform on the group, as the book's `x ←R 𝔾` is, because `γ ↦ γ • g` is a bijection
(`smul_generator_bijective`). -/
@[expose]
noncomputable def elGamalOWGame (setup : ℕ → PMF F.Desc) (A : F.ElGamalOWAdversary) (n : ℕ) :
    Game :=
  Game.withSetup (setup n) fun d =>
    PKE.owExperiment (elGamalExplicitCoinPKE (F.order d) (F.generator d)).toPKE
      ((fun γ : ZMod (F.order d) => γ • F.generator d) <$> ($ᵗ ZMod (F.order d))) (A n d)

/-- The one-way game against multiplicative ElGamal and the CDH game of `elGamalOWToCDHAdversary`
differ by at most `1 / 2 ^ n`, the distance of `sampleExp` from uniform. -/
theorem advantage_elGamalOWGame_cdhGame_le (setup : ℕ → PMF F.Desc) (A : F.ElGamalOWAdversary)
    (n : ℕ) :
    Game.advantage (F.elGamalOWGame setup A n)
      (F.cdhGame setup (F.elGamalOWToCDHAdversary A) n) ≤ 1 / 2 ^ n := by
  refine Game.advantage_withSetup_le _ _ _ fun d _ => ?_
  rw [Experiment.advantage, eval_owExperiment_elGamalExplicitCoinPKE]
  have key (S : ProbComp (F.Carrier d)) :
      ProbComp.eval (cdhExperiment (F.order d) (F.generator d) (elGamalOWToCDH S (A n d))) =
        (ProbComp.eval S).bind fun y => ProbComp.eval (cdhExperiment (F.order d)
          (F.generator d) fun u v => A n d u (v, y) >>= fun x => pure (y - x)) :=
    eval_cdhExperiment_bind (F.order d) (F.generator d) S fun y u v =>
      A n d u (v, y) >>= fun x => pure (y - x)
  unfold elGamalOWToCDHAdversary
  rw [key, key, ProbComp.eval_map, ProbComp.eval_map, ProbComp.eval_uniform, PMF.bind_map,
    PMF.bind_map, Game.advantage_comm]
  simp only [ProbComp.eval_bind, ProbComp.eval_pure, PMF.bind_bind, PMF.pure_bind,
    Function.comp_def]
  exact_mod_cast F.advantage_bind_sampleExp_le n d fun δ =>
    ProbComp.eval (cdhExperiment (F.order d) (F.generator d)
      fun u v => A n d u (v, δ • F.generator d) >>= fun x => pure (δ • F.generator d - x))

/-- **Multiplicative ElGamal is one-way under CDH** ([BonehShoup2023], Section 12.6.2, p. 500): if
CDH holds for the family under `setup`, every efficient typed adversary wins Attack Game 12.6 with
negligible probability. -/
theorem CDH.elGamal_oneWay {F : PrimeOrderGroupFamily} {setup : ℕ → PMF F.Desc}
    (hCDH : F.CDH setup) (A : F.ElGamalOWAdversary) (hA : A.IsPPT) :
    Negligible fun n => Game.succProbability (F.elGamalOWGame setup A n) := by
  have hcdh := hCDH _ (isPPT_elGamalOWToCDHAdversary hA)
  negligible using fun n => Game.succProbability_le_add_of_advantage_le
    (F.advantage_elGamalOWGame_cdhGame_le setup A n)

end PrimeOrderGroupFamily

end Cslib.Crypto
