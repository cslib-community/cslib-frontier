/-!
# The small-prime-factor test for Decisional Diffie–Hellman

In a cyclic group of order `q` whose order has a prime divisor `l`, whether a discrete logarithm is
divisible by `l` is visible from raising to the power `q / l`: `(q / l) • (a • g) = 0` exactly when
`l ∣ a.val` (`div_nsmul_smul_eq_zero_iff`). Because `l` is prime, `l` divides `(a * b).val` in
`ZMod q` exactly when `l` divides `a.val` or `b.val` (`dvd_val_mul_iff`), so a Diffie–Hellman triple
`(a • g, b • g, (a * b) • g)` satisfies `(q / l) • w = 0 ↔ (q / l) • u = 0 ∨ (q / l) • v = 0`
with probability `1`, whereas an independent uniform `w = c • g` matches with probability
`1 - (3 * l - 2) * (l - 1) / l ^ 3`. This generalizes the parity test (`l = 2`) of
[BonehShoup2023], Section 16.1.3, to arbitrary prime factors `l ∣ q` (Exercise 16.2(a), p. 707).

The book writes that the test has advantage "about `1 / l`": here the exact advantage is
`((3 * l - 2) * (l - 1)) / l ^ 3` (`ddhAdvantage_ddhSmallFactorDistinguisher`), which equals
`1 / 2` at `l = 2`, is at least `1 / l` for every prime `l`
(`inv_le_ddhAdvantage_ddhSmallFactorDistinguisher`), and approaches `3 / l` for large `l`.

The setting is that of `CslibFrontier/Crypto/Computational/DiffieHellman/Finite.lean`: an additive
commutative group `G` that is a `ZMod q`-module (`[NeZero q]`) with `c ↦ c • g` injective on
`ZMod q`. The fixed-group advantage places no bound on running time; polynomial-time efficiency over
`CyclicGroupFamily` and the asymptotic failure of DDH when the order has a polynomially bounded
prime factor are in `CslibFrontier/Crypto/Computational/DiffieHellman/CyclicGroupFamily.lean`. Not
covered: the `O(log q)` operation count as a count of group operations, Exercise 16.2(b), a family
of the groups `(ZMod p)ˣ`, and #5673's cleanup in
`CslibFrontier/Crypto/Computational/DiffieHellman/CyclicGroupFamily.lean`.

## Main definitions

* `Cslib.Crypto.ddhSmallFactorDistinguisher`: the distinguisher of Exercise 16.2(a), which accepts
  `(u, v, w)` iff `(q / l) • w = 0` iff `(q / l) • u = 0 ∨ (q / l) • v = 0`.

## Main results

* `Cslib.Crypto.div_nsmul_smul_eq_zero_iff`: `(q / l) • (a • g) = 0 ↔ l ∣ a.val` whenever `l ∣ q`
  and `c ↦ c • g` is injective.
* `Cslib.Crypto.dvd_val_mul_iff`: for prime `l ∣ q`,
  `l ∣ (a * b).val ↔ (q / l) • (a • g) = 0 ∨ (q / l) • (b • g) = 0`.
* `Cslib.Crypto.eval_ddhRealExperiment_ddhSmallFactorDistinguisher`: in the real DDH world,
  `ddhSmallFactorDistinguisher q l` returns `PMF.pure true`.
* `Cslib.Crypto.probability_ddhRandomExperiment_ddhSmallFactorDistinguisher`: in the random DDH
  world, `ddhSmallFactorDistinguisher q l` accepts with probability
  `1 - (3 * l - 2) * (l - 1) / l ^ 3`.
* `Cslib.Crypto.ddhAdvantage_ddhSmallFactorDistinguisher`: the exact fixed-group advantage is
  `((3 * l - 2) * (l - 1)) / l ^ 3` in `ℝ≥0`.
* `Cslib.Crypto.inv_le_ddhAdvantage_ddhSmallFactorDistinguisher`: the fixed-group advantage is at
  least `1 / l`.

## References

* [D. Boneh, V. Shoup, *A Graduate Course in Applied Cryptography*,
  Version 0.6][BonehShoup2023], Exercise 16.2(a) (p. 707) and Section 16.1.3 (p. 687).
-/

public section

namespace Cslib.Crypto

open Probability
open scoped NNReal ENNReal

section FixedGroupSmallFactor

/-- In a cyclic group of order `q` generated by `g`, if `l ∣ q`, raising `a • g` to `q / l` gives
`0` iff `l` divides `a.val`
(generalization of [BonehShoup2023], Lemma 16.1, p. 687; Exercise 16.2(a), p. 707). -/
theorem div_nsmul_smul_eq_zero_iff {G : Type} [AddCommGroup G] {q l : ℕ} [NeZero q]
    [Module (ZMod q) G] {g : G} (hlq : l ∣ q)
    (hg : Function.Injective fun c : ZMod q => c • g) (a : ZMod q) :
    (q / l) • (a • g) = 0 ↔ l ∣ a.val := by
  have hzero : (q / l) • (a • g) = (((q / l) * a.val : ℕ) : ZMod q) • g := by
    conv_lhs => rw [← ZMod.natCast_zmod_val a]
    rw [← Nat.cast_smul_eq_nsmul (ZMod q), smul_smul, ← Nat.cast_mul]
  rw [hzero, hg.eq_iff' (zero_smul (ZMod q) g), ZMod.natCast_eq_zero_iff]
  nth_rw 1 [← Nat.div_mul_cancel hlq]
  exact Nat.mul_dvd_mul_iff_left (Nat.div_pos (Nat.le_of_dvd (NeZero.pos q) hlq)
    (Nat.pos_of_dvd_of_pos hlq (NeZero.pos q)))

/-- For prime `l ∣ q`, `l` divides `(a * b).val` in `ZMod q` iff `(q / l) • (a • g) = 0` or
`(q / l) • (b • g) = 0`
(generalization of [BonehShoup2023], Lemma 16.2, p. 687; Exercise 16.2(a), p. 707). -/
theorem dvd_val_mul_iff {G : Type} [AddCommGroup G] {q l : ℕ} [NeZero q]
    [Module (ZMod q) G] {g : G} (hl : l.Prime) (hlq : l ∣ q)
    (hg : Function.Injective fun c : ZMod q => c • g) (a b : ZMod q) :
    l ∣ (a * b).val ↔ (q / l) • (a • g) = 0 ∨ (q / l) • (b • g) = 0 := by
  rw [ZMod.val_mul, Nat.dvd_mod_iff hlq, hl.dvd_mul,
    div_nsmul_smul_eq_zero_iff hlq hg a, div_nsmul_smul_eq_zero_iff hlq hg b]

/-- The `l`-th-power DDH distinguisher of [BonehShoup2023], Exercise 16.2(a) (p. 707):
accept `(u, v, w)` iff `(q / l) • w = 0` iff `(q / l) • u = 0 ∨ (q / l) • v = 0`. -/
@[expose] def ddhSmallFactorDistinguisher {G : Type} [AddMonoid G] [DecidableEq G]
    (q l : ℕ) (u v w : G) : ProbComp Bool :=
  pure (decide ((q / l) • w = 0 ↔ (q / l) • u = 0 ∨ (q / l) • v = 0))

/-- In the real DDH experiment, `ddhSmallFactorDistinguisher q l` returns `PMF.pure true`
when `l` is prime and divides `q`. -/
theorem eval_ddhRealExperiment_ddhSmallFactorDistinguisher {G : Type} [AddCommGroup G]
    [DecidableEq G] (q l : ℕ) [NeZero q] [Module (ZMod q) G] (g : G)
    (hl : l.Prime) (hlq : l ∣ q) (hg : Function.Injective fun c : ZMod q => c • g) :
    ProbComp.eval (ddhRealExperiment q g (ddhSmallFactorDistinguisher q l)) = PMF.pure true := by
  have h (a b : ZMod q) : decide ((q / l) • ((a * b) • g) = 0 ↔
      (q / l) • (a • g) = 0 ∨ (q / l) • (b • g) = 0) = true :=
    decide_eq_true ((div_nsmul_smul_eq_zero_iff hlq hg (a * b)).trans
      (dvd_val_mul_iff hl hlq hg a b))
  simp only [eval_ddhRealExperiment, ddhSmallFactorDistinguisher, ProbComp.eval_pure, h,
    PMF.bind_const]

/-- Reduction modulo `l` maps uniform `c : ZMod q` to uniform `ZMod l`, so `l ∣ c.val` holds with
probability `1 / l`. -/
private theorem uniform_zmod_map_dvd_apply_true {q l : ℕ} [NeZero q] (hlq : l ∣ q) :
    ((PMF.uniformOfFintype (ZMod q)).map
      (fun c : ZMod q => decide (l ∣ c.val))) true = (l : ℝ≥0∞)⁻¹ := by
  have : NeZero l := ⟨(Nat.pos_of_dvd_of_pos hlq (NeZero.pos q)).ne'⟩
  have hcomp : (fun c : ZMod q => decide (l ∣ c.val)) =
      (fun r : ZMod l => decide (r = 0)) ∘ (ZMod.castHom hlq (ZMod l)).toAddMonoidHom := by
    funext c
    simp only [Function.comp_apply, RingHom.toAddMonoidHom_eq_coe, AddMonoidHom.coe_ofClass,
      ZMod.castHom_apply, ← ZMod.natCast_val, ZMod.natCast_eq_zero_iff]
  rw [hcomp, ← PMF.map_comp,
    PMF.uniformOfFintype_map_addHom _ (ZMod.ringHom_surjective (ZMod.castHom hlq (ZMod l))),
    PMF.map_decide_eq_apply_true, PMF.uniformOfFintype_apply, ZMod.card]

/-- Exact acceptance probability of `ddhSmallFactorDistinguisher q l` in the random DDH experiment
in `ℝ≥0∞`. -/
private theorem eval_ddhRandomExperiment_ddhSmallFactorDistinguisher_apply_true {G : Type}
    [AddCommGroup G] [DecidableEq G] (q l : ℕ) [NeZero q] [Module (ZMod q) G] (g : G)
    (hlq : l ∣ q) (hg : Function.Injective fun c : ZMod q => c • g) :
    ProbComp.eval (ddhRandomExperiment q g (ddhSmallFactorDistinguisher q l)) true =
      let r : ℝ≥0∞ := (l : ℝ≥0∞)⁻¹
      r * (r * r + (1 - r) * r) + (1 - r) * (r * r + (1 - r) * (1 - r)) := by
  have hl0 : 0 < l := Nat.pos_of_dvd_of_pos hlq (NeZero.pos q)
  let β : PMF Bool := (PMF.uniformOfFintype (ZMod q)).map fun c : ZMod q => decide (l ∣ c.val)
  have hβt : β true = (l : ℝ≥0∞)⁻¹ := uniform_zmod_map_dvd_apply_true hlq
  have hβf : β false = 1 - (l : ℝ≥0∞)⁻¹ :=
    ENNReal.eq_sub_of_add_eq (ENNReal.inv_ne_top.mpr (Nat.cast_ne_zero.mpr hl0.ne'))
      (by rw [← hβt, add_comm, PMF.apply_true_add_apply_false])
  have hdec (a b c : ZMod q) :
      decide ((q / l) • (c • g) = 0 ↔ (q / l) • (a • g) = 0 ∨ (q / l) • (b • g) = 0) =
        decide (decide (l ∣ c.val) = (decide (l ∣ a.val) || decide (l ∣ b.val))) := by
    simp only [div_nsmul_smul_eq_zero_iff hlq hg]
    cases ha : decide (l ∣ a.val) <;> cases hb : decide (l ∣ b.val) <;>
      cases hc : decide (l ∣ c.val) <;> simp_all
  have heval : ProbComp.eval (ddhRandomExperiment q g (ddhSmallFactorDistinguisher q l)) =
      β.bind fun ba => β.bind fun bb => β.bind fun bc => PMF.pure (decide (bc = (ba || bb))) := by
    simp only [eval_ddhRandomExperiment, ddhSmallFactorDistinguisher, ProbComp.eval_pure,
      β, PMF.bind_map, Function.comp_def, hdec]
  rw [heval]
  simp only [PMF.bind_apply, tsum_fintype, Fintype.sum_bool, PMF.pure_apply, Bool.true_or,
    Bool.false_or, decide_true, decide_false, Bool.true_eq_false, Bool.false_eq_true, ↓reduceIte,
    mul_one, mul_zero, add_zero, hβt, hβf]
  ring

/-- Acceptance probability of `ddhSmallFactorDistinguisher q l` in the random DDH experiment is
`1 - (3 * l - 2) * (l - 1) / l ^ 3` ([BonehShoup2023], Exercise 16.2(a), p. 707). -/
theorem probability_ddhRandomExperiment_ddhSmallFactorDistinguisher {G : Type} [AddCommGroup G]
    [DecidableEq G] (q l : ℕ) [NeZero q] [Module (ZMod q) G] (g : G)
    (hlq : l ∣ q) (hg : Function.Injective fun c : ZMod q => c • g) :
    Pr[ddhRandomExperiment q g (ddhSmallFactorDistinguisher q l)] =
      1 - ((3 * (l : ℝ) - 2) * ((l : ℝ) - 1)) / (l : ℝ) ^ 3 := by
  have hl0 : 0 < l := Nat.pos_of_dvd_of_pos hlq (NeZero.pos q)
  have hle : (l : ℝ≥0∞)⁻¹ ≤ 1 := ENNReal.inv_le_one.mpr (by exact_mod_cast hl0)
  have hlt : (l : ℝ≥0∞)⁻¹ ≠ ⊤ := ENNReal.inv_ne_top.mpr (Nat.cast_ne_zero.mpr hl0.ne')
  have h1 : 1 - (l : ℝ≥0∞)⁻¹ ≠ ⊤ := ENNReal.sub_ne_top ENNReal.one_ne_top
  change ((ProbComp.eval (ddhRandomExperiment q g (ddhSmallFactorDistinguisher q l))) true).toReal =
    _
  rw [eval_ddhRandomExperiment_ddhSmallFactorDistinguisher_apply_true q l g hlq hg,
    ENNReal.toReal_add (ENNReal.mul_ne_top hlt (ENNReal.add_ne_top.mpr
      ⟨ENNReal.mul_ne_top hlt hlt, ENNReal.mul_ne_top h1 hlt⟩))
      (ENNReal.mul_ne_top h1 (ENNReal.add_ne_top.mpr
      ⟨ENNReal.mul_ne_top hlt hlt, ENNReal.mul_ne_top h1 h1⟩))]
  simp only [ENNReal.toReal_mul, ENNReal.toReal_add (ENNReal.mul_ne_top hlt hlt)
      (ENNReal.mul_ne_top h1 hlt),
    ENNReal.toReal_add (ENNReal.mul_ne_top hlt hlt) (ENNReal.mul_ne_top h1 h1),
    ENNReal.toReal_sub_of_le hle ENNReal.one_ne_top, ENNReal.toReal_one, ENNReal.toReal_inv,
    ENNReal.toReal_natCast]
  have hlne : (l : ℝ) ≠ 0 := Nat.cast_ne_zero.mpr hl0.ne'
  field_simp; ring

/-- The exact fixed-group DDH advantage of `ddhSmallFactorDistinguisher q l` for prime `l ∣ q`
is `(3 * l - 2) * (l - 1) / l ^ 3` ([BonehShoup2023], Exercise 16.2(a), p. 707). Since `l ≥ 1`,
both subtractions in `ℝ≥0` are exact (non-truncated). At `l = 2` this equals `1 / 2`, and for
every prime `l` it is at least `1 / l` and close to `3 / l` for large `l` (reading the book's
"advantage about `1 / l`"). -/
theorem ddhAdvantage_ddhSmallFactorDistinguisher {G : Type} [AddCommGroup G] [DecidableEq G]
    (q l : ℕ) [NeZero q] [Module (ZMod q) G] (g : G)
    (hl : l.Prime) (hlq : l ∣ q) (hg : Function.Injective fun c : ZMod q => c • g) :
    ddhAdvantage q g (ddhSmallFactorDistinguisher q l) =
      ((3 * (l : ℝ≥0) - 2) * ((l : ℝ≥0) - 1)) / (l : ℝ≥0) ^ 3 := by
  apply NNReal.eq
  have hl2 : (2 : ℝ) ≤ l := by exact_mod_cast hl.two_le
  have h1 : (1 : ℝ≥0) ≤ l := by exact_mod_cast hl.one_le
  have h2 : (2 : ℝ≥0) ≤ 3 * l := by exact_mod_cast (by have := hl.two_le; omega : 2 ≤ 3 * l)
  have hreal : Pr[ddhRealExperiment q g (ddhSmallFactorDistinguisher q l)] = 1 := by
    rw [eval_ddhRealExperiment_ddhSmallFactorDistinguisher q l g hl hlq hg,
      PMF.pure_apply_self, ENNReal.toReal_one]
  rw [ddhAdvantage, Experiment.coe_advantage, hreal,
    probability_ddhRandomExperiment_ddhSmallFactorDistinguisher q l g hlq hg, sub_sub_cancel,
    abs_of_nonneg (div_nonneg (mul_nonneg (by linarith) (by linarith)) (by positivity)),
    NNReal.coe_div, NNReal.coe_mul, NNReal.coe_sub h2, NNReal.coe_sub h1, NNReal.coe_mul,
    NNReal.coe_pow]
  push_cast; rfl

/-- `ddhSmallFactorDistinguisher q l` achieves fixed-group advantage at least `1 / l`
for every prime `l ∣ q` ([BonehShoup2023], Exercise 16.2(a), p. 707). -/
theorem inv_le_ddhAdvantage_ddhSmallFactorDistinguisher {G : Type} [AddCommGroup G] [DecidableEq G]
    (q l : ℕ) [NeZero q] [Module (ZMod q) G] (g : G)
    (hl : l.Prime) (hlq : l ∣ q) (hg : Function.Injective fun c : ZMod q => c • g) :
    (l : ℝ≥0)⁻¹ ≤ ddhAdvantage q g (ddhSmallFactorDistinguisher q l) := by
  have hl_pos : (0 : ℝ) < l := by exact_mod_cast hl.pos
  have hl2 : (2 : ℝ) ≤ l := by exact_mod_cast hl.two_le
  rw [ddhAdvantage_ddhSmallFactorDistinguisher q l g hl hlq hg, ← NNReal.coe_le_coe,
    NNReal.coe_inv, NNReal.coe_natCast, NNReal.coe_div, NNReal.coe_mul,
    NNReal.coe_sub (by exact_mod_cast (by have := hl.two_le; omega : 2 ≤ 3 * l)),
    NNReal.coe_sub (by exact_mod_cast hl.one_le), NNReal.coe_mul, NNReal.coe_pow]
  push_cast
  rw [inv_eq_one_div, div_le_div_iff₀ hl_pos (by positivity)]
  have hprod : 0 ≤ (l : ℝ) * (2 * (l : ℝ) - 1) * ((l : ℝ) - 2) :=
    mul_nonneg (mul_nonneg hl_pos.le (by linarith)) (by linarith)
  linarith

end FixedGroupSmallFactor

end Cslib.Crypto
