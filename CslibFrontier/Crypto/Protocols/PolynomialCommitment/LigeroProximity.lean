/-! ### Generator-matrix codes and Vandermonde Reed–Solomon bridge -/

section GeneratorCode

/-- The linear code `Submodule F (Fin n → F)` spanned by the rows of `G : Matrix (Fin l) (Fin n) F`,
consisting of all encoded words `v ᵥ* G` (`v : Fin l → F`). -/
def codeOfGenerator {F : Type*} [CommSemiring F] {l n : ℕ} (G : Matrix (Fin l) (Fin n) F) :
    Submodule F (Fin n → F) where
  carrier := {w | ∃ v : Fin l → F, v ᵥ* G = w}
  add_mem' := fun ⟨v₁, hv₁⟩ ⟨v₂, hv₂⟩ => ⟨v₁ + v₂, by rw [Matrix.add_vecMul, hv₁, hv₂]⟩
  zero_mem' := ⟨0, Matrix.zero_vecMul G⟩
  smul_mem' := fun c _ ⟨v, hv⟩ => ⟨c • v, by rw [Matrix.smul_vecMul, hv]⟩

/-- Membership in `codeOfGenerator G` means being of the form `v ᵥ* G`. -/
@[simp]
theorem mem_codeOfGenerator {F : Type*} [CommSemiring F] {l n : ℕ}
    {G : Matrix (Fin l) (Fin n) F} {w : Fin n → F} :
    w ∈ codeOfGenerator G ↔ ∃ v : Fin l → F, v ᵥ* G = w :=
  Iff.rfl

/-- Every vector `v : Fin l → F` encodes to a codeword `v ᵥ* G ∈ codeOfGenerator G`. -/
theorem vecMul_mem_codeOfGenerator {F : Type*} [CommSemiring F] {l n : ℕ}
    (G : Matrix (Fin l) (Fin n) F) (v : Fin l → F) :
    v ᵥ* G ∈ codeOfGenerator G :=
  ⟨v, rfl⟩

/-- The `k × n` Vandermonde generator matrix for `Cslib.Code.reedSolomon α k` at evaluation points
`α : Fin n → F`, with entry `(d, j)` equal to `α j ^ (d : ℕ)`. -/
@[expose] def reedSolomonGenerator {F : Type*} [Semiring F] {n : ℕ} (α : Fin n → F) (k : ℕ) :
    Matrix (Fin k) (Fin n) F :=
  Matrix.of fun d j => α j ^ (d : ℕ)

@[simp]
theorem reedSolomonGenerator_apply {F : Type*} [Semiring F] {n : ℕ} (α : Fin n → F) (k : ℕ)
    (d : Fin k) (j : Fin n) :
    reedSolomonGenerator α k d j = α j ^ (d : ℕ) := by
  rfl

/-- **Vandermonde generator bridge**: the row-space code of `reedSolomonGenerator α k` is
`Cslib.Code.reedSolomon α k`. -/
theorem codeOfGenerator_reedSolomonGenerator {F : Type*} [Field F] {n : ℕ}
    (α : Fin n → F) (k : ℕ) :
    codeOfGenerator (reedSolomonGenerator α k) = reedSolomon α k := by
  classical
  ext w
  rw [mem_codeOfGenerator, mem_reedSolomon]
  constructor
  · rintro ⟨v, rfl⟩
    rcases Nat.eq_zero_or_pos k with rfl | hk
    · refine ⟨0, WithBot.bot_lt_coe 0, funext fun j => ?_⟩
      simp [Matrix.vecMul, dotProduct]
    · refine ⟨ofFn k v, ofFn_degree_lt v, funext fun j => ?_⟩
      rw [ofFn_eq_sum_monomial, eval_finsetSum]
      simp only [eval_monomial, Matrix.vecMul, dotProduct, reedSolomonGenerator_apply]
  · rintro ⟨p, hp, rfl⟩
    refine ⟨fun d => p.coeff (d : ℕ), funext fun j => ?_⟩
    by_cases hp0 : p = 0
    · subst hp0
      simp [Matrix.vecMul, dotProduct]
    · have hlt : p.natDegree < k := (natDegree_lt_iff_degree_lt hp0).2 hp
      rw [eval_eq_sum_range' hlt, ← Fin.sum_univ_eq_sum_range]
      simp only [Matrix.vecMul, dotProduct, reedSolomonGenerator_apply]

/-- Encoding `v ↦ v ᵥ* reedSolomonGenerator α k` is injective when `α` is injective and `k ≤ n`. -/
theorem vecMul_reedSolomonGenerator_injective {F : Type*} [Field F] {n k : ℕ}
    {α : Fin n → F} (hα : Function.Injective α) (hkn : k ≤ n) :
    Function.Injective (fun v : Fin k → F => v ᵥ* reedSolomonGenerator α k) := by
  intro v₁ v₂ hEq
  rcases Nat.eq_zero_or_pos k with rfl | hk
  · funext d
    exact d.elim0
  · classical
    let p₁ : F[X] := ofFn k v₁
    let p₂ : F[X] := ofFn k v₂
    have heval (v : Fin k → F) (j : Fin n) :
        (ofFn k v).eval (α j) = (v ᵥ* reedSolomonGenerator α k) j := by
      rw [ofFn_eq_sum_monomial, eval_finsetSum]
      simp only [eval_monomial, Matrix.vecMul, dotProduct, reedSolomonGenerator_apply]
    have hp_eq : p₁ = p₂ := by
      by_contra hne
      have hcard := card_filter_eval_eq_eval_le hα
        (Nat.le_sub_one_of_lt (ofFn_natDegree_lt hk v₁))
        (Nat.le_sub_one_of_lt (ofFn_natDegree_lt hk v₂)) hne
      have hall : (Finset.univ.filter fun j : Fin n => p₁.eval (α j) = p₂.eval (α j)) =
          Finset.univ := by
        ext j
        simp only [Finset.mem_filter, Finset.mem_univ, true_and, p₁, p₂, heval, hEq]
      rw [hall, Finset.card_univ, Fintype.card_fin] at hcard
      omega
    funext d
    rw [← ofFn_coeff_eq_val_of_lt v₁ d.isLt, ← ofFn_coeff_eq_val_of_lt v₂ d.isLt]
    exact congrArg (fun p : F[X] => p.coeff (d : ℕ)) hp_eq

end GeneratorCode

/-! ### Column-query soundness and the Ligero interleaved proximity reduction -/

section ProximityIOP

private lemma card_filter_pi_mem {q : ℕ} {α : Type*} [Fintype α] [DecidableEq α] (S : Finset α) :
    (Finset.univ.filter fun Q : Fin q → α => ∀ t : Fin q, Q t ∈ S).card = S.card ^ q := by
  have heq : (Finset.univ.filter fun Q : Fin q → α => ∀ t : Fin q, Q t ∈ S) =
      Fintype.piFinset (fun _ : Fin q => S) := by
    ext Q
    simp only [Finset.mem_filter, Finset.mem_univ, true_and, Fintype.mem_piFinset]
  rw [heq, Fintype.card_piFinset_const]

/-- **Column-query escape bound**: if `r ᵥ* M` and `v ᵥ* G` disagree on strictly more than `e`
columns (`e < hammingDist (r ᵥ* M) (v ᵥ* G)`), then `q` independent uniform column queries
`Q : Fin q → Fin n` all pass `ligeroColumnCheck G M r v (Q t)` with probability at most
`((n - (e + 1)) / n) ^ q`. -/
theorem toOuterMeasure_ligeroColumnCheck_all_le {F : Type} [Semiring F] [DecidableEq F]
    {m l n q e : ℕ} [NeZero n]
    (G : Matrix (Fin l) (Fin n) F) (M : Matrix (Fin m) (Fin n) F)
    (r : Fin m → F) (v : Fin l → F)
    (hfar : e < hammingDist (r ᵥ* M) (v ᵥ* G)) :
    (PMF.uniformOfFintype (Fin q → Fin n)).toOuterMeasure
        {Q | ∀ t : Fin q, ligeroColumnCheck G M r v (Q t) = true} ≤
      (((n - (e + 1) : ℕ) : ℝ≥0∞) / (n : ℝ≥0∞)) ^ q := by
  classical
  have hn : 0 < n := NeZero.pos n
  let goodCols : Finset (Fin n) := Finset.univ.filter fun j => (v ᵥ* G) j = (r ᵥ* M) j
  have hgood_le : goodCols.card ≤ n - (e + 1) := by
    have htot := card_filter_eq_add_hammingDist (v ᵥ* G) (r ᵥ* M)
    rw [Fintype.card_fin, hammingDist_comm] at htot
    change goodCols.card + hammingDist (r ᵥ* M) (v ᵥ* G) = n at htot
    omega
  have hset : {Q : Fin q → Fin n | ∀ t : Fin q, ligeroColumnCheck G M r v (Q t) = true} =
      {Q : Fin q → Fin n | ∀ t : Fin q, Q t ∈ goodCols} := by
    ext Q
    simp only [Set.mem_ofPred_eq, ligeroColumnCheck, decide_eq_true_eq, goodCols,
      Finset.mem_filter, Finset.mem_univ, true_and]
  rw [hset]
  refine (Cslib.Probability.PMF.toOuterMeasure_uniformOfFintype_le_div
    (A := (n - (e + 1)) ^ q) (B := n ^ q) (Nat.pow_pos hn) ?_).trans_eq ?_
  · rw [card_filter_pi_mem goodCols, Fintype.card_fun, Fintype.card_fin, Fintype.card_fin,
      mul_comm (n ^ q)]
    exact Nat.mul_le_mul_right (n ^ q) (Nat.pow_le_pow_left hgood_le q)
  · simp only [Nat.cast_pow, div_eq_mul_inv, mul_pow, ENNReal.inv_pow]

/-- Honest Ligero encoding relation: `M` is the row-wise encoding `U * G` of witness matrix `U`. -/
@[expose] def ligeroCodewordRel {F : Type} [Semiring F] (m : ℕ) {l n : ℕ}
    (G : Matrix (Fin l) (Fin n) F) :
    Matrix (Fin m) (Fin n) F → Matrix (Fin m) (Fin l) F → Prop :=
  fun M U => M = U * G

/-- Interleaved `e`-proximity language for `G`: `m × n` matrices `M` whose column-indexed transpose
`Function.swap M` lies within column-Hamming distance `e` of
`interleavedLinear (Fin m) (codeOfGenerator G)`. -/
@[expose] def ligeroProximityLang {F : Type} [CommSemiring F] [DecidableEq F] (m : ℕ) {l n : ℕ}
    (G : Matrix (Fin l) (Fin n) F) (e : ℕ) : Set (Matrix (Fin m) (Fin n) F) :=
  {M | ∃ V ∈ interleavedLinear (Fin m) (codeOfGenerator G), hammingDist (Function.swap M) V ≤ e}

/-- Every honestly encoded matrix `M = U * G` belongs to `ligeroProximityLang m G e` for all `e`. -/
theorem mem_ligeroProximityLang_of_rel {F : Type} [CommSemiring F] [DecidableEq F] {m l n : ℕ}
    {G : Matrix (Fin l) (Fin n) F} {M : Matrix (Fin m) (Fin n) F} {U : Matrix (Fin m) (Fin l) F}
    (hrel : ligeroCodewordRel m G M U) (e : ℕ) :
    M ∈ ligeroProximityLang m G e := by
  subst hrel
  refine ⟨Function.swap (U * G), ?_, by rw [hammingDist_self]; exact Nat.zero_le e⟩
  rw [mem_interleavedLinear]
  exact fun r => ⟨U r, rfl⟩

/-- Round specification of the Ligero interleaved proximity test: uniform row-combination challenge
`r : Fin m → F`, prover response `v : Fin l → F`, and `q` uniform column queries
`Q : Fin q → Fin n`. -/
abbrev ligeroProximitySpec (m l n q : ℕ) (F : Type) : Spec :=
  [.verifier (Fin m → F),
   .prover (Fin l → F) (OracleInterface.full (Fin l → F)),
   .verifier (Fin q → Fin n)]

/-- **Ligero interleaved proximity reduction**: tests proximity of `M : Matrix (Fin m) (Fin n) F`
to `interleavedLinear (Fin m) (codeOfGenerator G)` by checking `q` uniformly sampled columns of a
random row linear combination `r ᵥ* M` against `v ᵥ* G`. -/
noncomputable def ligeroProximityReduction {F : Type} [Field F] [Fintype F] [DecidableEq F]
    (m : ℕ) {l n : ℕ} [NeZero n] (G : Matrix (Fin l) (Fin n) F) (q : ℕ) :
    Reduction OracleSpec.empty OracleSpec.empty (ligeroProximitySpec m l n q F)
      (Matrix (Fin m) (Fin n) F) (Matrix (Fin m) (Fin l) F) Unit Unit where
  prover _ U :=
    pure (show (Fin m → F) → ProbOracleComp OracleSpec.empty
        (ProbOracleComp OracleSpec.empty
          ((Fin l → F) × ((Fin q → Fin n) → ProbOracleComp OracleSpec.empty (Unit × Unit)))) from
      fun r => pure (pure (ligeroRowComb r U, fun _ => pure ((), ()))))
  verifier :=
    { samplers := (ProbComp.uniform (Fin m → F), ProbComp.uniform (Fin q → Fin n), ())
      decide := fun M (r, Q, _) => do
        let v ← OracleComp.query
          (spec := OracleSpec.empty ⊕ₒ msgSpec (ligeroProximitySpec m l n q F)) (.inr (.inl ()))
        return if ∀ t : Fin q, ligeroColumnCheck G M r v (Q t) = true then some ()
          else none }

theorem ligeroProximityReduction_outputOn {F : Type} [Field F] [Fintype F] [DecidableEq F]
    (m : ℕ) {l n : ℕ} [NeZero n] (G : Matrix (Fin l) (Fin n) F) (q : ℕ)
    (M : Matrix (Fin m) (Fin n) F) (r : Fin m → F) (v : Fin l → F) (Q : Fin q → Fin n) :
    (ligeroProximityReduction m G q).verifier.outputOn M (r, v, Q, ()) =
      if ∀ t : Fin q, ligeroColumnCheck G M r v (Q t) = true then some () else none := by
  rfl

/-- **Query locality**: the verifier's output depends on `M` only through the `q` queried columns
`Q t` (`t : Fin q`). -/
theorem ligeroProximityReduction_outputOn_congr {F : Type} [Field F] [Fintype F] [DecidableEq F]
    (m : ℕ) {l n : ℕ} [NeZero n] (G : Matrix (Fin l) (Fin n) F) (q : ℕ)
    {M₁ M₂ : Matrix (Fin m) (Fin n) F} (r : Fin m → F) (v : Fin l → F) (Q : Fin q → Fin n)
    (hcols : ∀ t : Fin q, ∀ i : Fin m, M₁ i (Q t) = M₂ i (Q t)) :
    (ligeroProximityReduction m G q).verifier.outputOn M₁ (r, v, Q, ()) =
      (ligeroProximityReduction m G q).verifier.outputOn M₂ (r, v, Q, ()) := by
  rw [ligeroProximityReduction_outputOn, ligeroProximityReduction_outputOn]
  have hiff : (∀ t : Fin q, ligeroColumnCheck G M₁ r v (Q t) = true) ↔
      (∀ t : Fin q, ligeroColumnCheck G M₂ r v (Q t) = true) :=
    forall_congr' fun t => by
      simp only [ligeroColumnCheck, decide_eq_true_eq, Matrix.vecMul_apply_eq_sum r _ (Q t)]
      rw [Finset.sum_congr rfl fun i _ => by rw [hcols t i]]
  by_cases h₁ : ∀ t : Fin q, ligeroColumnCheck G M₁ r v (Q t) = true
  · rw [ite_eq_left h₁, ite_eq_left (hiff.1 h₁)]
  · rw [ite_eq_right h₁, ite_eq_right (h₁ ∘ hiff.2)]

/-- **Completeness of the Ligero proximity reduction**: every honestly encoded matrix `M = U * G`
is accepted with error `0`. -/
theorem ligeroProximityReduction_complete {F : Type} [Field F] [Fintype F] [DecidableEq F]
    (m : ℕ) {l n : ℕ} [NeZero n] (G : Matrix (Fin l) (Fin n) F) (q : ℕ) :
    (ligeroProximityReduction m G q).Complete World.plain (ligeroCodewordRel m G) Accept 0 := by
  intro M U hrel
  subst hrel
  rw [Reduction.run, World.plain_eval_execute, PMF.toOuterMeasure_map_apply]
  simp only [ligeroProximityReduction, runStrategy, plainLaw_bind, plainLaw_pure, plainLaw_sample,
    PMF.pure_bind, PMF.bind_bind]
  rw [PMF.toOuterMeasure_bind_apply]
  refine Cslib.Probability.PMF.tsum_mul_le_of_forall_le _ fun r => ?_
  rw [PMF.toOuterMeasure_bind_apply]
  refine Cslib.Probability.PMF.tsum_mul_le_of_forall_le _ fun Q => le_of_eq ?_
  have hchk : ∀ t : Fin q, ligeroColumnCheck G (U * G) r (ligeroRowComb r U) (Q t) = true :=
    fun t => ligeroColumnCheck_honest G U r (Q t)
  refine (PMF.toOuterMeasure_pure_apply _ _).trans (ite_eq_right fun h => h ⟨?_, trivial⟩)
  exact (ligeroProximityReduction_outputOn m G q (U * G) r (ligeroRowComb r U) Q).trans
    (ite_eq_left hchk)

private lemma ligeroProximityReduction_rbrSound_of_rowBound
    {F : Type} [Field F] [Fintype F] [DecidableEq F]
    (m : ℕ) {l n q e : ℕ} [NeZero n] (G : Matrix (Fin l) (Fin n) F) (ε₁ : ℝ≥0∞)
    (hrow : ∀ M : Matrix (Fin m) (Fin n) F, M ∉ ligeroProximityLang m G e →
      (PMF.uniformOfFintype (Fin m → F)).toOuterMeasure
        {r | ∃ c ∈ codeOfGenerator G, hammingDist (r ᵥ* M) c ≤ e} ≤ ε₁) :
    (ligeroProximityReduction m G q).verifier.RbrSound
      (ligeroProximityLang m G e) Set.univ
      (ε₁, (((n - (e + 1) : ℕ) : ℝ≥0∞) / (n : ℝ≥0∞)) ^ q, ()) := by
  refine ⟨fun M pfx => match pfx with
    | none => M ∈ ligeroProximityLang m G e
    | some (r, none) => ∃ c ∈ codeOfGenerator G, hammingDist (r ᵥ* M) c ≤ e
    | some (r, some (_, none)) => ∃ c ∈ codeOfGenerator G, hammingDist (r ᵥ* M) c ≤ e
    | some (r, some (v, some (Q, _))) =>
        ∀ t : Fin q, ligeroColumnCheck G M r v (Q t) = true,
    fun M hM => hM,
    fun M => ⟨fun hM => ?_, fun r => ⟨fun hS _ h => hS h, fun v => ⟨fun hS => ?_,
      fun Q hS ⟨_, _, hout⟩ => ?_⟩⟩⟩⟩
  · change (ProbComp.eval (ProbComp.uniform (Fin m → F))).toOuterMeasure
      {r | ∃ c ∈ codeOfGenerator G, hammingDist (r ᵥ* M) c ≤ e} ≤ ε₁
    rw [ProbComp.eval_uniform]
    exact hrow M hM
  · have hfar : e < hammingDist (r ᵥ* M) (v ᵥ* G) := by
      by_contra hle
      exact hS ⟨v ᵥ* G, vecMul_mem_codeOfGenerator G v, Nat.le_of_not_lt hle⟩
    change (ProbComp.eval (ProbComp.uniform (Fin q → Fin n))).toOuterMeasure
      {Q | ∀ t : Fin q, ligeroColumnCheck G M r v (Q t) = true} ≤ _
    rw [ProbComp.eval_uniform]
    exact toOuterMeasure_ligeroColumnCheck_all_le G M r v hfar
  · rw [ligeroProximityReduction_outputOn] at hout
    split_ifs at hout with hchk
    exact hS hchk

private lemma vecMul_eq_sum_smul_swap {F : Type*} [CommSemiring F] {m n : ℕ}
    (r : Fin m → F) (M : Matrix (Fin m) (Fin n) F) :
    r ᵥ* M = fun j => ∑ i : Fin m, r i • Function.swap M j i := by
  funext j
  simp only [Matrix.vecMul, dotProduct, Function.swap, smul_eq_mul]

/-- Step toward `#643` and `#5968` after [AmesHazayIshaiVenkitasubramaniam2017] (locator not
re-verified against primary PDF; round-by-round soundness of `ligeroProximityReduction` within
`d / 3` against all prover strategies): when `3 * (e : ℕ∞) < minDist (codeOfGenerator G)`, the
row-combination round has escape error at most `(e + 1) / |F|` and the `q`-column query round has
escape error at most `((n - (e + 1)) / n) ^ q`. -/
theorem ligeroProximityReduction_rbrSound_of_three_mul_lt_minDist
    {F : Type} [Field F] [Fintype F] [DecidableEq F]
    (m : ℕ) {l n q e : ℕ} [NeZero n] {G : Matrix (Fin l) (Fin n) F}
    (hmin : 3 * (e : ℕ∞) < minDist (codeOfGenerator G : Set (Fin n → F))) :
    (ligeroProximityReduction m G q).verifier.RbrSound
      (ligeroProximityLang m G e) Set.univ
      (((e + 1 : ℕ) : ℝ≥0∞) / (Fintype.card F : ℝ≥0∞),
       (((n - (e + 1) : ℕ) : ℝ≥0∞) / (n : ℝ≥0∞)) ^ q, ()) := by
  refine ligeroProximityReduction_rbrSound_of_rowBound m G _ fun M hM => ?_
  have hfar : ∀ V ∈ interleavedLinear (Fin m) (codeOfGenerator G),
      e < hammingDist (Function.swap M) V := by
    intro V hV
    by_contra hle
    exact hM ⟨V, hV, Nat.le_of_not_lt hle⟩
  simpa only [vecMul_eq_sum_smul_swap] using
    toOuterMeasure_sum_smul_close_le_of_three_mul_lt_minDist hmin hfar

/-- **Plain-model soundness of the Ligero proximity reduction within `d / 3`** against every
(unbounded, adaptive) prover strategy. -/
theorem ligeroProximityReduction_sound_of_three_mul_lt_minDist
    {F : Type} [Field F] [Fintype F] [DecidableEq F]
    (m : ℕ) {l n q e : ℕ} [NeZero n] {G : Matrix (Fin l) (Fin n) F}
    (hmin : 3 * (e : ℕ∞) < minDist (codeOfGenerator G : Set (Fin n → F))) :
    (ligeroProximityReduction m G q).verifier.Sound (oP := OracleSpec.empty) World.plain
      (ligeroProximityLang m G e) Set.univ
      (((e + 1 : ℕ) : ℝ≥0∞) / (Fintype.card F : ℝ≥0∞) +
       (((n - (e + 1) : ℕ) : ℝ≥0∞) / (n : ℝ≥0∞)) ^ q) := by
  have h := (ligeroProximityReduction_rbrSound_of_three_mul_lt_minDist m (q := q) hmin).sound
  simpa only [PerChallenge.sum, add_zero] using h

/-- **Round-by-round soundness of the Reed–Solomon Ligero proximity reduction across the full
unique-decoding radius** (`2 * e + k ≤ n`, derived via
[BenSassonCarmonIshaiKoppartySaraf2020, Theorem 1.6 / eq. (1.2)]): the row-combination round has
escape error at most `n / |F|` and the `q`-column query round has escape error at most
`((n - (e + 1)) / n) ^ q`. -/
theorem ligeroProximityReduction_reedSolomon_rbrSound
    {F : Type} [Field F] [Fintype F] [DecidableEq F]
    (m : ℕ) {k n q e : ℕ} [NeZero n] {α : Fin n → F}
    (hα : Function.Injective α) (hunique : 2 * e + k ≤ n) :
    (ligeroProximityReduction m (reedSolomonGenerator α k) q).verifier.RbrSound
      (ligeroProximityLang m (reedSolomonGenerator α k) e) Set.univ
      ((n : ℝ≥0∞) / (Fintype.card F : ℝ≥0∞),
       (((n - (e + 1) : ℕ) : ℝ≥0∞) / (n : ℝ≥0∞)) ^ q, ()) := by
  refine ligeroProximityReduction_rbrSound_of_rowBound m (reedSolomonGenerator α k) _ fun M hM => ?_
  have hfar : ∀ V ∈ interleavedLinear (Fin m) (reedSolomon α k),
      e < hammingDist (Function.swap M) V := by
    intro V hV
    by_contra hle
    refine hM ⟨V, ?_, Nat.le_of_not_lt hle⟩
    rwa [codeOfGenerator_reedSolomonGenerator]
  have hbound := toOuterMeasure_sum_smul_reedSolomon_close_le hα
    (by simpa only [Fintype.card_fin] using hunique) hfar
  simpa only [codeOfGenerator_reedSolomonGenerator, vecMul_eq_sum_smul_swap,
    Fintype.card_fin] using hbound

/-- **Plain-model soundness of the Reed–Solomon Ligero proximity reduction across the full
unique-decoding radius** (`2 * e + k ≤ n`) against every prover strategy. -/
theorem ligeroProximityReduction_reedSolomon_sound
    {F : Type} [Field F] [Fintype F] [DecidableEq F]
    (m : ℕ) {k n q e : ℕ} [NeZero n] {α : Fin n → F}
    (hα : Function.Injective α) (hunique : 2 * e + k ≤ n) :
    (ligeroProximityReduction m (reedSolomonGenerator α k) q).verifier.Sound
      (oP := OracleSpec.empty) World.plain
      (ligeroProximityLang m (reedSolomonGenerator α k) e) Set.univ
      ((n : ℝ≥0∞) / (Fintype.card F : ℝ≥0∞) +
       (((n - (e + 1) : ℕ) : ℝ≥0∞) / (n : ℝ≥0∞)) ^ q) := by
  have h := (ligeroProximityReduction_reedSolomon_rbrSound m (q := q) hα hunique).sound
  simpa only [PerChallenge.sum, add_zero] using h

end ProximityIOP

/-! ### Cheating-prover soundness of `ligeroEvalCheck` under unique decoding -/

section EvalSoundness

/-- **Cheating-prover linear-evaluation soundness**: suppose `2 * (e : ℕ∞) < minDist
(codeOfGenerator G)`, encoding `· ᵥ* G` is injective, and `Function.swap M` lies within
column-Hamming distance `e` of `Function.swap (U * G)`. If a claimed bilinear evaluation is false
(`ligeroEval U b c ≠ w`), then **every** prover response `v : Fin l → F` (not only the honest
`ligeroRowComb b U`) passes `q` uniform column checks `ligeroEvalCheck G M b c w v (Q t)` with
probability at most `((n - (e + 1)) / n) ^ q`. -/
theorem toOuterMeasure_ligeroEvalCheck_false_le {F : Type} [CommRing F] [DecidableEq F]
    {m l n q e : ℕ} [NeZero n]
    (G : Matrix (Fin l) (Fin n) F)
    (hmin : 2 * (e : ℕ∞) < minDist (codeOfGenerator G : Set (Fin n → F)))
    (hinj : Function.Injective (fun v : Fin l → F => v ᵥ* G))
    {M : Matrix (Fin m) (Fin n) F} {U : Matrix (Fin m) (Fin l) F}
    (hclose : hammingDist (Function.swap M) (Function.swap (U * G)) ≤ e)
    (b : Fin m → F) (c : Fin l → F) (w : F) (hfalse : ligeroEval U b c ≠ w)
    (v : Fin l → F) :
    (PMF.uniformOfFintype (Fin q → Fin n)).toOuterMeasure
        {Q | ∀ t : Fin q, ligeroEvalCheck G M b c w v (Q t) = true} ≤
      (((n - (e + 1) : ℕ) : ℝ≥0∞) / (n : ℝ≥0∞)) ^ q := by
  have hv_ne : v ≠ ligeroRowComb b U → e < hammingDist (b ᵥ* M) (v ᵥ* G) := fun hv => by
    have hcw_ne : v ᵥ* G ≠ ligeroRowComb b U ᵥ* G := fun hEq => hv (hinj hEq)
    have hgt : 2 * e < hammingDist (v ᵥ* G) (ligeroRowComb b U ᵥ* G) :=
      (natCast_lt_minDist_iff (C := (codeOfGenerator G : Set (Fin n → F)))).1 hmin
        (v ᵥ* G) (vecMul_mem_codeOfGenerator G v)
        (ligeroRowComb b U ᵥ* G) (vecMul_mem_codeOfGenerator G _) hcw_ne
    have hclose_row : hammingDist (b ᵥ* M) (ligeroRowComb b U ᵥ* G) ≤ e := by
      rw [ligeroRowComb_mul, vecMul_eq_sum_smul_swap b M,
        vecMul_eq_sum_smul_swap b (U * G)]
      exact (hammingDist_sum_smul_le b (Function.swap M) (Function.swap (U * G))).trans hclose
    have htri := hammingDist_triangle (v ᵥ* G) (b ᵥ* M) (ligeroRowComb b U ᵥ* G)
    rw [hammingDist_comm (v ᵥ* G) (b ᵥ* M)] at htri
    omega
  by_cases hvw : v ⬝ᵥ c = w
  · have hv : v ≠ ligeroRowComb b U := fun hEq => hfalse (by rw [ligeroEval, ← hEq, hvw])
    refine ((PMF.uniformOfFintype (Fin q → Fin n)).toOuterMeasure.mono fun Q hQ => ?_).trans
      (toOuterMeasure_ligeroColumnCheck_all_le G M b v (hv_ne hv))
    intro t
    have ht := hQ t
    simp only [ligeroEvalCheck, ligeroColumnCheck, decide_eq_true_eq] at ht ⊢
    exact ht.2
  · rcases Nat.eq_zero_or_pos q with rfl | hq
    · simp only [pow_zero]
      exact Cslib.Probability.PMF.toOuterMeasure_le_one _ _
    · have hempty : {Q : Fin q → Fin n | ∀ t : Fin q, ligeroEvalCheck G M b c w v (Q t) = true} =
          ∅ := by
        ext Q
        simp only [Set.mem_ofPred_eq, Set.mem_empty_iff_false, iff_false, not_forall]
        refine ⟨⟨0, hq⟩, ?_⟩
        simp only [ligeroEvalCheck, decide_eq_true_eq, not_and]
        exact fun h => False.elim (hvw h)
      simp only [hempty, MeasureTheory.measure_empty, zero_le]

end EvalSoundness

end Cslib.Crypto.Protocols
