section CosetHierarchy

variable {F : Type*} [Field F]

/-- Evaluation points `j ↦ g * ω ^ j` of a multiplicative coset of size `n`. -/
@[expose] def cosetPoint (g ω : F) (n : ℕ) : Fin n → F :=
  fun j => g * ω ^ j.val

/-- Round-`i` evaluation domain of the 2-to-1 FRI coset hierarchy starting from `g * ⟨ω⟩` of
size `2 ^ d`: at round `i`, the domain has size `2 ^ (d - i)` and maps `j ↦ g^(2^i) * (ω^(2^i))^j`.
-/
@[expose] def cosetEval (g ω : F) (d i : ℕ) : Fin (2 ^ (d - i)) → F :=
  cosetPoint (g ^ (2 ^ i)) (ω ^ (2 ^ i)) (2 ^ (d - i))

/-- Every point of a coset with nonzero offset and primitive `n`-th root of unity is nonzero. -/
theorem cosetPoint_ne_zero {g ω : F} {n : ℕ} (hg : g ≠ 0) (hω : IsPrimitiveRoot ω n)
    (hn : n ≠ 0) (j : Fin n) : cosetPoint g ω n j ≠ 0 :=
  mul_ne_zero hg (pow_ne_zero j.val (hω.ne_zero hn))

/-- Distinct indices yield distinct evaluation points on a coset generated by a primitive `n`-th
root of unity with nonzero offset. -/
theorem cosetPoint_injective {g ω : F} {n : ℕ} (hg : g ≠ 0) (hω : IsPrimitiveRoot ω n) :
    Function.Injective (cosetPoint g ω n) :=
  fun _ _ hij => Fin.ext (hω.pow_inj (Fin.isLt _) (Fin.isLt _) (mul_left_cancel₀ hg hij))

/-- Raising a coset point of size `a * N` to the `a`-th power lands in the powered coset of size
`N` at index `j % N`. -/
theorem cosetPoint_pow_eq (g ω : F) {a N : ℕ} (hN : 0 < N) (hω : IsPrimitiveRoot ω (a * N))
    (j : Fin (a * N)) :
    (cosetPoint g ω (a * N) j) ^ a =
      cosetPoint (g ^ a) (ω ^ a) N ⟨j.val % N, Nat.mod_lt j.val hN⟩ := by
  have hmul : j.val * a = a * (j.val % N) + (a * N) * (j.val / N) := by
    nlinarith [Nat.div_add_mod j.val N]
  simp only [cosetPoint, mul_pow, ← pow_mul]
  rw [hmul, pow_add, pow_mul ω (a * N), hω.pow_eq_one, one_pow, mul_one]

/-- Fiber index `(j, t) ↦ j + t * N` inside `Fin (a * N)`. -/
@[expose] def fiberIdx {a N : ℕ} (j : Fin N) (t : Fin a) : Fin (a * N) :=
  ⟨j.val + t.val * N, by nlinarith [j.isLt, t.isLt]⟩

/-- The `a`-element fiber over `j : Fin N` consists of `(cosetPoint g ω (a * N) ⟨j, _⟩) * (ω^N)^t`.
-/
theorem cosetPoint_fiberIdx (g ω : F) {a N : ℕ} (ha : 0 < a) (j : Fin N) (t : Fin a) :
    cosetPoint g ω (a * N) (fiberIdx j t) =
      cosetPoint g ω (a * N) ⟨j.val, by nlinarith [j.isLt, ha]⟩ * (ω ^ N) ^ t.val := by
  simp only [cosetPoint, fiberIdx, pow_add, ← pow_mul, mul_assoc, mul_comm N t.val]

/-- Squaring a primitive `2 ^ d`-th root of unity `i` times produces a primitive `2 ^ (d - i)`-th
root of unity. -/
theorem isPrimitiveRoot_pow_two_pow {ω : F} {d i : ℕ} (hω : IsPrimitiveRoot ω (2 ^ d))
    (hi : i ≤ d) :
    IsPrimitiveRoot (ω ^ (2 ^ i)) (2 ^ (d - i)) := by
  simpa only [Nat.pow_div hi (by omega : 0 < 2)] using
    hω.pow_of_dvd (pow_ne_zero i (by omega)) (Nat.pow_dvd_pow 2 hi)

/-- Fiberwise primitive `a`-th root of unity `ω ^ N` from a primitive `(a * N)`-th root `ω`. -/
private theorem isPrimitiveRoot_fiber {ω : F} {a N : ℕ} (hN : 0 < N)
    (hω : IsPrimitiveRoot ω (a * N)) :
    IsPrimitiveRoot (ω ^ N) a := by
  simpa only [Nat.mul_div_cancel a hN] using hω.pow_of_dvd hN.ne' ⟨a, mul_comm _ _⟩

/-- Raising a fiber coset point to the `a`-th power yields the target point `j` on `L ^ a`. -/
private theorem cosetPoint_fiberIdx_pow_eq (g ω : F) {a N : ℕ} (hN : 0 < N)
    (hω : IsPrimitiveRoot ω (a * N)) (j : Fin N) (t : Fin a) :
    (cosetPoint g ω (a * N) (fiberIdx j t)) ^ a = cosetPoint (g ^ a) (ω ^ a) N j := by
  rw [cosetPoint_pow_eq g ω hN hω (fiberIdx j t)]
  congr 1
  exact Fin.ext (by simp [fiberIdx, Nat.mod_eq_of_lt j.isLt])

/-- Each level `i ≤ d` of the FRI coset hierarchy has distinct evaluation points. -/
theorem cosetEval_injective {g ω : F} {d i : ℕ} (hg : g ≠ 0) (hω : IsPrimitiveRoot ω (2 ^ d))
    (hi : i ≤ d) :
    Function.Injective (cosetEval g ω d i) :=
  cosetPoint_injective (pow_ne_zero _ hg) (isPrimitiveRoot_pow_two_pow hω hi)

/-- Every point at level `i ≤ d` of the FRI coset hierarchy is nonzero. -/
theorem cosetEval_ne_zero {g ω : F} {d i : ℕ} (hg : g ≠ 0) (hω : IsPrimitiveRoot ω (2 ^ d))
    (hi : i ≤ d) (j : Fin (2 ^ (d - i))) :
    cosetEval g ω d i j ≠ 0 :=
  cosetPoint_ne_zero (pow_ne_zero _ hg) (isPrimitiveRoot_pow_two_pow hω hi)
    (pow_ne_zero _ (by omega)) j

/-- Raising a level-`i` coset point to the `(2 ^ s)`-th power maps onto level `i + s`. -/
theorem cosetEval_pow_two_pow {g ω : F} {d i s : ℕ} (hω : IsPrimitiveRoot ω (2 ^ d))
    (his : i + s ≤ d) (j : Fin (2 ^ (d - i))) :
    (cosetEval g ω d i j) ^ (2 ^ s) =
      cosetEval g ω d (i + s) ⟨j.val % 2 ^ (d - (i + s)), Nat.mod_lt _ (by positivity)⟩ := by
  have hsplit : 2 ^ (d - i) = 2 ^ s * 2 ^ (d - (i + s)) := by
    rw [← pow_add]; congr 1; omega
  have hωi : IsPrimitiveRoot (ω ^ (2 ^ i)) (2 ^ s * 2 ^ (d - (i + s))) :=
    hsplit ▸ isPrimitiveRoot_pow_two_pow hω (by omega)
  have hstep := cosetPoint_pow_eq (g ^ (2 ^ i)) (ω ^ (2 ^ i)) (a := 2 ^ s)
    (N := 2 ^ (d - (i + s))) (by positivity) hωi ⟨j.val, hsplit ▸ j.isLt⟩
  simpa only [cosetEval, cosetPoint, ← pow_mul, ← pow_add] using hstep

/-- Squaring maps level `i` of the FRI coset hierarchy onto level `i + 1`. -/
theorem cosetEval_sq {g ω : F} {d i : ℕ} (hω : IsPrimitiveRoot ω (2 ^ d)) (hi : i < d)
    (j : Fin (2 ^ (d - i))) :
    (cosetEval g ω d i j) ^ 2 =
      cosetEval g ω d (i + 1) ⟨j.val % 2 ^ (d - (i + 1)), Nat.mod_lt _ (by positivity)⟩ := by
  simpa only [pow_one] using cosetEval_pow_two_pow (s := 1) hω hi j

/-- Shifting an index in level `i < d` by half the domain size negates its coset point. -/
theorem cosetEval_add_half {g ω : F} {d i : ℕ} (hω : IsPrimitiveRoot ω (2 ^ d)) (hi : i < d)
    (j : Fin (2 ^ (d - (i + 1)))) :
    cosetEval g ω d i ⟨j.val + 2 ^ (d - (i + 1)), by
      have : 2 ^ (d - i) = 2 ^ (d - (i + 1)) + 2 ^ (d - (i + 1)) := by
        have h1 : d - i = (d - (i + 1)) + 1 := by omega
        rw [h1, pow_succ, mul_two]
      omega⟩ =
      -cosetEval g ω d i ⟨j.val, lt_of_lt_of_le j.isLt (Nat.pow_le_pow_right (by omega)
        (by omega))⟩ := by
  have hd : d - i = (d - (i + 1)) + 1 := by omega
  have hsplit : 2 ^ (d - i) = 2 * 2 ^ (d - (i + 1)) := by rw [hd, pow_succ']
  have hneg := (isPrimitiveRoot_fiber (Nat.pow_pos (by omega))
    (hsplit ▸ isPrimitiveRoot_pow_two_pow hω hi.le)).eq_neg_one_of_two_right
  simp only [cosetEval, cosetPoint, pow_add, hneg, mul_neg, mul_one]

end CosetHierarchy

section PolyFolding

variable {F : Type*} [Field F]

/-- The `r`-th residue component of `p : F[X]` modulo `a`: its `t`-th coefficient is
`p.coeff (a * t + r)`. -/
@[expose] noncomputable def polyComp (a : ℕ) (p : F[X]) (r : Fin a) : F[X] :=
  ∑ t ∈ Finset.range (p.natDegree / a + 1), Polynomial.monomial t (p.coeff (a * t + r.val))

theorem coeff_polyComp {a : ℕ} (ha : 0 < a) (p : F[X]) (r : Fin a) (t : ℕ) :
    (polyComp a p r).coeff t = p.coeff (a * t + r.val) := by
  classical
  simp only [polyComp, finsetSum_coeff, coeff_monomial, Finsupp.single_apply,
    Finset.sum_ite_eq', Finset.mem_range]
  split_ifs with ht
  · rfl
  · refine (coeff_eq_zero_of_natDegree_lt ?_).symm
    have hlt := (Nat.div_lt_iff_lt_mul ha).mp (by omega : p.natDegree / a < t)
    nlinarith

/-- If `deg(p) < a * k`, each `a`-way component `polyComp a p r` has degree `< k`. -/
theorem degree_polyComp_lt {a k : ℕ} (ha : 0 < a) {p : F[X]} (hp : p.degree < (a * k : ℕ))
    (r : Fin a) :
    (polyComp a p r).degree < k := by
  rw [degree_lt_iff_coeff_zero]
  refine fun t ht => (coeff_polyComp ha p r t).trans <|
    coeff_eq_zero_of_degree_lt <| lt_of_lt_of_le hp ?_
  have hle : a * k ≤ a * t + r.val := by nlinarith
  exact_mod_cast hle

/-- Reconstruct a polynomial from its `a` residue components via
`∑ r : Fin a, X ^ r * (ps r).comp (X ^ a)`. -/
@[expose] noncomputable def reconstructPoly (a : ℕ) (ps : Fin a → F[X]) : F[X] :=
  ∑ r : Fin a, X ^ r.val * (ps r).comp (X ^ a)

theorem eval_reconstructPoly (a : ℕ) (ps : Fin a → F[X]) (x : F) :
    (reconstructPoly a ps).eval x = ∑ r : Fin a, x ^ r.val * (ps r).eval (x ^ a) := by
  simp only [reconstructPoly, eval_finsetSum, eval_mul, eval_pow, eval_X, eval_comp]

/-- The `n`-th coefficient of `reconstructPoly a ps` is the `(n / a)`-th coefficient of its
`(n % a)`-th residue component. -/
private theorem coeff_reconstructPoly {a : ℕ} (ha : 0 < a) (ps : Fin a → F[X]) (n : ℕ) :
    (reconstructPoly a ps).coeff n = (ps ⟨n % a, Nat.mod_lt n ha⟩).coeff (n / a) := by
  simp only [reconstructPoly, finsetSum_coeff, coeff_X_pow_mul']
  rw [Finset.sum_eq_single_of_mem ⟨n % a, Nat.mod_lt n ha⟩ (Finset.mem_univ _)]
  · have hsub : n - n % a = a * (n / a) := by
      have := Nat.div_add_mod n a
      omega
    simp only [Nat.mod_le, ↓reduceIte, ← expand_eq_comp_X_pow, coeff_expand ha, hsub,
      dvd_mul_right, Nat.mul_div_cancel_left _ ha]
  · intro r _ hne
    simp only [← expand_eq_comp_X_pow, coeff_expand ha]
    split_ifs with hle hdvd
    · rcases hdvd with ⟨q, hq⟩
      have hn : n = a * q + r.val := by omega
      have hmod : n % a = r.val := by rw [hn, Nat.mul_add_mod, Nat.mod_eq_of_lt r.isLt]
      exact absurd (Fin.ext hmod.symm) hne
    all_goals rfl

/-- Exact decomposition identity: `p = ∑ r : Fin a, X ^ r * (polyComp a p r).comp (X ^ a)`. -/
theorem reconstructPoly_polyComp {a : ℕ} (ha : 0 < a) (p : F[X]) :
    reconstructPoly a (polyComp a p) = p := by
  ext n
  rw [coeff_reconstructPoly ha, coeff_polyComp ha, Nat.div_add_mod]

/-- Evaluating `p` at `x` decomposes as `∑ r : Fin a, x ^ r * (polyComp a p r).eval (x ^ a)`. -/
theorem eval_eq_sum_eval_polyComp {a : ℕ} (ha : 0 < a) (p : F[X]) (x : F) :
    p.eval x = ∑ r : Fin a, x ^ r.val * (polyComp a p r).eval (x ^ a) := by
  conv_lhs => rw [← reconstructPoly_polyComp ha p]
  exact eval_reconstructPoly a (polyComp a p) x

/-- If every component `ps r` has degree `< k`, then `reconstructPoly a ps` has degree `< a * k`.
-/
theorem degree_reconstructPoly_lt {a k : ℕ} (ha : 0 < a) {ps : Fin a → F[X]}
    (hps : ∀ r, (ps r).degree < k) :
    (reconstructPoly a ps).degree < (a * k : ℕ) := by
  rw [degree_lt_iff_coeff_zero]
  intro n hn
  rw [coeff_reconstructPoly ha]
  refine coeff_eq_zero_of_degree_lt (lt_of_lt_of_le (hps _) ?_)
  exact_mod_cast (Nat.le_div_iff_mul_le ha).mpr (by rw [mul_comm]; exact hn)

/-- The `a`-to-1 folded polynomial `foldPoly a p z = ∑ r : Fin a, C (z ^ r) * polyComp a p r`. -/
@[expose] noncomputable def foldPoly (a : ℕ) (p : F[X]) (z : F) : F[X] :=
  ∑ r : Fin a, C (z ^ r.val) * polyComp a p r

/-- Folding preserves the reduced degree bound: `deg(p) < a * k` implies `deg(foldPoly a p z) < k`.
-/
theorem degree_foldPoly_lt {a k : ℕ} (ha : 0 < a) {p : F[X]} (hp : p.degree < (a * k : ℕ))
    (z : F) :
    (foldPoly a p z).degree < k := by
  rw [degree_lt_iff_coeff_zero]
  intro n hn
  simp only [foldPoly, finsetSum_coeff, coeff_C_mul]
  exact Finset.sum_eq_zero fun r _ => by
    rw [coeff_eq_zero_of_degree_lt (lt_of_lt_of_le (degree_polyComp_lt ha hp r) (mod_cast hn)),
      mul_zero]

theorem eval_foldPoly (a : ℕ) (p : F[X]) (z y : F) :
    (foldPoly a p z).eval y = ∑ r : Fin a, z ^ r.val * (polyComp a p r).eval y := by
  simp only [foldPoly, eval_finsetSum, eval_mul, eval_C]

end PolyFolding

section WordFolding

variable {F : Type*} [Field F]

/-- The `r`-th fiberwise IDFT / interpolation coefficient of a single `a`-element fiber
`ys : Fin a → F` above target index `j : Fin N` in the coset `g * ⟨ω⟩` of size `a * N`
([BenSassonCarmonIshaiKoppartySaraf2020], Section 8.2, printed p. 37: Eq. (8.1) defines the fiber,
the paragraph immediately following it defines the interpolation map whose output is this
coefficient vector, and Eq. (8.2) evaluates that vector at the challenge powers). -/
@[expose] def foldFiberComp (g ω : F) {a N : ℕ} (ys : Fin a → F) (r : Fin a) (j : Fin N) : F :=
  ((a : F) * (g * ω ^ j.val) ^ r.val)⁻¹ *
    ∑ t : Fin a, ((ω ^ N)⁻¹) ^ (r.val * t.val) * ys t

/-- The `r`-th fiberwise IDFT component word of `f : Fin (a * N) → F` on the powered coset
`g^a * ⟨ω^a⟩` of size `N`. -/
@[expose] def foldComp (g ω : F) {a N : ℕ} (f : Fin (a * N) → F) (r : Fin a) (j : Fin N) : F :=
  foldFiberComp g ω (fun t => f (fiberIdx j t)) r j

/-- Local `a`-to-1 FRI folding formula evaluated on a single `a`-element fiber `ys : Fin a → F`
above target index `j : Fin N` in the coset `g * ⟨ω⟩` of size `a * N` with challenge `z`
([BenSassonCarmonIshaiKoppartySaraf2020], Section 8.2, Eq. (8.2) on printed p. 37). -/
@[expose] def foldFiber (g ω : F) {a N : ℕ} (ys : Fin a → F) (j : Fin N) (z : F) : F :=
  ∑ r : Fin a, z ^ r.val * foldFiberComp g ω ys r j

/-- The `a`-to-1 FRI folding operator applied to a word `f : Fin (a * N) → F` at challenge `z : F`:
evaluates the parameterized curve `∑ r : Fin a, z ^ r • foldComp g ω f r`. -/
@[expose] def foldWord (g ω : F) {a N : ℕ} (f : Fin (a * N) → F) (z : F) : Fin N → F :=
  fun j => foldFiber g ω (fun t => f (fiberIdx j t)) j z

/-- `foldWord` evaluates pointwise via `foldFiber` on the `a`-element fiber over `j`. -/
theorem foldWord_apply_eq_foldFiber (g ω : F) {a N : ℕ} (f : Fin (a * N) → F) (z : F)
    (j : Fin N) :
    foldWord g ω f z j = foldFiber g ω (fun t => f (fiberIdx j t)) j z :=
  rfl

/-- `foldWord g ω f z` is the parameterized curve `∑ r : Fin a, z ^ r • foldComp g ω f r`. -/
theorem foldWord_eq_sum_smul (g ω : F) {a N : ℕ} (f : Fin (a * N) → F) (z : F) :
    foldWord g ω f z = ∑ r : Fin a, z ^ r.val • foldComp g ω f r := by
  ext j
  simp only [foldWord, foldFiber, foldComp, Finset.sum_apply, Pi.smul_apply, smul_eq_mul]

/-- Character orthogonality for a primitive `a`-th root of unity `ζ`:
`∑ t : Fin a, ζ ^ (u * t) * (ζ⁻¹) ^ (r * t) = if u = r then a else 0`. -/
private theorem sum_primitiveRoot_mul_inv {a : ℕ} {ζ : F} (hζ : IsPrimitiveRoot ζ a)
    (u r : Fin a) :
    (∑ t : Fin a, (ζ⁻¹) ^ (r.val * t.val) * ζ ^ (u.val * t.val)) =
      if u = r then (a : F) else 0 := by
  have hζ0 : ζ ≠ 0 := hζ.ne_zero (Fin.pos u).ne'
  simp_rw [pow_mul, ← mul_pow]
  by_cases hur : u = r
  · subst hur
    simp [inv_pow, inv_mul_cancel₀ (pow_ne_zero _ hζ0)]
  · simp only [hur, ↓reduceIte]
    set η : F := (ζ⁻¹) ^ r.val * ζ ^ u.val
    have hη_pow : η ^ a = 1 := by
      simp [η, mul_pow, pow_right_comm _ _ a, hζ.pow_eq_one]
    have hη_ne : η ≠ 1 := fun h1 => hur <| Fin.ext <| hζ.pow_inj u.isLt r.isLt <| by
      simpa [η, inv_pow, ← mul_assoc, hζ0] using congrArg (ζ ^ r.val * ·) h1
    have hgeom : (∑ t : Fin a, η ^ t.val) * (η - 1) = 0 := by
      rw [Fin.sum_univ_eq_sum_range, geom_sum_mul, hη_pow, sub_self]
    exact (mul_eq_zero.mp hgeom).resolve_right (sub_ne_zero.mpr hη_ne)

/-- `foldComp` commutes with polynomial evaluation: applying `foldComp` to the evaluations of `p`
on `g * ⟨ω⟩` yields the evaluations of `polyComp a p r` on `g^a * ⟨ω^a⟩`. -/
theorem foldComp_eval {g ω : F} {a N : ℕ} (hg : g ≠ 0) (ha : (a : F) ≠ 0) (hN : 0 < N)
    (hω : IsPrimitiveRoot ω (a * N)) (p : F[X]) (r : Fin a) (j : Fin N) :
    foldComp g ω (fun i => p.eval (cosetPoint g ω (a * N) i)) r j =
      (polyComp a p r).eval (cosetPoint (g ^ a) (ω ^ a) N j) := by
  have ha_pos : 0 < a := Nat.pos_of_ne_zero fun h => ha (by simp [h])
  have hx0 : g * ω ^ j.val ≠ 0 :=
    mul_ne_zero hg (pow_ne_zero _ (hω.ne_zero (Nat.mul_ne_zero ha_pos.ne' hN.ne')))
  have hterm (t : Fin a) :
      p.eval (cosetPoint g ω (a * N) (fiberIdx j t)) =
        ∑ u : Fin a, (g * ω ^ j.val) ^ u.val * (ω ^ N) ^ (u.val * t.val) *
          (polyComp a p u).eval (cosetPoint (g ^ a) (ω ^ a) N j) := by
    rw [eval_eq_sum_eval_polyComp ha_pos p]
    refine Finset.sum_congr rfl fun u _ => ?_
    rw [cosetPoint_fiberIdx_pow_eq g ω hN hω j t, cosetPoint_fiberIdx g ω ha_pos j t]
    simp only [cosetPoint, mul_pow, ← pow_mul, mul_assoc, mul_comm t.val u.val]
  have hsum :
      (∑ t : Fin a,
        ((ω ^ N)⁻¹) ^ (r.val * t.val) * p.eval (cosetPoint g ω (a * N) (fiberIdx j t))) =
        (a : F) * (g * ω ^ j.val) ^ r.val *
          (polyComp a p r).eval (cosetPoint (g ^ a) (ω ^ a) N j) := by
    simp only [hterm, Finset.mul_sum]
    rw [Finset.sum_comm]
    have hmul (u : Fin a) : (∑ t : Fin a, ((ω ^ N)⁻¹) ^ (r.val * t.val) *
        ((g * ω ^ j.val) ^ u.val * (ω ^ N) ^ (u.val * t.val) *
          (polyComp a p u).eval (cosetPoint (g ^ a) (ω ^ a) N j))) =
        (if u = r then (a : F) else 0) * ((g * ω ^ j.val) ^ u.val *
          (polyComp a p u).eval (cosetPoint (g ^ a) (ω ^ a) N j)) := by
      rw [← sum_primitiveRoot_mul_inv (isPrimitiveRoot_fiber hN hω) u r, Finset.sum_mul]
      exact Finset.sum_congr rfl fun _ _ => by ring
    simp_rw [hmul]
    simp [mul_assoc]
  rw [foldComp, foldFiberComp, hsum, ← mul_assoc,
    inv_mul_cancel₀ (mul_ne_zero ha (pow_ne_zero r.val hx0)), one_mul]

/-- `foldWord` commutes with polynomial evaluation: folding the evaluations of `p` yields the
evaluations of `foldPoly a p z` on the powered coset. -/
theorem foldWord_eval {g ω : F} {a N : ℕ} (hg : g ≠ 0) (ha : (a : F) ≠ 0) (hN : 0 < N)
    (hω : IsPrimitiveRoot ω (a * N)) (p : F[X]) (z : F) (j : Fin N) :
    foldWord g ω (fun i => p.eval (cosetPoint g ω (a * N) i)) z j =
      (foldPoly a p z).eval (cosetPoint (g ^ a) (ω ^ a) N j) := by
  simp only [foldWord, foldFiber, eval_foldPoly]
  exact Finset.sum_congr rfl fun r _ =>
    congrArg (z ^ r.val * ·) (foldComp_eval hg ha hN hω p r j)

/-- **Reed–Solomon closure under folding**: folding a codeword of
`reedSolomon (cosetPoint g ω (a * N)) (a * k)` with any scalar `z : F` produces a codeword of
`reedSolomon (cosetPoint (g ^ a) (ω ^ a) N) k`. -/
theorem foldWord_mem_reedSolomon {g ω : F} {a N k : ℕ} (hg : g ≠ 0) (ha : (a : F) ≠ 0)
    (hN : 0 < N) (hω : IsPrimitiveRoot ω (a * N)) {f : Fin (a * N) → F}
    (hf : f ∈ reedSolomon (cosetPoint g ω (a * N)) (a * k)) (z : F) :
    foldWord g ω f z ∈ reedSolomon (cosetPoint (g ^ a) (ω ^ a) N) k := by
  have ha_pos : 0 < a := Nat.pos_of_ne_zero fun h => ha (by simp [h])
  obtain ⟨p, hp, rfl⟩ := mem_reedSolomon.mp hf
  exact mem_reedSolomon.mpr ⟨foldPoly a p z, degree_foldPoly_lt ha_pos hp z,
    funext fun j => (foldWord_eval hg ha hN hω p z j).symm⟩

/-- **Exact fiberwise reconstruction**: any word `f : Fin (a * N) → F` is recovered pointwise on
every fiber from its `a` IDFT components `foldComp g ω f r`. -/
theorem reconstruct_foldComp {g ω : F} {a N : ℕ} (hg : g ≠ 0) (ha : (a : F) ≠ 0) (hN : 0 < N)
    (hω : IsPrimitiveRoot ω (a * N)) (f : Fin (a * N) → F) (j : Fin N) (t : Fin a) :
    ∑ r : Fin a, (cosetPoint g ω (a * N) (fiberIdx j t)) ^ r.val * foldComp g ω f r j =
      f (fiberIdx j t) := by
  have ha_pos : 0 < a := Nat.pos_of_ne_zero fun h => ha (by simp [h])
  have hx0 : g * ω ^ j.val ≠ 0 :=
    mul_ne_zero hg (pow_ne_zero _ (hω.ne_zero (Nat.mul_ne_zero ha_pos.ne' hN.ne')))
  have hterm (r : Fin a) :
      (cosetPoint g ω (a * N) (fiberIdx j t)) ^ r.val * foldComp g ω f r j =
        (a : F)⁻¹ * ∑ u : Fin a,
          (((ω ^ N)⁻¹) ^ (u.val * r.val) * (ω ^ N) ^ (t.val * r.val)) * f (fiberIdx j u) := by
    rw [cosetPoint_fiberIdx g ω ha_pos j t, foldComp, foldFiberComp]
    simp only [cosetPoint, mul_inv, mul_pow, Finset.mul_sum]
    refine Finset.sum_congr rfl fun u _ => ?_
    rw [← pow_mul (ω ^ N) t.val r.val, mul_comm r.val u.val]
    calc _ = ((g * ω ^ j.val) ^ r.val * ((g * ω ^ j.val) ^ r.val)⁻¹) *
            ((a : F)⁻¹ * ((((ω ^ N)⁻¹) ^ (u.val * r.val) * (ω ^ N) ^ (t.val * r.val)) *
              f (fiberIdx j u))) := by ring
      _ = _ := by rw [mul_inv_cancel₀ (pow_ne_zero r.val hx0), one_mul]
  simp only [hterm, ← Finset.mul_sum]
  rw [Finset.sum_comm]
  simp_rw [← Finset.sum_mul, sum_primitiveRoot_mul_inv (isPrimitiveRoot_fiber hN hω) t]
  simp [← mul_assoc, inv_mul_cancel₀ ha]

/-- Product-to-fiber bijection `Fin N × Fin a ≃ Fin (a * N)` inverse to `(i % N, i / N)`. -/
private def fiberIdxEquiv {a N : ℕ} (hN : 0 < N) : Fin N × Fin a ≃ Fin (a * N) where
  toFun p := fiberIdx p.1 p.2
  invFun i :=
    (⟨i.val % N, Nat.mod_lt i.val hN⟩,
     ⟨i.val / N, (Nat.div_lt_iff_lt_mul hN).mpr (by simpa only [mul_comm] using i.isLt)⟩)
  left_inv p := Prod.ext
    (Fin.ext <| by simp [fiberIdx, Nat.mod_eq_of_lt p.1.isLt])
    (Fin.ext <| by
      simp only [fiberIdx]
      rw [Nat.add_mul_div_right _ _ hN, Nat.div_eq_of_lt p.1.isLt, zero_add])
  right_inv i := Fin.ext <| by
    simp only [fiberIdx]
    rw [mul_comm (i.val / N) N, add_comm, Nat.div_add_mod]

/-- Push-forward of a coordinate weight function `W : Fin (a * N) → ℕ` across `a`-element fibers.
-/
@[expose] def pushWeight {a N : ℕ} (W : Fin (a * N) → ℕ) (j : Fin N) : ℕ :=
  ∑ t : Fin a, W (fiberIdx j t)

/-- Total weight is preserved by `pushWeight`: `∑ j, pushWeight W j = ∑ i, W i`. -/
theorem sum_pushWeight {a N : ℕ} (W : Fin (a * N) → ℕ) :
    (∑ j : Fin N, pushWeight W j) = ∑ i : Fin (a * N), W i := by
  rcases Nat.eq_zero_or_pos N with rfl | hN
  · simp [pushWeight]
  · unfold pushWeight
    rw [← Fintype.sum_prod_type']
    exact Fintype.sum_equiv (fiberIdxEquiv hN) _ _ fun _ => rfl

/-- Pointwise upper bound on `pushWeight`: if every coordinate has weight `≤ M`, then every fiber
has pushed-forward weight `≤ a * M`. -/
theorem pushWeight_le {a N M : ℕ} {W : Fin (a * N) → ℕ} (hW : ∀ i, W i ≤ M) (j : Fin N) :
    pushWeight W j ≤ a * M := by
  calc pushWeight W j
      ≤ ∑ _t : Fin a, M := Finset.sum_le_sum fun t _ => hW (fiberIdx j t)
    _ = a * M := by simp

/-- **Weighted correlated-agreement lifting across `a`-to-1 folding**: for any word `f` and
component codewords `v r ∈ reedSolomon (cosetPoint (g^a) (ω^a) N) k`, there exists a codeword
`c ∈ reedSolomon (cosetPoint g ω (a * N)) (a * k)` agreeing with `f` on every fiber over the
simultaneous agreement set `{j | ∀ r, foldComp g ω f r j = v r j}`, preserving all pushed-forward
weights. -/
theorem exists_mem_reedSolomon_weighted_agree_lift {g ω : F} {a N k : ℕ} [DecidableEq F]
    (hg : g ≠ 0) (ha : (a : F) ≠ 0) (hN : 0 < N) (hω : IsPrimitiveRoot ω (a * N))
    (f : Fin (a * N) → F) (v : Fin a → Fin N → F)
    (hv : ∀ r, v r ∈ reedSolomon (cosetPoint (g ^ a) (ω ^ a) N) k)
    (W : Fin (a * N) → ℕ) :
    ∃ c ∈ reedSolomon (cosetPoint g ω (a * N)) (a * k),
      (∀ j : Fin N, (∀ r : Fin a, foldComp g ω f r j = v r j) →
        ∀ t : Fin a, f (fiberIdx j t) = c (fiberIdx j t)) ∧
      (∑ j ∈ Finset.univ.filter (fun j : Fin N => ∀ r : Fin a, foldComp g ω f r j = v r j),
          pushWeight W j) ≤
        ∑ i ∈ Finset.univ.filter (fun i => f i = c i), W i := by
  have ha_pos : 0 < a := Nat.pos_of_ne_zero fun h => ha (by simp [h])
  choose ps hps_deg hps_eval using fun r => mem_reedSolomon.mp (hv r)
  let c : Fin (a * N) → F := fun i => (reconstructPoly a ps).eval (cosetPoint g ω (a * N) i)
  have hc_agree (j : Fin N) (hj : ∀ r : Fin a, foldComp g ω f r j = v r j) (t : Fin a) :
      f (fiberIdx j t) = c (fiberIdx j t) := by
    rw [← reconstruct_foldComp hg ha hN hω f j t]
    simp only [c, eval_reconstructPoly]
    exact Finset.sum_congr rfl fun r _ => by
      rw [cosetPoint_fiberIdx_pow_eq g ω hN hω j t, hj r, ← hps_eval r]
  refine ⟨c, eval_mem_reedSolomon _ (degree_reconstructPoly_lt ha_pos hps_deg), hc_agree, ?_⟩
  let S : Finset (Fin N) :=
    Finset.univ.filter fun j : Fin N => ∀ r : Fin a, foldComp g ω f r j = v r j
  calc ∑ j ∈ S, pushWeight W j
      = ∑ p ∈ S ×ˢ (Finset.univ : Finset (Fin a)), W (fiberIdxEquiv hN p) := by
        rw [Finset.sum_product]
        rfl
    _ = ∑ i ∈ (S ×ˢ (Finset.univ : Finset (Fin a))).image (fiberIdxEquiv hN), W i :=
        (Finset.sum_image fun _ _ _ _ h => (fiberIdxEquiv hN).injective h).symm
    _ ≤ ∑ i ∈ Finset.univ.filter (fun i => f i = c i), W i := by
        refine Finset.sum_le_sum_of_subset fun i hi => ?_
        rcases Finset.mem_image.mp hi with ⟨⟨j, t⟩, hjt, rfl⟩
        exact Finset.mem_filter.mpr ⟨Finset.mem_univ _,
          hc_agree j (Finset.mem_filter.mp (Finset.mem_product.mp hjt).1).2 t⟩

end WordFolding

section TwoToOneFolding

variable {F : Type*} [Field F]

/-- Local 2-to-1 FRI folding formula on a single negation pair `(yPos, yNeg)` at `(xPos, -xPos)`
with folding scalar `z`. -/
@[expose] def fold2Fiber (yPos yNeg xPos z : F) : F :=
  (yPos + yNeg) / 2 + z * ((yPos - yNeg) / (2 * xPos))

/-- **Fiber-representative invariance**: swapping `(xPos, -xPos)` and their evaluations
`(yPos, yNeg)` yields the exact same 2-to-1 folded value. -/
theorem fold2Fiber_swap (yPos yNeg xPos z : F) :
    fold2Fiber yNeg yPos (-xPos) z = fold2Fiber yPos yNeg xPos z := by
  simp only [fold2Fiber, mul_neg, div_neg]
  ring

/-- Explicit even component word for 2-to-1 folding: `j ↦ (f j + f (j + N)) / 2`. -/
@[expose] def fold2Even {N : ℕ} (f : Fin (2 * N) → F) (j : Fin N) : F :=
  (f ⟨j.val, by omega⟩ + f ⟨j.val + N, by omega⟩) / 2

/-- Explicit odd component word for 2-to-1 folding:
`j ↦ (f j - f (j + N)) / (2 * cosetPoint g ω (2 * N) j)`. -/
@[expose] def fold2Odd (g ω : F) {N : ℕ} (f : Fin (2 * N) → F) (j : Fin N) : F :=
  (f ⟨j.val, by omega⟩ - f ⟨j.val + N, by omega⟩) / (2 * cosetPoint g ω (2 * N) ⟨j.val, by omega⟩)

/-- Explicit 2-to-1 FRI folding operator on a coset of size `2 * N`. -/
@[expose] def fold2 (g ω : F) {N : ℕ} (f : Fin (2 * N) → F) (z : F) (j : Fin N) : F :=
  fold2Fiber (f ⟨j.val, by omega⟩) (f ⟨j.val + N, by omega⟩)
    (cosetPoint g ω (2 * N) ⟨j.val, by omega⟩) z

/-- `fold2` is the exact affine line `fold2Even f + z • fold2Odd g ω f`. -/
theorem fold2_eq_line (g ω : F) {N : ℕ} (f : Fin (2 * N) → F) (z : F) :
    fold2 g ω f z = fold2Even f + z • fold2Odd g ω f := by
  ext j
  rfl

/-- Helper: `ω ^ N = -1` whenever `ω` is a primitive `(2 * N)`-th root of unity. -/
private theorem pow_half_eq_neg_one {ω : F} {N : ℕ} (hN : 0 < N)
    (hω : IsPrimitiveRoot ω (2 * N)) :
    ω ^ N = -1 :=
  (isPrimitiveRoot_fiber hN hω).eq_neg_one_of_two_right

/-- `fold2Even` agrees with `foldComp` at component `0` for `a = 2`. -/
theorem fold2Even_eq_foldComp {g ω : F} {N : ℕ} (f : Fin (2 * N) → F) :
    fold2Even f = foldComp g ω f ⟨0, by omega⟩ := by
  ext j
  simp only [fold2Even, foldComp, foldFiberComp, Fin.sum_univ_two, fiberIdx, pow_zero, mul_one,
    zero_mul, one_mul, add_zero, Fin.val_zero, Fin.val_one, Nat.cast_ofNat]
  rw [div_eq_inv_mul]

/-- `fold2Odd` agrees with `foldComp` at component `1` for `a = 2`. -/
theorem fold2Odd_eq_foldComp {g ω : F} {N : ℕ} (hN : 0 < N) (hω : IsPrimitiveRoot ω (2 * N))
    (f : Fin (2 * N) → F) :
    fold2Odd g ω f = foldComp g ω f ⟨1, by omega⟩ := by
  ext j
  have hneg : ω ^ N = -1 := pow_half_eq_neg_one hN hω
  simp only [fold2Odd, foldComp, foldFiberComp, cosetPoint, Fin.sum_univ_two, fiberIdx, pow_zero,
    pow_one, zero_mul, one_mul, add_zero, Fin.val_zero, Fin.val_one, Nat.cast_ofNat, hneg, inv_neg,
    inv_one, neg_mul, ← sub_eq_add_neg]
  rw [div_eq_inv_mul]

/-- At `a = 2`, the local `a`-to-1 fiber evaluator `foldFiber` coincides with `fold2Fiber`. -/
theorem foldFiber_two_eq_fold2Fiber {g ω : F} {N : ℕ} (hN : 0 < N)
    (hω : IsPrimitiveRoot ω (2 * N)) (ys : Fin 2 → F) (j : Fin N) (z : F) :
    foldFiber g ω ys j z =
      fold2Fiber (ys 0) (ys 1) (cosetPoint g ω (2 * N) ⟨j.val, by omega⟩) z := by
  have hneg : ω ^ N = -1 := pow_half_eq_neg_one hN hω
  simp only [foldFiber, foldFiberComp, fold2Fiber, cosetPoint, Fin.sum_univ_two, Fin.val_zero,
    Fin.val_one, pow_zero, pow_one, one_mul, zero_mul, mul_one, Nat.cast_ofNat, hneg, inv_neg,
    inv_one, neg_mul, ← sub_eq_add_neg, div_eq_inv_mul]

/-- The explicit 2-to-1 folding operator `fold2` coincides with `foldWord` at `a = 2`. -/
theorem fold2_eq_foldWord {g ω : F} {N : ℕ} (hN : 0 < N) (hω : IsPrimitiveRoot ω (2 * N))
    (f : Fin (2 * N) → F) (z : F) :
    fold2 g ω f z = foldWord g ω f z := by
  rw [fold2_eq_line, foldWord_eq_sum_smul, Fin.sum_univ_two]
  simp only [pow_zero, one_smul, pow_one, Fin.val_zero, Fin.val_one]
  rw [fold2Even_eq_foldComp (g := g) (ω := ω) f, fold2Odd_eq_foldComp hN hω f]
  rfl

/-- **Reed–Solomon closure of 2-to-1 folding**: folding a codeword of
`reedSolomon (cosetPoint g ω (2 * N)) (2 * k)` produces a codeword of
`reedSolomon (cosetPoint (g ^ 2) (ω ^ 2) N) k`. -/
theorem fold2_mem_reedSolomon {g ω : F} {N k : ℕ} (hg : g ≠ 0) (h2 : (2 : F) ≠ 0)
    (hN : 0 < N) (hω : IsPrimitiveRoot ω (2 * N)) {f : Fin (2 * N) → F}
    (hf : f ∈ reedSolomon (cosetPoint g ω (2 * N)) (2 * k)) (z : F) :
    fold2 g ω f z ∈ reedSolomon (cosetPoint (g ^ 2) (ω ^ 2) N) k := by
  rw [fold2_eq_foldWord hN hω]
  exact foldWord_mem_reedSolomon hg (by simpa using h2) hN hω hf z

/-- **2-to-1 weighted correlated-agreement lifting**: for any word `f` and codewords
`(v₀, v₁) ∈ RS(L², k)²`, there exists `c ∈ RS(L, 2 * k)` whose `W`-weighted agreement with `f` is
at least the pushed-forward weight of `{j | fold2Even f j = v₀ j ∧ fold2Odd g ω f j = v₁ j}`. -/
theorem exists_mem_reedSolomon_weighted_agree_lift_two {g ω : F} {N k : ℕ} [DecidableEq F]
    (hg : g ≠ 0) (h2 : (2 : F) ≠ 0) (hN : 0 < N) (hω : IsPrimitiveRoot ω (2 * N))
    (f : Fin (2 * N) → F) {v₀ v₁ : Fin N → F}
    (hv₀ : v₀ ∈ reedSolomon (cosetPoint (g ^ 2) (ω ^ 2) N) k)
    (hv₁ : v₁ ∈ reedSolomon (cosetPoint (g ^ 2) (ω ^ 2) N) k)
    (W : Fin (2 * N) → ℕ) :
    ∃ c ∈ reedSolomon (cosetPoint g ω (2 * N)) (2 * k),
      (∑ j ∈ Finset.univ.filter (fun j : Fin N => fold2Even f j = v₀ j ∧ fold2Odd g ω f j = v₁ j),
          (W ⟨j.val, by omega⟩ + W ⟨j.val + N, by omega⟩)) ≤
        ∑ i ∈ Finset.univ.filter (fun i => f i = c i), W i := by
  obtain ⟨c, hc_mem, -, hsum⟩ :=
    exists_mem_reedSolomon_weighted_agree_lift hg (by simpa using h2) hN hω f ![v₀, v₁]
      (Fin.forall_fin_two.mpr ⟨hv₀, hv₁⟩) W
  refine ⟨c, hc_mem, ?_⟩
  simp only [Fin.forall_fin_two, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_fin_one,
    pushWeight, Fin.sum_univ_two, fiberIdx, Fin.val_zero, Fin.val_one, zero_mul, add_zero,
    one_mul] at hsum
  simp only [fold2Even_eq_foldComp (g := g) (ω := ω) f, fold2Odd_eq_foldComp hN hω f]
  exact hsum

end TwoToOneFolding

section WeightedDoubleCounting

variable {F ι : Type*} [Field F] [Fintype ι] [DecidableEq F]

/-- Two distinct vectors `u ≠ v : Fin a → F` yield matching degree-`(a - 1)` polynomial evaluations
at most `a - 1` times on any finite subset `Z ⊆ F`. -/
private theorem card_filter_poly_eq_le {a : ℕ} (u v : Fin a → F) (hne : u ≠ v) (Z : Finset F) :
    (Z.filter fun z => (∑ r : Fin a, z ^ r.val * u r) = ∑ r : Fin a, z ^ r.val * v r).card ≤
      a - 1 := by
  classical
  let P : F[X] := ∑ r : Fin a, Polynomial.monomial r.val (u r - v r)
  have hP_ne : P ≠ 0 := by
    obtain ⟨r, hr⟩ : ∃ r : Fin a, u r ≠ v r := not_forall.mp fun h => hne (funext h)
    intro h0
    have hcoeff : P.coeff r.val = 0 := by rw [h0, coeff_zero]
    simp only [P, finsetSum_coeff, coeff_monomial, Finsupp.single_apply, Fin.val_inj,
      Finset.sum_ite_eq', Finset.mem_univ, ↓reduceIte] at hcoeff
    exact hr (sub_eq_zero.mp hcoeff)
  have hsub : (Z.filter fun z =>
      (∑ r : Fin a, z ^ r.val * u r) = ∑ r : Fin a, z ^ r.val * v r) ⊆ P.roots.toFinset := by
    intro z hz
    rw [Multiset.mem_toFinset, mem_roots hP_ne, IsRoot.def]
    simp only [P, eval_finsetSum, eval_monomial, mul_comm _ (z ^ _), mul_sub,
      Finset.sum_sub_distrib]
    exact sub_eq_zero.mpr (Finset.mem_filter.mp hz).2
  calc _ ≤ P.roots.toFinset.card := Finset.card_le_card hsub
    _ ≤ P.roots.card := Multiset.toFinset_card_le _
    _ ≤ P.natDegree := card_roots' P
    _ ≤ a - 1 := natDegree_sum_le_of_forall_le _ _ fun r _ =>
        (natDegree_monomial_le _).trans (Nat.le_sub_one_of_lt r.isLt)

/-- **Integer-weighted curve union bound**: given `a ≥ 1`, integer weights `W : ι → ℕ`, and two
degree-`(a - 1)` curves `u, v : Fin a → ι → F`, if more than `(a - 1) * |{i | 0 < W i}|` scalars
`z ∈ Z` achieve `W`-weighted agreement `> B` between `∑ r, z^r • u r` and `∑ r, z^r • v r`, then
`u` and `v` agree simultaneously across all `r : Fin a` on a set of `W`-weight `> B`. -/
theorem weighted_agree_of_curve_many {a : ℕ} (ha : 1 ≤ a) (W : ι → ℕ)
    (u v : Fin a → ι → F) (Z : Finset F) (B : ℕ)
    (hZ : (a - 1) * (Finset.univ.filter fun i : ι => 0 < W i).card < Z.card)
    (hgood : ∀ z ∈ Z,
      B < ∑ i ∈ Finset.univ.filter (fun i =>
        (∑ r : Fin a, z ^ r.val * u r i) = ∑ r : Fin a, z ^ r.val * v r i), W i) :
    B < ∑ i ∈ Finset.univ.filter (fun i => ∀ r : Fin a, u r i = v r i), W i := by
  classical
  have _ := ha
  let S : Finset ι := Finset.univ.filter fun i => ∀ r : Fin a, u r i = v r i
  let agree (z : F) : Finset ι :=
    Finset.univ.filter fun i => (∑ r : Fin a, z ^ r.val * u r i) = ∑ r : Fin a, z ^ r.val * v r i
  let T : Finset ι := Finset.univ.filter fun i => i ∉ S ∧ 0 < W i
  by_contra hle
  push Not at hle
  have hcover : Z ⊆ T.biUnion fun i => Z.filter fun z => i ∈ agree z := fun z hz => by
    have ⟨i, hi_ag, hi_ns, hi_pos⟩ : ∃ i ∈ agree z, i ∉ S ∧ 0 < W i := by
      by_contra hnone
      push Not at hnone
      have heq : ∑ i ∈ (agree z).filter (· ∈ S), W i = ∑ i ∈ agree z, W i :=
        Finset.sum_subset (Finset.filter_subset _ _) fun i hi hns =>
          Nat.eq_zero_of_le_zero (hnone i hi fun hS => hns (Finset.mem_filter.mpr ⟨hi, hS⟩))
      exact absurd (lt_of_lt_of_le (hgood z hz) <| (heq ▸ Finset.sum_le_sum_of_subset
        fun _ hi => (Finset.mem_filter.mp hi).2).trans hle) (lt_irrefl B)
    exact Finset.mem_biUnion.mpr ⟨i, Finset.mem_filter.mpr ⟨Finset.mem_univ _, hi_ns, hi_pos⟩,
      Finset.mem_filter.mpr ⟨hz, hi_ag⟩⟩
  refine absurd hZ <| not_lt_of_ge <| calc
    Z.card ≤ (T.biUnion fun i => Z.filter fun z => i ∈ agree z).card := Finset.card_le_card hcover
    _ ≤ ∑ i ∈ T, (Z.filter fun z => i ∈ agree z).card := Finset.card_biUnion_le
    _ ≤ ∑ _i ∈ T, (a - 1) := Finset.sum_le_sum fun i hi => by
        have hns : (fun r => u r i) ≠ fun r => v r i := fun heq =>
          (Finset.mem_filter.mp hi).2.1
            (Finset.mem_filter.mpr ⟨Finset.mem_univ _, congrFun heq⟩)
        simpa only [agree, Finset.mem_filter, Finset.mem_univ, true_and] using
          card_filter_poly_eq_le (fun r => u r i) (fun r => v r i) hns Z
    _ = (a - 1) * T.card := by simp [mul_comm]
    _ ≤ (a - 1) * (Finset.univ.filter fun i : ι => 0 < W i).card :=
        Nat.mul_le_mul_left _ <| Finset.card_le_card fun _ hi =>
          Finset.mem_filter.mpr ⟨Finset.mem_univ _, (Finset.mem_filter.mp hi).2.2⟩

/-- **Integer-weighted line union bound**: if more than `Fintype.card ι` scalars `z ∈ Z` achieve
`W`-weighted agreement `> B` between `u₀ + z • u₁` and `v₀ + z • v₁`, then `(u₀, u₁)` agrees with
`(v₀, v₁)` simultaneously on a set of `W`-weight `> B`. -/
theorem weighted_agree_of_line_many (W : ι → ℕ) (u₀ u₁ v₀ v₁ : ι → F) (Z : Finset F) (B : ℕ)
    (hZ : Fintype.card ι < Z.card)
    (hgood : ∀ z ∈ Z,
      B < ∑ i ∈ Finset.univ.filter (fun i => (u₀ + z • u₁) i = (v₀ + z • v₁) i), W i) :
    B < ∑ i ∈ Finset.univ.filter (fun i => u₀ i = v₀ i ∧ u₁ i = v₁ i), W i := by
  have hfilt : (Finset.univ.filter fun i : ι => 0 < W i).card ≤ Fintype.card ι := by
    simpa only [Finset.card_univ] using Finset.card_filter_le (Finset.univ : Finset ι) _
  simpa only [Fin.forall_fin_two, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.cons_val_fin_one] using
    weighted_agree_of_curve_many (a := 2) (by omega) W ![u₀, u₁] ![v₀, v₁] Z B
      (by simpa only [Nat.reduceSub, one_mul] using hfilt.trans_lt hZ) fun z hz => by
        simpa only [Fin.sum_univ_two, Fin.val_zero, Fin.val_one, pow_zero, pow_one, one_mul,
          Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Pi.add_apply,
          Pi.smul_apply, smul_eq_mul] using hgood z hz

end WeightedDoubleCounting

end Cslib.Crypto.Protocols.FRI
