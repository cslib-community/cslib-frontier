/-!
# Semialgebraic isomorphisms and stable isomorphism

Two semialgebraic sets are **semialgebraically isomorphic** if there is a homeomorphism between
them whose graph is semialgebraic. They are **stably isomorphic** if they lie in the same class of
the equivalence relation generated by semialgebraic isomorphisms and the projections
`V × ℝᵏ → V` ([Datta2003], §1, p. 2).

The sets are subsets `A ⊆ σ → ℝ`. The graph of a map `A → B ⊆ τ → ℝ` is a subset of `σ ⊕ τ → ℝ`,
and `V × ℝᵏ` is the subset `{z | z ∘ Sum.inl ∈ V}` of `σ ⊕ Fin k → ℝ`. As for `IsSemialgebraic`,
the definitions allow any coordinate types; the notion is the standard one for finite `σ`.

## Main definitions

* `Cslib.SemialgebraicHomeomorph A B`: a homeomorphism `A ≃ₜ B` with semialgebraic graph.
* `Cslib.StablyIsomorphic A B`: the equivalence relation generated by semialgebraic isomorphisms
  and the projections `V × ℝᵏ → V`.

## Main results

* `Cslib.SemialgebraicHomeomorph.ofInverse`: a semialgebraic isomorphism from maps inverse to each
  other on `A` and `B`, continuous on them, whose graph, written through the inverse, is
  semialgebraic.
* `Cslib.SemialgebraicHomeomorph.reindex`: renaming the coordinates of a semialgebraic set.
* `Cslib.SemialgebraicHomeomorph.symm`: the inverse of a semialgebraic isomorphism.
* `Cslib.StablyIsomorphic.prod`: `V × ℝ^κ` is stably isomorphic to `V` for any finite `κ`.
* `Cslib.StablyIsomorphic.nonempty_iff`: stable isomorphism preserves (non)emptiness.

## References

* [Datta2003]
-/

public section

namespace Cslib

open MvPolynomial

universe u

variable {σ τ : Type*}

/-- A **semialgebraic isomorphism** between `A ⊆ σ → ℝ` and `B ⊆ τ → ℝ`: a homeomorphism whose
graph `{(a, e a) | a ∈ A} ⊆ σ ⊕ τ → ℝ` is semialgebraic ([Datta2003], §1, p. 2). -/
structure SemialgebraicHomeomorph (A : Set (σ → ℝ)) (B : Set (τ → ℝ)) extends A ≃ₜ B where
  /-- The graph of the homeomorphism is semialgebraic. -/
  isSemialgebraic_graph :
    IsSemialgebraic (Set.range fun a : A => Sum.elim (a : σ → ℝ) (toFun a : τ → ℝ))

namespace SemialgebraicHomeomorph

variable {A : Set (σ → ℝ)} {B : Set (τ → ℝ)}

/-- A semialgebraic isomorphism from maps `f` and `g` that are inverse to each other between `A`
and `B` and continuous on them, provided the graph of `g`,
`{z | z ∘ Sum.inr ∈ B ∧ g (z ∘ Sum.inr) = z ∘ Sum.inl}`, is semialgebraic. -/
noncomputable def ofInverse (f : (σ → ℝ) → τ → ℝ) (g : (τ → ℝ) → σ → ℝ)
    (hf : ∀ x ∈ A, f x ∈ B) (hg : ∀ y ∈ B, g y ∈ A) (hgf : ∀ x ∈ A, g (f x) = x)
    (hfg : ∀ y ∈ B, f (g y) = y) (hfc : ContinuousOn f A) (hgc : ContinuousOn g B)
    (hgraph : IsSemialgebraic {z : σ ⊕ τ → ℝ | z ∘ Sum.inr ∈ B ∧ g (z ∘ Sum.inr) = z ∘ Sum.inl}) :
    SemialgebraicHomeomorph A B where
  toFun x := ⟨f x, hf x x.2⟩
  invFun y := ⟨g y, hg y y.2⟩
  left_inv x := Subtype.ext (hgf x x.2)
  right_inv y := Subtype.ext (hfg y y.2)
  continuous_toFun := (continuousOn_iff_continuous_domRestrict.1 hfc).subtype_mk _
  continuous_invFun := (continuousOn_iff_continuous_domRestrict.1 hgc).subtype_mk _
  isSemialgebraic_graph := by
    convert hgraph using 1
    ext z
    simp only [Set.mem_range, Subtype.exists, Set.mem_ofPred_eq]
    constructor
    · rintro ⟨x, hx, rfl⟩
      simp only [Sum.elim_comp_inl, Sum.elim_comp_inr]
      exact ⟨hf x hx, hgf x hx⟩
    · rintro ⟨hz, hgz⟩
      refine ⟨z ∘ Sum.inl, hgz ▸ hg _ hz, ?_⟩
      rw [← hgz, hfg _ hz, hgz, Sum.elim_comp_inl_inr]

@[simp] theorem coe_ofInverse_apply (f : (σ → ℝ) → τ → ℝ) (g : (τ → ℝ) → σ → ℝ)
    (hf : ∀ x ∈ A, f x ∈ B) (hg : ∀ y ∈ B, g y ∈ A) (hgf : ∀ x ∈ A, g (f x) = x)
    (hfg : ∀ y ∈ B, f (g y) = y) (hfc : ContinuousOn f A) (hgc : ContinuousOn g B)
    (hgraph : IsSemialgebraic {z : σ ⊕ τ → ℝ | z ∘ Sum.inr ∈ B ∧ g (z ∘ Sum.inr) = z ∘ Sum.inl})
    (x : A) :
    ((ofInverse f g hf hg hgf hfg hfc hgc hgraph).toHomeomorph x : τ → ℝ) = f x := by
  unfold ofInverse
  rfl

@[simp] theorem coe_ofInverse_symm_apply (f : (σ → ℝ) → τ → ℝ) (g : (τ → ℝ) → σ → ℝ)
    (hf : ∀ x ∈ A, f x ∈ B) (hg : ∀ y ∈ B, g y ∈ A) (hgf : ∀ x ∈ A, g (f x) = x)
    (hfg : ∀ y ∈ B, f (g y) = y) (hfc : ContinuousOn f A) (hgc : ContinuousOn g B)
    (hgraph : IsSemialgebraic {z : σ ⊕ τ → ℝ | z ∘ Sum.inr ∈ B ∧ g (z ∘ Sum.inr) = z ∘ Sum.inl})
    (y : B) :
    ((ofInverse f g hf hg hgf hfg hfc hgc hgraph).toHomeomorph.symm y : σ → ℝ) = g y := by
  unfold ofInverse
  rfl

/-- **Renaming the coordinates** of a semialgebraic set `A ⊆ σ → ℝ` along `e : σ ≃ τ` is a
semialgebraic isomorphism onto `{y | y ∘ e ∈ A}`. -/
noncomputable def reindex [Finite σ] (e : σ ≃ τ) (hA : IsSemialgebraic A) :
    SemialgebraicHomeomorph A {y : τ → ℝ | y ∘ e ∈ A} :=
  ofInverse (fun x => x ∘ e.symm) (fun y => y ∘ e)
    (fun x hx => by simpa [Function.comp_assoc] using hx) (fun _ hy => hy)
    (fun x _ => by simp [Function.comp_assoc]) (fun y _ => by simp [Function.comp_assoc])
    (continuous_pi fun _ => continuous_apply _).continuousOn
    (continuous_pi fun _ => continuous_apply _).continuousOn <| by
      have hB := hA.preimage_comp (σ := σ ⊕ τ) (Sum.inr ∘ e)
      convert hB.inter (IsSemialgebraic.iInter fun s : σ =>
        IsSemialgebraic.setOf_eq (X (Sum.inr (e s))) (X (Sum.inl s))) using 1
      ext z
      simp only [Set.mem_ofPred_eq, Set.mem_inter_iff, Set.mem_preimage, Set.mem_iInter, eval_X,
        funext_iff, Function.comp_apply]
      rfl

/-- The inverse of a semialgebraic isomorphism is a semialgebraic isomorphism: its graph is the
graph of `e` with the two blocks of coordinates swapped. -/
noncomputable def symm (e : SemialgebraicHomeomorph A B) : SemialgebraicHomeomorph B A where
  toHomeomorph := e.toHomeomorph.symm
  isSemialgebraic_graph := by
    convert e.isSemialgebraic_graph.preimage_comp (Sum.swap : σ ⊕ τ → τ ⊕ σ) using 1
    ext w
    simp only [Set.mem_range, Set.mem_preimage]
    constructor
    · rintro ⟨b, rfl⟩
      refine ⟨e.toHomeomorph.symm b, funext fun k => ?_⟩
      rcases k with k | k <;> simp
    · rintro ⟨a, ha⟩
      refine ⟨e.toHomeomorph a, funext fun k => ?_⟩
      have := congrFun ha (Sum.swap k)
      rcases k with k | k <;> simpa using this

end SemialgebraicHomeomorph

/-- **Stable isomorphism** ([Datta2003], §1, p. 2): the equivalence relation generated by
semialgebraic isomorphisms and the projections `V × ℝᵏ → V`, where `V × ℝᵏ` is the subset
`{z | z ∘ Sum.inl ∈ V}` of `σ ⊕ Fin k → ℝ`. -/
inductive StablyIsomorphic : {σ : Type u} → Set (σ → ℝ) → {τ : Type u} → Set (τ → ℝ) → Prop
  /-- Semialgebraically isomorphic sets are stably isomorphic. -/
  | of_homeomorph {σ τ : Type u} {A : Set (σ → ℝ)} {B : Set (τ → ℝ)} :
      SemialgebraicHomeomorph A B → StablyIsomorphic A B
  /-- `V × ℝᵏ` is stably isomorphic to `V`. -/
  | prod_fin {σ : Type u} (V : Set (σ → ℝ)) (k : ℕ) :
      StablyIsomorphic {z : σ ⊕ Fin k → ℝ | z ∘ Sum.inl ∈ V} V
  /-- Stable isomorphism is symmetric. -/
  | symm {σ τ : Type u} {A : Set (σ → ℝ)} {B : Set (τ → ℝ)} :
      StablyIsomorphic A B → StablyIsomorphic B A
  /-- Stable isomorphism is transitive. -/
  | trans {σ τ υ : Type u} {A : Set (σ → ℝ)} {B : Set (τ → ℝ)} {C : Set (υ → ℝ)} :
      StablyIsomorphic A B → StablyIsomorphic B C → StablyIsomorphic A C

namespace StablyIsomorphic

variable {σ τ : Type u}

theorem refl (A : Set (σ → ℝ)) : StablyIsomorphic A A :=
  (prod_fin A 0).symm.trans (prod_fin A 0)

/-- `V × ℝ^κ` is stably isomorphic to a semialgebraic `V`, for any finite `κ`. -/
theorem prod [Finite σ] {V : Set (σ → ℝ)} (hV : IsSemialgebraic V) (κ : Type u) [Finite κ] :
    StablyIsomorphic {z : σ ⊕ κ → ℝ | z ∘ Sum.inl ∈ V} V := by
  have := Fintype.ofFinite κ
  have hA : IsSemialgebraic {z : σ ⊕ κ → ℝ | z ∘ Sum.inl ∈ V} := hV.preimage_comp Sum.inl
  have e := SemialgebraicHomeomorph.reindex
    ((Equiv.refl σ).sumCongr (Fintype.equivFin κ)) hA
  have hset : {y : σ ⊕ Fin (Fintype.card κ) → ℝ |
      y ∘ ((Equiv.refl σ).sumCongr (Fintype.equivFin κ)) ∈ {z : σ ⊕ κ → ℝ | z ∘ Sum.inl ∈ V}} =
      {z | z ∘ Sum.inl ∈ V} := by
    ext y
    rfl
  rw [hset] at e
  exact (of_homeomorph e).trans (prod_fin V _)

/-- Stably isomorphic sets are both empty or both nonempty. -/
theorem nonempty_iff {σ τ : Type u} {A : Set (σ → ℝ)} {B : Set (τ → ℝ)}
    (h : StablyIsomorphic A B) : A.Nonempty ↔ B.Nonempty := by
  induction h with
  | of_homeomorph e =>
    exact ⟨fun ⟨a, ha⟩ => ⟨_, (e.toHomeomorph ⟨a, ha⟩).2⟩,
      fun ⟨b, hb⟩ => ⟨_, (e.toHomeomorph.symm ⟨b, hb⟩).2⟩⟩
  | prod_fin V k =>
    exact ⟨fun ⟨z, hz⟩ => ⟨z ∘ Sum.inl, hz⟩,
      fun ⟨v, hv⟩ => ⟨Sum.elim v 0, by simpa [Set.mem_ofPred_eq] using hv⟩⟩
  | symm _ ih => exact ih.symm
  | trans _ _ ih₁ ih₂ => exact ih₁.trans ih₂

end StablyIsomorphic

end Cslib
