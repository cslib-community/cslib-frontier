/-!
# Semialgebraic sets

The standard definition takes `σ` finite and `R = ℝ` (or a real closed field): a subset of `ℝⁿ` is
**semialgebraic** if it belongs to the Boolean algebra of sets generated by the sign conditions
`{x | f(x) = 0}` and `{x | 0 < f(x)}` for polynomials `f` ([Coste2002], §2.1.1, p. 25; see also
[BochnakCosteRoy1998], Chapter 2). The sets `{x | 0 < f(x)}` alone generate the same Boolean
algebra, since `{x | f(x) = 0}` is the complement of `{x | 0 < f(x)} ∪ {x | 0 < -f(x)}`
(`IsSemialgebraic.setOf_eq_zero`). The definition here is an inductive predicate with one
constructor per generator and closure operation.

It is stated more generally, for any coordinate type `σ` and any commutative ring `R` with a
linear order. No compatibility between the order and the ring operations is assumed by the
definition or by its Boolean closure lemmas. The sign-condition lemmas (`setOf_nonneg`,
`setOf_eq_zero`, `setOf_le`, …) assume `IsStrictOrderedRing R`, and the uses in game theory take
`R = ℝ` with finitely many coordinates, where the definition is the standard one.

## Main definitions

* `Cslib.IsSemialgebraic s`: `s` is semialgebraic.

## Main results

* Closure: `IsSemialgebraic.union`, `.inter`, `.compl`, `.diff`, finite unions and
  intersections (`IsSemialgebraic.iUnion`, `IsSemialgebraic.iInter` and their `Finset` forms).
* Sign conditions: the sets `{x | f(x) = 0}`, `{x | f(x) ≤ g(x)}`, `{x | f(x) < g(x)}` and
  `{x | f(x) = g(x)}` are semialgebraic.
* `IsSemialgebraic.preimage_eval`: the preimage of a semialgebraic set under a polynomial map is
  semialgebraic; in particular semialgebraicity is invariant under renaming the coordinates
  (`IsSemialgebraic.preimage_comp`).

Closure under coordinate projections (the Tarski–Seidenberg theorem) is not proved here.

## References

* [M. Coste, *An Introduction to Semialgebraic Geometry*][Coste2002]
* [J. Bochnak, M. Coste and M.-F. Roy, *Real Algebraic Geometry*][BochnakCosteRoy1998]
-/

public section

namespace Cslib

open MvPolynomial

variable {σ τ R : Type*} [CommRing R] [LinearOrder R]

/-- A subset of `σ → R` is **semialgebraic** if it lies in the Boolean algebra of sets generated by
the sign conditions `{x | 0 < f(x)}` for polynomials `f`. For finite `σ` and `R = ℝ` this is the
standard definition ([Coste2002], §2.1.1, p. 25). For arbitrary `σ` and a linearly ordered
commutative ring `R`, with no compatibility assumed between the order and the ring, it is a
generalization. -/
inductive IsSemialgebraic : Set (σ → R) → Prop
  /-- The positivity set `{x | 0 < f(x)}` of a polynomial is semialgebraic. -/
  | setOf_pos (f : MvPolynomial σ R) : IsSemialgebraic {x | 0 < eval x f}
  /-- A union of two semialgebraic sets is semialgebraic. -/
  | union {s t : Set (σ → R)} : IsSemialgebraic s → IsSemialgebraic t → IsSemialgebraic (s ∪ t)
  /-- The complement of a semialgebraic set is semialgebraic. -/
  | compl {s : Set (σ → R)} : IsSemialgebraic s → IsSemialgebraic sᶜ

namespace IsSemialgebraic

variable {s t : Set (σ → R)}

theorem inter (hs : IsSemialgebraic s) (ht : IsSemialgebraic t) : IsSemialgebraic (s ∩ t) := by
  simpa using (hs.compl.union ht.compl).compl

theorem diff (hs : IsSemialgebraic s) (ht : IsSemialgebraic t) : IsSemialgebraic (s \ t) :=
  hs.inter ht.compl

theorem empty : IsSemialgebraic (∅ : Set (σ → R)) := by
  simpa using setOf_pos (σ := σ) (0 : MvPolynomial σ R)

theorem univ : IsSemialgebraic (Set.univ : Set (σ → R)) := by
  simpa using (empty (σ := σ) (R := R)).compl

theorem compl_iff : IsSemialgebraic sᶜ ↔ IsSemialgebraic s :=
  ⟨fun h => by simpa using h.compl, compl⟩

theorem biUnion {ι : Type*} {I : Finset ι} {s : ι → Set (σ → R)}
    (h : ∀ i ∈ I, IsSemialgebraic (s i)) : IsSemialgebraic (⋃ i ∈ I, s i) := by
  classical
  induction I using Finset.induction_on with
  | empty => simpa using empty
  | insert i I hi ih =>
    rw [Finset.set_biUnion_insert]
    exact (h i (Finset.mem_insert_self i I)).union
      (ih fun j hj => h j (Finset.mem_insert_of_mem hj))

theorem biInter {ι : Type*} {I : Finset ι} {s : ι → Set (σ → R)}
    (h : ∀ i ∈ I, IsSemialgebraic (s i)) : IsSemialgebraic (⋂ i ∈ I, s i) := by
  rw [← compl_iff, Set.compl_iInter₂]
  exact biUnion fun i hi => (h i hi).compl

theorem iUnion {ι : Type*} [Finite ι] {s : ι → Set (σ → R)} (h : ∀ i, IsSemialgebraic (s i)) :
    IsSemialgebraic (⋃ i, s i) := by
  have := Fintype.ofFinite ι
  simpa using biUnion (I := Finset.univ) fun i _ => h i

theorem iInter {ι : Type*} [Finite ι] {s : ι → Set (σ → R)} (h : ∀ i, IsSemialgebraic (s i)) :
    IsSemialgebraic (⋂ i, s i) := by
  have := Fintype.ofFinite ι
  simpa using biInter (I := Finset.univ) fun i _ => h i

section Sign

variable [IsStrictOrderedRing R]

/-- The set where a polynomial is nonnegative is semialgebraic. -/
theorem setOf_nonneg (f : MvPolynomial σ R) : IsSemialgebraic {x | 0 ≤ eval x f} := by
  convert (setOf_pos (-f)).compl using 1
  ext x
  simp

/-- The zero set of a polynomial is semialgebraic. -/
theorem setOf_eq_zero (f : MvPolynomial σ R) : IsSemialgebraic {x | eval x f = 0} := by
  convert (setOf_nonneg f).inter (setOf_nonneg (-f)) using 1
  ext x
  simp [le_antisymm_iff, and_comm]

/-- The set where one polynomial is at most another is semialgebraic. -/
theorem setOf_le (f g : MvPolynomial σ R) : IsSemialgebraic {x | eval x f ≤ eval x g} := by
  convert setOf_nonneg (g - f) using 1
  ext x
  simp

/-- The set where one polynomial is less than another is semialgebraic. -/
theorem setOf_lt (f g : MvPolynomial σ R) : IsSemialgebraic {x | eval x f < eval x g} := by
  convert setOf_pos (g - f) using 1
  ext x
  simp

/-- The set where two polynomials agree is semialgebraic. -/
theorem setOf_eq (f g : MvPolynomial σ R) : IsSemialgebraic {x | eval x f = eval x g} := by
  convert setOf_eq_zero (f - g) using 1
  ext x
  simp [sub_eq_zero]

end Sign

/-- The preimage of a semialgebraic set under a polynomial map `x ↦ (φ j (x))ⱼ` is semialgebraic.
-/
theorem preimage_eval {s : Set (τ → R)} (hs : IsSemialgebraic s) (φ : τ → MvPolynomial σ R) :
    IsSemialgebraic ((fun x j => eval x (φ j)) ⁻¹' s) := by
  induction hs with
  | setOf_pos f =>
    convert setOf_pos (aeval φ f) using 1
    ext x
    simp only [Set.mem_preimage, Set.mem_ofPred_eq]
    rw [show eval x (aeval φ f) = eval (fun j => eval x (φ j)) f from
      comp_aeval_apply φ (aeval x) f]
  | union _ _ hs ht => exact hs.union ht
  | compl _ hs => exact hs.compl

/-- Semialgebraicity is invariant under renaming the coordinates. -/
theorem preimage_comp {s : Set (τ → R)} (hs : IsSemialgebraic s) (e : τ → σ) :
    IsSemialgebraic ((fun x : σ → R => x ∘ e) ⁻¹' s) := by
  simpa [Function.comp_def] using hs.preimage_eval fun j => X (e j)

end IsSemialgebraic

end Cslib
