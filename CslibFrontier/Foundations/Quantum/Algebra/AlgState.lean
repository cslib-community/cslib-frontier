/-!
# States on star-ordered algebras

A *state* on a star-ordered `ℂ`-algebra `A` is a positive linear functional `φ : A → ℂ` with
`φ 1 = 1` (`Cslib.Quantum.AlgState`). It is the algebraic form of a quantum state: the vector
state `M ↦ ⟨ψ|M|ψ⟩` of a unit vector `ψ` (`Cslib.Quantum.AlgState.vector`), and more generally
`M ↦ Tr(ρM)` for a density matrix `ρ`, are states on the matrix algebra, but a state may live on
any algebra of observables, such as the algebra generated by the measurements of two commuting
provers. Every statement about quantum strategies phrased through a state therefore holds in the
finite-dimensional tensor-product model, the commuting-operator model and their tracial variants
at once.

A state gives every observable `a` the *state-dependent norm* `‖a‖_φ = √(Re φ(a⋆a))`
(`Cslib.Quantum.AlgState.norm`), the seminorm of the Gelfand–Naimark–Segal pre-inner product
`⟨a, b⟩_φ = φ(a⋆b)` (`PositiveLinearMap.PreGNS`). It is the norm in which the rigidity and
self-testing theorems of nonlocal games measure closeness of operators. The Cauchy–Schwarz
inequality `|φ(a⋆b)| ≤ ‖a‖_φ ‖b‖_φ` (`Cslib.Quantum.AlgState.norm_apply_star_mul_le`) and the
triangle inequality (`Cslib.Quantum.AlgState.norm_add_le`) come from Mathlib's GNS construction and
need no C⋆-norm.

## Main definitions

* `Cslib.Quantum.AlgState`: a state, a positive linear functional with `φ 1 = 1`.
* `Cslib.Quantum.AlgState.toPreGNS`: an observable as a vector of the GNS pre-inner product space.
* `Cslib.Quantum.AlgState.norm`: the state-dependent norm `‖a‖_φ`.
* `Cslib.Quantum.AlgState.vector`: the vector state `M ↦ ⟨ψ|M|ψ⟩` of a unit vector on matrices.

## Main results

* `Cslib.Quantum.AlgState.re_apply_nonneg`, `Cslib.Quantum.AlgState.ofReal_re_apply`: a state is
  real and nonnegative on nonnegative elements.
* `Cslib.Quantum.AlgState.norm_apply_star_mul_le`: Cauchy–Schwarz for states.
* `Cslib.Quantum.AlgState.norm_le_one`: a contraction, `a⋆a ≤ 1`, has state norm at most `1`.
* `Cslib.Quantum.AlgState.norm_sub_sq_eq_of_mul_self`: for self-adjoint involutions,
  `‖U - V‖²_φ = 2 - 2 Re φ(U V)`.
* `Cslib.Quantum.AlgState.comap`, `Cslib.Quantum.AlgState.norm_comap`: pulling a state back along
  a monotone star-algebra homomorphism, `‖a‖_{φ ∘ f} = ‖f a‖_φ`.
-/

@[expose] public section

namespace Cslib.Quantum

open scoped ComplexOrder

/-- A **state** on a star-ordered `ℂ`-algebra: a positive linear functional `φ` with `φ 1 = 1`. -/
structure AlgState (A : Type*) [Ring A] [PartialOrder A] [Algebra ℂ A] extends A →ₚ[ℂ] ℂ where
  /-- A state is normalized. -/
  map_one' : toFun 1 = 1

namespace AlgState

section Basic

variable {A : Type*} [Ring A] [PartialOrder A] [Algebra ℂ A]

instance : FunLike (AlgState A) A ℂ where
  coe φ := φ.toFun
  coe_injective φ ψ h := by
    obtain ⟨⟨⟨⟨_, _⟩, _⟩, _⟩, _⟩ := φ
    obtain ⟨⟨⟨⟨_, _⟩, _⟩, _⟩, _⟩ := ψ
    congr

instance : LinearMapClass (AlgState A) ℂ A ℂ where
  map_add φ := φ.map_add'
  map_smulₛₗ φ := φ.map_smul'

instance : OrderHomClass (AlgState A) A ℂ where
  map_rel φ _ _ h := φ.monotone' h

@[ext]
theorem ext {φ ψ : AlgState A} (h : ∀ a, φ a = ψ a) : φ = ψ :=
  DFunLike.ext _ _ h

@[simp]
theorem coe_toPositiveLinearMap (φ : AlgState A) : ⇑φ.toPositiveLinearMap = φ :=
  rfl

@[simp]
theorem map_one (φ : AlgState A) : φ 1 = 1 :=
  φ.map_one'

/-- A state is nonnegative on nonnegative elements. -/
theorem apply_nonneg (φ : AlgState A) {a : A} (ha : 0 ≤ a) : 0 ≤ φ a := by
  simpa using OrderHomClass.mono φ ha

/-- A state is monotone. -/
theorem apply_mono (φ : AlgState A) {a b : A} (h : a ≤ b) : φ a ≤ φ b :=
  OrderHomClass.mono φ h

/-- A state is real on nonnegative elements. -/
theorem ofReal_re_apply (φ : AlgState A) {a : A} (ha : 0 ≤ a) : ((φ a).re : ℂ) = φ a :=
  Complex.ext rfl (by simp [← (Complex.nonneg_iff.mp (φ.apply_nonneg ha)).2])

theorem re_apply_nonneg (φ : AlgState A) {a : A} (ha : 0 ≤ a) : 0 ≤ (φ a).re :=
  (Complex.nonneg_iff.mp (φ.apply_nonneg ha)).1

theorem re_apply_mono (φ : AlgState A) {a b : A} (h : a ≤ b) : (φ a).re ≤ (φ b).re :=
  Complex.re_le_re (φ.apply_mono h)

@[simp]
theorem apply_algebraMap (φ : AlgState A) (z : ℂ) : φ (algebraMap ℂ A z) = z := by
  rw [Algebra.algebraMap_eq_smul_one, map_smul, map_one, smul_eq_mul, mul_one]

/-- A state assigns probability at most `1` to an effect, `0 ≤ a ≤ 1`. -/
theorem re_apply_le_one (φ : AlgState A) {a : A} (h : a ≤ 1) : (φ a).re ≤ 1 := by
  simpa using φ.re_apply_mono h

end Basic

section Star

variable {A : Type*} [Ring A] [StarRing A] [PartialOrder A] [StarOrderedRing A] [Algebra ℂ A]

/-- A state is nonnegative on `a⋆a`. -/
theorem apply_star_mul_self_nonneg (φ : AlgState A) (a : A) : 0 ≤ φ (star a * a) :=
  φ.apply_nonneg (star_mul_self_nonneg a)

variable [StarModule ℂ A] [SelfAdjointDecompose A]

/-- An observable as a vector of the GNS pre-inner product space of `φ`, with inner product
`⟨a, b⟩_φ = φ(a⋆b)`. -/
noncomputable def toPreGNS (φ : AlgState A) : A ≃ₗ[ℂ] φ.toPositiveLinearMap.PreGNS :=
  φ.toPositiveLinearMap.toPreGNS

theorem inner_toPreGNS (φ : AlgState A) (a b : A) :
    inner ℂ (φ.toPreGNS a) (φ.toPreGNS b) = φ (star a * b) :=
  rfl

/-- The **state-dependent norm** `‖a‖_φ = √(Re φ(a⋆a))`, the GNS seminorm of `a`. -/
noncomputable def norm (φ : AlgState A) (a : A) : ℝ :=
  ‖φ.toPreGNS a‖

theorem norm_eq_sqrt (φ : AlgState A) (a : A) : φ.norm a = √(φ (star a * a)).re :=
  rfl

theorem norm_nonneg (φ : AlgState A) (a : A) : 0 ≤ φ.norm a :=
  _root_.norm_nonneg _

theorem norm_sq (φ : AlgState A) (a : A) : φ.norm a ^ 2 = (φ (star a * a)).re := by
  rw [norm_eq_sqrt, Real.sq_sqrt (φ.re_apply_nonneg (star_mul_self_nonneg a))]

theorem ofReal_norm_sq (φ : AlgState A) (a : A) : ((φ.norm a ^ 2 : ℝ) : ℂ) = φ (star a * a) := by
  rw [norm_sq, φ.ofReal_re_apply (star_mul_self_nonneg a)]

theorem norm_add_le (φ : AlgState A) (a b : A) : φ.norm (a + b) ≤ φ.norm a + φ.norm b := by
  simpa [norm, map_add] using _root_.norm_add_le (φ.toPreGNS a) (φ.toPreGNS b)

theorem norm_sub_le (φ : AlgState A) (a b : A) : φ.norm (a - b) ≤ φ.norm a + φ.norm b := by
  simpa [norm, map_sub] using _root_.norm_sub_le (φ.toPreGNS a) (φ.toPreGNS b)

@[simp]
theorem norm_neg (φ : AlgState A) (a : A) : φ.norm (-a) = φ.norm a := by
  simp [norm, map_neg]

theorem norm_sub_comm (φ : AlgState A) (a b : A) : φ.norm (a - b) = φ.norm (b - a) := by
  rw [← norm_neg, neg_sub]

@[simp]
theorem norm_zero (φ : AlgState A) : φ.norm 0 = 0 := by
  simp [norm]

@[simp]
theorem norm_one (φ : AlgState A) : φ.norm 1 = 1 := by
  simp [norm_eq_sqrt]

theorem norm_smul (φ : AlgState A) (z : ℂ) (a : A) : φ.norm (z • a) = ‖z‖ * φ.norm a := by
  simp [norm, map_smul, _root_.norm_smul]

/-- **Cauchy–Schwarz** for states: `|φ(a⋆b)| ≤ ‖a‖_φ ‖b‖_φ`. -/
theorem norm_apply_star_mul_le (φ : AlgState A) (a b : A) :
    ‖φ (star a * b)‖ ≤ φ.norm a * φ.norm b := by
  rw [← inner_toPreGNS]
  exact norm_inner_le_norm _ _

theorem re_apply_star_mul_le (φ : AlgState A) (a b : A) :
    (φ (star a * b)).re ≤ φ.norm a * φ.norm b :=
  (Complex.re_le_norm _).trans (φ.norm_apply_star_mul_le a b)

/-- Cauchy–Schwarz for a finite sum of state pairings. -/
theorem abs_sum_re_star_mul_le {ι : Type*} [Fintype ι] (φ : AlgState A) (X Y : ι → A) :
    |∑ i, (φ (star (X i) * Y i)).re| ≤
      √(∑ i, φ.norm (X i) ^ 2) * √(∑ i, φ.norm (Y i) ^ 2) := by
  calc
    _ ≤ ∑ i, |(φ (star (X i) * Y i)).re| := Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ i, φ.norm (X i) * φ.norm (Y i) := Finset.sum_le_sum fun i _ =>
      (Complex.abs_re_le_norm _).trans (φ.norm_apply_star_mul_le _ _)
    _ ≤ _ := Real.sum_mul_le_sqrt_mul_sqrt _ _ _

/-- Cauchy–Schwarz for a state pairing with a normalized left family. -/
theorem abs_sum_re_star_mul_le_of_normalized {ι : Type*} [Fintype ι]
    (φ : AlgState A) (X Y : ι → A)
    (hX : (∑ a, φ.norm (X a) ^ 2) ≤ 1) :
    |∑ a, (φ (star (X a) * Y a)).re| ≤ √(∑ a, φ.norm (Y a) ^ 2) := by
  refine (φ.abs_sum_re_star_mul_le X Y).trans ?_
  simpa only [Real.sqrt_one, one_mul] using
    mul_le_mul_of_nonneg_right (Real.sqrt_le_sqrt hX) (Real.sqrt_nonneg _)

/-- Cauchy–Schwarz for a state pairing with a normalized right family. -/
theorem abs_sum_re_star_mul_le_of_normalized_right {ι : Type*} [Fintype ι]
    (φ : AlgState A) (X Y : ι → A)
    (hY : (∑ a, φ.norm (Y a) ^ 2) ≤ 1) :
    |∑ a, (φ (star (X a) * Y a)).re| ≤ √(∑ a, φ.norm (X a) ^ 2) := by
  refine (φ.abs_sum_re_star_mul_le X Y).trans ?_
  simpa only [Real.sqrt_one, mul_one] using
    mul_le_mul_of_nonneg_left (Real.sqrt_le_sqrt hY) (Real.sqrt_nonneg _)

/-- A bound `x⋆x ≤ y` bounds the state norm: `‖x‖²_φ ≤ Re φ(y)`. -/
theorem norm_sq_le_of_star_mul_le (φ : AlgState A) {x y : A} (h : star x * x ≤ y) :
    φ.norm x ^ 2 ≤ (φ y).re := by
  rw [norm_sq]
  exact φ.re_apply_mono h

/-- A contraction, `a⋆a ≤ 1`, has state norm at most `1`. -/
theorem norm_le_one (φ : AlgState A) {a : A} (h : star a * a ≤ 1) : φ.norm a ≤ 1 := by
  rw [norm_eq_sqrt, Real.sqrt_le_one]
  exact φ.re_apply_le_one h

/-- For self-adjoint involutions `U`, `V` the squared distance is linear in the correlation:
`‖U - V‖²_φ = 2 - 2 Re φ(U V)`. -/
theorem norm_sub_sq_eq_of_mul_self (φ : AlgState A) {U V : A} (hU : IsSelfAdjoint U)
    (hV : IsSelfAdjoint V) (hU2 : U * U = 1) (hV2 : V * V = 1) :
    φ.norm (U - V) ^ 2 = 2 - 2 * (φ (U * V)).re := by
  have h1 : ∀ {W : A}, IsSelfAdjoint W → W * W = 1 → ‖φ.toPreGNS W‖ ^ 2 = 1 := fun hW hW2 => by
    change φ.norm _ ^ 2 = 1
    rw [φ.norm_sq, hW.star_eq, hW2, φ.map_one, Complex.one_re]
  change ‖φ.toPreGNS (U - V)‖ ^ 2 = _
  rw [map_sub, norm_sub_sq (𝕜 := ℂ), h1 hU hU2, h1 hV hV2, inner_toPreGNS, hU.star_eq,
    RCLike.re_to_complex]
  ring

omit [StarModule ℂ A] [SelfAdjointDecompose A] in
/-- The **pullback** `φ ∘ f` of a state along a monotone star-algebra homomorphism `f`. -/
noncomputable def comap {B : Type*} [Ring B] [StarRing B] [PartialOrder B] [Algebra ℂ B]
    (φ : AlgState B) (f : A →⋆ₐ[ℂ] B) (hf : Monotone f) : AlgState A where
  toFun a := φ (f a)
  map_add' a b := by simp [map_add]
  map_smul' z a := by simp [map_smul]
  monotone' _ _ h := φ.apply_mono (hf h)
  map_one' := by simp [φ.map_one]

omit [StarOrderedRing A] [StarModule ℂ A] [SelfAdjointDecompose A] in
theorem comap_apply {B : Type*} [Ring B] [StarRing B] [PartialOrder B] [Algebra ℂ B]
    (φ : AlgState B) (f : A →⋆ₐ[ℂ] B) (hf : Monotone f) (a : A) :
    φ.comap f hf a = φ (f a) :=
  rfl

/-- The state norm of a pullback is the state norm of the image: `‖a‖_{φ ∘ f} = ‖f a‖_φ`. -/
theorem norm_comap {B : Type*} [Ring B] [StarRing B] [PartialOrder B] [StarOrderedRing B]
    [Algebra ℂ B] [StarModule ℂ B] [SelfAdjointDecompose B] (φ : AlgState B) (f : A →⋆ₐ[ℂ] B)
    (hf : Monotone f) (a : A) : (φ.comap f hf).norm a = φ.norm (f a) := by
  rw [norm_eq_sqrt, norm_eq_sqrt, comap_apply, map_mul, map_star]

end Star

section Matrix

open Matrix
open scoped MatrixOrder

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

/-- The **vector state** `M ↦ ⟨ψ|M|ψ⟩` of a unit vector `ψ` on the matrix algebra. -/
noncomputable def vector (ψ : EuclideanSpace ℂ ι) (hψ : ‖ψ‖ = 1) : AlgState (Matrix ι ι ℂ) where
  toFun M := star ψ.ofLp ⬝ᵥ (M *ᵥ ψ.ofLp)
  map_add' M N := by simp [add_mulVec, dotProduct_add]
  map_smul' z M := by simp [smul_mulVec, dotProduct_smul]
  monotone' M N h := by
    rw [← sub_nonneg]
    have := (Matrix.le_iff.mp h).dotProduct_mulVec_nonneg ψ.ofLp
    simpa [sub_mulVec, dotProduct_sub] using this
  map_one' := by
    simp [EuclideanSpace.star_dotProduct_self_eq_norm_sq, hψ]

theorem vector_apply (ψ : EuclideanSpace ℂ ι) (hψ : ‖ψ‖ = 1) (M : Matrix ι ι ℂ) :
    vector ψ hψ M = star ψ.ofLp ⬝ᵥ (M *ᵥ ψ.ofLp) :=
  rfl

/-- The state norm of a vector state is the norm of the image vector: `‖M‖_ψ = ‖M ψ‖`. -/
theorem norm_vector (ψ : EuclideanSpace ℂ ι) (hψ : ‖ψ‖ = 1) (M : Matrix ι ι ℂ) :
    (vector ψ hψ).norm M = ‖(WithLp.toLp 2 (M *ᵥ ψ.ofLp) : EuclideanSpace ℂ ι)‖ := by
  apply (sq_eq_sq₀ ((vector ψ hψ).norm_nonneg M) (_root_.norm_nonneg _)).mp
  rw [norm_sq, vector_apply, star_eq_conjTranspose, Matrix.norm_toLp_mulVec_sq_eq]

end Matrix

end AlgState

end Cslib.Quantum
