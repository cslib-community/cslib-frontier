public import CslibFrontier.Foundations.Quantum.Algebra.Involution

/-!
# Joint measurements of commuting observables

A finite family `O : ι → A` of pairwise commuting `±1` observables can be measured jointly: the
outcome `a : ι → Bool` has the effect `P_a = ∏_j P_{a_j}(O_j)`, the product of the eigenspace
projections (`Cslib.Quantum.jointProj`), and these effects form a projective measurement
(`Cslib.Quantum.Measurement.ofCommuting`). This is how a prover answers a whole equation of a
linear constraint system, or measures several commuting Pauli observables at once.

The products are taken in the subalgebra generated by the family
(`Cslib.Quantum.jointAlg`), which is commutative because the generators commute; there the
commutative identities of finite products and sums apply, for instance
`∑_a ∏_j P_{a_j}(O_j) = ∏_j ∑_b P_b(O_j) = 1` (`Cslib.Quantum.sum_jointProj`).

The relations of the family determine which outcomes occur: each `O_j` acts on `P_a` by its sign
`σ_{a_j} = Cslib.BitString.signVal a_j` (`Cslib.Quantum.mul_jointProj`), so if the product of the
family is `c · 1` (`Cslib.Quantum.jointProd`), every outcome with `∏_j σ_{a_j} ≠ c` has effect `0`
(`Cslib.Quantum.jointProj_eq_zero`).

## Main definitions

* `Cslib.Quantum.jointAlg`: the commutative subalgebra generated by the family.
* `Cslib.Quantum.jointProj`: the joint projection `∏_j P_{a_j}(O_j)`.
* `Cslib.Quantum.jointProd`: the product `∏_j O_j`.
* `Cslib.Quantum.Measurement.ofCommuting`: the joint measurement.

## Main results

* `Cslib.Quantum.sum_jointProj`: the joint projections sum to `1`.
* `Cslib.Quantum.exists_jointProj_eq_mul`: each joint projection factors through every
  `P_{a_j}(O_j)`.
* `Cslib.Quantum.jointProj_eq_zero`: outcomes contradicting the product of the family vanish.
-/

@[expose] public section

namespace Cslib.Quantum

open Finset
open BitString (signVal)
open scoped IsMulCommutative

section Ring

variable {ι A : Type*} [Ring A] [Algebra ℂ A]

/-- The subalgebra generated by a family of observables. -/
abbrev jointAlg (O : ι → A) : Subalgebra ℂ A :=
  Algebra.adjoin ℂ (Set.range O)

theorem mem_jointAlg (O : ι → A) (j : ι) : O j ∈ jointAlg O :=
  Algebra.subset_adjoin (Set.mem_range_self j)

theorem signProj_mem_jointAlg (O : ι → A) (j : ι) (b : Bool) : signProj (O j) b ∈ jointAlg O :=
  Subalgebra.smul_mem _ (Subalgebra.add_mem _ (Subalgebra.one_mem _)
    (Subalgebra.smul_mem _ (mem_jointAlg O j) _)) _

/-- The subalgebra generated by pairwise commuting observables is commutative. -/
theorem isMulCommutative_jointAlg (O : ι → A) (hO : ∀ i j, Commute (O i) (O j)) :
    IsMulCommutative (jointAlg O) :=
  Algebra.isMulCommutative_adjoin ℂ (by rintro _ ⟨i, rfl⟩ _ ⟨j, rfl⟩ _; exact hO i j)

/-- The projection `P_b(O_j)` as an element of the generated subalgebra. -/
noncomputable def jointSignProj (O : ι → A) (j : ι) (b : Bool) : jointAlg O :=
  ⟨signProj (O j) b, signProj_mem_jointAlg O j b⟩

@[simp]
theorem val_jointSignProj (O : ι → A) (j : ι) (b : Bool) :
    (jointAlg O).val (jointSignProj O j b) = signProj (O j) b :=
  rfl

variable [Fintype ι] [DecidableEq ι]

/-- The **joint projection** `∏_j P_{a_j}(O_j)` of pairwise commuting observables. -/
noncomputable def jointProj (O : ι → A) (hO : ∀ i j, Commute (O i) (O j)) (a : ι → Bool) : A :=
  haveI := isMulCommutative_jointAlg O hO
  (jointAlg O).val (∏ j, jointSignProj O j (a j))

/-- The product `∏_j O_j` of pairwise commuting observables. -/
noncomputable def jointProd (O : ι → A) (hO : ∀ i j, Commute (O i) (O j)) : A :=
  haveI := isMulCommutative_jointAlg O hO
  (jointAlg O).val (∏ j, (⟨O j, mem_jointAlg O j⟩ : jointAlg O))

variable (O : ι → A) (hO : ∀ i j, Commute (O i) (O j))

omit [DecidableEq ι] in
theorem jointProj_mem_jointAlg (a : ι → Bool) : jointProj O hO a ∈ jointAlg O := by
  unfold jointProj
  exact SetLike.coe_mem _

/-- The joint projections sum to `1`. -/
theorem sum_jointProj : ∑ a, jointProj O hO a = 1 := by
  have := isMulCommutative_jointAlg O hO
  have h₁ : ∀ j, ∑ b, jointSignProj O j b = 1 := fun j =>
    Subtype.ext (by simpa [jointSignProj] using sum_signProj (O j))
  unfold jointProj
  rw [← map_sum, ← Fintype.prod_sum (fun j b => jointSignProj O j b)]
  simp only [h₁, Finset.prod_const_one, map_one]

omit [DecidableEq ι] in
/-- Each joint projection factors through every projection `P_{a_j}(O_j)`, on either side. -/
theorem exists_jointProj_eq_mul (a : ι → Bool) (j : ι) :
    ∃ M, jointProj O hO a = M * signProj (O j) (a j) ∧
      jointProj O hO a = signProj (O j) (a j) * M := by
  classical
  have := isMulCommutative_jointAlg O hO
  refine ⟨(jointAlg O).val (∏ k ∈ univ.erase j, jointSignProj O k (a k)), ?_, ?_⟩
  · unfold jointProj
    rw [← Finset.prod_erase_mul _ _ (mem_univ j), map_mul]
    rfl
  · unfold jointProj
    rw [← Finset.mul_prod_erase _ _ (mem_univ j), map_mul]
    rfl

section Involution

variable (hO' : ∀ j, O j * O j = 1)
include hO'

omit [DecidableEq ι] in
/-- Each observable acts on a joint projection by its sign: `O_j P_a = σ_{a_j} P_a`. -/
theorem mul_jointProj (a : ι → Bool) (j : ι) :
    O j * jointProj O hO a = (signVal (a j) : ℂ) • jointProj O hO a := by
  obtain ⟨M, -, hM⟩ := exists_jointProj_eq_mul O hO a j
  rw [hM, ← mul_assoc, mul_signProj (hO' j), smul_mul_assoc]

omit [DecidableEq ι] in
/-- The product of the family acts on a joint projection by the product of the signs. -/
theorem jointProd_mul_jointProj (a : ι → Bool) :
    jointProd O hO * jointProj O hO a = (∏ j, (signVal (a j) : ℂ)) • jointProj O hO a := by
  classical
  have := isMulCommutative_jointAlg O hO
  have key : ∀ s : Finset ι, (jointAlg O).val (∏ j ∈ s, (⟨O j, mem_jointAlg O j⟩ : jointAlg O)) *
      jointProj O hO a = (∏ j ∈ s, (signVal (a j) : ℂ)) • jointProj O hO a := by
    intro s
    induction s using Finset.induction_on with
    | empty => simp
    | insert j s hj ih =>
      rw [Finset.prod_insert hj, Finset.prod_insert hj, map_mul, mul_assoc, ih, mul_smul_comm,
        Subalgebra.coe_val, Subtype.coe_mk, mul_jointProj O hO hO', smul_smul, mul_comm]
  exact key univ

omit [DecidableEq ι] in
/-- **Outcomes contradicting the product vanish**: if `∏_j O_j = c · 1` and the signs of `a`
multiply to something other than `c`, then `P_a = 0`. -/
theorem jointProj_eq_zero {c : ℂ} (hprod : jointProd O hO = c • 1) {a : ι → Bool}
    (ha : c ≠ ∏ j, (signVal (a j) : ℂ)) : jointProj O hO a = 0 := by
  have h := jointProd_mul_jointProj O hO hO' a
  rw [hprod, smul_mul_assoc, one_mul] at h
  have hz : (c - ∏ j, (signVal (a j) : ℂ)) • jointProj O hO a = 0 := by rw [sub_smul, h, sub_self]
  rw [← one_smul ℂ (jointProj O hO a), ← inv_mul_cancel₀ (sub_ne_zero.mpr ha), mul_smul, hz,
    smul_zero]

omit [DecidableEq ι] in
/-- The joint projections are idempotent. -/
theorem jointProj_mul_self (a : ι → Bool) :
    jointProj O hO a * jointProj O hO a = jointProj O hO a := by
  have := isMulCommutative_jointAlg O hO
  have hp : ∀ j, jointSignProj O j (a j) * jointSignProj O j (a j) = jointSignProj O j (a j) :=
    fun j => Subtype.ext (signProj_mul_self (hO' j) (a j))
  unfold jointProj
  rw [← map_mul, ← Finset.prod_mul_distrib]
  simp only [hp]

omit [DecidableEq ι] in
/-- Joint projections of different outcomes are orthogonal. -/
theorem jointProj_mul_signProj_of_ne {a : ι → Bool} {j : ι} {b : Bool} (hb : a j ≠ b) :
    jointProj O hO a * signProj (O j) b = 0 := by
  obtain ⟨M, hM, -⟩ := exists_jointProj_eq_mul O hO a j
  rw [hM, mul_assoc, signProj_mul_signProj_of_ne (hO' j) hb, mul_zero]

end Involution

end Ring

/-- In a commutative algebra, `jointProd` is the product of the family. -/
theorem jointProd_eq_prod {ι A : Type*} [Fintype ι] [CommRing A] [Algebra ℂ A] (O : ι → A)
    (hO : ∀ i j, Commute (O i) (O j)) : jointProd O hO = ∏ j, O j := by
  have := isMulCommutative_jointAlg O hO
  unfold jointProd
  rw [map_prod]
  rfl

section Order

variable {ι A : Type*} [Fintype ι] [DecidableEq ι] [Ring A] [StarRing A] [PartialOrder A]
  [StarOrderedRing A] [Algebra ℂ A] [StarModule ℂ A] (O : ι → A) (hO : ∀ i j, Commute (O i) (O j))

omit [PartialOrder A] [StarOrderedRing A] [DecidableEq ι] in
/-- The joint projections of self-adjoint observables are self-adjoint. -/
theorem isSelfAdjoint_jointProj (hsa : ∀ j, IsSelfAdjoint (O j)) (a : ι → Bool) :
    IsSelfAdjoint (jointProj O hO a) := by
  classical
  have := isMulCommutative_jointAlg O hO
  have key : ∀ s : Finset ι,
      IsSelfAdjoint ((jointAlg O).val (∏ j ∈ s, jointSignProj O j (a j))) := by
    intro s
    induction s using Finset.induction_on with
    | empty => simp
    | insert j s hj ih =>
      rw [Finset.prod_insert hj, map_mul]
      refine isSelfAdjoint_iff.mpr ?_
      rw [star_mul, ih.star_eq, val_jointSignProj, (isSelfAdjoint_signProj (hsa j) (a j)).star_eq,
        ← val_jointSignProj, ← map_mul, mul_comm, map_mul]
  exact key univ

/-- The **joint measurement** of pairwise commuting `±1` observables: the outcome `a : ι → Bool`
has the effect `∏_j P_{a_j}(O_j)`. -/
noncomputable def Measurement.ofCommuting (hsa : ∀ j, IsSelfAdjoint (O j))
    (hO' : ∀ j, O j * O j = 1) : Measurement (ι → Bool) A where
  effect := jointProj O hO
  nonneg a := nonneg_of_isSelfAdjoint_of_mul_self (isSelfAdjoint_jointProj O hO hsa a)
    (jointProj_mul_self O hO hO' a)
  sum_effect := sum_jointProj O hO

theorem Measurement.ofCommuting_effect (hsa : ∀ j, IsSelfAdjoint (O j))
    (hO' : ∀ j, O j * O j = 1) (a : ι → Bool) :
    (Measurement.ofCommuting O hO hsa hO').effect a = jointProj O hO a :=
  rfl

end Order

end Cslib.Quantum
