/-!
# From one level to the next

The layer `1 + s^(n+1) A` is generated by elementary matrices of the form `1 + s^(n+1) E_{ij}` and
diagonal ones, which are short words (`Cslib.SLTower.PL`). So a bound `N` on the word length in
`G h n` gives the bound `N + h² · 5 · bQ h n` in `G h (n + 1)` (`Cslib.SLTower.WL.lift`), where
`bQ h n` is polynomial in `n`.

From *VP ≠ VNP over every field* [AnthropicVPVNP2026], module `Nc.Tower.Diam`.

## Main definitions

* `Cslib.SLTower.PL`: being a product of short elementary words in the layer.
* `Cslib.SLTower.bQ h n`: the length of the words for one elementary layer matrix.

## Main results

* `Cslib.SLTower.PL.all`: every layer element is such a product.
* `Cslib.SLTower.WL.lift`: the word length grows by `h² · 5 · bQ h n` from level `n` to `n + 1`.
-/

public section

namespace Cslib.SLTower

open Matrix Finset

variable {h n : ℕ} [NeZero h] {h2 : 2 ≤ h}

/-- A trace-zero matrix whose layer element is a product of at most N generators. -/
def PL (h2 : 2 ≤ h) (n : ℕ) (A : Matrix (Fin h) (Fin h) (ZMod 2)) (N : ℕ) : Prop :=
  ∃ hA : A.trace = 0, WL h2 (lay (n := n) A hA) N

omit [NeZero h] in
theorem lay_zero : lay (h := h) (n := n) 0 (trace_zero _ _) = 1 := by
  refine Subtype.ext <| Matrix.ext fun a b => ?_
  simp [lay_val, layMat]

theorem PL.zero (N : ℕ) : PL h2 n 0 N :=
    ⟨trace_zero _ _, by rw [lay_zero]; exact WL.one.mono (Nat.zero_le _)⟩

theorem PL.add {A B : Matrix (Fin h) (Fin h) (ZMod 2)} {N M : ℕ} (hA : PL h2 n A N)
    (hB : PL h2 n B M) :
    PL h2 n (A + B) (N + M) := by
  obtain ⟨a1, a2⟩ := hA
  obtain ⟨b1, b2⟩ := hB
  exact ⟨by rw [trace_add, a1, b1, add_zero], by rw [← lay_mul A B a1 b1]; exact a2.mul b2⟩

theorem PL.sum {ι : Type*} (S : Finset ι) (M : ι → Matrix (Fin h) (Fin h) (ZMod 2)) (N : ℕ)
    (hM : ∀ p ∈ S, PL h2 n (M p) N) : PL h2 n (∑ p ∈ S, M p) (S.card * N) := by
  classical
  induction S using Finset.induction_on with
  | empty => simpa using PL.zero (h2 := h2) (n := n) 0
  | insert p S hp ih =>
    rw [Finset.sum_insert hp, Finset.card_insert_of_notMem hp, Nat.add_one_mul,
      Nat.add_comm (S.card * N) N]
    exact (hM p (mem_insert_self _ _)).add (ih fun q hq => hM q (mem_insert_of_mem hq))

/-- The bound for one elementary matrix of the layer. -/
@[expose] def bQ (h n : ℕ) : ℕ := 4 ^ (h + 3) * (9 * (n + 2) ^ 3) * (n + 1) ^ 3

theorem WL.el_layer (h3 : 3 ≤ h) (i j : Fin h) (hij : i ≠ j) :
    WL h2 (SpecialLinearGroup.transvection hij (s (n + 2) ^ (n + 1)) : G h (n + 1)) (bQ h n) :=
  WL.el_pow h3 (fun i j hij => WL.el_s h3 i j hij) (n + 1) (by omega) i j hij

omit [NeZero h] in
theorem lay_single (i j : Fin h) (hij : i ≠ j) (htr : (Matrix.single i j (1 : ZMod 2)).trace = 0) :
    lay (n := n) (Matrix.single i j 1) htr =
        SpecialLinearGroup.transvection hij (s (n + 2) ^ (n + 1)) := by
  refine Subtype.ext <| Matrix.ext fun a b => ?_
  simp only [lay_val, layMat, SpecialLinearGroup.transvection_coe, Matrix.add_apply,
    Matrix.smul_apply, Matrix.map_apply, Matrix.single_apply, smul_eq_mul]
  congr 1
  split_ifs <;> simp


theorem PL.single (h3 : 3 ≤ h) (i j : Fin h) (hij : i ≠ j) : PL h2 n (Matrix.single i j 1)
    (bQ h n) :=
  ⟨Matrix.trace_single_eq_of_ne i j 1 hij, by rw [lay_single i j hij]; exact WL.el_layer h3 i j hij⟩

theorem trace_diag (i : Fin h) : (Matrix.single i i (1 : ZMod 2) + Matrix.single 0 0 1).trace =
    0 := by
  rw [trace_add, Matrix.trace_single_eq_same, Matrix.trace_single_eq_same]
  rfl

/-- The diagonal elements of the layer. -/
theorem lay_diag (i : Fin h) (hi : i ≠ 0) :
    lay (n := n) (Matrix.single i i 1 + Matrix.single 0 0 1) (trace_diag i) =
      SpecialLinearGroup.transvection hi.symm (s (n + 2) ^ (n + 1)) *
          SpecialLinearGroup.transvection hi 1 *
        (SpecialLinearGroup.transvection hi.symm (s (n + 2) ^ (n + 1)) *
            SpecialLinearGroup.transvection hi 1) *
                SpecialLinearGroup.transvection hi (s (n + 2) ^ (n + 1)) := by
  refine Subtype.ext ?_
  have hs : s (n + 2) ^ (n + 1) * s (n + 2) ^ (n + 1) = 0 := by rw [← sq, s_sq]
  set σ := s (n + 2) ^ (n + 1) with hσ
  simp only [Matrix.SpecialLinearGroup.coe_mul, SpecialLinearGroup.transvection_coe]
  have hl : layMat n (Matrix.single i i 1 + Matrix.single 0 0 1) =
      1 + (Matrix.single i i σ + Matrix.single 0 0 σ) := by
    rw [layMat, ← hσ]
    congr 1
    ext a b
    simp only [Matrix.smul_apply, Matrix.map_apply, Matrix.add_apply, Matrix.single_apply,
      smul_eq_mul, map_add, mul_add]
    congr 1 <;> split_ifs <;> simp
  rw [lay_val, hl]
  set a := Matrix.single (0 : Fin h) i σ with ha
  set b := Matrix.single i (0 : Fin h) (1 : R (n + 2)) with hb
  set c := Matrix.single i (0 : Fin h) σ with hc
  have haa : a * a = 0 := Matrix.single_mul_single_of_ne _ _ _ _ hi _
  have hbb : b * b = 0 := Matrix.single_mul_single_of_ne _ _ _ _ hi.symm _
  have hab : a * b = Matrix.single 0 0 σ := by rw [ha, hb, Matrix.single_mul_single_same, mul_one]
  have hba : b * a = Matrix.single i i σ := by rw [ha, hb, Matrix.single_mul_single_same, one_mul]
  have hbab : b * a * b = c := by rw [hba, hb, hc, Matrix.single_mul_single_same, mul_one]
  have haba : a * b * a = 0 :=
      by rw [hab, ha, Matrix.single_mul_single_same, hs, Matrix.single_zero]
  have hac : a * c = 0 := by rw [ha, hc, Matrix.single_mul_single_same, hs, Matrix.single_zero]
  have hbc : b * c = 0 := Matrix.single_mul_single_of_ne _ _ _ _ hi.symm _
  have hcc : c * c = 0 := Matrix.single_mul_single_of_ne _ _ _ _ hi.symm _
  rw [← hab, ← hba]
  have e2 : (1 + a) * (1 + b) * ((1 + a) * (1 + b)) = 1 + (b * a + c + a * b) := by
    have e3 : (1 + a) * (1 + b) * ((1 + a) * (1 + b)) = 1 + ((a + b + a * b) + (a + b + a * b)) +
        (b * a + b * a * b +
      a * b) + (a * a + a * a * b + b * b + a * b * a + a * b * a * b + a * (b * b)) := by
      noncomm_ring
    rw [e3, two_nsmul_mat, haa, hbb, haba, hbab]
    simp
  have e4 : (1 + (b * a + c + a * b)) * (1 + c) = 1 + (b * a + a * b) + (c + c) +
      (b * (a * c) + c * c + a * (b * c)) := by noncomm_ring
  rw [e2, e4, two_nsmul_mat, hac, hcc, hbc]
  simp

theorem PL.diag (h3 : 3 ≤ h) (i : Fin h) : PL h2 n (Matrix.single i i 1 + Matrix.single 0 0 1)
    (5 * bQ h n) := by
  by_cases hi : i = 0
  · subst hi
    have h11 : (1 + 1 : ZMod 2) = 0 := rfl
    rw [← Matrix.single_add, h11, Matrix.single_zero]
    exact PL.zero _
  · refine ⟨trace_diag i, ?_⟩
    rw [lay_diag i hi]
    have p1 := WL.el_layer (n := n) (h2 := h2) h3 0 i (Ne.symm hi)
    have p2 := WL.el_one (n := n + 1) (h2 := h2) h3 i 0 hi
    have p3 := WL.el_layer (n := n) (h2 := h2) h3 i 0 hi
    refine (((p1.mul p2).mul (p1.mul p2)).mul p3).mono ?_
    have h4 : 4 ^ (h + 3) * (2 * (n + 1 + 1)) ^ 3 ≤ bQ h n := by
      unfold bQ
      have : 1 ≤ (n + 1) ^ 3 := Nat.one_le_pow _ _ (by omega)
      calc 4 ^ (h + 3) * (2 * (n + 1 + 1)) ^ 3 = 4 ^ (h + 3) * (8 * (n + 2) ^ 3) * 1 := by ring
        _ ≤ 4 ^ (h + 3) * (9 * (n + 2) ^ 3) * (n + 1) ^ 3 := by gcongr; omega
    omega

/-- The layer: a matrix as a sum of elementary ones. -/
theorem sum_layer (A : Matrix (Fin h) (Fin h) (ZMod 2)) (hA : A.trace = 0) :
    ∑ p : Fin h × Fin h,
        A p.1 p.2 • (if p.1 = p.2 then Matrix.single p.1 p.1 1 + Matrix.single 0 0 1
      else Matrix.single p.1 p.2 1 : Matrix (Fin h) (Fin h) (ZMod 2)) = A := by
  ext a b
  rw [Matrix.sum_apply]
  have h1 : ∀ p : Fin h × Fin h,
      (A p.1 p.2 • (if p.1 = p.2 then Matrix.single p.1 p.1 1 + Matrix.single 0 0 1
      else Matrix.single p.1 p.2 1 : Matrix (Fin h) (Fin h) (ZMod 2))) a b =
      (if p = (a, b) then A p.1 p.2 else 0) +
          (if p.1 = p.2 then (if 0 = a ∧ 0 = b then A p.1 p.2 else 0) else 0) := by
    rintro ⟨i, j⟩
    simp only [Matrix.smul_apply, smul_eq_mul, Prod.mk.injEq]
    by_cases hij : i = j
    · subst hij
      rw [ite_eq_left rfl, ite_eq_left rfl, Matrix.add_apply, Matrix.single_apply,
          Matrix.single_apply, mul_add]
      congr 1 <;> split_ifs <;> simp
    · rw [ite_eq_right hij, ite_eq_right hij, Matrix.single_apply, add_zero]
      split_ifs <;> simp
  rw [Finset.sum_congr rfl fun p _ => h1 p, Finset.sum_add_distrib, Finset.sum_ite_eq' univ (a, b),
      ite_eq_left (mem_univ _), Fintype.sum_prod_type]
  by_cases hab : 0 = a ∧ 0 = b
  · rcases hab with ⟨rfl, rfl⟩
    simpa [Matrix.trace] using hA
  · simp [hab]

theorem PL.all (h3 : 3 ≤ h) (A : Matrix (Fin h) (Fin h) (ZMod 2)) (hA : A.trace = 0) :
    PL h2 n A (h * h * (5 * bQ h n)) := by
  have h4 := PL.sum (h2 := h2) (n := n) (univ : Finset (Fin h × Fin h)) (fun p => A p.1 p.2 •
    (if p.1 = p.2 then Matrix.single p.1 p.1 1 + Matrix.single 0 0 1 else Matrix.single p.1 p.2 1))
        (5 * bQ h n) (by
    rintro ⟨i, j⟩ -
    simp only
    rcases (by decide : ∀ c : ZMod 2, c = 0 ∨ c = 1) (A i j) with h0 | h1
    · rw [h0, zero_smul]
      exact PL.zero _
    · rw [h1, one_smul]
      split_ifs with hij
      · exact PL.diag h3 i
      · obtain ⟨a1, a2⟩ := PL.single (h2 := h2) (n := n) h3 i j hij
        exact ⟨a1, a2.mono (by omega)⟩)
  rw [sum_layer A hA] at h4
  simpa using h4

theorem red_tt (k : Fin h) : red (n + 1) (tt (n + 1) k) = tt n k := by
  rw [tt, tt]
  split_ifs
  exacts [red_t _, map_one _]

theorem redG_gen (k : Fin h) : redG (gen h2 k : G h (n + 1)) = gen h2 k := by
  refine Subtype.ext <| Matrix.ext fun a b => ?_
  simp only [redG_apply, gen_val, transvection, Matrix.add_apply, map_add,
    Matrix.one_apply, Matrix.single_apply]
  congr 1 <;> split_ifs <;> simp [red_tt]

/-- From level n to level n + 1. -/
theorem WL.lift (h3 : 3 ≤ h) {N : ℕ} (hN : ∀ g : G h n, WL h2 g N) (g : G h (n + 1)) :
    WL h2 g (N + h * h * (5 * bQ h n)) := by
  obtain ⟨l, h1, h4⟩ := hN (redG g)
  have h5 : redG ((l.map (Cslib.SLTower.gen h2)).prod : G h (n + 1)) = redG g := by
    rw [map_list_prod, List.map_map, ← h4]
    congr 1
    exact List.map_congr_left fun k _ => redG_gen k
  have h6 : redG (((l.map (Cslib.SLTower.gen h2)).prod : G h (n + 1))⁻¹ * g) = 1 := by
    rw [map_mul, map_inv, h5, inv_mul_cancel]
  obtain ⟨A, hA, h7⟩ := exists_lay h6
  obtain ⟨hA', h8⟩ := PL.all (h2 := h2) (n := n) h3 A hA
  rw [eq_mul_of_inv_mul_eq h7]
  exact (show WL h2 ((l.map (Cslib.SLTower.gen h2)).prod : G h (n + 1)) N from ⟨l, h1, rfl⟩).mul h8

end Cslib.SLTower
