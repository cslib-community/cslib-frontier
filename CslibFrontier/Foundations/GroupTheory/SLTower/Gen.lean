public import CslibFrontier.Foundations.GroupTheory.SLTower.UT
import Mathlib.LinearAlgebra.Matrix.Transvection
import Mathlib.Tactic.NoncommRing

/-!
# The unitriangular group is generated by the simple root elements

The simple root elements `x h j = 1 + E_{j,j+1}` generate the group `U h` of upper unitriangular
`h × h` matrices over `F₂` (`Cslib.SLTower.closure_range_x`). The elementary matrices
`1 + E_{ij}`, `i < j`, are iterated commutators of the `x h j`; multiplying by `1 + E_{ij}` from
the left, for the lowest row `i` that differs from the identity, clears the entry `(i, j)`.

From *VP ≠ VNP over every field* [AnthropicVPVNP2026], module `Nc.Vp.Gen`.

## Main results

* `Cslib.SLTower.closure_range_x`: `U h` is generated by the `x h j`.
* `Cslib.SLTower.apply_eq_of_x_mul`: a function on `U h` that does not change under left
  multiplication by the `x h j` is constant.

## References

* [Anthropic, *VP ≠ VNP over every field*, paper and Lean formalization][AnthropicVPVNP2026],
  the generators `x_j` of Appendix F, p. 37; module `Nc.Vp.Gen` (`mem_of_x`, `const_of_x`)
-/

public section

namespace Cslib.SLTower

open Matrix Subgroup

variable {h : ℕ}

/-- The elementary matrix `1 + E_{ij}`, `i < j`, as an element of `U h`. -/
private def el {i j : Fin h} (hij : i < j) : U h :=
  ⟨⟨transvection i j 1, det_transvection_of_ne _ _ hij.ne 1⟩, mem_U.2 fun a b => by
    have hne : ∀ c, ¬(i = a ∧ j = c ∧ c ≤ a) := by
      rintro c ⟨rfl, rfl, hc⟩; exact hc.not_gt hij
    refine ⟨fun hab => ?_, ?_⟩
    · change (1 + single i j (1 : ZMod 2)) a b = 0
      rw [Matrix.add_apply, one_apply_ne hab.ne', single_apply_of_ne _ _ _ _ _ fun e =>
        hne b ⟨e.1, e.2, hab.le⟩, add_zero]
    · change (1 + single i j (1 : ZMod 2)) a a = 1
      rw [Matrix.add_apply, one_apply_eq, single_apply_of_ne _ _ _ _ _ fun e =>
        hne a ⟨e.1, e.2, le_rfl⟩, add_zero]⟩

private theorem coe_el {i j : Fin h} (hij : i < j) :
    ((el hij : SL2 h) : Matrix (Fin h) (Fin h) (ZMod 2)) = transvection i j 1 := rfl

private theorem el_mul_el {i j : Fin h} (hij : i < j) : el hij * el hij = 1 := by
  refine Subtype.ext (Subtype.ext ?_)
  simp only [Subgroup.coe_mul, SpecialLinearGroup.coe_mul, coe_el,
    transvection_mul_transvection_same i j hij.ne]
  exact transvection_zero i j

/-- The commutator of `1 + E_{ik}` and `1 + E_{kj}` is `1 + E_{ij}`. -/
private theorem el_comm {i k j : Fin h} (hik : i < k) (hkj : k < j) :
    el hik * el hkj * (el hik * el hkj) = el (hik.trans hkj) := by
  refine Subtype.ext (Subtype.ext ?_)
  simp only [Subgroup.coe_mul, SpecialLinearGroup.coe_mul, coe_el, transvection]
  set a := single i k (1 : ZMod 2)
  set b := single k j (1 : ZMod 2)
  have two (M : Matrix (Fin h) (Fin h) (ZMod 2)) : M + M = 0 :=
    Matrix.ext fun _ _ => CharTwo.add_self_eq_zero _
  have e : (1 + a) * (1 + b) * ((1 + a) * (1 + b)) = 1 + a * b + ((a + b + a * b) +
      (a + b + a * b)) + (a * a + a * a * b + b * a + b * b + b * a * b + a * (b * a) +
        a * (b * b) + a * (b * a) * b) := by noncomm_ring
  rw [e, two, single_mul_single_of_ne _ _ _ _ hik.ne', single_mul_single_of_ne _ _ _ _ hkj.ne',
    single_mul_single_of_ne _ _ _ _ (hik.trans hkj).ne', single_mul_single_same]
  simp

/-- `1 + E_{i,i+1}` is a simple root element. -/
private theorem el_mem_of_succ {i j : Fin h} (hij : i < j) (hd : j.1 = i.1 + 1) :
    el hij ∈ closure (Set.range (x h)) := by
  refine subset_closure ⟨⟨i, by omega⟩, Subtype.ext (Subtype.ext ?_)⟩
  simp only [x_val, coe_el, transvection]
  congr 2
  exact Fin.ext (by simp [hi, hd])

private theorem el_mem {i j : Fin h} (hij : i < j) : el hij ∈ closure (Set.range (x h)) := by
  obtain ⟨d, hd⟩ : ∃ d, j.1 = i.1 + d + 1 := ⟨j.1 - i.1 - 1, by have := Fin.lt_def.1 hij; omega⟩
  induction d generalizing j with
  | zero => exact el_mem_of_succ hij hd
  | succ d ih =>
    have hkj : (⟨j.1 - 1, by omega⟩ : Fin h) < j := Fin.lt_def.2 (by simp; omega)
    have hik : i < ⟨j.1 - 1, by omega⟩ := Fin.lt_def.2 (by simp; omega)
    have h1 := ih hik (by simp; omega)
    have h2 := el_mem_of_succ hkj (by simp; omega)
    rw [← el_comm hik hkj]
    exact mul_mem (mul_mem h1 h2) (mul_mem h1 h2)

/-- **The simple root elements generate `U h`.** -/
theorem closure_range_x : closure (Set.range (x h)) = ⊤ := by
  set H := closure (Set.range (x h))
  let D : U h → Finset (Fin h × Fin h) := fun A => Finset.univ.filter fun p =>
    ((A : SL2 h) : Matrix (Fin h) (Fin h) (ZMod 2)) p.1 p.2 ≠ (1 : Matrix _ _ (ZMod 2)) p.1 p.2
  suffices key : ∀ n (A : U h), (D A).card = n → A ∈ H from
    eq_top_iff.2 fun A _ => key _ A rfl
  intro n
  induction n using Nat.strong_induction_on with
  | _ n ih =>
  intro A hA
  rcases (D A).eq_empty_or_nonempty with h0 | hne
  · convert H.one_mem
    exact Subtype.ext <| Subtype.ext <| Matrix.ext fun a b =>
      of_not_not fun hab => Finset.notMem_empty (a, b) (h0 ▸ by simpa [D] using hab)
  -- the lowest row `i` that differs from the identity, and an entry `(i, j)` there
  obtain ⟨⟨i, j⟩, hp, hmax⟩ := (D A).exists_max_image Prod.fst hne
  have hM : ((A : SL2 h) : Matrix (Fin h) (Fin h) (ZMod 2)) i j ≠ (1 : Matrix _ _ (ZMod 2)) i j :=
    by simpa [D] using hp
  have hij : i < j := lt_of_not_ge fun hji => hM <| by
    rcases hji.lt_or_eq with hji | rfl
    · simpa [one_apply_ne hji.ne'] using (mem_U.1 A.2 i j).1 hji
    · simpa using (mem_U.1 A.2 j j).2
  have hrow (b : Fin h) : ((A : SL2 h) : Matrix (Fin h) (Fin h) (ZMod 2)) j b =
      (1 : Matrix _ _ (ZMod 2)) j b :=
    of_not_not fun hb => (hmax (j, b) (by simpa [D] using hb)).not_gt hij
  have hB : (((el hij * A : U h) : SL2 h) : Matrix (Fin h) (Fin h) (ZMod 2)) =
      ((A : SL2 h) : Matrix (Fin h) (Fin h) (ZMod 2)) + single i j 1 := by
    ext a b
    change (transvection i j (1 : ZMod 2) * ((A : SL2 h) : Matrix (Fin h) (Fin h) (ZMod 2))) a b = _
    by_cases ha : a = i
    · subst ha
      rw [transvection_mul_apply_same, hrow, Matrix.add_apply, one_mul]
      rcases eq_or_ne j b with rfl | hb <;> simp [*]
    · simp [transvection_mul_apply_of_ne _ _ _ _ ha, Ne.symm ha]
  have hsub : D (el hij * A) ⊆ (D A).erase (i, j) := fun p hp' => by
    simp only [D, Finset.mem_filter, Finset.mem_univ, true_and, hB] at hp'
    by_cases hpij : p = (i, j)
    · subst hpij
      rw [one_apply_ne hij.ne] at hM hp'
      exact absurd (by simpa using (by decide : ∀ c : ZMod 2, c ≠ 0 → c + 1 = 0) _ hM) hp'
    · exact Finset.mem_erase.2 ⟨hpij,
        by simpa [D, single_apply_of_ne _ _ _ _ _ fun e => hpij (Prod.ext e.1.symm e.2.symm)]
          using hp'⟩
  have hlt := (Finset.card_le_card hsub).trans_lt (Finset.card_erase_lt_of_mem hp)
  rw [show A = el hij * (el hij * A) by rw [← mul_assoc, el_mul_el, one_mul]]
  exact mul_mem (el_mem hij) (ih _ (hA ▸ hlt) _ rfl)

/-- A function on `U h` that does not change under left multiplication by the simple root
elements is constant. -/
theorem apply_eq_of_x_mul {β : Type*} {f : U h → β} (hf : ∀ j u, f (x h j * u) = f u)
    (p q : U h) : f p = f q := by
  have key : ∀ g ∈ closure (Set.range (x h)), ∀ u, f (g * u) = f u := fun g hg => by
    induction hg using closure_induction with
    | mem _ hg => obtain ⟨j, rfl⟩ := hg; exact hf j
    | one => simp
    | mul a b _ _ ha hb => intro u; rw [mul_assoc, ha, hb]
    | inv a _ ha => intro u; rw [← ha, mul_inv_cancel_left]
  simpa using key (p * q⁻¹) (closure_range_x ▸ mem_top _) q

end Cslib.SLTower
