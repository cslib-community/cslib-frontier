public import CslibFrontier.Init
public import CslibFrontier.Foundations.GroupTheory.SLTower.Diam

/-!
# The diameter of the groups

`SL_h(F₂)` is generated by transvections, and each of them is a word in the generators, so every
element of `G h 0` is a word of bounded length (`Cslib.SLTower.exists_base`). With
`Cslib.SLTower.WL.lift`, every element of `G h n` is a word of length at most `C (n + 1)^7`.

From *VP ≠ VNP over every field* [AnthropicVPVNP2026], module `Nc.Tower.Base`.

## Main results

* `Cslib.SLTower.exists_transvections`: `SL_h(F₂)` is generated by transvections.
* `Cslib.SLTower.exists_base`, `Cslib.SLTower.exists_diam`: the diameter bounds.
-/

public section

namespace Cslib.SLTower

open Matrix Finset

variable {h n : ℕ} [NeZero h] {h2 : 2 ≤ h}

omit [NeZero h] in
/-- Every element of `SL_h(F₂)` is a product of transvections: Mathlib's decomposition into
transvections and a determinant-one diagonal, whose diagonal is the identity over `ZMod 2`. -/
theorem exists_transvections (A : SL2 h) : ∃ l : List (TransvectionStruct (Fin h) (ZMod 2)),
    A = (l.map TransvectionStruct.toSpecialLinearGroup).prod := by
  obtain ⟨L, L', D, hD, hA⟩ :=
    SpecialLinearGroup.exists_list_transvec_mul_diagonal_mul_list_transvec A
  have h3 (i : Fin h) : D i = 1 :=
    (show ∀ c : ZMod 2, c ≠ 0 → c = 1 by decide) _ fun h0 => by
      rw [det_diagonal, Finset.prod_eq_zero (mem_univ i) h0] at hD
      exact absurd hD (by decide)
  have h5 : (⟨diagonal D, hD⟩ : SpecialLinearGroup (Fin h) (ZMod 2)) = (1 : SL2 h) := by
    ext i j; simp [diagonal_apply, h3, Matrix.one_apply]
  exact ⟨L ++ L', by rw [hA, h5, _root_.mul_one, List.map_append, List.prod_append]⟩

theorem th0_toSpecialLinearGroup (τ : TransvectionStruct (Fin h) (ZMod 2)) :
    (th0 0 τ.toSpecialLinearGroup : G h n) =
    SpecialLinearGroup.transvection τ.hij (cst (n + 1) τ.c) := by
  refine Subtype.ext (Matrix.ext fun a b => ?_)
  have hw (x : Fin h) : (wt 0 x : (R (n + 1))ˣ) = 1 := ite_eq_right (Fin.not_lt_zero x)
  rw [th0_val, shMat_apply, hw, hw, sub_zero, sub_zero, SpecialLinearGroup.transvection_coe,
    TransvectionStruct.toSpecialLinearGroup_def, SpecialLinearGroup.transvection_coe,
    Matrix.add_apply, Matrix.add_apply, map_add, Matrix.single_apply, Matrix.single_apply]
  simp only [Units.val_one, inv_one, one_mul, mul_one, Matrix.one_apply]
  congr 1 <;> split_ifs <;> simp

theorem WL.transvectionStruct (h3 : 3 ≤ h) (τ : TransvectionStruct (Fin h) (ZMod 2)) : ∃ N,
    WL h2 (th0 0 τ.toSpecialLinearGroup : G h n) N := by
  rw [th0_toSpecialLinearGroup]
  rcases (show ∀ c : ZMod 2, c = 0 ∨ c = 1 by decide) τ.c with h0 | h1
  · exact ⟨0, by simpa [h0, SpecialLinearGroup.transvection_coeff_zero] using WL.one⟩
  · exact ⟨4 ^ (h + 3) * (2 * (n + 1)) ^ 3, by simpa [h1] using WL.el_one h3 τ.i τ.j τ.hij⟩

theorem WL.const (h3 : 3 ≤ h) (A : SL2 h) : ∃ N, WL h2 (th0 0 A : G h n) N := by
  obtain ⟨l, rfl⟩ := exists_transvections A
  induction l with
  | nil => exact ⟨0, by simpa using WL.one⟩
  | cons τ l ih =>
    obtain ⟨N, hN⟩ := ih
    obtain ⟨M, hM⟩ := WL.transvectionStruct (n := n) (h2 := h2) h3 τ
    exact ⟨M + N, by simpa only [List.map_cons, List.prod_cons, map_mul] using hM.mul hN⟩

theorem exists_base (h2 : 2 ≤ h) (h3 : 3 ≤ h) : ∃ C, ∀ g : G h 0, WL h2 g C := by
  have h1 (g : G h 0) : ∃ N, WL h2 g N := by
    obtain ⟨N, hN⟩ := WL.const (n := 0) (h2 := h2) h3 (evG g)
    have hg : th0 0 (evG g) = g := (evG_bijective_zero (h := h)).1 <|
      Subtype.ext <| Matrix.ext fun _ _ => by rw [evG_th0, sub_zero, sub_zero]
    exact ⟨N, hg ▸ hN⟩
  choose N hN using h1
  exact ⟨univ.sup N, fun g => (hN g).mono (Finset.le_sup (mem_univ g))⟩

/-- **The diameter.** -/
theorem exists_diam (h : ℕ) [NeZero h] (h2 : 2 ≤ h) (h3 : 3 ≤ h) :
    ∃ C, ∀ (n : ℕ) (g : G h n), WL h2 g (C * (n + 1) ^ 7) := by
  obtain ⟨C, hC⟩ := exists_base h2 h3
  let B := h * h * (5 * (4 ^ (h + 3) * 9 * 8))
  refine ⟨C + B, fun n => ?_⟩
  induction n with
  | zero => exact fun g => (hC g).mono (by simp)
  | succ n ih =>
    refine fun g => (WL.lift h3 ih g).mono ?_
    have h6 : bQ h n ≤ 4 ^ (h + 3) * 9 * 8 * (n + 1) ^ 6 := by
      unfold bQ
      have : (n + 2) ^ 3 ≤ 8 * (n + 1) ^ 3 :=
        (Nat.pow_le_pow_left (show n + 2 ≤ 2 * (n + 1) by omega) 3).trans_eq (by ring)
      exact (by gcongr : _ ≤ 4 ^ (h + 3) * (9 * (8 * (n + 1) ^ 3)) * (n + 1) ^ 3).trans_eq (by ring)
    have h4 : h * h * (5 * bQ h n) ≤ B * (n + 1) ^ 6 :=
      (by gcongr : _ ≤ h * h * (5 * (4 ^ (h + 3) * 9 * 8 * (n + 1) ^ 6))).trans_eq
        (by simp only [B]; ring)
    have h7 : (n + 1) ^ 7 + (n + 1) ^ 6 ≤ (n + 1 + 1) ^ 7 := by
      calc (n + 1) ^ 7 + (n + 1) ^ 6 = (n + 1) ^ 6 * (n + 2) := by ring
        _ ≤ (n + 2) ^ 6 * (n + 2) := Nat.mul_le_mul_right _ (Nat.pow_le_pow_left (by omega) 6)
        _ = (n + 1 + 1) ^ 7 := by ring
    refine (Nat.add_le_add_left (h4.trans (Nat.mul_le_mul_right _ (Nat.le_add_left B C))) _).trans
      ?_
    rw [← mul_add]
    exact Nat.mul_le_mul_left _ h7

end Cslib.SLTower
